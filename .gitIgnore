*.scx
*.sct
*.vcx
*.vct
*.frx
*.frt
*.mnx
*.mnt
*.lbx
*.lbt

# === NOTA: Si NO quieres ignorar los binarios (estrategia mixta),
# comenta o elimina las líneas anteriores ===

# === ARCHIVOS DE PROYECTO COMPILADOS ===
*.exe
*.prg~  (backups del editor de VFP)

# === CARPETAS DE SISTEMA ===
_screen/
*.dcu

