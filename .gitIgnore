# === ARCHIVOS TEMPORALES DE VFP ===
*.bak
*.err
*.ftp
*.log
*.tmp
foxuser.*
Config.fpw

# === ÍNDICES (se regeneran) ===
*.cdx
*.idx

# === BINARIOS DE VFP (si usas FoxBin2Prg y solo versionas los .prg/.h) ===
