	PROCEDURE Load
		DODEFAULT()
		SET SEPARATOR  TO "."
		SET POINT TO ","
	ENDPROC

	PROCEDURE btn_aceptar.Click
		local lddesde, ldhasta, lncodvendedor, lncodcliente
		local lcsql, lnresult, loexception
		local lccliente, lcvendedor
		
		
		lddesde      = fechatomysql(thisform.fecha_desde.getvalue())
		ldhasta      = fechatomysql(thisform.fecha_hasta.getvalue())
		lncodvendedor = thisform.txt_id_vendedor.value
		lncodcliente  = thisform.txt_id_cliente.value
		
		lcvendedor		= alltrim(thisform.txt_vendedor.value)
		lccliente		= alltrim(thisform.txt_cliente.value)
		
		try
		* Construir la llamada al stored procedure
			lcsql = "CALL sp_reporte_ventas_detallado('" + lddesde + "', '" + ldhasta + "', " + ;
				alltrim(str(lncodcliente)) + ", " + ;
				alltrim(str(lncodvendedor)) + ", 0)"
		
			* Ejecutar la consulta
			lnresult = sqlexec(conexion, lcsql, "curVentasDetalle")
		
			if lnresult > 0
				* Verificar si hay datos
				if reccount("curVentasDetalle") > 0
					* Imprimir el informe
					*REPORT FORM _informe_cobro_detallado.frx PREVIEW
					* Para imprimir directamente: 
					lddesde      = thisform.fecha_desde.getvalue()
					ldhasta      = thisform.fecha_hasta.getvalue()
					
					report form _informe_venta_detallado preview noconsole
				else
					messagebox("No se encontraron registros para los criterios especificados", 64, "Información")
				endif
			else
				messagebox("Error al ejecutar la consulta de ventas", 16, "Error")
			endif
		
		
		
		catch to loexception
			messagebox("Error: " + loexception.message, 16, "Error en consulta")
		endtry
		
	ENDPROC

	PROCEDURE btn_cancelar.Click
		THISFORM.Release()
	ENDPROC

	PROCEDURE txt_id_cliente.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			local loregistro as object
			do form bus_cliente to loregistro
			
			if vartype(loregistro) <> "L"
				
				this.value = loregistro.idcliente
				this.setfocus()
			else
				this.value = 0
			endif
		endif
	ENDPROC

	PROCEDURE txt_id_cliente.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnIDcliente, lcSQL
		    
		    lnIDcliente= this.Value
		    
		    lcSQL = "SELECT * FROM v_clientes WHERE idcliente= " + ALLTRIM(STR(lnIDcliente, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_cliente") > 0
		        IF RECCOUNT("cur_cliente") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_cliente.idcliente
					thisform.txt_cliente.Value = cur_cliente.nombre_completo
					*
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Cliente no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_cliente.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar Cobrador: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_cliente.Value = "TODOS"
		ENDIF
	ENDPROC

	PROCEDURE txt_id_vendedor.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			local loregistro as object
			do form bus_vendedor to loregistro
		
		
			if vartype(loregistro) <> "L"
		
				this.value = loregistro.idvendedor
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
	ENDPROC

	PROCEDURE txt_id_vendedor.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnIDvendedor, lcSQL
		    
		    lnIDvendedor = this.Value
		    
		    lcSQL = "SELECT * FROM v_vendedores WHERE idvendedor = " + ALLTRIM(STR(lnIDvendedor, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_vendedor") > 0
		        IF RECCOUNT("cur_vendedor") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_vendedor.idvendedor
					thisform.txt_vendedor.Value = cur_vendedor.vendedor
					*
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Vendedor no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_vendedor.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar Vendedor: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_vendedor.Value = "TODOS"
		ENDIF
	ENDPROC

ENDDEFINE
