	PROCEDURE aplicarformatocondicionalgrid
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tcSuc, tcDep
		
		THISFORM.codSucursal = tcSuc
		THISFORM.codDeposito = tcDep
		
		lcSQL = "SELECT * FROM v_articulo WHERE idsucursal = " + TRANSFORM(THISFORM.codSucursal) + ;
		        " AND iddeposito = " + TRANSFORM(THISFORM.codDeposito)
		
		IF SQLEXEC(conexion, lcSQL, "cur_articulos") > 0
		    THISFORM.llenar_grid()
		    thisform.aplicarformatocondicionalgrid()
		ENDIF
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		
		IF nKeyCode=27
			NODEFAULT 
			thisform.cmdgroup.command2.Click
		ENDIF 
		
		IF nKeyCode = 15
			NODEFAULT 
			thisform.cmdgroup.command1.Click
		ENDIF 
	ENDPROC

	PROCEDURE llenar_grid
		WITH ThisForm.Grid1
		    .RecordSource = "cur_articulos"
		    .ColumnCount = 16
		    
		    * Columna 1 - Código
		    .Column1.ControlSource = "cur_articulos.codbarra"
		    .Column1.Width = 100
		    .Column1.Header1.Caption = "Código"
		    .Column1.Alignment = 0 
		    
		    * Columna 2 - Descripción
		    .Column2.ControlSource = "cur_articulos.descripcion"
		    .Column2.Width = 300
		    .Column2.Header1.Caption = "Descripción"
		    .Column2.Alignment = 0 
		    
		    * Columna 3 - Depósito
		    .Column3.ControlSource = "cur_articulos.nombre_deposito"
		    .Column3.Width = 150
		    .Column3.Header1.Caption = "Depósito"
		    .Column3.Alignment = 0  
		    
		    * Columna 4 - Stock Actual (PRIMERO después de Depósito)
		    .Column4.ControlSource = "cur_articulos.stock_actual"
		    .Column4.Width =80
		    .Column4.Header1.Caption = "Stock Act."
		    .Column4.Alignment = 0 
		    .Column4.DynamicBackColor = 'IIF(VAL(cur_articulos.stock_actual) < cur_articulos.stock_minimo, RGB(255, 200, 200), RGB(255, 255, 255))'
		    
		    * Columna 5 - Precio Contado (SEGUNDO después de Depósito)
		    .Column5.ControlSource = "cur_articulos.precio_contado"
		    .Column5.Width = 100
		    .Column5.Header1.Caption = "Precio Contado"
		    .Column5.inputmask = '999,999,999'
		    .Column5.Alignment = 0 
		    
		    * Columna 6 - Precio Costo (TERCERO después de Depósito)
		    .Column6.ControlSource = "cur_articulos.precio_costo"
		    .Column6.Width = 100
		    .Column6.Header1.Caption = "Precio Costo"
		    .Column6.Alignment = 0  
		    .Column6.inputmask = '999,999,999'
		    .Column6.DynamicBackColor = 'IIF(cur_articulos.precio_costo = 0, RGB(255, 200, 200), RGB(255, 255, 255))'
		    
		    * Columna 7 - ID
		    .Column7.ControlSource = "cur_articulos.idarticulo"
		    .Column7.Width = 60
		    .Column7.Header1.Caption = "SKU"
		    
		    * Columna 8 - Marca
		    .Column8.ControlSource = "cur_articulos.nombre_marca"
		    .Column8.Width = 100
		    .Column8.Header1.Caption = "Marca"
		    .Column8.Alignment = 0 
		    
		    * Columna 9 - Grupo
		    .Column9.ControlSource = "cur_articulos.nombre_grupo"
		    .Column9.Width = 180
		    .Column9.Header1.Caption = "Grupo"
		    .Column9.Alignment = 0
		    
		    * Columna 10 - Subgrupo
		    .Column10.ControlSource = "cur_articulos.nombre_subgrupo"
		    .Column10.Width = 180
		    .Column10.Header1.Caption = "Subgrupo"
		    .Column10.Alignment = 0
		    
		    * Columna 11 - Proveedor
		    .Column11.ControlSource = "cur_articulos.nombre_proveedor"
		    .Column11.Width = 180
		    .Column11.Header1.Caption = "Proveedor"
		    .Column11.Alignment = 0
		    
		    * Columna 12 - Unidad
		    .Column12.ControlSource = "cur_articulos.unidad"
		    .Column12.Width = 50
		    .Column12.Header1.Caption = "Unidad"
		    .Column12.Alignment = 0  
		    
		    * Columna 13 - Stock Mínimo
		    .Column13.ControlSource = "cur_articulos.stock_minimo"
		    .Column13.Width = 70
		    .Column13.Header1.Caption = "Stock Min."
		    .Column13.Alignment = 0  
		    
		    * Columna 14 - Sucursal
		    .Column14.ControlSource = "cur_articulos.nombre_sucursal"
		    .Column14.Width = 150
		    .Column14.Header1.Caption = "Sucursal"
		    .Column14.Alignment = 0  
		    
		    * Columna 15 - Impuesto
		    .Column15.ControlSource = "cur_articulos.impuesto"
		    .Column15.Width = 50
		    .Column15.Header1.Caption = "IVA"
		    .Column15.Alignment = 0 
		    
		    * Columna 16 - Última Compra
		    .Column16.ControlSource = "cur_articulos.ultima_fecha_compra"
		    .Column16.Width = 80
		    .Column16.Header1.Caption = "Últ.Compra"
		    
		    * Propiedades adicionales de la grilla
		    .ReadOnly = .T.  && Solo lectura
		    .AllowHeaderSizing = .T.
		    .AllowRowSizing = .T.
		    
		ENDWITH
	ENDPROC

	PROCEDURE Unload
		RETURN thisform.registro
	ENDPROC

	PROCEDURE cmdgroup.Command1.Click
		SELECT cur_articulos
		SCATTER NAME thisform.registro
		thisform.Release
	ENDPROC

	PROCEDURE cmdgroup.Command2.Click
		thisform.Release
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		*!*	* En el evento AfterRowColChange del Grid1
		*!*	LOCAL i
		*!*	FOR i = 1 TO This.ColumnCount
		*!*	    DO CASE
		*!*	        CASE i = 9  && Columna Precio Costo
		*!*	            IF cur_articulos.precio_costo = 0
		*!*	                This.Columns(i).DynamicBackColor = "RGB(255, 200, 200)"
		*!*	            ELSE
		*!*	                This.Columns(i).DynamicBackColor = "RGB(255, 255, 255)"
		*!*	            ENDIF
		*!*	            
		*!*	        CASE i = 11  && Columna Stock Actual
		*!*	            IF val(cur_articulos.stock_actual) < cur_articulos.stock_minimo
		*!*	                This.Columns(i).DynamicBackColor = "RGB(255, 200, 200)"
		*!*	            ELSE
		*!*	                This.Columns(i).DynamicBackColor = "RGB(255, 255, 255)"
		*!*	            ENDIF
		*!*	    ENDCASE
		*!*	ENDFOR
		
	ENDPROC

	PROCEDURE Grid1.Column1.Text1.KeyPress
		lparameters nkeycode, nshiftaltctrl
		
		if nkeycode = 13
			nodefault
			thisform.cmdgroup.click()
		endif
	ENDPROC

	PROCEDURE Grid1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode=13
		NODEFAULT 
			thisform.cmdgroup.command1.Click
		ENDIF 
	ENDPROC

	PROCEDURE txt_buscar.InteractiveChange
		dodefault()
		local lcbusqueda, lcfiltro, lcrecordsource, lacampos[1], lncampos, lni, lccampo
		
		* Obtener el texto de búsqueda (sin espacios al inicio/final)
		lcbusqueda = alltrim(upper(this.value))
		
		* Obtener el recordsource del grid
		lcrecordsource = thisform.grid1.recordsource
		
		if empty(lcbusqueda)
		* Si no hay texto de búsqueda, mostrar todos los registros
			if used(lcrecordsource)
				select (lcrecordsource)
				set filter to
				go top
			endif
		else
		* Verificar que exista la propiedad cCamposBusqueda
			if type("THISFORM.cCamposBusqueda") = "C" and !empty(thisform.ccamposbusqueda)
		
		* Dividir los campos por comas
				lncampos = alines(lacampos, strtran(thisform.ccamposbusqueda, " ", ""), 1, ",")
				lcfiltro = ""
		
		* Construir el filtro dinámicamente
				for lni = 1 to lncampos
					lccampo = alltrim(lacampos[lnI])
		
		* Verificar que el campo existe en el cursor
					if used(lcrecordsource)
						select (lcrecordsource)
						if type(lccampo) <> "U"
		
		* Agregar OR si no es el primer campo
							if !empty(lcfiltro)
								lcfiltro = lcfiltro + " OR "
							endif
		
		* Determinar el tipo de campo y construir la condición apropiada
							do case
								case type(lccampo) = "N"  && Campo numérico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(STR(" + lccampo + ")))"
		
								case type(lccampo) = "C"  && Campo de texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(" + lccampo + "))"
		
								case type(lccampo) = "D"  && Campo de fecha
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(DTOC(" + lccampo + "))"
		
								case type(lccampo) = "L"  && Campo lógico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(IIF(" + lccampo + ", 'TRUE', 'FALSE'))"
		
								otherwise  && Otros tipos, tratar como texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(TRANSFORM(" + lccampo + ")))"
							endcase
						endif
					endif
				next
		
		* Aplicar el filtro si se construyó correctamente
				if !empty(lcfiltro) and used(lcrecordsource)
					select (lcrecordsource)
					set filter to &lcfiltro
					go top
				endif
		
			else
		* Si no existe la propiedad, mostrar mensaje de error
				messagebox("La propiedad 'cCamposBusqueda' no está definida en el formulario.", 16, "Error de configuración")
			endif
		endif
		
		* Refrescar el grid
		thisform.grid1.refresh()
	ENDPROC

ENDDEFINE
