		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		LOCAL lcSQL
		
		lcSQL = "SELECT * FROM v_clientes order by nombre"
		
		IF SQLEXEC(conexion, lcSQL, "cur_cliente") > 0
		    THISFORM.llenar_grid()
		ENDIF
		
	ENDPROC

	PROCEDURE llenar_grid
		WITH ThisForm.Grid1
		    .RecordSource = "cur_cliente"
		    .ColumnCount = 16
		
		    .Column1.ControlSource = "cur_cliente.ci"
		    .Column1.Width = 100
		    .Column1.Header1.Caption = "Cédula"
		    .Column1.Alignment = 0 
		    
		    * Columna 2 - Nombre Completo
		    .Column2.ControlSource = "cur_cliente.nombre_completo"
		    .Column2.Width = 250
		    .Column2.Header1.Caption = "Nombre Completo"
		    .Column2.Alignment = 0 
		    
		    * Columna 3 - Nombre
		    .Column3.ControlSource = "cur_cliente.nombre"
		    .Column3.Width = 120
		    .Column3.Header1.Caption = "Nombre"
		    .Column3.Alignment = 0 
		    
		    * Columna 4 - Apellido
		    .Column4.ControlSource = "cur_cliente.apellido"
