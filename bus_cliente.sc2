		    * Columna 6 - RUC
		    .Column6.ControlSource = "cur_cliente.ruc"
		    .Column6.Width = 100
		    .Column6.Header1.Caption = "RUC"
		    .Column6.Alignment = 0 
		    
		    * Columna 7 - Celular
		    .Column7.ControlSource = "cur_cliente.celular"
		    .Column7.Width = 100
		    .Column7.Header1.Caption = "Celular"
		    .Column7.Alignment = 0  
		    
		    * Columna 8 - Teléfono
		    .Column8.ControlSource = "cur_cliente.telefono"
		    .Column8.Width = 100
		    .Column8.Header1.Caption = "Teléfono"
		    .Column8.Alignment = 0  
		    
		    * Columna 9 - Zona
		    .Column9.ControlSource = "cur_cliente.zona"
		    .Column9.Width = 150
		    .Column9.Header1.Caption = "Zona"
		    .Column9.Alignment = 0 
		    
		    * Columna 10 - Barrio
		    .Column10.ControlSource = "cur_cliente.barrio"
		    .Column10.Width = 150
		    .Column10.Header1.Caption = "Barrio"
		    .Column10.Alignment = 0
		    
		    * Columna 11 - Ubicación Completa
		    .Column11.ControlSource = "cur_cliente.ubicacion_completa"
