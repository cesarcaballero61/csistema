	PROCEDURE btn_aceptar.Click
		LOCAL lddesde, ldhasta, lncodCobrador, lncodcliente
		LOCAL lcSQL, lnResult, loException
		
		lddesde      = FechaToMySQL(thisform.fecha_desde.getvalue())
		ldhasta      = FechaToMySQL(thisform.fecha_hasta.getvalue())
		lncodCobrador = thisform.txt_id_COBRADOR.Value
		lncodcliente  = thisform.txt_id_CLIENTE.Value
		
		lcCobrador		=ALLTRIM(thisform.txt_cobrador.Value)
		lcCliente		=ALLTRIM(thisform.txt_cliente.Value)
		
		TRY
		    * Construir la llamada al stored procedure
		    lcSQL = "CALL sp_consultar_pagos_cuotas_detalle('" + lddesde + "', '" + ldhasta + "', " + ;
		            ALLTRIM(STR(lncodCobrador)) + ", " + ;
		            ALLTRIM(STR(lncodcliente)) + ", 0)"
		    
		    * Ejecutar la consulta
		    lnResult = SQLEXEC(CONEXION, lcSQL, "curPagosDetalle")
		    
		    IF lnResult > 0
		        * Verificar si hay datos
		        IF RECCOUNT("curPagosDetalle") > 0
		            * Imprimir el informe
		            *REPORT FORM _informe_cobro_detallado.frx PREVIEW
		            * Para imprimir directamente: 
		            lddesde      = thisform.fecha_desde.getvalue()
					ldhasta      = thisform.fecha_hasta.getvalue()
		             REPORT FORM _informe_cobro_detallado PREVIEW NOCONSOLE 
		        ELSE
		            MESSAGEBOX("No se encontraron registros para los criterios especificados", 64, "Información")
		        ENDIF
		    ELSE
		        MESSAGEBOX("Error al ejecutar la consulta de pagos", 16, "Error")
		    ENDIF
		    
		    
		    
		CATCH TO loException
		    MESSAGEBOX("Error: " + loException.Message, 16, "Error en consulta")
		ENDTRY
		
	ENDPROC

	PROCEDURE btn_cancelar.Click
		THISFORM.Release()
	ENDPROC

	PROCEDURE txt_id_cliente.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			local loregistro as object
			do form bus_cliente to loregistro
			
			if vartype(loregistro) <> "L"
				
				this.value = loregistro.idcliente
				this.setfocus()
			else
				this.value = 0
			endif
		endif
	ENDPROC

	PROCEDURE txt_id_cliente.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnIDcliente, lcSQL
		    
		    lnIDcliente= this.Value
		    
		    lcSQL = "SELECT * FROM v_clientes WHERE idcliente= " + ALLTRIM(STR(lnIDcliente, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_cliente") > 0
		        IF RECCOUNT("cur_cliente") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_cliente.idcliente
					thisform.txt_cliente.Value = cur_cliente.nombre_completo
					*
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Cliente no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_cliente.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar Cobrador: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_cliente.Value = "TODOS"
		ENDIF
	ENDPROC

	PROCEDURE txt_id_cobrador.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			local loregistro as object
			do form bus_cobrador to loregistro
		
		
			if vartype(loregistro) <> "L"
		
				this.value = loregistro.idcobrador
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
	ENDPROC

	PROCEDURE txt_id_cobrador.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnIDcobrador, lcSQL
		    
		    lnIDcobrador= this.Value
		    
		    lcSQL = "SELECT * FROM v_cobradores WHERE idcobrador = " + ALLTRIM(STR(lnIDcobrador, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_cobrador") > 0
		        IF RECCOUNT("cur_cobrador") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_cobrador.idcobrador
					thisform.txt_cobrador.Value = cur_cobrador.nombre_completo
					*
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Cobrador no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_cobrador.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar Cobrador: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_cobrador.Value = "TODOS"
		ENDIF
