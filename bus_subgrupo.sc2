DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txt_buscar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Grid1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="cmdgroup" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: llenar_grid
		*p: ccamposbusqueda
		*p: codgrupo
		*p: cod_grupo
		*p: registro
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		Caption = "Buscar subgrupo"
		ccamposbusqueda = idsubgrupo,subgrupo,grupo
		codgrupo = 0
		cod_grupo = .F.
		DoCreate = .T.
		Height = 343
		Icon = iconos\ventana.ico
		LockScreen = .F.
		MaxButton = .F.
		MinButton = .F.
		Name = "FORM1"
		Picture = 
		registro = .F.
		ShowWindow = 1
		Width = 447
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdgroup' AS commandgroup WITH ;
		AutoSize = .F., ;
		ButtonCount = 2, ;
		Height = 37, ;
		Left = 324, ;
		Name = "cmdgroup", ;
		Top = 303, ;
		Value = 1, ;
		Width = 112, ;
		Command1.AutoSize = .F., ;
		Command1.Caption = "Elegir", ;
		Command1.Height = 27, ;
		Command1.Left = 5, ;
		Command1.Name = "Command1", ;
		Command1.Top = 5, ;
		Command1.Width = 50, ;
		Command2.AutoSize = .F., ;
		Command2.Caption = "Salir", ;
		Command2.Height = 27, ;
		Command2.Left = 57, ;
		Command2.Name = "Command2", ;
		Command2.Top = 5, ;
		Command2.Width = 50
		*< END OBJECT: BaseClass="commandgroup" />

	ADD OBJECT 'Grid1' AS grid WITH ;
		AllowCellSelection = .F., ;
		BackColor = 255,255,255, ;
		ColumnCount = 0, ;
		DeleteMark = .F., ;
		FontSize = 8, ;
		ForeColor = 0,0,0, ;
		GridLineColor = 192,192,192, ;
		GridLines = 0, ;
		GridLineWidth = 1, ;
		HeaderHeight = 20, ;
		Height = 240, ;
		Left = 1, ;
		Name = "Grid1", ;
		Panel = 1, ;
		RecordMark = .F., ;
		RowHeight = 17, ;
		ScrollBars = 3, ;
		SplitBar = .F., ;
		Themes = .T., ;
		Top = 60, ;
		Width = 444
		*< END OBJECT: BaseClass="grid" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		Caption = "Buscar:", ;
		FontSize = 8, ;
		Height = 16, ;
		Left = 2, ;
		Name = "Label1", ;
		Top = 27, ;
		Width = 40
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'txt_buscar' AS textbox WITH ;
		FontSize = 8, ;
		Format = "k!", ;
		Height = 22, ;
		InputMask = "", ;
		IntegralHeight = .T., ;
		Left = 50, ;
		Name = "txt_buscar", ;
		Top = 24, ;
		Width = 228
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Init
		LPARAMETERS tncodsubgrupo
		this.codgrupo = IIF(EMPTY(tncodsubgrupo),0,tncodsubgrupo)
		
		IF NOT empty(this.codgrupo)
			= SQLEXEC(conexion,"select * from v_subgrupo where idgrupo = "+ ALLTRIM(STR(this.codgrupo,10,0)) +" order by subgrupo","curbusqueda")
		ELSE
			= SQLEXEC(conexion,"select * from v_subgrupo order by subgrupo","curbusqueda")
		ENDIF 
		
		
		thisform.llenar_grid()
	ENDPROC

	PROCEDURE llenar_grid
		WITH this.grid1
			.RecordSource="curbusqueda"
			.RecordSourceType= 1
			.columncount=3
			.fontsize=8
			
			.column1.header1.caption="CODIGO"
			.column1.width=50
			.column1.alignment=0
			.column1.controlsource="curbusqueda.idsubgrupo"
			
			.column2.header1.caption="SUB GRUPO"
			.column2.width=198
			.column2.controlsource="curbusqueda.subgrupo"
			
			.column3.header1.caption="GRUPO"
			.column3.width=198
			.column3.controlsource="curbusqueda.GRUPO"
			.column3.alignment = 0
		ENDWITH 
	ENDPROC

	PROCEDURE Unload
		RETURN thisform.registro
	ENDPROC

	PROCEDURE cmdgroup.Command1.Click
		SELECT curbusqueda
		SCATTER NAME thisform.registro
		thisform.Release
	ENDPROC

	PROCEDURE cmdgroup.Command2.Click
		thisform.Release
	ENDPROC

	PROCEDURE Grid1.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode=13
			NODEFAULT 
			thisform.cmdgroup.command1.Click
		ENDIF 
	ENDPROC

	PROCEDURE txt_buscar.InteractiveChange
		dodefault()
		local lcbusqueda, lcfiltro, lcrecordsource, lacampos[1], lncampos, lni, lccampo
		
		* Obtener el texto de búsqueda (sin espacios al inicio/final)
		lcbusqueda = alltrim(upper(this.value))
		
		* Obtener el recordsource del grid
		lcrecordsource = thisform.grid1.recordsource
		
		if empty(lcbusqueda)
		* Si no hay texto de búsqueda, mostrar todos los registros
			if used(lcrecordsource)
				select (lcrecordsource)
				set filter to
				go top
			endif
		else
		* Verificar que exista la propiedad cCamposBusqueda
			if type("THISFORM.cCamposBusqueda") = "C" and !empty(thisform.ccamposbusqueda)
		
		* Dividir los campos por comas
				lncampos = alines(lacampos, strtran(thisform.ccamposbusqueda, " ", ""), 1, ",")
				lcfiltro = ""
		
		* Construir el filtro dinámicamente
				for lni = 1 to lncampos
					lccampo = alltrim(lacampos[lnI])
		
		* Verificar que el campo existe en el cursor
					if used(lcrecordsource)
						select (lcrecordsource)
						if type(lccampo) <> "U"
		
		* Agregar OR si no es el primer campo
							if !empty(lcfiltro)
								lcfiltro = lcfiltro + " OR "
							endif
		
		* Determinar el tipo de campo y construir la condición apropiada
							do case
								case type(lccampo) = "N"  && Campo numérico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(STR(" + lccampo + ")))"
		
								case type(lccampo) = "C"  && Campo de texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(" + lccampo + "))"
		
								case type(lccampo) = "D"  && Campo de fecha
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(DTOC(" + lccampo + "))"
		
								case type(lccampo) = "L"  && Campo lógico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(IIF(" + lccampo + ", 'TRUE', 'FALSE'))"
		
								otherwise  && Otros tipos, tratar como texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(TRANSFORM(" + lccampo + ")))"
							endcase
						endif
					endif
				next
		
		* Aplicar el filtro si se construyó correctamente
				if !empty(lcfiltro) and used(lcrecordsource)
					select (lcrecordsource)
					set filter to &lcfiltro
					go top
				endif
		
			else
		* Si no existe la propiedad, mostrar mensaje de error
				messagebox("La propiedad 'cCamposBusqueda' no está definida en el formulario.", 16, "Error de configuración")
			endif
		endif
		
		* Refrescar el grid
		thisform.grid1.refresh()
	ENDPROC

ENDDEFINE
