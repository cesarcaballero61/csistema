	PROCEDURE Init
		DODEFAULT()
		= sqlexec(conexion, "select * from v_cuotas_ventas_clientes WHERE 0=1", "crs_cuotas_ventas")
		thisform._grid_cuota_venta()
		
		= sqlexec(conexion, "select * from v_detalle_cuotas WHERE 0=1", "crs_detalle_cuotas")
		thisform._grid_cuotas()
		
		
		= sqlexec(conexion, "select * from v_detalle_ventas_simple WHERE 0=1", "crs_detalle_venta_articulo")
		thisform._grid_detalle_venta()
		
		
		
		= sqlexec(conexion, "select * from v_recibos_detallados WHERE 0=1", "crs_pagos_cuotas")
		thisform._GRid_detalles_pagos()
		
		
		
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		
		SET NULLDISPLAY TO "S/D"
		
	ENDPROC

	PROCEDURE sumar_saldo
		LOCAL lnTotal
		lnTotal = 0
		* Verificar si existe el cursor
		IF USED("crs_cuotas_ventas")
		
		    * Guardar el área de trabajo actual
		    LOCAL lcAreaAnterior
		    lcAreaAnterior = ALIAS()
		    
		    * Seleccionar el cursor temporal
		    SELECT crs_cuotas_ventas
		    
		    * Calcular la suma
		    SUM saldo_actual TO lnTotal
		    
		    * Volver al área de trabajo anterior si existe
		    IF !EMPTY(lcAreaAnterior)
		        SELECT (lcAreaAnterior)
		    ENDIF
		ELSE
		    * Si no existe el cursor, el total es 0
		    lnTotal = 0
		ENDIF
		
		RETURN lnTotal
	ENDPROC

	PROCEDURE test_menu
		MESSAGEBOX("HOLA MUNDO DESDE EN MENU CONTEXTUAL",64,"AVISO")
	ENDPROC

	PROCEDURE _busar_detalle_cuotas
		lparameters tnidcuota
		
		local lnid_cuota, lcsql
		
		lnid_cuota = tnidcuota
		
		lcsql = "select * from v_detalle_cuotas where idcuotas=";
			+ alltrim(str(tnidcuota, 10, 0)) + " ORDER BY ORDEN_CUOTA ASC"
		
		
		if sqlexec(conexion, lcsql, "crs_detalle_cuotas") > 0
			if reccount("crs_detalle_cuotas") = 0
				messagebox("ESTE CLIENTE NO POSEE DATOS DE DETALLE DE CUOTAS!", 16, "AVISO")
			endif
		else
			aerror(loerror)
			messagebox("Error en consulta de DETALLE DE cuotas de cliente " + loerror[2])
		endif
		
		thisform._grid_cuotas()
	ENDPROC

	PROCEDURE _buscar_datos_cuota
		LPARAMETERS tnidcliente, tnEstado
		
		LOCAL lnid_cliente, lcsql, lcEstado, lcWhereCondition
		LOCAL ARRAY loError[1]
		
		*-- Validar parámetros
		IF EMPTY(tnidcliente) OR tnidcliente <= 0
		    MESSAGEBOX("ID de cliente inválido.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lnid_cliente = tnidcliente
		
		*-- Definir condición de estado corregida
		DO CASE
		    CASE tnEstado = 1  && Todos los estados
		        lcEstado = ""
		    CASE tnEstado = 2  && Solo pendientes
		        lcEstado = "AND estado_cuota= 'PEN'"
		    CASE tnEstado = 3  && Solo cancelados
		        lcEstado = "AND estado_cuota= 'CAN'"
		    OTHERWISE         && Por defecto: pendientes
		        lcEstado = "AND estado_cuota= 'PEN'"
		ENDCASE
		
		*-- Construir consulta SQL de forma segura
		lcsql = "SELECT * FROM v_cuotas_ventas_clientes " + ;
		        "WHERE idcliente = " + ALLTRIM(STR(tnidcliente)) + " " + ;
		        lcEstado + " " + ;
		        "ORDER BY idventa"
		
		*-- Ejecutar consulta
		IF SQLEXEC(conexion, lcsql, "crs_cuotas_ventas") > 0
		    IF RECCOUNT("crs_cuotas_ventas") = 0
		        *-- Mensaje contextual según el estado
		        DO CASE
		            CASE tnEstado = 1
		                lcMensaje = "Este cliente no posee cuotas registradas."
		            CASE tnEstado = 2
		                lcMensaje = "Este cliente no posee cuotas pendientes."
		            CASE tnEstado = 3
		                lcMensaje = "Este cliente no posee cuotas canceladas."
		            OTHERWISE
		                lcMensaje = "Este cliente no posee datos de cuotas."
		        ENDCASE
		        this.Init()
		        MESSAGEBOX(lcMensaje, 64, "Aviso")
		    ELSE
		        *-- Procesar datos encontrados
		        THISFORM.TXT_SALDO.VALUE = THISFORM.sumar_saldo()
		        GO TOP IN crs_cuotas_ventas
		        
		        *-- Buscar detalle de la primera cuota (descomentar si es necesario)
		        * THISFORM._buscar_detalle_cuota(crs_cuotas_ventas.idcuotas)
		    ENDIF
		ELSE
		    AERROR(loError)
		    MESSAGEBOX("Error en consulta de cuotas del cliente: " + loError[2], 16, "Error")
		    RETURN .F.
		ENDIF
		
		*-- Actualizar grid
		THISFORM._grid_cuota_venta()
		
		RETURN .T.
	ENDPROC

	PROCEDURE _buscar_detalle_venta
		lparameters tnidventa
		
		local lnidventa, lcsql
		local array loerror[1]
		
		
		lnidventa = tnidventa
		
		lcsql = "select * from v_detalle_ventas_simple where idVenta=";
			+ alltrim(str(lnidventa, 10, 0)) + "  ORDER BY idDetalle ASC"
		
		
		if sqlexec(conexion, lcsql, "crs_detalle_venta_articulo") > 0
			if reccount("crs_detalle_venta_articulo") = 0
				messagebox("ESTE CLIENTE NO POSEE DATOS DE DETALLE DE VENTA!", 16, "AVISO")
			endif
		else
			aerror(loerror)
			messagebox("Error en consulta de DETALLE DE VENTA" + loerror[2])
		endif
		
		thisform._grid_detalle_venta()
	ENDPROC

	PROCEDURE _buscar_recibo
		LPARAMETERS tnidcuota
		
		LOCAL lnid_cuota, lcsql, lnResult
		LOCAL ARRAY loError[1]
		
		*-- Validar parámetro
		IF EMPTY(tnidcuota) OR tnidcuota <= 0
		    MESSAGEBOX("ID de cuota inválido.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		lnid_cuota = tnidcuota
		
		*-- Consulta para obtener los pagos de la cuota específica
		lcsql = "SELECT * FROM v_recibos_detallados " + ;
		        "WHERE idcuotas = " + ALLTRIM(STR(tnidcuota)) + " " + ;
		        "ORDER BY fecha DESC, nro_recibo DESC"
		
		lnResult = SQLEXEC(conexion, lcsql, "crs_pagos_cuotas")
		
		IF lnResult > 0
		*!*	    IF RECCOUNT("crs_pagos_cuotas") = 0
		*!*	        MESSAGEBOX("La cuota Nº " + ALLTRIM(STR(tnidcuota)) + " no posee pagos registrados.", 64, "Información")
		*!*	    ENDIF
		ELSE
		    AERROR(loError)
		    MESSAGEBOX("Error al consultar pagos de la cuota: " + loError[2], 16, "Error")
		    RETURN .F.
		ENDIF
		
		*-- Actualizar la grilla de pagos
		THISFORM._GRid_detalles_pagos()
		
		RETURN .T.
	ENDPROC

	PROCEDURE _calcular_totales_cuotas
		local lntotalpagado, lntotalpendiente, lntotalcuota
		
		*-- Inicializar variables
		store 0 to lntotalpagado, lntotalpendiente, lntotalcuota
		
		*-- Verificar que el cursor existe y tiene datos
		if used("crs_detalle_cuotas") and reccount("crs_detalle_cuotas") > 0
			select crs_detalle_cuotas
		
		*-- Calcular totales usando SCAN (más preciso)
			scan
				do case
					case estado_detalle = 'CAN'  && Cuota cancelada
						lntotalpagado = lntotalpagado + cuota
					case estado_detalle = 'PEN'  && Cuota pendiente
						lntotalpendiente = lntotalpendiente + saldo_cuota
						lntotalpagado = lntotalpagado + (cuota - saldo_cuota)
				endcase
		
		*-- Total de todas las cuotas (suma de montos originales)
				lntotalcuota = lntotalcuota + cuota
			endscan
		
		*-- Ir al primer registro para no afectar la navegación
			go top in crs_detalle_cuotas
		else
			messagebox("No hay datos de detalle de cuotas para calcular totales.", 64, "Información")
			return .f.
		endif
		
		*-- Actualizar controles del formulario
		with thisform
			.txt_total_pagado.value = lntotalpagado
			.txt_total_pendiente.value = lntotalpendiente
			.txt_total_cuotas.value = lntotalcuota
		
		*-- Calcular y mostrar porcentaje de avance
			if lntotalcuota > 0
				.lblporcentaje.caption = "Avance: " + ;
					transform((lntotalpagado / lntotalcuota) * 100, "999.9") + "%"
			else
				.lblporcentaje.caption = "Avance: 0%"
			endif
		endwith
		
		return .t.
		
	ENDPROC

	PROCEDURE _cancelar_operacion
		*-- Método para cancelar operación de pago y limpiar/desbloquear controles
		
		*-- Limpiar controles de texto
		with this
		*-- Limpiar y desbloquear controles de cliente
			.txt_ci_cliente.value = ""
			.txt_ci_cliente.enabled = .t.
		
			.txt_id_cuota.value 	= 0
		
			.txt_cliente.value = ""
			.txt_id_cliente.value = 0
			.txt_id_zona.value = 0
			.txt_zona.value = ""
			.txt_id_barrio.value = 0
			.txt_barrio.value = ""
			.txt_id_profesion.value = 0
			.txt_profesion.value = ""
			
			.txt_totaL_CUOTAS.Value = 0
			.txt_tOTAL_PAGADO.Value = 0
			.txt_totAL_PENDIENTE.Value = 0
			.txt_salDO.Value = 0
			.lblPorcentaje.Caption=''
		
		*-- Ejecutar evento Init del formulario
			.init()
		endwith
		
		*-- Mensaje de confirmación
		messagebox("Operación cancelada. Controles reseteados.", 64, "Cancelado")
	ENDPROC

	PROCEDURE _grid_cuotas
		WITH THIS.grid_cuotas
			.allowcellselection = .f.
			.columncount = 0
			.FontSize = 7
			.recordsourcetype = 1
			.recordsource = "crs_detalle_cuotas"
			.columncount = 12
		
			*-- Columna 1: ORDEN CUOTA
			.Column1.Header1.Caption = "ORDEN"
			.Column1.Header1.FontBold = .t.
			.Column1.ControlSource = "crs_detalle_cuotas.orden_cuota"
			.Column1.Width = 50
			.Column1.Alignment = 2
		
			*-- Columna 2: DESCRIPCIÓN CUOTA
			.Column2.Header1.Caption = "CUOTA"
			.Column2.Header1.FontBold = .t.
			.Column2.ControlSource = "crs_detalle_cuotas.orden_char"
			.Column2.Width = 60
			.Column2.Alignment = 2
		
			*-- Columna 3: FECHA VENCIMIENTO
			.Column3.Header1.Caption = "FEC. VTO."
			.Column3.Header1.FontBold = .t.
			.Column3.ControlSource = "crs_detalle_cuotas.fecha_vto"
			.Column3.Width = 80
		
			*-- Columna 4: DÍAS ATRASO
			.Column4.Header1.Caption = "ATRASO"
			.Column4.Header1.FontBold = .t.
			.Column4.ControlSource = "iif(crs_detalle_cuotas.estado_detalle='PEN',crs_detalle_cuotas.dias_atraso_efectivo,crs_detalle_cuotas.ultimo_atraso)"
			.Column4.Width = 60
			.Column4.Alignment = 0
		
			*-- Columna 5: NIVEL MORA
			.Column5.Header1.Caption = "MORA"
			.Column5.Header1.FontBold = .t.
			.Column5.ControlSource = "crs_detalle_cuotas.nivel_mora"
			.Column5.Width = 80
		
			*-- Columna 6: MONTO CUOTA (VALOR ORIGINAL)
			.Column6.Header1.Caption = "MONTO"
			.Column6.Header1.FontBold = .t.
			.Column6.ControlSource = "crs_detalle_cuotas.cuota"
			.Column6.Width = 80
			.Column6.Alignment = 1
			.Column6.InputMask = "999,999,999"
		
			*-- Columna 7: PAGADO (MONTO ABONADO)
			.Column7.Header1.Caption = "PAGADO"
			.Column7.Header1.FontBold = .t.
			.Column7.ControlSource = "crs_detalle_cuotas.total_pagado_detalle"
			.Column7.Width = 80
			.Column7.Alignment = 1
			.Column7.InputMask = "999,999,999"
		
			*-- Columna 8: SALDO (PENDIENTE)
			.Column8.Header1.Caption = "SALDO"
			.Column8.Header1.FontBold = .t.
			.Column8.ControlSource = "crs_detalle_cuotas.saldo_cuota"
			.Column8.Width = 80
			.Column8.Alignment = 1
			.Column8.InputMask = "999,999,999"
		
			*-- Columna 9: % PAGADO
			.Column9.Header1.Caption = "% PAG."
			.Column9.Header1.FontBold = .t.
			.Column9.ControlSource = "crs_detalle_cuotas.porcentaje_pagado_detalle"
			.Column9.Width = 60
			.Column9.Alignment = 1
			.Column9.Format = "99.9%"
		
			*-- Columna 10: ESTADO
			.Column10.Header1.Caption = "ESTADO"
			.Column10.Header1.FontBold = .t.
			.Column10.ControlSource = "crs_detalle_cuotas.estado_detalle_descripcion"
			.Column10.Width = 80
		
			*-- Columna 11: ÚLTIMO PAGO
			.Column11.Header1.Caption = "ÚLT. PAGO"
			.Column11.Header1.FontBold = .t.
			.Column11.ControlSource = "iif(ISNULL(crs_detalle_cuotas.ultima_fecha_pago),'',crs_detalle_cuotas.ultima_fecha_pago)"
			.Column11.Width = 80
		
			*-- Columna 12: ÚLTIMO IMPORTE
			.Column12.Header1.Caption = "ÚLT. IMP."
			.Column12.Header1.FontBold = .t.
			.Column12.ControlSource = "crs_detalle_cuotas.ultimo_importe"
			.Column12.Width = 80
			.Column12.Alignment = 1
			.Column12.InputMask = "999,999,999"
			*-- Formato condicional
			FOR i = 1 TO .ColumnCount
				.Columns(i).DynamicBackColor = ;
					"IIF(estado_detalle_descripcion='CANCELADO',RGB(220,255,220)," + ;
					"IIF(VAL(dias_atraso_efectivo)>30,RGB(255,200,200)," + ;
					"IIF(VAL(dias_atraso_efectivo)>0,RGB(255,255,200),RGB(255,255,255))))"
			ENDFOR
		
			*-- Color de texto según estado y mora
			FOR i = 1 TO .ColumnCount
				.Columns(i).DynamicForeColor = ;
					"IIF(estado_detalle_descripcion='CANCELADO',RGB(0,100,0)," + ;
					"IIF(VAL(dias_atraso_efectivo)>30,RGB(255,0,0)," + ;
					"IIF(VAL(dias_atraso_efectivo)>0,RGB(255,128,0),RGB(0,0,0))))"
			ENDFOR
		
			*-- Formato especial para columna de mora
			.Column5.DynamicForeColor = ;
				"IIF(nivel_mora='MORA GRAVE',RGB(255,0,0)," + ;
				"IIF(nivel_mora='MORA MODERADA',RGB(255,128,0)," + ;
				"IIF(nivel_mora='MORA LEVE',RGB(255,200,0),RGB(0,128,0))))"
		
			.Column5.DynamicFontBold = ;
				"nivel_mora='MORA GRAVE' OR nivel_mora='MORA MODERADA'"
		
			.Redraw()
		ENDWITH
	ENDPROC

