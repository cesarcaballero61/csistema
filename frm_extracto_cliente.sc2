	PROCEDURE _grid_detalle_venta
		with this.grid_detalle_venta
			.allowcellselection = .f.
			.columncount = 0
			.fontsize = 7
			.recordsourcetype = 1
			.recordsource = "crs_detalle_venta_articulo"
			.columncount = 10
		
			*-- Columna 1: CÓDIGO DE BARRAS
			.column1.header1.caption = "CÓDIGO"
			.column1.header1.fontbold = .t.
			.column1.controlsource = "crs_detalle_venta_articulo.codbarra"
			.column1.width = 100
		
			*-- Columna 2: DESCRIPCIÓN DEL ARTÍCULO
			.column2.header1.caption = "DESCRIPCIÓN"
			.column2.header1.fontbold = .t.
			.column2.controlsource = "crs_detalle_venta_articulo.articulo_descripcion"
