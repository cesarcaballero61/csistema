	PROCEDURE GRID_CUOTA_VENTA.AfterRowColChange
		lparameters ncolindex
		
		
		if used("crs_cuotas_ventas") and reccount("crs_cuotas_ventas") > 0
			thisform._busar_detalle_cuotas(crs_cuotas_ventas.idcuotas)
			thisform._buscar_detalle_venta(crs_cuotas_ventas.idventa)
		
			thisform.txt_id_cuota.value = crs_cuotas_ventas.idcuotas
		
			IF thisform._buscar_recibo(thisform.txt_id_cuota.value)
				THISFORM._calcular_totales_cuotas()
			ENDIF 
		endif
	ENDPROC

	PROCEDURE GRID_CUOTA_VENTA.KeyPress
		lparameters nkeycode, nshiftaltctrl
		
		if nkeycode = 13
			nodefault
			if reccount("crs_cuotas_ventas") > 0
				thisform.grid_cuotas.setfocus()
			endif
		endif
	ENDPROC

	PROCEDURE GRID_CUOTA_VENTA.RightClick
		if reccount() > 0
		* En el evento RightClick del Grid
			local nrecno,loForm
			*guardo el formulario en una variable
			loForm = thisform
			* Guardar el número de registro actual
			nrecno = recno()
		
		* Definir el menú popup
			define popup popfactura shortcut relative from mrow(), mcol()
			define bar 1 of popfactura prompt "Imprimir Factura"
			define bar 2 of popfactura prompt "Imprimir Pagaré"
			define bar 3 of popfactura prompt "\-"  && Separador
			*define bar 4 of popfactura prompt "MENSAJE TEST_MENU"
			define bar 4 of popfactura prompt "Cancelar"
		
		* Asociar acciones a cada opción
			on selection bar 1 of popfactura do _imiprimirfactura with idventa
			on selection bar 2 of popfactura do _imprimirpagare with idventa
			*on selection bar 4 of popfactura loForm.test_menu()
		
		* Activar el menú
			activate popup popfactura
		
		* Liberar el menú de la memoria
			release popup popfactura
		endif
		
	ENDPROC

	PROCEDURE GRID_CUOTA_VENTA.When
		NODEFAULT 
		this.AfterRowColChange()
	ENDPROC

