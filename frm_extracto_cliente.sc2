		    THISFORM._CANCELAR_OPERACION()
		    THISFORM.TXT_CI_CLIENTE.SetFocus()
		ENDIF
	ENDPROC

	PROCEDURE btn_notificarwhatsapp.Click
		*validar si existe cuotas vencidas para notificar
		
		local lccliente, lcnrocuota, lctelefono, ldfechavto, lnmonto
		
		if reccount('crs_detalle_cuotas') = 0
			messagebox("No hay datos de cuotas para notificar", 016, "Atencion")
			return
		endif
		
		
		* ===== VALIDACIÓN DE WHATSAPP =====
		*!*	if !whatsappestainstalado()
		*!*		messagebox("WhatsApp no está instalado en este equipo." + chr(13) + chr(13) + ;
		*!*			  "Por favor, instale WhatsApp Desktop desde:" + chr(13) + ;
		*!*			  "https://www.whatsapp.com/download", ;
		*!*			  16, "WhatsApp No Disponible")
		*!*		return
		*!*	endif
		
		
		
		* ===== VALIDAR DATOS DEL FORMULARIO =====
		lctelefono = crs_cuotas_ventas.celular
		lccliente  = alltrim(crs_cuotas_ventas.cliente_nombre_completo)
		lcnrocuota = alltrim(crs_detalle_cuotas.orden_char)
		ldfechavto = crs_detalle_cuotas.fecha_vto
		lnmonto		= crs_detalle_cuotas.saldo_cuota
		
		
		if empty(lctelefono)
			messagebox("Este cliente no tiene el numero de telefono asignado", 48, "Validación")
			return
		ENDIF
		
		IF ALLTRIM(crs_detalle_cuotas.estado_detalle_descripcion) == "CANCELADO"
			MESSAGEBOX("Esta cuota ya fue cancelada, las notificaciones a clientes solo se efectuan a cuotas vencidas con atraso >0",48,"Validación")
			return
		ENDIF 
		
		
		IF INT(VAL(crs_detalle_cuotas.dias_atraso_efectivo)) <= 0
			messagebox("Esta cuota aun no esta vencida, las notificaciones a clientes solo se efectuan a cuotas vencidas con atraso >0",48,"Validación")
			RETURN
		ENDIF 
		
		* ===== ENVIAR NOTIFICACIÓN =====
		set procedure to whatsappnativo additive
		
		local lowa, llexito
		lowa = createobject("WhatsAppNativo")
		
		llexito = lowa.notificarcuotavencida(;
			  lctelefono, ;
			  lccliente, ;
			  lcnrocuota, ;
			  ldfechavto, ;
			  lnmonto, ;
			  "Gs.")
		
		if llexito
			messagebox("WhatsApp abierto correctamente." + chr(13) + ;
				  "Complete el envío en la ventana de WhatsApp.", ;
				  64, "Éxito")
		endif
		
		lowa = null
		
	ENDPROC

	PROCEDURE BTN_REGISTRAR.Click
		if reccount() = 0 and !used("crs_cuota_ventas")
			messagebox('Seleccione una venta para imprimir...', 16, 'Aviso')
			thisform.txt_ci_CLIENTE.SetFocus()
			return
		endif
		
		if messagebox("Desea guardar los datos de pagos?", 36, "Aviso") = 6
			thisform._imprimir_extracto(crs_cuotas_ventas.idventa)
		endif
	ENDPROC

