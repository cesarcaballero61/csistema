	PROCEDURE _imprimir_extracto
		* metodo imprimir_extracto del formulario frm_extracto
		lparameters tnidventa
		
		local lnresult, lcsql
		local array loerror[1]
		
		
		if empty(tnidventa) or isnull(tnidventa)
			messagebox("Debe especificar un ID de venta válido", 16, "Error")
			return .f.
		endif
		
		
		* Llamar al stored procedure
		lcsql = "CALL sp_extracto_cliente(" + alltrim(str(tnidventa)) + ")"
		
		lnresult = sqlexec(conexion, lcsql, "curExtracto")
		
		if lnresult < 0
			aerror(loerror)
			messagebox("Error al ejecutar el stored procedure: " + loerror(2), 16, "Error")
			return .f.
		endif
		
		* Verificar si se obtuvieron datos
		if reccount("curExtracto") = 0
			messagebox("No se encontraron datos de esta venta ", 48, "Información")
			use in curextracto
			return .f.
		endif
		
		* Aquí puedes generar el reporte
		SELECT curExtracto
		LOCATE 
		
		REPORT FORM _extracto_cliente PREVIEW
		
		* Limpiar
		*use in curextracto
		
		return .t.
	ENDPROC

	PROCEDURE Btnnorbase1.Click
		IF thisform._buscar_datos_cuota(thisform.txt_id_cliente.value, thisform.cmb_pendiente.listindex)
			thisform.grID_CUOTA_VENTA.SetFocus()
