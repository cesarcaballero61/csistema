	PROCEDURE GRID_RECIBO.RightClick
		if reccount() > 0
		* En el evento RightClick del Grid
			local nrecno
		
		* Guardar el número de registro actual
			nrecno = recno()
		
		* Definir el menú popup
			define popup poprecibo shortcut relative from mrow(), mcol()
			define bar 1 of poprecibo prompt "Imprimir Recibos"
			define bar 2 of poprecibo  prompt "\-"  && Separador
			define bar 3 of poprecibo  prompt "Cancelar"
		
		* Asociar acciones a cada opción
			on selection bar 1 of poprecibo  do _imiprimirrecibo with idpago
		
		
		* Activar el menú
			activate popup poprecibo
		
		* Liberar el menú de la memoria
			release popup poprecibo
		endif
	ENDPROC

