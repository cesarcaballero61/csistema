	PROCEDURE aperturar
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode = 27
			nodefault 
			thisform.btncancelar.Click()
		endif
		
	ENDPROC

	PROCEDURE limpiarctl
		lparameters toForm
		
		for each loForm in toForm.controls
			if loForm.baseclass = "Textbox"
				loForm.limpiarctl()
			endif
		endfor
	ENDPROC

	PROCEDURE tieneaperturaabierta
		lparameters tnidpersonal
		local llencontrado, lcsql
		
		llencontrado = .f.
		
		lcsql = "SELECT idapecierre FROM apecierrecaja " + ;
			"WHERE idpersonal = " + alltrim(str(tnidpersonal)) + ;
			" AND estado = 'A' " + ;
			"LIMIT 1"
		
		if sqlexec(conexion, lcsql, "cur_apertura") > 0
			llencontrado = (reccount("cur_apertura") > 0)
			use in select("cur_apertura")
		endif
		
		return llencontrado
	ENDPROC

	PROCEDURE btnaceptar.Click
		IF EMPTY(thisform.txtcodconcepto.Value)
		    MESSAGEBOX("El Campo de concepto de caja no puede quedar vacio!", 48, "Aviso")
		    thisform.txtcodconcepto.SetFocus()
		    RETURN
		ENDIF
		
		IF EMPTY(thisform.txtcodpersonal.Value)
		    MESSAGEBOX("El Campo de personal no puede quedar vacio!", 48, "Aviso")
		    thisform.txtcodpersonal.SetFocus()
		    RETURN
		ENDIF
		
		IF EMPTY(thisform.txtmonto.Value)
		    MESSAGEBOX("El Campo de monto no puede quedar vacio!", 48, "Aviso")
		    thisform.txtmonto.SetFocus()
		    RETURN
		ENDIF
		
		
		** Verificar si ya tiene apertura abierta
		IF thisform.TieneAperturaAbierta(thisform.txtcodpersonal.Value)
		    MESSAGEBOX("Este personal ya tiene una apertura de caja activa!", 48, "Aviso")
		    RETURN
		ENDIF
		
		
		n_codconcepto = thisform.txtcodconcepto.Value
		n_codpersonal = thisform.txtcodpersonal.Value
		n_montoApertura = thisform.txtmonto.Value
		
		IF MESSAGEBOX("¿Desea registrar esta apertura de caja para el personal?", 36, "Advertencia") = 6
		    LOCAL lcSQL, lcFecha, lcHora
		    
		    lcFecha = thisform.txtfecha.Value
		    lcHora = TIME()
		    
		    TEXT TO lcSQL NOSHOW
		        INSERT INTO apecierrecaja (
		            fechaape,
		            horaape,
		            montoape,
		            estado,
		            idpersonal,
		            ingreso,
		            egreso,
		            diferencia
		        ) VALUES (
		            ?lcFecha,
		            ?lcHora,
		            ?n_montoApertura,
		            'A',
		            ?n_codpersonal,
		            0,
		            0,
		            0
		        )
		    ENDTEXT
		    
		    IF SQLExec(conexion, lcSQL) > 0
		        MESSAGEBOX("Apertura de caja registrada correctamente!", 64, "Éxito")
		        ** Opcional: Limpiar formulario después del registro
		        thisform.txtfecha.Value = DATE()
		        thisform.txtmonto.Value = 0
		        thisform.txtcodconcepto.Value = 0
		        thisform.txt_concepto.Value = ""
		        thisform.txt_tipo.Value = ""
		        thisform.txtcodpersonal.Value = 0
		        thisform.txtpersonal.Value = ""
		        thisform.txt_CI.Value = ""
		        thisform.txt_telefono.Value = ""
		        thisform.txt_direccion.Value =""
		        thisform.txtmonto.Value = 0
		    ELSE
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al registrar apertura: " + laError[2], 16, "Error")
		    ENDIF
		ENDIF
	ENDPROC

	PROCEDURE btncancelar.Click
		thisform.Release()
	ENDPROC

	PROCEDURE txtcodConcepto.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode = 42
			NODEFAULT
			DO FORM bus_conceptos TO registro
			
			IF VARTYPE(registro) <>"L"
				this.Value = registro.idconcepto
			
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE txtcodConcepto.Valid
		IF NOT EMPTY(this.Value)
		    LOCAL lnConceptoID, lcSQL
		    
		    lnConceptoID = this.Value
		    
		    lcSQL = "SELECT * FROM concepto_caja WHERE idconcepto = " + ALLTRIM(STR(lnConceptoID, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_concepto") > 0
		        IF RECCOUNT("cur_concepto") > 0
		            ** Llenar campos del formulario
		            this.Value = cur_concepto.idconcepto
		            thisform.txt_concepto.Value = cur_concepto.concepto
		            thisform.txt_tipo.Value = cur_concepto.tipo
		            *thisform.txt_descripcion.Value = cur_concepto.concepto + " (" + cur_concepto.tipo + ")"
		        ELSE
		            ** Concepto no encontrado
		            MESSAGEBOX("Concepto de caja no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_concepto.Value = ""
		            thisform.txt_tipo.Value = ""
		           * thisform.txt_descripcion.Value = ""
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar concepto: " + laError[2], 16, "Error")
		    ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtcodpersonal.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode = 42
			NODEFAULT
			DO FORM bus_personal TO registro
			
			IF VARTYPE(registro) <>"L"
				this.Value = registro.idpersonal
			
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE txtcodpersonal.LostFocus
		IF NOT EMPTY(this.Value)
		    LOCAL lnPersonalID, lcSQL
		    
		    lnPersonalID = this.Value
		    
		    lcSQL = "SELECT * FROM personal WHERE idPersonal = " + ALLTRIM(STR(lnPersonalID, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_personal") > 0
		        IF RECCOUNT("cur_personal") > 0
		            ** Llenar campos del formulario
		            this.Value = cur_personal.idPersonal
		            thisform.txtpersonal.Value = ALLTRIM(cur_personal.nombre) + " " + ALLTRIM(cur_personal.apellido)
		            thisform.txt_ci.Value = cur_personal.ci
		            thisform.txt_telefono.Value = cur_personal.telefono
		            thisform.txt_direccion.Value = cur_personal.Direccion
		        ELSE
		            ** Personal no encontrado
		            MESSAGEBOX("Personal no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txtpersonal.Value = ""
		            thisform.txt_ci.Value = ""
		            thisform.txt_telefono.Value = ""
		            thisform.txt_direccion.Value = ""
		
		            ** CORRECCIÓN: Solo NODEFAULT para evitar perder el foco
		            NODEFAULT  && Esto evita que el evento LostFocus complete su acción
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar personal: " + laError[2], 16, "Error")
		        NODEFAULT  && Esto evita que el evento LostFocus complete su acción
		    ENDIF
		ENDIF
	ENDPROC

	PROCEDURE txtcodpersonal.Valid
		NODEFAULT 
	ENDPROC

	PROCEDURE txtmonto.GotFocus
		this.InputMask =""
	ENDPROC

	PROCEDURE txtmonto.LostFocus
		this.InputMask ="999,999,999"
	ENDPROC

ENDDEFINE
