	PROCEDURE aplicarformatocondicionalgrid
		 WITH thisform.grdMovimientos
		        ** Colorear toda la fila según el tipo de movimiento
		        FOR lnCol = 1 TO .ColumnCount
		            .Columns(lnCol).DynamicForeColor = ;
		                "IIF(UPPER(ALLTRIM(curMovimientosCierre.tipo)) = 'I', RGB(0, 100, 0), " + ;
		                "IIF(UPPER(ALLTRIM(curMovimientosCierre.tipo)) = 'E', RGB(200, 0, 0), RGB(0, 0, 0)))"
		            
		            .Columns(lnCol).DynamicBackColor = ;
		                "IIF(UPPER(ALLTRIM(curMovimientosCierre.tipo)) = 'I', RGB(240, 255, 240), " + ;
		                "IIF(UPPER(ALLTRIM(curMovimientosCierre.tipo)) = 'E', RGB(255, 240, 240), RGB(255, 255, 255)))"
		        ENDFOR
		        
		        ** Destacar especialmente las columnas de montos
		        .Column5.DynamicForeColor = "RGB(0, 0, 150)"  &&  Monto Total en azul oscuro
		        .Column6.DynamicForeColor = "RGB(0, 100, 0)"   && Ingresos en verde
		        .Column7.DynamicForeColor = "RGB(200, 0, 0)"   && Egresos en rojo
		        
		        ** Negrita para montos significativos
		        .Column5.DynamicFontBold = "iif(curMovimientosCierre.monto > 100000,.t.,.f.)"
		        .Column6.DynamicFontBold = "iif(VAL(curMovimientosCierre.ingreso) > 50000,.t.,.f.)"
		        .Column7.DynamicFontBold = "iif(VAL(curMovimientosCierre.egreso) > 50000,.t.,.f.)"
		        
		        .Refresh()
		    ENDWITH
	ENDPROC

	PROCEDURE buscarapertura
	ENDPROC

	PROCEDURE buscaraperturaactiva
		LPARAMETERS tnIdPersonal
		    LOCAL lcSQL, lnIdApertura, llExito
		    
		    lnIdApertura = 0
		    llExito = .F.
		    
		    ** Validar que se reciba un ID de personal válido
		    IF EMPTY(tnIdPersonal) OR tnIdPersonal = 0
		        RETURN 0
		    ENDIF
		    
		    lcSQL = "SELECT idapecierre FROM apecierrecaja " + ;
		            "WHERE idpersonal = " + ALLTRIM(STR(tnIdPersonal, 20, 0)) + ;
		            " AND estado = 'A' " + ;
		            "ORDER BY idapecierre DESC " + ;
		            "LIMIT 1"
		    
		    ** Ejecutar consulta
		    IF SQLExec(conexion, lcSQL, "curApertura") > 0
		        IF RECCOUNT("curApertura") > 0
		            lnIdApertura = curApertura.idapecierre
		            llExito = .T.
		        ELSE
		            ** No se encontró apertura activa
		            lnIdApertura = 0
		        ENDIF
		        USE IN curApertura
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar apertura: " + laError[2], 16, "Error")
		        lnIdApertura = -1  && -1 indica error
		    ENDIF
		    
		    RETURN lnIdApertura
	ENDPROC

	PROCEDURE buscarmovcaja
	ENDPROC

	PROCEDURE buscarmovimientos
		lparameters tnidapertura
		local lcsql, lnresult, lcmensaje, lncount
		local array laerror(1)
		
		** Validar parámetro
		if empty(tnidapertura) or tnidapertura <= 0
			messagebox("ID de apertura inválido", 16, "Error")
			return .f.
		endif
		
		** Construir la llamada al stored procedure
		lcsql = "CALL sp_movimientos_cierre_caja(" + alltrim(str(tnidapertura, 20, 0)) + ")"
		
		** Ejecutar el stored procedure
		lnresult = sqlexec(conexion, lcsql, "curMovimientosCierre")
		
		** Manejar resultados
		do case
			case lnresult > 0
				** Verificar si realmente hay registros
				lncount = reccount("curMovimientosCierre")
		
				if lncount > 0
				** Hay movimientos encontrados
					lcmensaje = "Consulta ejecutada correctamente. " + ;
						alltrim(str(lncount)) + " movimientos encontrados."
						
						MESSAGEBOX(lcmensaje,64,"Atencion")
					return .t.
				else
					** No hay movimientos - cursor vacío
					use in curmovimientoscierre
					messagebox("No se encontraron movimientos para la apertura ID: " + ;
						  alltrim(str(tnidapertura)), 64, "Datos No Encontrados")
					return .f.
				ENDIF
				
			case lnresult < 0
				** Error en la ejecución
				aerror(laerror)
				lcmensaje = "Error al ejecutar stored procedure: " + chr(13) + ;
					"Error: " + laerror[2] + chr(13) + ;
					"Comando: " + lcsql
				messagebox(lcmensaje, 16, "Error de Base de Datos")
				return .f.
		endcase
	ENDPROC

	PROCEDURE calcularcierre
	ENDPROC

	PROCEDURE calculartotales
		local lningresos, lnegresos, lnsaldo
		local lncantmov
		
		
		* Inicializar variables
		store 0 to lningresos, lnegresos, lnsaldo,lncantmov 
		
		* Verificar que el cursor esté abierto y tenga datos
		if used('curMovimientosCierre') and reccount('curMovimientosCierre') > 0
			select curmovimientoscierre
		
		* Calcular sumatorias
			calculate sum(val(ingreso)) to lningresos in curmovimientoscierre
			calculate sum(val(egreso)) to lnegresos in curmovimientoscierre
			calculate count(idmov) to lncantmov in curmovimientoscierre
		
		* Calcular saldo
			lnsaldo = lningresos - lnegresos
			GO top
		else
		* Si no hay datos, mostrar ceros
			store 0 to lningresos, lnegresos, lncantmov 
		endif
		
		* Mostrar en los textbox - FORMATO EN GUARANÍES
		with thisform
			.txtingreso.value = transform(lningresos, "999,999,999") + " Gs"
			.txtegreso.value = transform(lnegresos, "999,999,999") + " Gs"
			.txtsaldo.value = transform(lnsaldo, "999,999,999") + " Gs"
			.txtcantMov.value =lncantmov 
		
		* Opcional: Cambiar color del saldo si es negativo
			if lnsaldo < 0
				.txtsaldo.forecolor = rgb(255, 0, 0)  && rojo para saldo negativo
			else
				.txtsaldo.forecolor = rgb(0, 0, 0)    && negro para saldo positivo
			endif
		endwith
		
	ENDPROC

