	PROCEDURE btncerrarCaja.Click
		* Método para cerrar caja usando SQLExec
		if messagebox("¿Desea cerrar la caja para este personal?", 36, "Advertencia") = 6
			* 1. Calcular totales de ingresos, egresos y saldo
			local lningresos, lnegresos, lnsaldo, lnmontoapertura, lnmontocierre, lndiferencia
			store 0 to lningresos, lnegresos, lnsaldo, lnmontoapertura, lnmontocierre, lndiferencia
		
			* Verificar que el cursor esté abierto
			if used('curMovimientosCierre') and reccount('curMovimientosCierre') > 0
				select curmovimientoscierre
				GO top
				
				* Calcular sumatorias.
				
				calculate sum(VAL(ingreso)) to lningresos
				calculate sum(VAL(egreso)) to lnegresos
				lnsaldo = lningresos - lnegresos
		
				* 2. Obtener monto de apertura y calcular monto de cierre
				* Asumiendo que tienes el monto de apertura almacenado en alguna variable
				lnmontoapertura = thisform.txtmontoape.Value && Ajusta según tu variable
				lnmontocierre = lnmontoapertura + lnsaldo
				lndiferencia = lnsaldo  && O calcula la diferencia según tu lógica de negocio
		
				* 3. Actualizar la tabla apecierrecaja usando SQLExec
				local lnhandle, lcsql, lnresult
		
				* Obtener handle de conexión (asumiendo que ya tienes una conexión abierta)
				lnhandle = conexion  && Ajusta según cómo manejes la conexión
		
				if lnhandle > 0
				* Construir la sentencia UPDATE
					lcsql = ;
						"UPDATE apecierrecaja SET " + ;
						"fechacierre = now()," + ;
						"horacierre = '" + time() + "', " + ;
						"ingreso = " + alltrim(str(lningresos)) + ", " + ;
						"egreso = " + alltrim(str(lnegresos)) + ", " + ;
						"diferencia = " + alltrim(str(lndiferencia)) + ", " + ;
						"montocierre = " + alltrim(str(lnmontocierre)) + ", " + ;
						"estado = 'C' " + ;
						"WHERE idapecierre = " + alltrim(str(thisform.txtidapertura.value))
		
					* Ejecutar el UPDATE
					lnresult = sqlexec(lnhandle, lcsql)
		
					if lnresult > 0
		
						* Éxito - caja cerrada
						messagebox("Caja cerrada exitosamente" + chr(13) + ;
							  "Fecha: " + dtoc(date()) + chr(13) + ;
							  "Hora: " + time() + chr(13) + ;
							  "Monto de cierre: " + transform(lnmontocierre, "@$ 999,999,999"), ;
							  64, "Caja Cerrada")
							  
						thisform.btncerrarCaja.Enabled = .f.
						thisform.btnimprimir.SetFocus()
					else
						* Error en la ejecución SQL
						local lcerror
						LOCAL laerr[1]
						AERROR(laerr)
						lcerror = "Error ejecutando UPDATE: " + alltrim(laerr(2))
						messagebox(lcerror, 16, "Error SQL")
					endif
				else
					messagebox("No hay conexión a la base de datos", 16, "Error")
				endif
			else
				messagebox("No hay datos de movimientos para procesar", 48, "Advertencia")
			endif
		endif
	ENDPROC

	PROCEDURE grdMovimientos.When
		nodefault
	ENDPROC

	PROCEDURE txtcodpersonal.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnPersonalID, lcSQL
		    
		    lnPersonalID = this.Value
		    
		    lcSQL = "SELECT * FROM personal WHERE idPersonal = " + ALLTRIM(STR(lnPersonalID, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_personal") > 0
		        IF RECCOUNT("cur_personal") > 0
		            ** Llenar campos del formulario
		            this.Value = cur_personal.idPersonal
		            thisform.txtpersonal.Value = ALLTRIM(cur_personal.nombre) + " " + ALLTRIM(cur_personal.apellido)
		            thisform.txt_ci.Value = cur_personal.ci
		            thisform.txt_telefono.Value = cur_personal.telefono
		            thisform.txt_direccion.Value = cur_personal.Direccion
		            thisform.txtidAPERTURA.Enabled = .t.
		            thisform.btnbuscarapertura.enabled= .t.
		            
		            thisform.txtidAPERTURA.Value = thisform.buscaraperturaactiva(this.Value)
		        ELSE
		            ** Personal no encontrado
		            MESSAGEBOX("Personal no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txtpersonal.Value = ""
		            thisform.txt_ci.Value = ""
		            thisform.txt_telefono.Value = ""
		            thisform.txt_direccion.Value = ""
		            thisform.txtidAPERTURA.Enabled = .f.
		            thisform.txtidAPERTURA.Enabled = .f.
		            thisform.btnbuscarapertura.enabled= .f.
		            
		            thisform.txtidAPERTURA.Value = 0
		            
		            ** DEVOLVER EL FOCO AL CONTROL ACTUAL
		            this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar personal: " + laError[2], 16, "Error")
		    ENDIF
		ENDIF
	ENDPROC

	PROCEDURE TXTIDAPERTURA.LostFocus
		dodefault()
		
		if !empty(this.value)
		
			local llret
		
			llret = thisform.buscarmovimientos(this.value)
		
			if llret
				thisform.grdmovimientos.recordsource = "curMovimientosCierre"
				thisform.montargrid()  && O la versión que prefieras
		
				thisform.txtfechaapertura.value =curMovimientosCierre.fechaape
				thisform.txthoraape.value =curMovimientosCierre.horaape
				thisform.txtmontoape.value =curMovimientosCierre.montoape
				thisform.txtfechacie.value =curMovimientosCierre.fechacierre
				thisform.txthoracierre.value =curMovimientosCierre.horacierre
				thisform.txtestado.value =curMovimientosCierre.estado_cierre
				
				thisform.calculartotales()
				thisform.btncerrarCaja.Enabled = IIF(curMovimientosCierre.estado_original =='A',.t.,.f.)
			ELSE
				thisform.grdmovimientos.recordsource = ""
				thisform.gridvacio()  && O la versión que prefieras
		
				thisform.txtfechaapertura.value =""
				thisform.txthoraape.value =""
				thisform.txtmontoape.value =""
				thisform.txtfechacie.value =""
				thisform.txthoracierre.value =""
				thisform.txtestado.value =""
				thisform.btncerrarCaja.Enabled = .f.
			endif
		
		endif
	ENDPROC

ENDDEFINE
