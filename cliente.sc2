	PROCEDURE actualizar_navegacion
		local lntotal, lnactual, lcestado
		
		if used('crsCliente') and reccount('crsCliente') > 0
			lntotal = reccount('crsCliente')
			lnactual = recno('crsCliente')
			lcestado = "Registro " + transform(lnactual) + " de " + transform(lntotal)
		
		* Actualizar control que muestre el estado
			if type("thisform.lblEstado") = "O" and pemstatus(thisform.lblestado, "Caption", 5)
				thisform.lblestado.caption = lcestado
			endif
		
		* Habilitar/deshabilitar botones de navegación si existen
			if type("thisform.cmdPrimero") = "O" and pemstatus(thisform.cmdprimero, "Enabled", 5)
				thisform.cmdprimero.enabled = (lnactual > 1)
			endif
			if type("thisform.cmdAnterior") = "O" and pemstatus(thisform.cmdanterior, "Enabled", 5)
				thisform.cmdanterior.enabled = (lnactual > 1)
			endif
			if type("thisform.cmdSiguiente") = "O" and pemstatus(thisform.cmdsiguiente, "Enabled", 5)
				thisform.cmdsiguiente.enabled = (lnactual < lntotal)
			endif
			if type("thisform.cmdUltimo") = "O" and pemstatus(thisform.cmdultimo, "Enabled", 5)
				thisform.cmdultimo.enabled = (lnactual < lntotal)
			endif
		else
		* Sin registros
			if type("thisform.lblEstado") = "O" and pemstatus(thisform.lblestado, "Caption", 5)
				thisform.lblestado.caption = "Sin registros"
			endif
		
		* Deshabilitar botones de navegación
			if type("thisform.cmdPrimero") = "O" and pemstatus(thisform.cmdprimero, "Enabled", 5)
				thisform.cmdprimero.enabled = .f.
			endif
			if type("thisform.cmdAnterior") = "O" and pemstatus(thisform.cmdanterior, "Enabled", 5)
				thisform.cmdanterior.enabled = .f.
			endif
			if type("thisform.cmdSiguiente") = "O" and pemstatus(thisform.cmdsiguiente, "Enabled", 5)
				thisform.cmdsiguiente.enabled = .f.
			endif
			if type("thisform.cmdUltimo") = "O" and pemstatus(thisform.cmdultimo, "Enabled", 5)
				thisform.cmdultimo.enabled = .f.
			endif
		endif
		
	ENDPROC

	PROCEDURE bloquearcampos		&& metodo para setear enabled en controles
		* Descripción: Recorre todos los TextBox del formulario y 
		*              bloquea/desbloquea según el parámetro y la propiedad Tag
		* Parámetros: tlEnable - .T. para habilitar, .F. para deshabilitar
		*-------------------------------------------------------
		LPARAMETERS tlEnable
		
		LOCAL lnControl, loControl
		
		*--- Recorrer todos los controles del formulario
		FOR lnControl = 1 TO THIS.ControlCount
		    loControl = THIS.Controls(lnControl)
		    
		    *--- Verificar si es un TextBox y tiene Tag = "*"
		    DO CASE 
		     CASE UPPER(loControl.BaseClass) == "TEXTBOX" AND ;
		       UPPER(ALLTRIM(loControl.Tag)) == "*"
		       
		        loControl.Enabled = tlEnable
		        
		     CASE UPPER(loControl.BaseClass) == "EDITBOX" AND ;
		       UPPER(ALLTRIM(loControl.Tag)) == "*"
		       
		       	loControl.Enabled = tlEnable
		    ENDCASE 
		ENDFOR
		
		*--- Opcional: Refrescar el formulario
		THIS.Refresh()
	ENDPROC

	PROCEDURE bloquear_boton_nav		&& bloquear botones de navegacion.
		WITH thisform
		
			.cmdPrimero.enabled 	= .f.
			.cmdAnterior.enabled 	= .f.
			
			.cmdSiguiente.enabled	=.f.
			.cmdUltimo.enabled		=.f.
		ENDWITH 
	ENDPROC

	PROCEDURE borrar_registro
		thisform.coperacion = "B"
	ENDPROC

	PROCEDURE cancelar
		thisform.bloquearcampos(.f.)
		
		***Botones***
		WITH thisform
			.Caption = "CLIENTES"
			.btnnuevo.Enabled     = .t.
			.btnmodificar.Enabled = .t.
			.btnbuscar.Enabled	  = .t.
			.btnborrar.Enabled 	  = .t.
			.btnbuscar.Enabled 	  = .t.
			
			.btn_agregar_foto.enabled = .f.
			.btn_eliminar.enabled = .f.
			
			.btnaceptar.Enabled		= .f.
			.btncancelar.Enabled	= .f.
			
			.coperacion = ""
			.btnnuevo.setfocus()
		
		ENDWITH 
	ENDPROC

	PROCEDURE crearmenucontextual
		*!*	define popup mnucontextual SHORTCUT RELATIVE FROM MROW(), MCOL()
		
		*!*	*-- Agregar opciones al menú
		*!*	define bar 1 of mnucontextual prompt "Nuevo"
		*!*	define bar 2 of mnucontextual prompt "Editar"
		*!*	define bar 3 of mnucontextual prompt "Eliminar"
		*!*	define bar 4 of mnucontextual prompt "\-"
		*!*	define bar 5 of mnucontextual prompt "Copiar"
		*!*	define bar 6 of mnucontextual prompt "Pegar"
		*!*	define bar 7 of mnucontextual prompt "\-"
		*!*	define bar 8 of mnucontextual prompt "Salir"
		
		*!*	*-- Asignar acciones a cada opción
		*!*	on selection bar 1 of mnucontextual thisform.opcionnuevo()
		*!*	on selection bar 2 of mnucontextual thisform.opcioneditar()
		*!*	on selection bar 3 of mnucontextual thisform.opcioneliminar()
		*!*	on selection bar 5 of mnucontextual thisform.opcioncopiar()
		*!*	on selection bar 6 of mnucontextual thisform.opcionpegar()
		*!*	on selection bar 8 of mnucontextual thisform.opcionsalir()
	ENDPROC

	PROCEDURE guardar_registro
		local lccomando, lcmensaje, lcdetall
		
		
		do case
			case thisform.coperacion == "N"
				lcmensaje = "¿Desea guardar los datos del cliente?"
			case thisform.coperacion == "M"
				lcmensaje = "¿Desea modificar los datos del cliente?"
			case thisform.coperacion == "B"
				lcmensaje = "¿Desea borrar los datos del cliente?"
		endcase
		
		if messagebox(lcmensaje, 4 + 32, "Advertencia") = 6
			
			local lcoperacion, lnidcliente, lnidzona, lnidbarrio, lnidprofesion
			local lcnombre, lcapellido, lcruc, lcci, lccelular, lctelefono, lcreferencia
			local lctrabajolugar, lctrabajotelefono, lcref1, lcref2, lcref3
			local lcreftel1, lcreftel2, lcreftel3,lcfoto 
			local llok, laerr[1], lnnewid, lcorden,llallok
			
			llallok =.t.
		
			* Guardar el orden actual para restaurarlo después
			lcorden = order('crsCliente')
		
			lcoperacion = thisform.coperacion
			lnidcliente = thisform.txtidcliente.value
			lnidzona = thisform.txtcod_zona.value
			lnidbarrio = thisform.txtcod_barrio.value
			lnidprofesion = thisform.txtcod_profesion.value
		
		
			* Usando la función IfEmpty para todos los campos de texto
			lcnombre = IfEmpty(ALLTRIM(thisform.txt_nombre.value), "S/N")
			lcapellido = IfEmpty(ALLTRIM(thisform.txt_apellido.value), "S/N")
			lcruc = IfEmpty(ALLTRIM(thisform.txt_ruc.value), "S/N")
			lcci = IfEmpty(ALLTRIM(thisform.txt_cedula.value), "S/N")
			lccelular = IfEmpty(ALLTRIM(thisform.txt_celular.value), "S/N")
			lctelefono = IfEmpty(ALLTRIM(thisform.txt_telefono.value), "S/N")
			lcreferencia = IfEmpty(ALLTRIM(thisform.edit_detalle.value), "S/N")
			lctrabajolugar = IfEmpty(ALLTRIM(thisform.txt_lugartrabajo.value), "S/N")
			lctrabajotelefono = IfEmpty(ALLTRIM(thisform.txt_telefonotrabajo.value), "S/N")
			lcref1 = IfEmpty(ALLTRIM(thisform.txt_ref1.value), "S/N")
			lcref2 = IfEmpty(ALLTRIM(thisform.txt_ref2.value), "S/N")
			lcref3 = IfEmpty(ALLTRIM(thisform.txt_ref3.value), "S/N")
			lcreftel1 = IfEmpty(ALLTRIM(thisform.txt_refcontacto1.value), "S/N")
			lcreftel2 = IfEmpty(ALLTRIM(thisform.txt_refcontacto2.value), "S/N")
			lcreftel3 = IfEmpty(ALLTRIM(thisform.txt_refcontacto3.value), "S/N")
			lcfoto = ifempty(this.crutafoto,null)
			
			
			= sqlexec(conexion, "START TRANSACTION")
		
			* COMANDO ACTUALIZADO PARA CLIENTE
			lccomando = "CALL amb_cliente(?lcoperacion , ?lnIdCliente, ?lnIdZona, ?lnIdBarrio, " + ;
				"?lnIdProfesion, ?lcNombre, ?lcApellido, ?lcRuc, ?lcCi, ?lcCelular, " + ;
				"?lcTelefono, ?lcReferencia, ?lcTrabajoLugar, ?lcTrabajoTelefono, " + ;
				"?lcRef1, ?lcRef2, ?lcRef3, ?lcRefTel1, ?lcRefTel2, ?lcRefTel3,?lcfoto)"
		
			llok = sqlexec(conexion, lccomando, "curResultadoCliente")
		
			if llok > 0
				* VERIFICAR SI EL PROCEDIMIENTO RETORNÓ RESULTADOS
				IF USED("curResultadoCliente") AND RECCOUNT("curResultadoCliente") > 0
					lcmensaje = ALLTRIM(curResultadoCliente.mensaje)
					lcdetalle = ALLTRIM(curResultadoCliente.detalle)
		
					* OBTENER EL NUEVO ID SI ES UNA INSERCIÓN
					if lcoperacion = "N"
						lnnewid = INT(VAL(curresultadocliente.nuevo_id))
					else
						lnnewid = lnidcliente
					endif
		
					use in curresultadocliente
		
					= sqlexec(conexion, "COMMIT")
					
					messagebox(lcmensaje + CHR(13) + lcdetalle, 64, "Éxito")
		
					* Recargar datos desde la base de datos
					= sqlexec(conexion, "SELECT * FROM v_clientes ORDER BY idcliente", "crsCliente")
		
					* Restaurar el orden original si existía
					if not empty(lcorden)
						set order to (lcorden) in crscliente
					endif
		
					* Posicionarse en el registro correcto
					if lcoperacion = "B"
						if reccount("crsCliente") > 0
							go top
						else
							thisform.limpiar_datos()
						endif
					else
						* Buscar el registro insertado/modificado
						select crscliente
						locate for idcliente = lnnewid
						if not found()
							if lcoperacion = "N"
								go bottom in crscliente
							else
								go top in crscliente
							endif
						endif
					endif
		
					* Actualizar interfaz con los datos frescos
					thisform.llenarcampos()
					thisform.cancelar()
		
				ELSE
				
					* NO HAY REGISTROS EN EL RESULTADO - POSIBLE ERROR
					= sqlexec(conexion, "ROLLBACK")
					llallok =.f.
					messagebox("No se recibió respuesta del procedimiento almacenado", 16, "Error")
					
				ENDIF 
			
			else
				aerror(laerr)
				= sqlexec(conexion, "ROLLBACK")
				llallok =.f.
				messagebox("Error de conexión: " + laerr[2], 16, "Error")	
			ENDIF
			
			RETURN llallok 
		ELSE
			RETURN .f.
		ENDIF 
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tlinsert
		
		thisform.linsert = tlinsert
		
		DODEFAULT()
		
		
		local lcsql
		lcsql = "select * from v_clientes order by idcliente"
		
		if sqlexec(conexion, lcsql, "crsCliente") > 0
			go top
			thisform.llenarcampos()
		ENDIF
		
		
		this.actualizar_navegacion()
		this.bloquearcampos(.f.)
		
		IF thisform.linsert 
			this.WindowType = 1
			thisform.nuevo_registro()
		ENDIF 
	ENDPROC

	PROCEDURE limpiarcampos
		* Descripción: Recorre todos los TextBox del formulario y 
		*   				y limpiar los controles de acuerdo a sus tipo de datos segun la propiedad 
		*					ctipodato = "C" string, ctipo="N" numeric.
		*-------------------------------------------------------
		
		LOCAL lnControl, loControl
		
		FOR lnControl = 1 TO this.ControlCount
			loControl= this.Controls(lnControl)
			
			IF UPPER(loControl.baseclass) =="TEXTBOX" AND;
				PEMSTATUS(loControl,"ctipodato",5)
				
				DO case
				 	CASE loControl.ctipodato == "C"
						loControl.value=""
					CASE loControl.ctipodato == "N"
						loControl.value =0
						
					* -- Aqui colocar mas tipo de datos para limpiar
				ENDCASE 
				
				
			ENDIF 
		
		ENDFOR 
		this.Refresh()
	ENDPROC

	PROCEDURE llenarcampos		&& metodo para llenar los campos con datos.
		* Validar que el cursor principal existe y tiene datos
		LOCAL lcRutaFoto 
		
		IF NOT USED('crsCliente')
			RETURN
		ENDIF
		
		IF EOF('crscliente') OR BOF('crscliente') OR RECCOUNT('crscliente') = 0
			thisform.limpiarcampos()
			RETURN
		ENDIF
		
		WITH thisform
			*id
			.txtidcliente.Value =crscliente.idcliente
			*nombre ,cedula y ruc
			.txt_cedula.Value	=crscliente.ci
			.olddni =ALLTRIM(crscliente.ci)
			.txt_ruc.Value		=crscliente.ruc
			.txt_nombre.Value	=crscliente.nombre
			.txt_apellido.Value	=crscliente.apellido
			
			
			*datos de direcciones
			.txtcod_zona.Value	=crscliente.idzona
			.txt_zona.Value		=crscliente.zona
			.txtcod_barrio.Value=crscliente.idbarrio
			.txt_barrio.Value	=crscliente.barrio
			
			*profesion
			.txtcod_profesion.Value = crscliente.idprofesion
			.txt_profesion.Value =crscliente.profesion
			
			*contactos
			.txt_celular.Value			=crscliente.celular
			.txt_telefono.Value			=crscliente.telefono
			.txt_lugarTrabajo.Value		=crscliente.trabajo_lugar
			.txt_telefonoTrabajo.Value	=crscliente.trabajo_telefono
			
			*referencias
			
			.txt_ref1.Value		=crscliente.ref1
			.txt_ref2.Value		=crscliente.ref2
			.txt_ref3.Value		=crscliente.ref3
			
			.txt_refcontacto1.Value	=crscliente.reftel1
			.txt_refcontacto2.Value	=crscliente.reftel2
			.txt_refcontacto3.Value	=crscliente.reftel3
			.edit_detalle.Value = crscliente.referencia
			
			*llenar foto
			IF USED('crscliente') AND !ISNULL(crscliente.foto)
			 	  lcRutaFoto = ALLTRIM(crscliente.foto)
			 
				 IF FILE(lcRutaFoto)
				 	thisform.image1.Picture = lcRutaFoto
				 	thisform.crutafoto = lcRutaFoto
				 ELSE
				 	this.image1.Picture = 'Imagenes\sin_img.png'
				 	thisform.crutafoto = null
				 ENDIF 
			ELSE
				this.image1.Picture = 'Imagenes\sin_img.png'
				thisform.crutafoto = null	
			ENDIF
		ENDWITH
		
		* Actualizar estado de navegación
		thisform.actualizar_navegacion()
		
	ENDPROC

	PROCEDURE modificar_registro
		thisform.bloquearcampos(.t.)
		thisform.coperacion = "M"
		
		***Botones***
		WITH thisform
			.Caption = "MODIFICAR CLIENTE"
			.btnnuevo.Enabled     = .f.
			.btnmodificar.Enabled = .f.
			.btnbuscar.Enabled	  = .f.
			.btnborrar.Enabled 	  = .f.
			.btnbuscar.Enabled 	  = .f.
			
			.btn_agregar_foto.enabled = .f.
			.btn_eliminar.enabled = .f.
			
			.btn_agregar_foto.enabled = .t.
			.btn_eliminar.enabled = .t.
			
			.btnaceptar.Enabled		= .t.
			.btncancelar.Enabled	= .t.
			
			.coperacion = "M"
			
			.txt_cedula.SetFocus()
			.bloquear_boton_nav()
		
		ENDWITH 
	ENDPROC

	PROCEDURE MouseDown
		lparameters nbutton, nshift, nxcoord, nycoord
		
		
		*!*	*-- Verificar si es clic derecho (botón 2)
		*!*	if nbutton = 2
		*!*	*-- Simplemente activar el popup
		*!*		activate popup mnucontextual  AT  MROW()+1, MCOL()+2
		*!*	endif
	ENDPROC

	PROCEDURE nuevo_registro
		thisform.bloquearcampos(.t.)
		thisform.limpiarcampos()
		
		***Botones***
		WITH thisform
			.Caption = "NUEVO CLIENTE"
			.btnnuevo.Enabled     = .f.
			.btnmodificar.Enabled = .f.
			.btnbuscar.Enabled	  = .f.
			.btnborrar.Enabled 	  = .f.
			.btnbuscar.Enabled 	  = .f.
			
			.btnaceptar.Enabled		= .t.
			.btncancelar.Enabled	= .t.
			
			.btn_agregar_foto.enabled = .t.
			.btn_eliminar.enabled = .t.
			
			.coperacion = "N"
			
			.image1.Picture = 'Imagenes\sin_img.png'
			.crutafoto = null	
			
			.edit_detalle.Value = ""
			.txt_cedula.SetFocus()
			
			.bloquear_boton_nav()
		
		ENDWITH 
	ENDPROC

	PROCEDURE Unload
		if thisform.linsert
			return thisform.cretcod
		endif
	ENDPROC

	PROCEDURE validarcampos
		local lncontrol, locontrol
		local llok
		llok = .t.
		
		for lncontrol = 1 to this.controlcount
			locontrol = this.controls(lncontrol)
		
			if upper(locontrol.baseclass) == "TEXTBOX" and;
					pemstatus(locontrol, "lobligatorio", 5)
		
				if locontrol.lobligatorio
					do case
						case locontrol.ctipodato == "N"
							if empty(locontrol.value)
								
								locontrol.setfocus()
								return  .f.
							endif
						case locontrol.ctipodato == "C"
							if empty(alltrim(locontrol.value))
							
								locontrol.setfocus()
								RETURN .f.
							endif
					endcase
				endif
			endif
		
		endfor
		
		return llok
	ENDPROC

	PROCEDURE validarctl
		lparameters toControl as Object
	ENDPROC

	PROCEDURE btnaceptar.Click
		IF !thisform.validarcampos()
			messagebox("Complete todos los campos obligatorios (*) antes de continuar.", 16, "Aviso")
		ELSE
			
			IF thisform.guardar_registro()
				thisform.cretcod = ALLTRIM(crsCliente.ci)
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE btnborrar.Click
		thisform.coperacion = "B"
		thisform.guardar_registro()
		
		
		
	ENDPROC

	PROCEDURE btnbuscar.Click
		local loregistro
		
		do form bus_cliente to loregistro
		
		if vartype(loregistro) <> "L"
		
			select crsCliente
			locate for idcliente = loregistro.idcliente
		
			if not found()
				MESSAGEBOX("registro no encontrado!!",016,"Error")
				go top in crsCliente
			endif
		
			thisform.llenarcampos()
		endif
	ENDPROC

	PROCEDURE btncancelar.Click
		thisform.cancelar()
		thisform.llenarcampos()
	ENDPROC

	PROCEDURE btnmodificar.Click
		thisform.modificar_registro()
	ENDPROC

	PROCEDURE btnnuevo.Click
		thisform.nuevo_registro()
	ENDPROC

	PROCEDURE btnsalir.Click
		thisform.Release()
	ENDPROC

	PROCEDURE btn_agregar_foto.Click
		* Evento Click del botón btn_agregar_foto
		local lcrutaimagen, lcextension
		local lcimagendefault
		
		
		* Abrir diálogo para seleccionar imagen
		lcrutaimagen = getfile("JPG;JPEG;PNG;BMP;GIF", "Seleccionar Foto del Cliente", "Abrir", 0)
		
		* Verificar si el usuario seleccionó un archivo
		if !empty(lcrutaimagen) and file(lcrutaimagen)
		* Verificar que sea un archivo de imagen válido
			lcextension = upper(justext(lcrutaimagen))
			thisform.image1.picture = ""
		
			if inlist(lcextension, "JPG", "JPEG", "PNG", "BMP", "GIF")
		* Asignar la imagen al control
				thisform.image1.picture = lcrutaimagen
		
		* Ajustar el tamaño de la imagen al control (opcional)
				thisform.image1.stretch = 2  && 0=Clip, 1=Isometric, 2=Stretch
		
		* Guardar la ruta en una propiedad del formulario o campo (opcional)
				thisform.crutafoto = lcrutaimagen
		
		
				messagebox("Foto cargada correctamente", 64, "Éxito")
			else
				messagebox("El archivo seleccionado no es una imagen válida", 48, "Advertencia")
			endif
		
		else
			lcimagendefault = "imagenes\sin_img.png"
			thisform.image1.picture = lcimagendefault
		endif
	ENDPROC

	PROCEDURE btn_eliminar.Click
		* Evento Click del botón Eliminar/Borrar imagen
		LOCAL lcImagenDefault
		
		* Ruta de la imagen por defecto (ajusta la ruta según tu aplicación)
		lcImagenDefault = "imagenes\sin_img.png"  && o la ruta que uses
		
		* Verificar si existe la imagen por defecto
		IF FILE(lcImagenDefault)
		    ThisForm.Image1.Picture = lcImagenDefault
		ELSE
		    * Si no existe imagen por defecto, limpiar el control
		    ThisForm.Image1.Picture = ""
		ENDIF
		
		* Limpiar la referencia de la foto en el registro (opcional)
		* REPLACE foto WITH ""
		ThisForm.cRutaFoto = null
		
		MESSAGEBOX("Foto eliminada", 64, "Información")
	ENDPROC

	PROCEDURE cmdAnterior.Click
		IF USED('crsCliente') AND RECCOUNT('crsCliente') > 0
		    IF NOT BOF('crsCliente')
		        SKIP -1 IN crsCliente
		        IF BOF('crsCliente')
		            GO TOP IN crsCliente
		        ENDIF
		        thisform.llenarcampos()
		    ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdPrimero.Click
		IF USED('crsCliente') AND RECCOUNT('crsCliente') > 0
		    GO TOP IN crsCliente
		     thisform.llenarcampos()
		ENDIF
	ENDPROC

	PROCEDURE cmdSiguiente.Click
		IF USED('crsCliente') AND RECCOUNT('crsCliente') > 0
		    IF NOT EOF('crsCliente')
		        SKIP 1 IN crsCliente
		        IF EOF('crsCliente')
		            GO BOTTOM IN crsCliente
		        ENDIF
		         thisform.llenarcampos()
		    ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdUltimo.Click
		IF USED('crsCliente') AND RECCOUNT('crsCliente') > 0
		    GO BOTTOM IN crsCliente
		     thisform.llenarcampos()
		ENDIF
	ENDPROC

	PROCEDURE txtcod_barrio.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode = 42
			nodefault
			local loregistro as object
			do form bus_barrio WITH thisform.txtcod_zona.Value to loregistro
		
		
			if vartype(loregistro) <> "L"
				this.value = loregistro.idbarrio
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
		
		if m.nkeycode = 22
			nodefault
			local lncodigo
			do form barrio with .t.,thisform.txtcod_zona.Value to m.lncodigo
			this.value = IIF(EMPTY(m.lncodigo),0,m.lncodigo)
		endif
	ENDPROC

	PROCEDURE txtcod_barrio.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnbarrioID,lnZonaID, lcSQL
		    
		    lnbarrioID= this.Value
		    lnZonaID = thisform.txtcod_zona.Value
		    
		    lcSQL = "SELECT * FROM v_barrio_zona WHERE idbarrio = " + ALLTRIM(STR(lnbarrioID, 20, 0))
		    lcSQL = lcSQL + " AND idzona = "+ALLTRIM(STR(lnZonaID,20,0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_barrio") > 0
		        IF RECCOUNT("cur_barrio") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_barrio.idbarrio
					thisform.txt_barrio.Value = cur_barrio.barrio
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Barrio no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_barrio.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar barrio: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_barrio.Value = ""
		ENDIF
	ENDPROC

