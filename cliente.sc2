	PROCEDURE txt_cedula.LostFocus
		DODEFAULT()
		
		LOCAL lcCedula, lcOldCedula, llEncontrado, lcMensaje, lcConsulta
		lcCedula = ALLTRIM(this.Value)
		lcOldCedula = thisform.olddni
		
		IF thisform.coperacion == "N"
		    ** Buscar cliente en v_cliente por cedula si existe emitir mensaje
		    IF !EMPTY(lcCedula) AND lcCedula != "S/N"
		        lcConsulta = "SELECT idcliente, nombre, apellido FROM v_clientes " + ;
		                    "WHERE ci = '" + lcCedula +"'"
		        
		        IF SQLExec(conexion, lcConsulta, "curBuscarCedula") > 0
		            IF USED("curBuscarCedula") AND RECCOUNT("curBuscarCedula") > 0
		                lcMensaje = "Ya existe un cliente registrado con esta cédula:" + CHR(13) + ;
		                            "ID: " + ALLTRIM(STR(curBuscarCedula.idcliente)) + CHR(13) + ;
		                            "Cliente: " + ALLTRIM(curBuscarCedula.nombre) + " " + ALLTRIM(curBuscarCedula.apellido)
		                MESSAGEBOX(lcMensaje, 16, "Cédula Duplicada")
		                this.Value = ""
		               NODEFAULT 
		            ENDIF
		            USE IN SELECT("curBuscarCedula")
		        ELSE
		            MESSAGEBOX("Error al verificar la cédula en la base de datos", 16, "Error")
		        ENDIF
		    ENDIF
		
		ELSE
		    IF lcCedula != lcOldCedula
		        ** Buscar cliente en v_cliente, si existe emitir mensaje de que existe cliente con este numero de cedula
		        IF !EMPTY(lcCedula) AND lcCedula != "S/N"
		            lcConsulta = "SELECT idcliente, nombre, apellido FROM v_clientes " + ;
		                        "WHERE ci = '" + lcCedula  +"'"+ ;
		                        " AND idcliente != " + ALLTRIM(STR(thisform.txtidcliente.Value))
		            
		            IF SQLExec(conexion, lcConsulta, "curBuscarCedula") > 0
		                IF USED("curBuscarCedula") AND RECCOUNT("curBuscarCedula") > 0
		                    lcMensaje = "Ya existe otro cliente registrado con esta cédula:" + CHR(13) + ;
		                                "ID: " + ALLTRIM(STR(curBuscarCedula.idcliente)) + CHR(13) + ;
		                                "Cliente: " + ALLTRIM(curBuscarCedula.nombre) + " " + ALLTRIM(curBuscarCedula.apellido) + CHR(13) + ;
		                                "No se puede modificar la cédula a un número ya registrado."
		                    MESSAGEBOX(lcMensaje, 16, "Cédula Duplicada")
		                    this.Value = lcOldCedula
		                    NODEFAULT 
		                ENDIF
		                USE IN SELECT("curBuscarCedula")
		            ELSE
		                MESSAGEBOX("Error al verificar la cédula en la base de datos", 16, "Error")
		            ENDIF
		        ENDIF
		    ENDIF 
		ENDIF 
	ENDPROC

ENDDEFINE
