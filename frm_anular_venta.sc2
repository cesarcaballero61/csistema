	PROCEDURE BTN_ANULAR.Click
		IF RECCOUNT('crs_venta') = 0  && Cambiado de crs_recibo a crs_venta
		    MESSAGEBOX('Debes seleccionar una venta para anular!', 16, 'Aviso')  && Cambiado mensaje
		    RETURN 
		ENDIF 
		
		*-- Preguntar al usuario si desea anular la venta
		lnRespuesta = MESSAGEBOX("¿Está seguro que desea anular la venta seleccionada?", ;
		                         4 + 32 + 256, ;  && Botones Sí/No + Icono Pregunta + 2do botón por defecto
		                         "Confirmar Anulación")
		
		*-- Si el usuario eligió Sí (respuesta = 6), llamar al método anular
		IF lnRespuesta = 6
		    IF thisform._anularventa()  && Cambiado de _anular a _anularventa
		        MESSAGEBOX("Anulación de venta exitosa", 64, "Aviso")  && Cambiado mensaje
		        thisform.Init()
		    ENDIF 
		ENDIF
	ENDPROC

	PROCEDURE BTN_CANCELAR.Click
		thisform.Init()
	ENDPROC

	PROCEDURE BTN_FILTRAR.Click
		LOCAL lcnrodesde, lcnrohasta
		LOCAL lddesde, ldhasta
		
		lcnrodesde = ALLTRIM(thisform.txt_factura_INI.Value)  && Cambiado de txt_reCIBO_INI
		lcnrohasta = ALLTRIM(thisform.txt_factura_FIN.Value)  && Cambiado de txT_RECIBO_FIN
		lddesde = fechatomysql(thisform._fecha_desde.getvalue())
		IF lddesde = '0000-00-00'
		    lddesde = ""
		ENDIF
		
		ldhasta = fechatomysql(thisform._fecha_hasta.getvalue())
		IF ldhasta = '0000-00-00'
		    ldhasta = ""
		ENDIF
		
		IF thisform._filtrar(lcnrodesde, lcnrohasta, lddesde, ldhasta)
		    thisform._gridventa()  && Cambiado de _gridrecibo
		ENDIF 
	ENDPROC

	PROCEDURE BTN_SALIR.Click
		THISFORM.Release()
	ENDPROC

	PROCEDURE grddetalle.When
		NODEFAULT
	ENDPROC

	PROCEDURE grdventa.AfterRowColChange
		LPARAMETERS nColIndex
		
		IF USED("crs_venta") AND RECCOUNT("crs_venta") > 0
		    IF thisform._buscardetalleventa(crs_venta.idVenta)  && Cambiado de _buscardetallerecibo
		        thisform._griddetalle()  && Mantener el mismo nombre si es el método general
		    ENDIF 
		ENDIF
	ENDPROC

	PROCEDURE grdventa.Click
		this.AfterRowColChange()
	ENDPROC

	PROCEDURE grdventa.When
		NODEFAULT
	ENDPROC

	PROCEDURE TXT_FACTURA_FIN.LostFocus
		dodefault()
	ENDPROC

	PROCEDURE TXT_FACTURA_INI.LostFocus
		dodefault()
	ENDPROC

ENDDEFINE
