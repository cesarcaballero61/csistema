	PROCEDURE Init
		DODEFAULT()
		
		LOCAL LCSQLVENTA, LCSQLDETALLE_VENTA
		
		LCSQLVENTA = "SELECT * FROM v_venta WHERE 1=0"
		LCSQLDETALLE_VENTA = "SELECT * FROM v_detalle_venta WHERE 1=0"
		
		=SQLEXEC(CONEXION, LCSQLVENTA, "crs_venta")
		=SQLEXEC(CONEXION, LCSQLDETALLE_VENTA, "crs_detalle_venta")
		
		THIS._gridventa()
		THIS._griddetalle()
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		
		SET NULLDISPLAY TO 'S/D'
	ENDPROC

	PROCEDURE _anularventa
		LOCAL lnidventa, lcmotivo, lnidusuario, lnResult, lcSQL, lnHandle, llExito
		
		lnidventa = crs_venta.idVenta  && Cambiado de crs_recibo.idpago a crs_venta.idVenta
		lcmotivo = 'ANULACION DE VENTA'  && Cambiado motivo
		lnidusuario = _SCREEN.OAPP.NUSUARIOSISTEMA
		llExito = .F.
		
		* Usar conexión existente
		lnHandle = conexion
		=SQLEXEC(conexion,'START TRANSACTION')
		
		lcSQL = "CALL sp_anular_venta(" + ;  && Cambiado de sp_anular_recibo a sp_anular_venta
		        ALLTRIM(STR(lnidventa)) + ", " + ;
		        "'" + lcmotivo + "', " + ;
		        ALLTRIM(STR(lnidusuario)) + ")"
		
		lnResult = SQLExec(lnHandle, lcSQL)
		
		IF lnResult > 0
		    llExito = .T.
		    =SQLEXEC(conexion,"commit")
		ELSE
		    AERROR(loerror)
		    =SQLEXEC(conexion,'ROLLBACK')
		    MESSAGEBOX("Error al anular la venta: " + loerror(2), 16, "Error")  && Cambiado mensaje
		    llExito = .F.
		ENDIF
		
		RETURN llExito
	ENDPROC

	PROCEDURE _buscardetalleventa
		LPARAMETERS tnidventa
		
		LOCAL lcSQL, lnResult, laError[1]
		
		*-- Validar que se recibió un ID de venta válido
		IF EMPTY(tnidventa) OR ISNULL(tnidventa)
		    MESSAGEBOX("No se especificó un ID de venta válido.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*-- Construir la consulta SQL para MySQL
		lcSQL = "SELECT * FROM v_detalle_venta WHERE idVenta = " + TRANSFORM(tnidventa) + ;
		        " ORDER BY idDetalle"
		
		*-- Ejecutar la consulta usando SQLEXEC
		lnResult = SQLEXEC(conexion, lcSQL, 'crs_detalle_venta')
		
		*-- Verificar el resultado de la ejecución
		IF lnResult <= 0
		    *-- Capturar información del error usando AERROR
		    AERROR(laError)
		    
		    LOCAL lcErrorMessage
		    lcErrorMessage = "Error al ejecutar la consulta de detalle de venta." + CHR(13) + ;
		                     "Código de error: " + TRANSFORM(lnResult) + CHR(13) + ;
		                     "Error: " + TRANSFORM(laError[2]) + CHR(13) + ;
		                     "Mensaje: " + TRANSFORM(laError[3])
		    
		    MESSAGEBOX(lcErrorMessage, 16, "Error de Base de Datos")
		    RETURN .F.
		ENDIF
		
		*-- Verificar si se obtuvieron registros
		IF RECCOUNT('crs_detalle_venta') = 0
		    MESSAGEBOX("No se encontraron detalles para la venta ID: " + TRANSFORM(tnidventa), 64, "Información")
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE _cancelar
	ENDPROC

	PROCEDURE _filtrar
		LPARAMETERS tcnrofacturaini, tcnrofacturafin, tdfechainicio, tdfechafin
		
		*-- Suponiendo que 'conexion' es el manejador de conexión a la base de datos
		LOCAL lcWhere, lcSQL, lnResult, laError[1]
		
		*-- Construir la cláusula WHERE basada en los parámetros recibidos
		lcWhere = ""
		
		*-- Validar y agregar condición para número de factura inicial
		IF !EMPTY(tcnrofacturaini)
		    lcWhere = lcWhere + " AND nro_factura >= '" + ALLTRIM(tcnrofacturaini) + "'"
		ENDIF
		
		*-- Validar y agregar condición para número de factura final
		IF !EMPTY(tcnrofacturafin)
		    lcWhere = lcWhere + " AND nro_factura <= '" + ALLTRIM(tcnrofacturafin) + "'"
		ENDIF
		
		*-- Validar y agregar condición para fecha de inicio
		IF !EMPTY(tdfechainicio)
		    lcWhere = lcWhere + " AND fecha >= '" + tdfechainicio + "'"
		ENDIF
		
		*-- Validar y agregar condición para fecha de fin
		IF !EMPTY(tdfechafin)
		    lcWhere = lcWhere + " AND fecha <= '" + tdfechafin + "'"
		ENDIF
		
		*-- Remover el "AND" inicial si existe
		IF !EMPTY(lcWhere)
		    lcWhere = SUBSTR(lcWhere, 6)  && Remueve el " AND " inicial
		ENDIF
		
		*-- Construir la consulta SQL completa para MySQL
		IF EMPTY(lcWhere)
		    lcSQL = "SELECT * FROM v_venta ORDER BY fecha DESC, idVenta DESC"
		ELSE
		    lcSQL = "SELECT * FROM v_venta WHERE " + lcWhere + " ORDER BY fecha DESC, idVenta DESC"
		ENDIF
		
		*-- Ejecutar la consulta usando SQLEXEC
		lnResult = SQLEXEC(conexion, lcSQL, 'crs_venta')
		
		*-- Verificar el resultado de la ejecución
		IF lnResult <= 0
		    *-- Capturar información del error usando AERROR
		    AERROR(laError)
		    
		    *-- Construir mensaje de error detallado
		    LOCAL lcErrorMessage
		    lcErrorMessage = "Error al ejecutar la consulta en la base de datos." + CHR(13) + ;
		                     "Código de error: " + TRANSFORM(lnResult) + CHR(13) + ;
		                     "Nativo: " + TRANSFORM(laError[2]) + CHR(13) + ;
		                     "Mensaje: " + TRANSFORM(laError[3])
		    
		    *-- Si hay más información de error, agregarla
		    IF ALEN(laError) >= 5 AND !EMPTY(laError[5])
		        lcErrorMessage = lcErrorMessage + CHR(13) + "Detalle: " + TRANSFORM(laError[5])
		    ENDIF
		    
		    MESSAGEBOX(lcErrorMessage, 16, "Error de Base de Datos")
		    RETURN .F.
		ENDIF
		
		*-- Verificar si se obtuvieron registros
		IF RECCOUNT('crs_venta') = 0
		    MESSAGEBOX("No se encontraron ventas con los criterios especificados.", 64, "Información")
		ENDIF
		
		RETURN .T.
	ENDPROC

