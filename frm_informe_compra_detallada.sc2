	ADD OBJECT 'txt_id_proveedor' AS txtbase WITH ;
		Alignment = 3, ;
		Format = "k!", ;
		Height = 22, ;
		Left = 135, ;
		Name = "txt_id_proveedor", ;
		TabIndex = 3, ;
		Top = 96, ;
		Value = 0, ;
		Width = 36
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="textbox" />

	ADD OBJECT 'txt_proveedor' AS txtbase WITH ;
		DisabledForeColor = 0,0,0, ;
		Enabled = .F., ;
		Height = 22, ;
		Left = 172, ;
		Name = "txt_proveedor", ;
		TabIndex = 9, ;
		Top = 96, ;
		Width = 153
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="textbox" />
	
	PROCEDURE Load
		DODEFAULT()
		SET SEPARATOR  TO "."
		SET POINT TO ","
	ENDPROC

	PROCEDURE btn_aceptar.Click
		LOCAL lddesde, ldhasta, lncodProveedor
		LOCAL lcsql, lnresult, loexception
		LOCAL lcproveedor
		
		
		lddesde      = fechatomysql(thisform.fecha_desde.getvalue())
		ldhasta      = fechatomysql(thisform.fecha_hasta.getvalue())
		lncodProveedor = thisform.txt_id_proveedor.value
		
		lcproveedor   = ALLTRIM(thisform.txt_proveedor.value)
		
		
		TRY
		* Construir la llamada al stored procedure
		    lcsql = "CALL sp_informe_compras_detallado('" + lddesde + "', '" + ldhasta + "', " + ;
		        ALLTRIM(STR(lncodProveedor)) + ")"
		
		    * Ejecutar la consulta
		    lnresult = SQLEXEC(conexion, lcsql, "curComprasDetalle")
		
		    IF lnresult > 0
		        * Verificar si hay datos
		        IF RECCOUNT("curComprasDetalle") > 0
		            * Imprimir el informe
		            * Para imprimir directamente: 
		            lddesde      = thisform.fecha_desde.getvalue()
		            ldhasta      = thisform.fecha_hasta.getvalue()
		            
		            REPORT FORM _informe_compra_detallado PREVIEW NOCONSOLE
		        ELSE
		            MESSAGEBOX("No se encontraron registros para los criterios especificados", 64, "Información")
		        ENDIF
		    ELSE
		    	AERROR(loerror)
		        MESSAGEBOX("Error al ejecutar la consulta de compras "+loerror[2], 16, "Error")
		    ENDIF
		
		
		
		CATCH TO loexception
		    MESSAGEBOX("Error: " + loexception.message, 16, "Error en consulta")
		ENDTRY
	ENDPROC

	PROCEDURE btn_cancelar.Click
		THISFORM.Release()
	ENDPROC

	PROCEDURE txt_id_proveedor.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			local loregistro as object
			do form bus_proveedor to loregistro
		
		
			if vartype(loregistro) <> "L"
		
				this.value = loregistro.idproveedor
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
	ENDPROC

	PROCEDURE txt_id_proveedor.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnIDproveedor, lcSQL
		    
		    lnIDproveedor = this.Value
		    
		    lcSQL = "SELECT * FROM proveedor WHERE idproveedor = " + ALLTRIM(STR(lnIDproveedor, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_proveedor") > 0
		        IF RECCOUNT("cur_proveedor") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_proveedor.idproveedor
					thisform.txt_proveedor.Value = cur_proveedor.proveedor
					*
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Proveedor no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_proveedor.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar Proveedor: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_proveedor.Value = "TODOS"
		ENDIF
	ENDPROC

ENDDEFINE
