	PROCEDURE Init
		DODEFAULT()
		
		LOCAL LCSQLCOMPRA, LCSQLDETALLE_COMPRA
		
		LCSQLCOMPRA = "SELECT * FROM v_compra WHERE 1=0"
		LCSQLDETALLE_COMPRA = "SELECT * FROM v_detalle_compra WHERE 1=0"
		
		=SQLEXEC(CONEXION, LCSQLCOMPRA, "crs_compra")
		=SQLEXEC(CONEXION, LCSQLDETALLE_COMPRA, "crs_detalle_compra")
		
		THIS._gridcompra()
		THIS._griddetalle()
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		
		SET NULLDISPLAY TO 'S/D'
	ENDPROC

	PROCEDURE _anularcompra
		LPARAMETERS tnidcompra, tcmotivo
		**metodo anular compra llamado _anularcompra.
		LOCAL lnidcompra, lcmotivo, lnidusuario, lnResult, lcSQL, lnHandle, llExito
		
		lnidcompra = crs_compra.idcompra  && Cambiado de crs_venta.idVenta a crs_compra.idcompra
		lcmotivo = IIF(EMPTY(tcmotivo), 'ANULACION DE COMPRA', ALLTRIM(tcmotivo))  && Cambiado motivo
		lnidusuario = _SCREEN.OAPP.NUSUARIOSISTEMA
		llExito = .F.
		
		* Usar conexión existente
		lnHandle = conexion
		=SQLEXEC(conexion,'START TRANSACTION')
		
		lcSQL = "CALL sp_anular_compra(" + ;  && Cambiado de sp_anular_venta a sp_anular_compra
		        ALLTRIM(STR(lnidcompra)) + ", " + ;
		        "'" + lcmotivo + "', " + ;
		        ALLTRIM(STR(lnidusuario)) + ")"
		
		lnResult = SQLExec(lnHandle, lcSQL)
		
		IF lnResult > 0
		    llExito = .T.
		    =SQLEXEC(conexion,"commit")
		ELSE
		    AERROR(loerror)
		    =SQLEXEC(conexion,'ROLLBACK')
		    MESSAGEBOX("Error al anular la compra: " + loerror(2), 16, "Error")  && Cambiado mensaje
		    llExito = .F.
		ENDIF
		
		RETURN llExito
	ENDPROC

	PROCEDURE _buscardetallecompra
		LPARAMETERS tnidcompra
		* este codigo esta en un metodo llamado _buscardetallecompra.
		LOCAL lcSQL, lnResult, laError[1]
		
		*-- Validar que se recibió un ID de compra válido
		IF EMPTY(tnidcompra) OR ISNULL(tnidcompra)
		    MESSAGEBOX("No se especificó un ID de compra válido.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*-- Construir la consulta SQL para MySQL
		lcSQL = "SELECT * FROM v_detalle_compra WHERE idcompra = " + TRANSFORM(tnidcompra) + ;
		        " ORDER BY idcompra_detalle"
		
		*-- Ejecutar la consulta usando SQLEXEC
		lnResult = SQLEXEC(conexion, lcSQL, 'crs_detalle_compra')
		
		*-- Verificar el resultado de la ejecución
		IF lnResult <= 0
		    *-- Capturar información del error usando AERROR
		    AERROR(laError)
		    
		    LOCAL lcErrorMessage
		    lcErrorMessage = "Error al ejecutar la consulta de detalle de compra." + CHR(13) + ;
		                     "Código de error: " + TRANSFORM(lnResult) + CHR(13) + ;
		                     "Error: " + TRANSFORM(laError[2]) + CHR(13) + ;
		                     "Mensaje: " + TRANSFORM(laError[3])
		    
		    MESSAGEBOX(lcErrorMessage, 16, "Error de Base de Datos")
		    RETURN .F.
		ENDIF
		
		*-- Verificar si se obtuvieron registros
		IF RECCOUNT('crs_detalle_compra') = 0
		    MESSAGEBOX("No se encontraron detalles para la compra ID: " + TRANSFORM(tnidcompra), 64, "Información")
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE _cancelar
	ENDPROC

	PROCEDURE _filtrar
		LPARAMETERS tcnrofacturaini, tcnrofacturafin, tdfechainicio, tdfechafin
		
		*-- Suponiendo que 'conexion' es el manejador de conexión a la base de datos
		LOCAL lcWhere, lcSQL, lnResult, laError[1]
		
		*-- Construir la cláusula WHERE basada en los parámetros recibidos
		lcWhere = ""
		
		*-- Validar y agregar condición para número de factura inicial
		IF !EMPTY(tcnrofacturaini)
		    lcWhere = lcWhere + " AND nro_factura >= '" + ALLTRIM(tcnrofacturaini) + "'"
		ENDIF
		
		*-- Validar y agregar condición para número de factura final
		IF !EMPTY(tcnrofacturafin)
		    lcWhere = lcWhere + " AND nro_factura <= '" + ALLTRIM(tcnrofacturafin) + "'"
		ENDIF
		
		*-- Validar y agregar condición para fecha de inicio
		IF !EMPTY(tdfechainicio)
		    lcWhere = lcWhere + " AND fecha >= '" + tdfechainicio + "'"
		ENDIF
		
		*-- Validar y agregar condición para fecha de fin
		IF !EMPTY(tdfechafin)
		    lcWhere = lcWhere + " AND fecha <= '" + tdfechafin + "'"
		ENDIF
		
		*-- Remover el "AND" inicial si existe
		IF !EMPTY(lcWhere)
		    lcWhere = SUBSTR(lcWhere, 6)  && Remueve el " AND " inicial
		ENDIF
		
		*-- Construir la consulta SQL completa para MySQL
		IF EMPTY(lcWhere)
		    lcSQL = "SELECT * FROM v_compra ORDER BY fecha DESC, idcompra DESC"
		ELSE
		    lcSQL = "SELECT * FROM v_compra WHERE " + lcWhere + " ORDER BY fecha DESC, idcompra DESC"
		ENDIF
		
		*-- Ejecutar la consulta usando SQLEXEC
		lnResult = SQLEXEC(conexion, lcSQL, 'crs_compra')
		
		*-- Verificar el resultado de la ejecución
		IF lnResult <= 0
		    *-- Capturar información del error usando AERROR
		    AERROR(laError)
		    
		    *-- Construir mensaje de error detallado
		    LOCAL lcErrorMessage
		    lcErrorMessage = "Error al ejecutar la consulta en la base de datos." + CHR(13) + ;
		                     "Código de error: " + TRANSFORM(lnResult) + CHR(13) + ;
		                     "Nativo: " + TRANSFORM(laError[2]) + CHR(13) + ;
		                     "Mensaje: " + TRANSFORM(laError[3])
		    
		    *-- Si hay más información de error, agregarla
		    IF ALEN(laError) >= 5 AND !EMPTY(laError[5])
		        lcErrorMessage = lcErrorMessage + CHR(13) + "Detalle: " + TRANSFORM(laError[5])
		    ENDIF
		    
		    MESSAGEBOX(lcErrorMessage, 16, "Error de Base de Datos")
		    RETURN .F.
		ENDIF
		
		*-- Verificar si se obtuvieron registros
		IF RECCOUNT('crs_compra') = 0
		    MESSAGEBOX("No se encontraron compras con los criterios especificados.", 64, "Información")
		ENDIF
		
		RETURN .T.
	ENDPROC

