	PROCEDURE BTN_ANULAR.Click
		IF RECCOUNT('crs_compra') = 0 
		    MESSAGEBOX('Debes seleccionar una compra para anular!', 16, 'Aviso') 
		    RETURN 
		ENDIF 
		
		*-- Preguntar al usuario si desea anular la compra
		lnRespuesta = MESSAGEBOX("¿Está seguro que desea anular la compra seleccionada?", ;
		                         4 + 32 + 256, ;  && Botones Sí/No + Icono Pregunta + 2do botón por defecto
		                         "Confirmar Anulación")
		
		*-- Si el usuario eligió Sí (respuesta = 6), llamar al método anular
		IF lnRespuesta = 6
		    IF thisform._anularcompra()
		        MESSAGEBOX("Anulación de compra exitosa", 64, "Aviso")  
		        thisform.Init()
		    ENDIF 
		ENDIF
	ENDPROC

	PROCEDURE BTN_CANCELAR.Click
		thisform.Init()
	ENDPROC

	PROCEDURE BTN_FILTRAR.Click
		LOCAL lcnrodesde, lcnrohasta
		LOCAL lddesde, ldhasta
		
		lcnrodesde = ALLTRIM(thisform.txt_factura_INI.Value)  && Cambiado de txt_reCIBO_INI
		lcnrohasta = ALLTRIM(thisform.txt_factura_FIN.Value)  && Cambiado de txT_RECIBO_FIN
		lddesde = fechatomysql(thisform._fecha_desde.getvalue())
		IF lddesde = '0000-00-00'
		    lddesde = ""
		ENDIF
		
		ldhasta = fechatomysql(thisform._fecha_hasta.getvalue())
		IF ldhasta = '0000-00-00'
		    ldhasta = ""
		ENDIF
		
		IF thisform._filtrar(lcnrodesde, lcnrohasta, lddesde, ldhasta)
		    thisform._gridcompra()  && Cambiado de _gridrecibo
		ENDIF 
	ENDPROC

	PROCEDURE BTN_SALIR.Click
		THISFORM.Release()
	ENDPROC

	PROCEDURE grdCompra.AfterRowColChange
		LPARAMETERS nColIndex
		
		IF USED("crs_compra") AND RECCOUNT("crs_compra") > 0
		    IF thisform._buscardetallecompra(crs_compra.idcompra)
		        thisform._griddetalle()
		    ENDIF 
		ENDIF
	ENDPROC

	PROCEDURE grdCompra.Click
		this.AfterRowColChange()
	ENDPROC

	PROCEDURE grdCompra.When
		NODEFAULT
	ENDPROC

	PROCEDURE grddetalle.When
		NODEFAULT
	ENDPROC

	PROCEDURE TXT_FACTURA_FIN.LostFocus
		dodefault()
	ENDPROC

	PROCEDURE TXT_FACTURA_INI.LostFocus
		dodefault()
	ENDPROC

ENDDEFINE
