	PROCEDURE txt_cuota.Valid
		IF NOT empty(this.value)
			thisform.txt_precio_financiado.Value = this.Value * thisform.txtplazo.Value
			thisform.txt_subtotal.Value = thisform.txt_precio_financiado.Value * thisform.txt_cantidad.Value
		ELSE 
			this.Value = thisform.txt_cuota_aux.Value
		ENDIF 
	ENDPROC

