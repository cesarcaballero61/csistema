			thisform.cancelar_venta()
		ENDIF 
	ENDPROC

	PROCEDURE btnguardar.Click
		if thisform.guardar_venta()
			
		endif
	ENDPROC

	PROCEDURE btnsalir.Click
		thisform.Release()
	ENDPROC

	PROCEDURE btn_agregar.Click
		if empty(thisform.txt_cod_articulo.value)
			messagebox("Debes seleccionar un articulo para seguir.", 48, "Aviso")
			thisform.txt_cod_articulo.setfocus()
			return
		endif
		
		if empty(thisform.txtplazo.value)
			messagebox("Debes establecer un #CUOTA para seguir.", 48, "Aviso")
			return
		endif
		
		
		if empty(thisform.txt_cantidad.value)
			messagebox("Debes establecer una CANTIDAD para seguir.", 48, "Aviso")
			return
		endif
		
		*** Limpiar las cuotas ante una nueva insercion. ****
		
		select crstempcuotas
		zap
		
		select crstempdetalle
		append blank
		
		replace ;
			codart 		with alltrim(thisform.txt_cod_articulo.value), ;
			cdesart 	with alltrim(thisform.txt_descripcion.value), ;
			cplancuota 	with alltrim(thisform.txt_plancuota.value), ;
			cplazo 		with alltrim(thisform.cbo_plazo.value), ;
			ncantcuota 	with thisform.txtplazo.value, ;
			nmontocuota with thisform.txt_cuota.value, ;
			ctipo 		with alltrim(thisform.txt_tipo.value), ;
			ncantart 	with thisform.txt_cantidad.value, ;
			civa		with thisform.txtimpuesto.value,;
			ngravadas_exenta with iif(thisform.txtimpuesto.value = "0", thisform.txt_subtotal.value, 0),;
			ngravada_cinco 	 with iif(thisform.txtimpuesto.value = "5", thisform.txt_subtotal.value, 0),;
			ngravada_diez    with iif(thisform.txtimpuesto.value = "10", thisform.txt_subtotal.value, 0),;
			nprecio 	with thisform.txt_precio_financiado.value, ;
			nsubtotal 	with thisform.txt_subtotal.value, ;
			nidarticulo with thisform.txt_idarticulo.value, ;
			nprecosto	with thisform.txt_precio_costo.value,;
			ninteres 	with thisform.txtinteres.value, ;
			nmargen 	with thisform.txt_margen.value
		
		
		thisform.limpiar_articulos()
		thisform.txt_cod_articulo.enabled = .t.
		thisform.txt_cod_articulo.setfocus()
		thisform.txt_total.value = thisform.sumar_totales()
		thisform.txt_excenta.value = thisform.sumar_excenta()
		thisform.txt_iva_cinco.value = thisform.sumar_gravadas_cinco()
		thisform.txt_iva_diez.value = thisform.sumar_gravadas_diez()
		thisform.btn_ver_datos_articulos.enabled = .t.
		thisform.btn_cuota.enabled = .t.
		
		thisform.grddetalle.refresh()
	ENDPROC

	PROCEDURE btn_cuota.Click
		select crstempdetalle
		GO TOP
		if EOF()
			messagebox("No hay detalles de ventas para generar cuotas", 48, "Aviso")
			return
		endif
		do form frm_generar_cuota with thisform.datasessionid
		
		*thisform.recalcular_financiamiento()
		
	ENDPROC

	PROCEDURE btn_eliminar.Click
		*========================================
		* Evento Click del Botón Eliminar
		* Descripción: Elimina el registro actual del cursor y actualiza el total
		*========================================
		LOCAL lnRecNo, lnRecCount, lnResponse
		
		* Validaciones iniciales
		IF !USED("crstempdetalle")
		    MESSAGEBOX("No hay registros para eliminar.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		SELECT crstempdetalle
		lnRecCount = RECCOUNT()
		
		* Validar que existen registros y hay uno seleccionado
		DO CASE
		    CASE lnRecCount = 0
		        MESSAGEBOX("No hay registros para eliminar.", 48, "Aviso")
		        RETURN .F.
		    
		    CASE EOF() OR BOF()
		        MESSAGEBOX("Debe seleccionar un registro para eliminar.", 48, "Aviso")
		        RETURN .F.
		ENDCASE
		
		* Confirmar eliminación
		lnResponse = MESSAGEBOX("¿Está seguro de eliminar este registro?", 4+32, "Confirmar Eliminación")
		IF lnResponse != 6
		    RETURN .F.
		ENDIF
		
		* Guardar posición actual
		lnRecNo = RECNO()
		
		* Eliminar el registro
		DELETE
		
		
		* Reposicionar cursor
		lnRecCount = RECCOUNT()
		IF lnRecCount > 0
		    * Ir al mismo número de registro o al último si ya no existe
		    GO MIN(lnRecNo, lnRecCount)
		ENDIF
		
		* Actualizar interfaz
		Thisform.ActualizarInterfaz()
		
		MESSAGEBOX("Registro eliminado correctamente.", 64, "Éxito")
		RETURN .T.
	ENDPROC

	PROCEDURE btn_ver_datos_articulos.Click
		if not empty(thisform.txt_idarticulo.value)
			do form articulo with thisform.txt_idarticulo.value
		else
			select crstempdetalle
			if EOF()
				messagebox("seleccione un articulo para continuar", 48, "Aviso")
				return
			endif
			do form articulo with crstempdetalle.nidarticulo
		endif
	ENDPROC

	PROCEDURE cbo_plazo.GotFocus
		KEYBOARD '{SPACEBAR}'
	ENDPROC

	PROCEDURE cbo_plazo.LostFocus
		this.enabled =.f.
		
	ENDPROC

	PROCEDURE cbo_plazo.Valid
		* Obtener valores y convertirlos de vuelta a numérico
		local lctipo, lnorden, lncuota
		
		with thisform.cbo_plazo
			lctipo = .list(.listindex, 2)           && String
			lnorden = val(.list(.listindex, 3))     && Convertir a numérico
			lncuota = val(.list(.listindex, 4))     && Convertir a numérico
		endwith
		
		thisform.txtplazo.value = lnorden
		thisform.txt_cuota.value = lncuota
		thisform.txt_cuota_aux.value = lncuota
		
		thisform.txt_tipo.value = lctipo
		
		thisform.txt_cantidad.enabled =.t.
		thisform.txt_cantidad.value = 1
		
		thisform.txt_precio_financiado.value = round(lncuota * lnorden, 0)
		thisform.txtplazo.enabled =(this.listindex = 1)
		thisform.txt_cuota.Enabled = .T.&&(this.ListIndex = 1)
	ENDPROC

