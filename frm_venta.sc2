	PROCEDURE txtfecha.LostFocus
		dodefault()
		
		if empty(this.value)
			this.value = date()
		endif
		this.enabled = .f.
	ENDPROC

	PROCEDURE txtplazo.LostFocus
		DODEFAULT()
		thisform.txt_cuota.Value = ROUND(thisform.txt_cuota_aux.Value / this.Value,0)
		thisform.txt_cuota_aux.Value = thisform.txt_cuota.Value 
		this.Enabled =.f.
	ENDPROC

	PROCEDURE txt_cantidad.LostFocus
		DODEFAULT()
		
		IF this.Value > 0 
			thisform.txt_subtotal.Value = this.Value * thisform.txt_precio_financiado.Value
			thisform.txt_cuota.Value = this.Value * thisform.txt_cuota_aux.Value
			
			IF thisform.cbo_plazo.ListIndex = 1
				thisform.txt_cuota.SetFocus()
			ENDIF 
			
		ELSE
			MESSAGEBOX("La cantidad debe ser > 0",16,"Aviso")
			this.Value = 1
			NODEFAULT 
			RETURN 
		ENDIF 
		thisform.txt_cantidad.Enabled = .f.
	ENDPROC

	PROCEDURE txt_ci_cliente.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			LOCAL lcruc_ci as String
			lcruc_ci = ""
			local loregistro as object
			do form bus_cliente to loregistro
		
		
			if vartype(loregistro) <> "L"
			
				lcruc_ci = ALLTRIM(loregistro.ci)
				
				IF EMPTY(ALLTRIM(loregistro.ci))
					lcruc_ci =ALLTRIM(loregistro.ruc)
				ENDIF
				
				IF EMPTY(lcruc_ci)
					MESSAGEBOX("Este cliente no posee #cedula ni #ruc"+CHR(13);
					+"debes completar los datos faltantes antes de continuar",16,"Aviso")
					lcruc_ci=""
				ENDIF  
				
				this.value = lcruc_ci
				this.setfocus()
			else
				this.value = ""
			endif
		endif
		
		
		if m.nkeycode = 22
			nodefault
			local lncodigo
			do form cliente with .t. to m.lncodigo
			this.value = m.lncodigo
		endif
	ENDPROC

	PROCEDURE txt_ci_cliente.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lncodCliente, lcSQL
		    
		    lncodCliente= this.Value
		    
		    lcSQL = "SELECT * FROM v_clientes WHERE ci = '" + ALLTRIM(lncodCliente)+"'"
		    lcSQL =lcSQL + "  or  ruc = '" + ALLTRIM(lncodCliente)+"'"
		    
		    IF SQLExec(conexion, lcSQL, "cur_cliente") > 0
		        IF RECCOUNT("cur_cliente") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = ICASE(!EMPTY(cur_cliente.ci),cur_cliente.ci,!EMPTY(cur_cliente.ruc),cur_cliente.ruc,ALLTRIM(STR(cur_cliente.idcliente,10,0)))
					thisform.txt_cliente.Value = ALLTRIM(cur_cliente.nombre_completo)
					thisform.txt_idcliente.Value = cur_cliente.idcliente
		
					this.Enabled = .f.
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Cliente no encontrado!", 16, "Atención")
		            this.Value = ""
					thisform.txt_cliente.Value = ""
					thisform.txt_idcliente.Value = 0
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar Cliente: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_cliente.Value = ""
			thisform.txt_idcliente.Value = 0
		ENDIF
	ENDPROC

	PROCEDURE txt_cod_articulo.KeyPress
		lparameters nkeycode, nshiftaltctrl
		
		
		if nkeycode = 42
			nodefault
		
			if empty(thisform.txt_cod_deposito.value)
				messagebox("Seleccione un depósito", 16, "Aviso")
				thisform.txt_cod_deposito.setfocus()
				return
			endif
		
		
			local loregistro as object
			do form bus_articulo with _screen.oapp.nsucursal, thisform.txt_cod_deposito.value to  loregistro
		
		
			if vartype(loregistro) <> "L"
		
				this.value = alltrim(loregistro.codbarra)
				this.setfocus()
		
			else
		
				this.value = ""
		
			endif
		endif
	ENDPROC

	PROCEDURE txt_cod_articulo.LostFocus
		local lnidtipopago
		
		dodefault()
		if not empty(this.value)
			local lccodarticulo, lncoddeposito, lncodsucursal, lcsql
		
			lncodsucursal = _screen.oapp.nsucursal
			lccodarticulo = ALLTRIM(this.Value)
			lncoddeposito = thisform.txt_cod_deposito.Value
			
		
			lcsql = "SELECT * FROM v_articulo WHERE codbarra = '" + lccodarticulo +"'"
			lcsql = lcsql + " and iddeposito = "+ALLTRIM(STR(lncoddeposito,10,0))
			lcsql = lcsql + " and idsucursal = "+ALLTRIM(STR(lncodsucursal,10,0))
		
			if sqlexec(conexion, lcsql, "cur_articulo") > 0
				if reccount("cur_articulo") > 0
				
					LOCAL lnPrecioContado,lnInteres,lncantCuota
					
					STORE 0 TO lnPrecioContado,lnInteres,lncantCuota
		
					** Llenar campos del formulario.
					**
					this.value = ALLTRIM(cur_articulo.codbarra)
					thisform.txt_idarticulo.Value		= cur_articulo.idarticulo
					thisform.txt_descripcion.value 		= cur_articulo.descripcion
					thisform.txt_planCuota.Value 		= cur_articulo.nombre_plan_cuota
					thisform.txt_precio_contado.Value 	= cur_articulo.precio_contado
					thisform.txtimpuesto.Value			= cur_articulo.impuesto
					
					lnPrecioContado	= cur_articulo.precio_contado
					lnInteres		= cur_articulo.interes_mensual
					lncantCuota		= cur_articulo.limite_cuota
					
					thisform.txt_margen.Value 		= cur_articulo.margen_contado
					thisform.txt_precio_costo.Value = cur_articulo.precio_costo
					thisform.txtinteres.Value 		= lnInteres
					
					thisform.cbo_plazo.Enabled 		= .t.
					thisform.btn_agregar.Enabled 	= .t.
					thisform.btn_eliminar.Enabled 	= .t.
		
					
					thisform.calcular_cuotas(lnPrecioContado,lnInteres,lncantCuota)
					
					thisform.txt_cantidad.Value = 0
					thisform.txt_precio_financiado.Value = 0
					thisform.txt_subtotal.Value = 0
					
					thisform.btn_ver_datos_articulos.Enabled =.t.
					*this.Enabled = .f.
				else
					** Articulo no encontrado
					messagebox("Articulo no encontrado", 16, "Atención")
		
					*limpiar datos de articulos
					thisform.limpiar_articulos()
		
					** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		
					this.setfocus()
					nodefault
		
				endif
			else
				** Error en la consulta
				local laerror[1]
				aerror(laerror)
				
				messagebox("Error al buscar la Forma de pago: " + laerror[2], 16, "Error")
			endif
		else
			*thisform.txt_forma.value = ""
		endif
	ENDPROC

