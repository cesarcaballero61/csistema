	PROCEDURE actualizarinterfaz
		local lntotal, lnexcenta, lnivacinco, lnivadiez, llhayregistros
		
		* Refrescar grid
		if type("THIS.grdDetalle") = "O"
			this.grddetalle.refresh()
		endif
		
		* Calcular totales
		lntotal = this.sumar_totales()
		lnexcenta = this.sumar_excenta()
		lnivacinco = this.sumar_gravadas_cinco()
		lnivadiez = this.sumar_gravadas_diez()
		
		* Actualizar campos de texto
		with this
			.txt_total.value = lntotal
			.txt_excenta.value = lnexcenta
			.txt_iva_cinco.value = lnivacinco
			.txt_iva_diez.value = lnivadiez
		endwith
		
		* Gestionar estado de botones
		llhayregistros = !(eof())
		this.btn_ver_datos_articulos.enabled = .t.
		this.btn_cuota.enabled = .t.
		
		
		* Limpiar cuotas si no hay registros
		if !llhayregistros and used("crstempcuotas")
			select crstempcuotas
			zap
			select crstempdetalle
		endif
	ENDPROC

	PROCEDURE calcular_cuotas
		LPARAMETERS tnprecioContado,tnInteresmensual,tncantCuota
		
		LOCAL ARRAY loError[1]
		
		LOCAL lcSQL as String
		lcSQL = "call CalcularPrecioCuotasDetallado('',?tnprecioContado,?tnInteresmensual,?tncantCuota)"
		
		IF SQLEXEC(conexion,lcSQL,"cur_cuotas_calculados")>0
			thisform.llenar_cbo_plazo() && genera el codigo para llenar con este metodo el comboBox. llamado cbo_plazo con el campo llamado descripcion.
		ELSE
			AERROR(loError)
			MESSAGEBOX("Error al calcular las cuotas "+loError[2],16,"Aviso")
			THISFORM.CBO_plazo.Enabled = .f.
		ENDIF 
	ENDPROC

	PROCEDURE calcular_cuota_subtotales
	ENDPROC

	PROCEDURE cancelar_venta
		with thisform
			.txtfecha.value = {}
			.cbo_tipoventa.value = ""
			.txt_ci_cliente.value = ""
			.txt_cliente.value = ""
			.txt_idcliente.value = 0
			.txt_cod_vendedor.value = 0
			.txt_vendedor.value = ""
			.txt_cod_cobrador.value = 0
			.txt_cobrador.value = ""
			.txt_cod_formapago.value = 0
			.txt_forma.value = ""
			.txt_cod_deposito.value = 0
			.txt_deposito.value = ""
		
		
			.txt_excenta.value = 0
			.txt_iva_diez.value = 0
			.txt_iva_cinco.value = 0
			.txt_total.value = 0
		
			.limpiar_articulos()
		
		
			.txtfecha.enabled =.t.
			.cbo_tipoventa.enabled =.t.
			.txt_ci_cliente.enabled =.t.
			.txt_cod_vendedor.enabled =.t.
			.txt_cod_cobrador.enabled =.t.
			.txt_cod_formapago.enabled = .t.
			.txt_cod_deposito.enabled =.t.
		
		
			.btn_agregar.enabled  = .f.
			.btn_eliminar.enabled = .f.
			.btn_ver_datos_articulos.enabled = .f.
			.btn_cuota.enabled =.f.
		
		
			select crstempdetalle
			zap
		
			select crstempcuotas
			zap
		
		
		
			.grid_detalle()
			.txtfecha.setfocus()
		endwith
		
	ENDPROC

	PROCEDURE generar_factura
		LPARAMETERS tcEstablecimiento, tcPuntoExpedicion
		
		LOCAL lcSQL, lcNroFactura, lnSucursal, lnResult
		
		* Inicializar variables
		lcNroFactura = ""
		lnSucursal = _screen.oapp.nSucursal
		
		* Llamar al stored procedure con parámetros posicionales
		* MySQL usa variables de sesión para parámetros OUT.
		
		lcSQL = "CALL obtener_nro_factura('" + tcEstablecimiento + "', '" + ;
		        tcPuntoExpedicion + "', " + TRANSFORM(lnSucursal) + ", @nro_factura)"
		
		lnResult = SQLEXEC(conexion, lcSQL)
		
		IF lnResult > 0
		
		    * Recuperar el valor del parámetro OUT usando la variable de sesión
		    lcSQL = "SELECT @nro_factura AS nro_factura"
		    lnResult = SQLEXEC(conexion, lcSQL, "curNroFactura")
		    
		    IF lnResult > 0 AND USED("curNroFactura") AND RECCOUNT("curNroFactura") > 0
		        lcNroFactura = ALLTRIM(curNroFactura.nro_factura)
		    ELSE
		        MESSAGEBOX("Error al recuperar número de factura", 16, "Error")
		        lcNroFactura = ""
		    ENDIF
		ELSE
		    * Capturar error de SQL
		    LOCAL ARRAY laError[1]
		    AERROR(laError)
		    MESSAGEBOX("Error al ejecutar SP: " + CHR(13) + laError[2], 16, "Error")
		    lcNroFactura = ""
		ENDIF
		
		* Limpiar cursor
		IF USED("curNroFactura")
		    USE IN curNroFactura
		ENDIF
		
		RETURN lcNroFactura
	ENDPROC

	PROCEDURE grid_detalle
		WITH this.grdDetalle
			.AllowCellSelection = .f.
			.ColumnCount = 0
			.RecordSourceType = 1
		    .RecordSource = "crstempdetalle"
		    .ColumnCount = 14
		    
		    *-- Columna 1: CODIGO
		    .Column1.Header1.Caption = "CODIGO"
		    .Column1.Header1.FontBold = .t.
		    .Column1.ControlSource = "crstempdetalle.codArt"
		    .Column1.Width = 75
		
		    *-- Columna 2: ARTICULO
		    .Column2.Header1.Caption = "ARTICULO"
		    .Column2.Header1.FontBold = .t.
		    .Column2.ControlSource = "crstempdetalle.cdesArt"
		    .Column2.Width = 200
		
		    *-- Columna 3: PLAN_CUOTA
		    .Column3.Header1.Caption = "PLAN_CUOTA"
		    .Column3.Header1.FontBold = .t.
		    .Column3.ControlSource = "crstempdetalle.cplanCuota"
		    .Column3.Width = 150
		
		    *-- Columna 4: PRECIO_CUOTA
		    .Column4.Header1.Caption = "PRECIO_CUOTA"
		    .Column4.Header1.FontBold = .t.
		    .Column4.ControlSource = "crstempdetalle.cplazo"
		    .Column4.Width = 150
		
		    *-- Columna 5: #CUOTA
		    .Column5.Header1.Caption = "PLAZO"
		    .Column5.Header1.FontBold = .t.
		    .Column5.ControlSource = "crstempdetalle.ncantcuota"
		    .Column5.Width = 75
		    .Column5.Alignment = 2  && Centrado
		
		    *-- Columna 6: CUOTA
		    .Column6.Header1.Caption = "CUOTA"
		    .Column6.Header1.FontBold = .t.
		    .Column6.ControlSource = "crstempdetalle.nmontocuota"
		    .Column6.Width = 75
		   	.Column6.inputmask = "999,999,999"
		
		    *-- Columna 7: TIPO
		    .Column7.Header1.Caption = "TIPO"
		    .Column7.Header1.FontBold = .t.
		    .Column7.ControlSource = "crstempdetalle.ctipo"
		    .Column7.Width = 75
		
		    *-- Columna 8: CANTART
		    .Column8.Header1.Caption = "CANTART"
		    .Column8.Header1.FontBold = .t.
		    .Column8.ControlSource = "crstempdetalle.ncantart"
		    .Column8.Width = 75
		    .Column8.Alignment = 2  && Centrado
		
		    *-- Columna 9: PRECIO
		    .Column9.Header1.Caption = "PRECIO"
		    .Column9.Header1.FontBold = .t.
		    .Column9.ControlSource = "crstempdetalle.nprecio"
		    .Column9.Width = 75
		    .Column9.inputmask = "999,999,999"
		
		    *-- Columna 10: SUBTOTAL
		    .Column10.Header1.Caption = "SUBTOTAL"
		    .Column10.Header1.FontBold = .t.
		    .Column10.ControlSource = "crstempdetalle.nSubtotal"
		    .Column10.Width = 75
		    .Column10.inputmask = "999,999,999"
		
		    *-- Columnas adicionales del cursor que no se muestran en la imagen
		    *-- pero están en la estructura
		    .Column11.Visible = .F.  && nidarticulo
		    .Column12.Visible = .F.  && nprecosto
		    .Column13.Visible = .F.  && ninteres
		    .Column14.Visible = .F.  && nmargen
		    
		    
		    .redraw()
		ENDWITH
			
		
	ENDPROC

	PROCEDURE guardar_venta
		local lcsqlcabcuotas, lcsqlcabecera, lcsqldetcuota, lcsqldetalle, ldprimerafechavto
		local lncantidadcuotas, lnidcuotas, lnidventa, lnresult, lntotalcuotas,lnIDusuario
		
		local llok as boolean
		
		llok = .t.
		
		
		local array loerror[1]
		
		select crstempdetalle
		go top
		if eof()
			messagebox('Esta venta no posee detalles de ventas para guardar!', 64, "Atencion")
			return
		endif
		
		IF thisform.Cbo_tipoventa.Value =="CREDITO"
			select crstempcuotas
			go top
			if eof()
				messagebox('Esta venta no posee cuotas generadas para guardar!', 64, "Atencion")
				return
			ENDIF
		ENDIF 
		
		
		local  ldfecha,ldfecha_vto_pagare, lctipo, lcnrosuc, lcnroexp, lcnrofactura, lcnrofactura_cuota, lcestado,;
			lnexenta, lngravada_cinco, lngravada_diez, lnliqui_iva_cinco, lnliqui_iva_diez, lntotal_liqui_iva, ln_total,;
			lncod_vendedor, lncod_cliente, lncod_sucursal, lncod_empresa, lncod_deposito, lncod_cobrador, lncod_formapago
		
		if messagebox("Desea guardar los datos y cuotas de esta venta?", 36, "Aviso") = 6
		
			*codigo de usuario que registro la venta
			lnIDusuario = _screen.OAPP.NUSUARIOSISTEMA
			*****
		
			with thisform
		
				ldfecha 	= .txtfecha.value
				ldfecha_vto_pagare = this.obtener_ultima_fecha_vto()
				ldfecha_vto_pagare = IIF(!EMPTY(ldfecha_vto_pagare ),ldfecha_vto_pagare, ldfecha)
				lctipo 		= iif(.cbo_tipoventa.value == "CREDITO", "CRE", "CON")
				lcnrosuc 	=.txt_nrosuc.value
				lcnroexp 	=.nro_exp.value
				lcnrofactura =.txt_nrofactura.value
				lcnrofactura_cuota = alltrim(lcnrosuc) + "-" + alltrim(lcnroexp) + "-" + alltrim(lcnrofactura)
				lcestado 	= 'F'
				lnexenta 	= .txt_excenta.value
				lngravada_cinco = .txt_iva_cinco.value
				lngravada_diez 	= .txt_iva_diez.value
				lnliqui_iva_cinco 	= iif(.txt_iva_cinco.value > 0,.txt_iva_diez.value / 21, 0)
				lnliqui_iva_diez 	= iif(.txt_iva_diez.value > 0,.txt_iva_diez.value / 11, 0)
				lntotal_liqui_iva 	= lnliqui_iva_cinco + lnliqui_iva_diez
				ln_total =.txt_total.value
				lncod_vendedor 	=.txt_cod_vendedor.value
				lncod_cliente  	= .txt_idcliente.value
				lncod_sucursal 	= _screen.oapp.nsucursal
				lncod_empresa  	= _screen.oapp.nempresa
				lncod_deposito 	= .txt_cod_deposito.value
				lncod_cobrador 	= .txt_cod_cobrador.value
				lncod_formapago = .txt_cod_formapago.value
		
			endwith
		
			= sqlexec(conexion, "start transaction")
		
		* 1. LLAMAR AL SP PARA GUARDAR CABECERA DE VENTA
			lcsqlcabecera = "CALL ventas_cabecera(?ldfecha, ?ldfecha_vto_pagare, ?lctipo, ?lcnrosuc, ?lcnroexp, ?lcnrofactura, ?lcestado, " + ;
				"?lnexenta, ?lngravada_cinco, ?lngravada_diez, ?lnliqui_iva_cinco, ?lnliqui_iva_diez, " + ;
				"?lntotal_liqui_iva, ?ln_total, ?lncod_vendedor, ?lncod_cliente, ?lncod_sucursal, " + ;
				"?lncod_empresa, ?lncod_deposito, ?lncod_cobrador, ?lncod_formapago, ?lnIDusuario)"
		
			lnresult = sqlexec(conexion, lcsqlcabecera, "curVentaId")
		
			if lnresult < 0
				llok = .f.
				aerror(loerror)
				= sqlexec(conexion, "rollback")
				messagebox("Error al guardar la cabecera de venta: " + loerror[2], 16, "Error")
				return
			endif
		
		* OBTENER EL ID DE VENTA GENERADO DEL SP
			lnidventa = 0
			if used("curVentaId") and reccount("curVentaId") > 0
				lnidventa = curventaid.codigo
			else
				llok = .f.
				= sqlexec(conexion, "rollback")
				messagebox("Error al obtener el ID de venta generado", 16, "Error")
				return
			endif
		
		* 2. LLAMAR AL SP PARA GUARDAR DETALLES DE VENTA
			select crstempdetalle
			go top
			scan
				lcsqldetalle = "CALL ventas_detalle(?lnIdVenta, ?crstempdetalle.ctipo, ?crstempdetalle.cplanCuota, " + ;
					"?crstempdetalle.ninteres, ?crstempdetalle.ncantcuota, ?crstempdetalle.nmargen, " + ;
					"?crstempdetalle.nmontocuota, ?crstempdetalle.nprecosto, ?crstempdetalle.ncantart, " + ;
					"?crstempdetalle.nprecio, ?crstempdetalle.nSubtotal, ?crstempdetalle.civa, " + ;
					"?crstempdetalle.ngravadas_exenta, ?crstempdetalle.ngravada_cinco, ?crstempdetalle.ngravada_diez, " + ;
					"?crstempdetalle.nidarticulo, ?lncod_deposito)"
		
				lnresult = sqlexec(conexion, lcsqldetalle)
				if lnresult < 0
					llok = .f.
					aerror(loerror)
					= sqlexec(conexion, "rollback")
					messagebox("Error al guardar el detalle de venta: " + loerror[2], 16, "Error")
					return
				endif
			endscan
		
		* 3. GUARDAR CABECERA Y DETALLES DE CUOTAS USANDO TUS SPs.
			if lctipo = 'CRE'
				select crstempcuotas
				count to lncantidadcuotas
				go top
				ldprimerafechavto = crstempcuotas.dfechavto
		
		* Calcular el saldo total sumando todas las cuotas
				lntotalcuotas = 0
				scan
					lntotalcuotas = lntotalcuotas + crstempcuotas.nmontocuota
				endscan
				go top
		
				* Llamar al SP para guardar cabecera de cuotas
				
				lcsqlcabcuotas = "CALL cuotas_cabecera(?ldfecha, ?lcnrofactura_cuota , ?lnCantidadCuotas, ?ldPrimeraFechaVto, " + ;
					"?lnTotalCuotas, ?lnTotalCuotas, ?lnIdVenta, ?lncod_cliente)"
		
				lnresult = sqlexec(conexion, lcsqlcabcuotas, "curIdCuotas")
				if lnresult < 0
					llok = .f.
					aerror(loerror)
					= sqlexec(conexion, "rollback")
					messagebox("Error al guardar la cabecera de cuotas: " + loerror[2], 16, "Error")
					return
				endif
		
		* OBTENER EL ID DE CUOTAS GENERADO DEL SP
				lnidcuotas = 0
				if used("curIdCuotas") and reccount("curIdCuotas") > 0
					lnidcuotas = curidcuotas.idcuotas
				else
					llok = .f.
					aerror(loerror)
					= sqlexec(conexion, "rollback")
					messagebox("Error al obtener el ID de cuotas generado " + loerror[2], 16, "Error")
					return
				endif
		
		* Guardar detalle de cuotas usando SP individual
				select crstempcuotas
				go top
				scan
					lcsqldetcuota = "CALL cuotas_detalle(?crstempcuotas.cOrdenCuota, ?crstempcuotas.nOrdencuota, " + ;
						"?crstempcuotas.dfechavto, ?crstempcuotas.nmontocuota, ?crstempcuotas.ncuotasaldo, ?lnIdCuotas)"
					lnresult = sqlexec(conexion, lcsqldetcuota)
					if lnresult < 0
						llok = .f.
						aerror(loerror)
						= sqlexec(conexion, "rollback")
						messagebox("Error al guardar el detalle de cuotas: " + loerror[2], 16, "Error")
						return
					endif
				endscan
			endif
		
			if sqlexec(conexion, "CALL confirmar_nro_factura(?lcnrosuc , ?lcnroexp , ?lncod_sucursal)") > 0
		
		* Si todo sale bien, hacemos commit
				= sqlexec(conexion, "commit")
				messagebox("Venta guardada correctamente! ID: " + transform(lnidventa), 64, "Éxito")
				
				
				*imprimir factura 
				thisform.imprimir_factura(lnidventa)
				thisform.imprimir_pagare(lnidventa)
				thisform.cancelar_venta()
				pdfechavto = {}
				pnmetodo = 1
		
		* numeracion
				thisform.txt_nrosuc.value = _screen.oapp.cestablecimiento
				thisform.nro_exp.value  = _screen.oapp.cpuntoexpedicion
				thisform.txt_nrofactura.value = thisform.generar_factura(thisform.txt_nrosuc.value, thisform.nro_exp.value)
		
		
			else
				llok = .f.
				aerror(loerror)
				= sqlexec(conexion, "rollback")
				messagebox("Error al confirmar la numeración " + loerror[2], 16, "Error")
			endif
		
		
			return llok
		else
			return .f.
		endif
		
		********************
		
		
		
		
	ENDPROC

	PROCEDURE imprimir_factura
		LPARAMETERS tncodventa
		*-- Procedimiento para imprimir factura
		
		LOCAL lcSQL
		
		*-- Llamar al stored procedure
		lcSQL = "CALL sp_consultar_venta(" + TRANSFORM(tncodventa) + ")"
		
		SQLEXEC(conexion, lcSQL, "cur_factura")
		
		*-- Verificar si hay datos
		IF RECCOUNT("cur_factura") = 0
		    MESSAGEBOX("No se encontraron datos para esta venta", 48, "Aviso")
		    RETURN
		ENDIF
		
		SELECT cur_factura
		*-- Llamar al reporte
		REPORT FORM _factura PREVIEW NOCONSOLE
		
		*-- Limpiar
		USE IN cur_factura
		
	ENDPROC

	PROCEDURE imprimir_pagare
		LPARAMETERS tncodventa
		*-- Procedimiento para imprimir factura
		
		LOCAL lcSQL
		
		*-- Llamar al stored procedure
		lcSQL = "CALL sp_consultar_pagare(" + TRANSFORM(tncodventa) + ")"
		
		SQLEXEC(conexion, lcSQL, "cur_pagare")
		
		*-- Verificar si hay datos
		IF RECCOUNT("cur_pagare") = 0
		    MESSAGEBOX("No se encontraron datos para esta venta", 48, "Aviso")
		    RETURN
		ENDIF
		
		SELECT cur_pagare
		*-- Llamar al reporte
		REPORT FORM _pagare PREVIEW NOCONSOLE
		
		*-- Limpiar
		USE IN cur_pagare
		
	ENDPROC

	PROCEDURE Init
		dodefault()
		public pnmetodo, pdfechavto
		pdfechavto = {}
		pnmetodo = 1
		
		* numeracion
		thisform.txt_nrosuc.value = _screen.oapp.cestablecimiento
		thisform.nro_exp.value  = _screen.oapp.cpuntoexpedicion
		
		thisform.txt_nrofactura.value = thisform.generar_factura(thisform.txt_nrosuc.value, thisform.nro_exp.value)
		thisform.grid_detalle()
	ENDPROC

	PROCEDURE limpiar_articulos
		WITH thisform
		
			.txt_cod_articulo.Value= ""
			.txt_descripcion.Value = ""
			.txt_planCuota.Value = ""
			.cbo_plazo.Clear()
			.txtplazo.Value=0
			.txt_cantidad.Value = 0
			.txt_precio_financiado.Value = 0
			.txt_subtotal.Value = 0
			
			*precios
			.txt_precio_contado.Value = 0
			.txtimpuesto.Value	=""
			.txt_cuota.Value = 0
			.txt_tipo.Value = ""
			
			.txtinteres.Value = 0
			.txt_margen.Value = 0
			.txt_cuota_aux.Value = 0
			.txt_precio_costo.Value = 0
			.txt_idarticulo.Value = 0
			
		ENDWITH 
	ENDPROC

	PROCEDURE llenar_cbo_plazo
		*Metodo llenar_cbo_plazo
		LOCAL lnRecCount
		
		* Limpiar el ComboBox
		thisform.cbo_plazo.Clear()
		
		* Configurar el ComboBox con columnas adicionales ocultas
		WITH thisform.cbo_plazo
		    .ColumnCount = 4  && Total de columnas: descripcion, tipo, orden, cuota
		    .ColumnWidths = "200,0,0,0"  && Solo la primera columna visible (ajusta el ancho según necesites)
		    .BoundColumn = 1  && La columna visible es la que se muestra
		    .RowSourceType = 0  && Ninguno, para agregar manualmente
		ENDWITH
		
		* Verificar que el cursor existe y tiene registros
		IF USED("cur_cuotas_calculados")
		    SELECT cur_cuotas_calculados
		    lnRecCount = RECCOUNT()
		    
		    IF lnRecCount > 0
		        GO TOP
		        
		        * Recorrer el cursor y agregar cada registro al ComboBox con todas sus columnas
		        SCAN
		            thisform.cbo_plazo.AddListItem(ALLTRIM(cur_cuotas_calculados.descripcion), ;
		            thisform.cbo_plazo.ListCount + 1, 1)
		            thisform.cbo_plazo.List(thisform.cbo_plazo.ListCount, 2) = ALLTRIM(cur_cuotas_calculados.tipo)
		            thisform.cbo_plazo.List(thisform.cbo_plazo.ListCount, 3) = TRANSFORM(cur_cuotas_calculados.orden)
		            thisform.cbo_plazo.List(thisform.cbo_plazo.ListCount, 4) = TRANSFORM(cur_cuotas_calculados.cuota)
		        ENDSCAN
		        
		        * Opcional: Seleccionar el primer elemento
		        thisform.cbo_plazo.ListIndex = 1
		        
		    ELSE
		        MESSAGEBOX("No hay datos para mostrar en el combo de plazos", 48, "Aviso")
		    ENDIF
		ELSE
		    MESSAGEBOX("El cursor cur_cuotas_calculados no está disponible", 16, "Error")
		ENDIF
		
		RETURN
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		
		CREATE CURSOR crstempdetalle(codArt c(45),cdesArt c(45),cplanCuota c(45),;
		 cplazo c(45), ncantcuota n(10), nmontocuota n(10,2), ctipo c(45),;
		 ncantart n(10),nprecio n(10),civa c(2), ngravadas_exenta n(10),ngravada_cinco n(10),ngravada_diez n(10),;
		 nSubtotal n(10), nidarticulo n(10),;
		 nprecosto n(10,2), ninteres n(10,2), nmargen n(10,2))
		
		CREATE CURSOR crstempcuotas(cOrdenCuota c(10), nOrdencuota n(10),;
		 dfechavto d(8), nmontocuota n(10), ncuotasaldo n(10))
		 
		 
	ENDPROC

	PROCEDURE obtener_ultima_fecha_vto
		local ldultimafecha
		
		if used('crstempcuotas') and reccount('crstempcuotas') > 0
			calculate max(dfechavto) for !empty(dfechavto) in crstempcuotas to ldultimafecha
		else
			ldultimafecha = {}
		endif
		
		return ldultimafecha
	ENDPROC

	PROCEDURE recalcular_financiamiento
	ENDPROC

	PROCEDURE sumar_excenta
		LOCAL lnExenta
		lnExenta= 0
		* Verificar si existe el cursor
		IF USED("crstempdetalle")
		    * Guardar el área de trabajo actual
		    LOCAL lcAreaAnterior
		    lcAreaAnterior = ALIAS()
		    
		    * Seleccionar el cursor temporal
		    SELECT crstempdetalle
		    
		    * Calcular la suma
		    SUM ngravadas_exenta TO lnExenta
		    
		    * Volver al área de trabajo anterior si existe
		    IF !EMPTY(lcAreaAnterior)
		        SELECT (lcAreaAnterior)
		    ENDIF
		ELSE
		    * Si no existe el cursor, el total es 0
		    lnExenta= 0
		ENDIF
		
		RETURN lnExenta
	ENDPROC

	PROCEDURE sumar_gravadas_cinco
		LOCAL lngravadas_cinco
		lngravadas_cinco= 0
		* Verificar si existe el cursor
		IF USED("crstempdetalle")
		    * Guardar el área de trabajo actual
		    LOCAL lcAreaAnterior
		    lcAreaAnterior = ALIAS()
		    
		    * Seleccionar el cursor temporal
		    SELECT crstempdetalle
		    
		    * Calcular la suma
		    SUM ngravada_cinco TO lngravadas_cinco
		    
		    * Volver al área de trabajo anterior si existe
		    IF !EMPTY(lcAreaAnterior)
		        SELECT (lcAreaAnterior)
		    ENDIF
		ELSE
		    * Si no existe el cursor, el total es 0
		    lngravadas_cinco= 0
		ENDIF
		
		RETURN lngravadas_cinco
	ENDPROC

	PROCEDURE sumar_gravadas_diez
		LOCAL lngravadas_diez
		lngravadas_diez= 0
		* Verificar si existe el cursor
		IF USED("crstempdetalle")
		    * Guardar el área de trabajo actual
		    LOCAL lcAreaAnterior
		    lcAreaAnterior = ALIAS()
		    
		    * Seleccionar el cursor temporal
		    SELECT crstempdetalle
		    
		    * Calcular la suma
		    SUM ngravada_diez TO lngravadas_diez
		    
		    * Volver al área de trabajo anterior si existe
		    IF !EMPTY(lcAreaAnterior)
		        SELECT (lcAreaAnterior)
		    ENDIF
		ELSE
		    * Si no existe el cursor, el total es 0
		    lngravadas_diez= 0
		ENDIF
		
		RETURN lngravadas_diez
	ENDPROC

	PROCEDURE sumar_totales
		* Método: CalcularTotal
		* Descripción: Suma el campo nSubtotal del cursor crstempdetalle
		* Retorna: El total calculado
		LOCAL lnTotal
		lnTotal = 0
		* Verificar si existe el cursor
		IF USED("crstempdetalle")
		    * Guardar el área de trabajo actual
		    LOCAL lcAreaAnterior
		    lcAreaAnterior = ALIAS()
		    
		    * Seleccionar el cursor temporal
		    SELECT crstempdetalle
		    
		    * Calcular la suma
		    SUM nSubtotal TO lnTotal
		    
		    * Volver al área de trabajo anterior si existe
		    IF !EMPTY(lcAreaAnterior)
		        SELECT (lcAreaAnterior)
		    ENDIF
		ELSE
		    * Si no existe el cursor, el total es 0
		    lnTotal = 0
		ENDIF
		
		RETURN lnTotal
	ENDPROC

