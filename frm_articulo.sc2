	PROCEDURE Init
		LPARAMETERS tipo,registro
		this.operacio=tipo
		this.registro=registro
		thisform.cmb_impuesto.ListIndex=1
		IF this.operacio='N'
			thisform.Caption="Nuevo Articulo"
			cexp="select MAX(idarticulo) as idarticulo from articulo"
			IF SQLEXEC(conexion,cexp,"cur_max")>0
				IF ISNULL(cur_max.idarticulo)
					thisform.txt_id.Value=1
				ELSE
					thisform.txt_id.Value=cur_max.idarticulo + 1
				ENDIF 
				thisform.txt_codInterno.Value=PADL(cur_max.idarticulo,5,"0")
			ELSE
			
				AERROR(ERR)
			ENDIF 
		ELSE
			thisform.Caption="Modificar Articulo"
			thisform.txt_id.Value=this.registro.idarticulo
			thisform.txt_codInterno.Value=this.registro.codbarra
			thisform.txt_descripcion.Value=this.registro.descripcion
			thisform.txt_codgrupo.Value=this.registro.idgrupo
			thisform.txt_grupo.Value=this.registro.grupo
			thisform.txt_codsubgrupo.Value=this.registro.idsubgrupo
			thisform.txt_subgrupo.Value=this.registro.subgrupo
			thisform.txt_codmarca.Value=this.registro.idmarca
			thisform.txt_marca.Value=this.registro.marca
			thisform.txt_codproveedor.Value=this.registro.idproveedor
			thisform.txt_proveedor.Value=this.registro.proveedor
			thisform.txt_pcosto.Value=this.registro.precio_costo
			thisform.txt_pcontado.Value=this.registro.precio_contado
			thisform.txt_stockminimo.Value=this.registro.stockminimo
			
			DO CASE 
				CASE thisform.registro.impuesto=10
					thisform.cmb_impuesto.ListIndex=1
				CASE thisform.registro.impuesto=5
					thisform.cmb_impuesto.ListIndex=2
					
				OTHERWISE 
					thisform.cmb_impuesto.ListIndex=3
			ENDCASE 
		ENDIF 
	ENDPROC

	PROCEDURE Command1.Click
		DO buscar_grupo.app
		thisform.registro=lbuscar_grupo()
		IF vartype(thisform.registro)!="L" then
			thisform.txt_codgrupo.Value=thisform.registro.idgrupo
			thisform.txt_codgrupo.setfocus
		ENDIF 
	ENDPROC

	PROCEDURE Command10.Click
		DO proveedor.app
	ENDPROC

	PROCEDURE Command2.Click
		DO buscar_subgrupo.app
		thisform.registro=lbuscar_subgrupo(thisform.txt_codgrupo.Value)
		IF vartype(thisform.registro)!="L" then
			thisform.txt_codsubgrupo.Value=thisform.registro.idsubgrupo
			thisform.txt_codsubgrupo.setfocus
		ENDIF 
	ENDPROC

	PROCEDURE Command3.Click
		DO buscar_marca.app
		thisform.registro=lbuscar_marca()
		IF vartype(thisform.registro)!="L" then
			thisform.txt_codmarca.Value=thisform.registro.idmarca
			thisform.txt_codmarca.setfocus
		ENDIF 
	ENDPROC

	PROCEDURE Command4.Click
		DO buscar_proveedor.app
		thisform.registro=lbuscar_proveedor()
		IF vartype(thisform.registro)!="L" then
			thisform.txt_codproveedor.Value=thisform.registro.idproveedor
			thisform.txt_codproveedor.setfocus
		ENDIF 
	ENDPROC

	PROCEDURE Command5.Click
		**validar
		n_cant_controls=thisform.ControlCount
		FOR lnCnt=1 TO n_cant_controls
			IF thisform.Controls(lnCnt).tag="*" then
				IF EMPTY(thisform.Controls(lnCnt).value) then
					MESSAGEBOX("Llene los campos por favor..!!",064,"Atención")
					thisform.Controls(lnCnt).setfocus
					RETURN 
				ENDIF 
			ENDIF 
		NEXT
		******
		codigoArticulo=thisform.txt_id.Value
		codigoInterno=thisform.txt_codInterno.Value
		descripcionArticulo=alltrim(thisform.txt_descripcion.Value)
		codigoGrupo=thisform.txt_codgrupo.Value
		codigoSubgrupo=thisform.txt_codsubgrupo.Value
		codigoMarca=thisform.txt_codmarca.Value
		codigoProveedor=thisform.txt_codproveedor.Visible
		precioCosto=thisform.txt_pcosto.Value
		precioContado=thisform.txt_pcontado.Value
		stockMinimo=thisform.txt_stockminimo.Value
		IF thisform.cmb_impuesto.ListIndex=1
			impuestoArticulo=10
		ENDIF 
		IF thisform.cmb_impuesto.ListIndex=2
			impuestoArticulo=5
		ENDIF 
		
		IF thisform.cmb_impuesto.ListIndex=3
			impuestoArticulo=0
		ENDIF 
		
		IF thisform.operacio="N"
			TEXT TO sqlquery NOSHOW 
			 call amb_articulo("N"
			 ,?codigoArticulo
			 ,?descripcionArticulo
			 ,?codigoInterno
			 ,?impuestoArticulo
			 ,?precioCosto
			 ,?precioContado
			 ,1
			 ,?stockMinimo
			 ,?codigoMarca
			 ,?codigoGrupo
			 ,?codigoSubgrupo
			 ,?codigoProveedor)
			ENDTEXT 
			 
		ELSE
			TEXT TO sqlquery NOSHOW 
			 call amb_articulo("M"
			 ,?codigoArticulo
			 ,?descripcionArticulo
			 ,?codigoInterno
			 ,?impuestoArticulo
			 ,?precioCosto
			 ,?precioContado
			 ,1
			 ,?stockMinimo
			 ,?codigoMarca
			 ,?codigoGrupo
			 ,?codigoSubgrupo
			 ,?codigoProveedor)
			ENDTEXT 
			 
		ENDIF 
			IF sqlexec(conexion,sqlquery)<0
				DO error.app
			ELSE
				thisform.Release
			ENDIF 
			
			
	ENDPROC

	PROCEDURE Command6.Click
		thisform.Release
	ENDPROC

	PROCEDURE Command7.Click
		DO grupo.app
	ENDPROC

	PROCEDURE Command8.Click
		DO subgrupo.app
	ENDPROC

	PROCEDURE Command9.Click
		DO marca.app
	ENDPROC

	PROCEDURE txt_codgrupo.Valid
		IF NOT EMPTY(this.Value)
			cexp="select * from grupo where idgrupo= "+ALLTRIM(STR(this.Value,20,0))
			IF SQLEXEC(conexion,cexp,"cur_grupo")>0
				IF RECCOUNT("cur_grupo")>0
					thisform.txt_grupo.Value=cur_grupo.grupo
				ELSE
					MESSAGEBOX("Este grupo no existe...",016,"Atencion")
					thisform.txt_codgrupo.Value=cur_grupo.idgrupo
					thisform.txt_grupo.Value=cur_grupo.grupo
				ENDIF 
			ELSE
				DO error.app
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE txt_codInterno.Valid
		*!*	IF thisform.operacio="N"
		*!*		TEXT TO sqlconsulta NOSHOW
		*!*			SELECT idarticulo FROM articulo WHERE codbarra=?this.Value
		*!*		ENDTEXT 
		*!*		IF SQLEXEC(conexion,sqlconsulta,"cur_articulo_existente")>0
		*!*			IF RECCOUNT("cur_articulo_existente")>0
		*!*				MESSAGEBOX("Este codigo ya existe..",016,"Atención")
		*!*			ENDIF 
		*!*		ELSE
		*!*			DO error.app
		*!*		ENDIF 
		
		*!*	ENDIF 
	ENDPROC

	PROCEDURE txt_codmarca.Valid
		IF NOT EMPTY(this.Value)
			cexp="select * from marca where idmarca= "+ALLTRIM(STR(this.Value,20,0))
			IF SQLEXEC(conexion,cexp,"cur_marca")>0
				IF RECCOUNT("cur_marca")>0
					thisform.txt_marca.Value=cur_marca.marca
				ELSE
					MESSAGEBOX("Este Marca no existe...",016,"Atencion")
					thisform.txt_codmarca.Value=0
					thisform.txt_marca.Value=""
				ENDIF 
			ELSE
				DO error.app
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE txt_codproveedor.Valid
		IF NOT EMPTY(this.Value)
			cexp="select * from proveedor where idproveedor= "+ALLTRIM(STR(this.Value,20,0))
			IF SQLEXEC(conexion,cexp,"cur_proveedor")>0
				IF RECCOUNT("cur_proveedor")>0
					thisform.txt_proveedor.Value=cur_proveedor.proveedor
				ELSE
					MESSAGEBOX("Este proveedor no existe...",016,"Atencion")
					thisform.txt_codproveedor.Value=0
					thisform.txt_proveedor.Value=""
				ENDIF 
			ELSE
				AERROR(ERR)
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE txt_codsubgrupo.Valid
		IF NOT EMPTY(this.Value)
			cexp="select * from subgrupo where idsubgrupo= "+ALLTRIM(STR(this.Value,20,0))
			IF SQLEXEC(conexion,cexp,"cur_subgrupo")>0
				IF RECCOUNT("cur_subgrupo")>0
					thisform.txt_subgrupo.Value=cur_subgrupo.subgrupo
				ELSE
					MESSAGEBOX("Este subgrupo no existe...",016,"Atencion")
					thisform.txt_codsubgrupo.Value=0
					thisform.txt_subgrupo.Value=""
				ENDIF 
			ELSE
				DO error.app
			ENDIF 
		ENDIF 
	ENDPROC

ENDDEFINE
