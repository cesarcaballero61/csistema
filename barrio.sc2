	PROCEDURE Init
		lparameters tlinsert,tnidzona
		thisform.linsert = m.tlinsert
		
		SQLEXEC(conexion,"select * from v_barrio_zona","cur_barrio")
		GO top
		
		thisform.llenar_dato()
		thisform.llenar_grid()
		
		if thisform.linsert
			thisform.windowtype = 1
			thisform.btn_nuevo.click()
			thisform.txt_cod_zona.enabled = .f.
			
			thisform.txt_cod_zona.Value = tnidzona
			thisform.txt_cod_zona.LostFocus()	
			thisform.Refresh()
		endif
	ENDPROC

	PROCEDURE llenar_dato
		thisform.txt_codigo.Value=cur_barrio.idbarrio
		thisform.txt_barrio.Value=cur_barrio.barrio
		thisform.txt_cod_zona.Value = cur_barrio.idzona
		thisform.txt_zona.Value = cur_barrio.zona
		
	ENDPROC

	PROCEDURE llenar_grid
		WITH this.grid1
			.RecordSource="cur_barrio"
			.RecordSourceType= 1
			.fontsize=8
			.columncount=4
			
			.column1.header1.caption="Código"
			.column1.width=50
			.column1.alignment=0
			.column1.controlsource="idbarrio"
			
			.column2.header1.caption="Barrio"
			.column2.width=198
			.column2.controlsource="barrio"
			
			.column3.header1.caption="Id Zona"
			.column3.width=75
			.column3.alignment =0
			.column3.controlsource="idzona"
			
			.column4.header1.caption="Zona"
			.column4.width=180
			.column4.controlsource="zona"
		ENDWITH 
	ENDPROC

	PROCEDURE Unload
		if thisform.linsert
			return thisform.nretcod
		endif
	ENDPROC

	PROCEDURE btn_aceptar.Click
		local lnok, cap_cod, cap_barrio, cap_codzona, lncodnew, cap_tipo
		local array laerr[1]
		
		if empty(thisform.txt_barrio.value)
			messagebox("El campo de barrio no puede quedar vacio.", 16, "Aviso")
			thisform.txt_barrio.setfocus()
			RETURN 
		endif
		
		
		if empty(thisform.txt_cod_zona.value)
			messagebox("El campo de zona no puede quedar vacio.", 16, "Aviso")
			thisform.txt_cod_zona.setfocus()
			RETURN 
		endif
		
		cap_cod = thisform.txt_codigo.value
		cap_barrio = thisform.txt_barrio.value
		cap_codzona = thisform.txt_cod_zona.value
		cap_tipo = thisform.tipo
		
		
		= sqlexec(conexion, "START TRANSACTION")
		
		lnok = sqlexec(conexion, "call amb_barrio(?cap_tipo, ?cap_cod, ?cap_codzona, ?cap_barrio)")
		
		if lnok > 0
			if cap_tipo = "N"
				= sqlexec(conexion, "SELECT CAST(LAST_INSERT_ID() AS SIGNED) as new_id", "curNewId")
				
				if used("curNewId") and reccount("curNewId") > 0
					lncodnew = int(val(curnewid.new_id))
					use in curnewid
				else
					lncodnew = 0
				endif
			else
				lncodnew = cap_cod
			endif
		
			= sqlexec(conexion, "COMMIT")
			
			= sqlexec(conexion, "select * from v_barrio_zona", "cur_barrio")
		
		* Buscar el registro insertado/modificado
			select cur_barrio
			locate for idbarrio = lncodnew
			if not found()
				if cap_tipo = "N"
					go bottom in cur_barrio
				else
					go top in cur_barrio
				endif
			endif
		
			thisform.llenar_grid()
			thisform.llenar_dato()
			
			* MENSAJE DE ÉXITO
		    DO CASE
		        CASE cap_tipo = "N"
		            MESSAGEBOX("Barrio creado correctamente", 64, "Éxito")
		        CASE cap_tipo = "M"
		            MESSAGEBOX("Barrio modificado correctamente", 64, "Éxito")
		    ENDCASE
		
		else
		* ERROR EN LA EJECUCIÓN DEL SQLEXEC
			aerror(laerr)
			= sqlexec(conexion, "ROLLBACK")
			messagebox("Error de conexión: " + laerr[2], 16, "Error")
		endif
		
		
		
		if thisform.linsert
		
			thisform.nretcod = lncodnew
			thisform.release()
		else
			thisform.btn_nuevo.enabled 		= .t.
			thisform.btn_borrar.enabled 	= .t.
			thisform.btn_modificar.enabled 	=.t.
		
			thisform.btn_aceptar.enabled 	= .f.
			thisform.btn_cancelar.enabled 	= .f.
			thisform.txt_barrio.enabled 	= .f.
			thisform.txt_cod_zona.enabled 	=.f.
			thisform.cnt_navegacion.enabled = .t.
			thisform.grid1.enabled 			= .t.
			thisform.llenar_dato()
			thisform.llenar_grid()
			thisform.btn_nuevo.setfocus()
			
		endif
		
		
	ENDPROC

	PROCEDURE btn_borrar.Click
		local lnok
		
		if messagebox("Desea borrar este registro?", 36, "Aviso") = 6
		
				cap_cod = thisform.txt_codigo.value
				cap_barrio = thisform.txt_barrio.value
				cap_codzona = thisform.txt_cod_zona.value
			
			= sqlexec(conexion, "START TRANSACTION")
		
			lnok = sqlexec(conexion, "call amb_barrio('B', ?cap_cod, ?cap_codzona, ?cap_barrio)")
		
			if lnok > 0
				= sqlexec(conexion, "COMMIT")
				= sqlexec(conexion, "select * from v_barrio_zona", "cur_barrio")
				MESSAGEBOX("Registro eliminado correctamente", 64, "Éxito")
			else
				
				aerror(err)
				= sqlexec(conexion, "ROLLBACK")
				messagebox("Error ocurrido al borrar datos: " + err[2], 16, "Error")
			ENDIF
			
			SELECT cur_barrio
			GO top
			
			thisform.llenar_grid()
			thisform.llenar_dato()
		
		endif
		
	ENDPROC

	PROCEDURE btn_cancelar.Click
		thisform.btn_nuevo.enabled = .t.
		thisform.btn_modificar.enabled =.t.
		thisform.btn_borrar.enabled = .t.
		thisform.btn_aceptar.enabled = .f.
		thisform.btn_cancelar.enabled = .f.
		thisform.txt_barrio.enabled = .f.
		
		thisform.txt_cod_zona.enabled = .f.
		thisform.cnt_navegacion.enabled = .t.
		thisform.grid1.enabled = .t.
		go top
		thisform.llenar_dato()
		thisform.btn_nuevo.setfocus
	ENDPROC

	PROCEDURE btn_modificar.Click
		thisform.btn_nuevo.enabled = .f.
		thisform.btn_borrar.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		thisform.btn_aceptar.setfocus
		thisform.txt_barrio.enabled = .t.
		
		thisform.txt_cod_zona.enabled = .t.
		
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_barrio.setfocus
		
		thisform.tipo = "M"
	ENDPROC

	PROCEDURE btn_nuevo.Click
		this.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_borrar.enabled = .f.
		
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		thisform.txt_codigo.value 		= 0
		
		thisform.txt_cod_zona.enabled = .t.
		thisform.txt_cod_zona.value 	= 0
		thisform.txt_zona.value 		= ""
		
		
		thisform.txt_barrio.enabled = .t.
		thisform.txt_barrio.value = ""
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_barrio.setfocus
		
		thisform.tipo = "N"
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.Release
	ENDPROC

	PROCEDURE cnt_navegacion.btn_atras.Click
		 SELECT cur_barrio
		 IF  .NOT. BOF()
		    SKIP -1
		    IF BOF()
		       GOTO TOP
		       WAIT WINDOW NOWAIT "Estas en el primer registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh()
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_primero.Click
		SELECT cur_barrio
		GO top
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE cnt_navegacion.btn_siguiente.Click
		 SELECT cur_barrio
		 IF  .NOT. EOF()
		    SKIP
		    IF EOF()
		       GOTO BOTTOM
		       WAIT WINDOW NOWAIT "Estas en el último registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_ultimo.Click
		SELECT cur_barrio
		GO bottom
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		thisform.llenar_dato
	ENDPROC

	PROCEDURE Grid1.Click
		thisform.llenar_dato
	ENDPROC

	PROCEDURE txt_buscar.InteractiveChange
		dodefault()
		local lcbusqueda, lcfiltro, lcrecordsource, lacampos[1], lncampos, lni, lccampo
		
		* Obtener el texto de búsqueda (sin espacios al inicio/final)
		lcbusqueda = alltrim(upper(this.value))
		
		* Obtener el recordsource del grid
		lcrecordsource = thisform.grid1.recordsource
		
		if empty(lcbusqueda)
		* Si no hay texto de búsqueda, mostrar todos los registros
			if used(lcrecordsource)
				select (lcrecordsource)
				set filter to
				go top
			endif
		else
		* Verificar que exista la propiedad cCamposBusqueda
			if type("THISFORM.cCamposBusqueda") = "C" and !empty(thisform.ccamposbusqueda)
		
		* Dividir los campos por comas
				lncampos = alines(lacampos, strtran(thisform.ccamposbusqueda, " ", ""), 1, ",")
				lcfiltro = ""
		
		* Construir el filtro dinámicamente
				for lni = 1 to lncampos
					lccampo = alltrim(lacampos[lnI])
		
		* Verificar que el campo existe en el cursor
					if used(lcrecordsource)
						select (lcrecordsource)
						if type(lccampo) <> "U"
		
		* Agregar OR si no es el primer campo
							if !empty(lcfiltro)
								lcfiltro = lcfiltro + " OR "
							endif
		
		* Determinar el tipo de campo y construir la condición apropiada
							do case
								case type(lccampo) = "N"  && Campo numérico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(STR(" + lccampo + ")))"
		
								case type(lccampo) = "C"  && Campo de texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(" + lccampo + "))"
		
								case type(lccampo) = "D"  && Campo de fecha
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(DTOC(" + lccampo + "))"
		
								case type(lccampo) = "L"  && Campo lógico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(IIF(" + lccampo + ", 'TRUE', 'FALSE'))"
		
								otherwise  && Otros tipos, tratar como texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(TRANSFORM(" + lccampo + ")))"
							endcase
						endif
					endif
				next
		
		* Aplicar el filtro si se construyó correctamente
				if !empty(lcfiltro) and used(lcrecordsource)
					select (lcrecordsource)
					set filter to &lcfiltro
					go top
				endif
		
			else
		* Si no existe la propiedad, mostrar mensaje de error
				messagebox("La propiedad 'cCamposBusqueda' no está definida en el formulario.", 16, "Error de configuración")
			endif
		endif
		
		* Refrescar el grid
		thisform.grid1.refresh()
	ENDPROC

	PROCEDURE txt_cod_zona.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42 && buscar
			nodefault
			local loregistro as object
			do FORM bus_zona to loregistro
		
			if vartype(loregistro) <> "L"
				this.value = loregistro.idzona
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
		if m.nkeycode = 22 && insertar
			NODEFAULT
			do form zona with .t. to lnCodigo
			this.Value = IIF(!EMPTY(lnCodigo),lnCodigo,0)
		endif
	ENDPROC

	PROCEDURE txt_cod_zona.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnzonaID, lcSQL
		    
		    lnzonaID = this.Value
		    
		    lcSQL = "SELECT * FROM zona  WHERE idzona= " + ALLTRIM(STR(lnzonaID, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_zona") > 0
		        IF RECCOUNT("cur_zona") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_zona.idzona
					thisform.txt_zona.Value = cur_zona.zona
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Zona no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_zona.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar zona: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_zona.Value = ""
		ENDIF
	ENDPROC

ENDDEFINE
