	PROCEDURE Init
		lparameters tlinsert
		
		thisform.linsert = m.tlinsert
		
		IF sqlexec(conexion, "select * from v_deposito order by iddeposito", "cur_deposito")<0
		
			AERROR(loerr)
			MESSAGEBOX(loerr(2),16,"Aviso")
			RETURN 
		ENDIF 
		
		go top
		thisform.llenar_dato()
		thisform.llenar_grid()
		
		if thisform.linsert
			thisform.windowtype = 1
			thisform.btn_nuevo.click()
		endif
	ENDPROC

	PROCEDURE llenar_dato
		thisform.txt_codigo.Value=cur_deposito.iddeposito
		thisform.txt_deposito.Value=cur_deposito.deposito
		thisform.txt_cod_suc.Value=cur_deposito.idsucursal
		thisform.txt_sucursal.Value=cur_deposito.sucursal
		
	ENDPROC

	PROCEDURE llenar_grid
		WITH this.grid1
			.RecordSource="cur_deposito"
			.RecordSourceType= 1
			.fontsize=8
			.columncount=3
			
			.column1.header1.caption="Código"
			.column1.width=50
			.column1.alignment=0
			.column1.controlsource="iddeposito"
			
			.column2.header1.caption="Deposito"
			.column2.width=198
			.column2.controlsource="deposito"
			
			.column3.header1.caption="Sucursal"
			.column3.width=198
			.column3.controlsource="sucursal"
		ENDWITH 
	ENDPROC

	PROCEDURE Unload
		if thisform.linsert
			return thisform.nretcod
		endif
	ENDPROC

	PROCEDURE btn_aceptar.Click
		LOCAL lnok, cap_cod, cap_deposito, cap_cod_suc, lncodnew, cap_tipo
		LOCAL ARRAY laerr[1]
		
		cap_cod = thisform.txt_codigo.value
		cap_deposito = ALLTRIM(thisform.txt_deposito.value)
		cap_cod_suc = thisform.txt_cod_suc.value
		cap_tipo = thisform.tipo
		
		* VALIDACIONES DE CAMPOS OBLIGATORIOS
		IF EMPTY(cap_deposito)
		    MESSAGEBOX("El campo Depósito es obligatorio", 16, "Validación")
		    thisform.txt_deposito.setfocus()
		    RETURN
		ENDIF
		
		IF EMPTY(cap_cod_suc) OR cap_cod_suc = 0
		    MESSAGEBOX("Debe seleccionar una sucursal", 16, "Validación")
		    thisform.txt_cod_suc.setfocus()
		    RETURN
		ENDIF
		
		
		= SQLEXEC(conexion, "START TRANSACTION")
		
		* NOTA: Debes crear el procedimiento almacenado amb_deposito
		lnok = SQLEXEC(conexion, "call amb_deposito(?cap_tipo, ?cap_cod, ?cap_deposito, ?cap_cod_suc)")
		
		IF lnok > 0
			IF cap_tipo = "N"
				= SQLEXEC(conexion, "SELECT CAST(LAST_INSERT_ID() AS SIGNED) as new_id", "curNewId")
				IF USED("curNewId") AND RECCOUNT("curNewId") > 0
					lncodnew = INT(VAL(curNewId.new_id))
					USE IN curNewId
				ELSE
					lncodnew = 0
				ENDIF
			ELSE
				lncodnew = cap_cod
			ENDIF
		
			= SQLEXEC(conexion, "COMMIT")
			= SQLEXEC(conexion, "select * from v_deposito order by iddeposito", "cur_deposito")
		
			* BUSCAR EL REGISTRO INSERTADO/MODIFICADO
			SELECT cur_deposito
			LOCATE FOR iddeposito = lncodnew
			IF NOT FOUND()
				IF cap_tipo = "N"
					GO BOTTOM IN cur_deposito
				ELSE
					GO TOP IN cur_deposito
				ENDIF
			ENDIF
			
			thisform.llenar_grid()
			thisform.llenar_dato()
		
		ELSE
			* ERROR EN LA EJECUCIÓN DEL SQLEXEC
			AERROR(laerr)
			= SQLEXEC(conexion, "ROLLBACK")
			MESSAGEBOX("Error de conexión: " + laerr[2], 16, "Error")
		ENDIF
		
		IF thisform.linsert
			thisform.nretcod = lncodnew
			thisform.release()
		ELSE
			thisform.btn_nuevo.enabled = .t.
			thisform.btn_modificar.enabled = .t.
			thisform.btn_borrar.Enabled = .t.
			
			thisform.btn_aceptar.enabled = .f.
			thisform.btn_cancelar.enabled = .f.
			
			* BLOQUEAR CONTROLES DE LA IMAGEN
			thisform.txt_deposito.enabled = .f.
			thisform.txt_cod_suc.enabled = .f.
			thisform.txt_sucursal.enabled = .f.
			
			thisform.cnt_navegacion.enabled = .t.
			thisform.grid1.enabled = .t.
			
			thisform.llenar_dato()
			thisform.llenar_grid()
			thisform.btn_nuevo.setfocus()
		ENDIF
	ENDPROC

	PROCEDURE btn_borrar.Click
		LOCAL lnok
		
		IF MESSAGEBOX("¿Desea borrar este registro?", 36, "Aviso") = 6
		
			cap_cod = thisform.txt_codigo.value
			
			= SQLEXEC(conexion, "START TRANSACTION")
		
			* SOLO SE ENVÍAN EL TIPO 'B' Y EL CÓDIGO DEL DEPÓSITO
			lnok = SQLEXEC(conexion, "call amb_deposito('B', ?cap_cod, '', 0)")
		
			IF lnok > 0
				= SQLEXEC(conexion, "COMMIT")
				= SQLEXEC(conexion, "select * from v_deposito", "cur_deposito")
				MESSAGEBOX("Registro eliminado correctamente", 64, "Éxito")
			ELSE
				= SQLEXEC(conexion, "ROLLBACK")
				AERROR(err)
				MESSAGEBOX("Error ocurrido al borrar datos: " + err[2], 16, "Error")
			ENDIF
			
			SELECT cur_deposito
			GO TOP
			
			thisform.llenar_grid()
			thisform.llenar_dato()
			
			* RESTAURAR FORMULARIO A MODO CONSULTA
			thisform.btn_nuevo.enabled = .t.
			thisform.btn_modificar.enabled = .t.
			thisform.btn_borrar.enabled = .t.
			thisform.btn_aceptar.enabled = .f.
			thisform.btn_cancelar.enabled = .f.
			
			thisform.txt_deposito.enabled = .f.
			thisform.txt_cod_suc.enabled = .f.
			thisform.txt_sucursal.enabled = .f.
			
			thisform.cnt_navegacion.enabled = .t.
			thisform.grid1.enabled = .t.
			
			thisform.btn_nuevo.setfocus()
		
		ENDIF
	ENDPROC

	PROCEDURE btn_cancelar.Click
		thisform.btn_nuevo.enabled 		= .t.
		thisform.btn_modificar.enabled 	= .t.
		thisform.btn_aceptar.enabled 	= .f.
		thisform.btn_cancelar.enabled 	= .f.
		thisform.btn_borrar.enabled 	= .t.
		
		* BLOQUEAR CONTROLES DE LA IMAGEN
		thisform.txt_deposito.enabled 		= .f.
		thisform.txt_cod_suc.enabled 		= .f.
		thisform.txt_sucursal.enabled 		= .f.
		
		thisform.cnt_navegacion.enabled 	= .t.
		thisform.grid1.enabled 			= .t.
		
		if thisform.tipo = "N"
			select cur_deposito
			go top
		endif
		thisform.llenar_dato()
		thisform.btn_nuevo.setfocus()
	ENDPROC

	PROCEDURE btn_modificar.Click
		thisform.btn_nuevo.enabled = .f.
		thisform.btn_borrar.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		thisform.btn_aceptar.setfocus()
		thisform.txt_deposito.enabled = .t.
		thisform.txt_cod_suc.enabled = .t.
		thisform.txt_sucursal.enabled = .f.
		
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_deposito.setfocus
		
		thisform.tipo = "M"
	ENDPROC

	PROCEDURE btn_nuevo.Click
		this.Enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_borrar.Enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		thisform.txt_codigo.Value = 0
		thisform.txt_deposito.enabled = .t.
		thisform.txt_deposito.value = ""
		thisform.txt_cod_suc.enabled = .t.
		thisform.txt_cod_suc.value = 0
		thisform.txt_sucursal.enabled = .f. 
		thisform.txt_sucursal.value = "" 
		
		
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_deposito.setfocus
		
		thisform.tipo = "N"
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.Release
	ENDPROC

	PROCEDURE cnt_navegacion.btn_atras.Click
		 SELECT cur_deposito
		 IF  .NOT. BOF()
		    SKIP -1
		    IF BOF()
		       GOTO TOP
		       WAIT WINDOW NOWAIT "Estas en el primer registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh()
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_primero.Click
		SELECT cur_deposito
		GO top
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE cnt_navegacion.btn_siguiente.Click
		 SELECT cur_deposito
		 IF  .NOT. EOF()
		    SKIP
		    IF EOF()
		       GOTO BOTTOM
		       WAIT WINDOW NOWAIT "Estas en el último registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_ultimo.Click
		SELECT cur_deposito
		GO bottom
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		thisform.llenar_dato
	ENDPROC

	PROCEDURE Grid1.Click
		thisform.llenar_dato
	ENDPROC

	PROCEDURE txt_buscar.InteractiveChange
		dodefault()
		local lcbusqueda, lcfiltro, lcrecordsource, lacampos[1], lncampos, lni, lccampo
		
		* Obtener el texto de búsqueda (sin espacios al inicio/final)
		lcbusqueda = alltrim(upper(this.value))
		
		* Obtener el recordsource del grid
		lcrecordsource = thisform.grid1.recordsource
		
		if empty(lcbusqueda)
		* Si no hay texto de búsqueda, mostrar todos los registros
			if used(lcrecordsource)
				select (lcrecordsource)
				set filter to
				go top
			endif
		else
		* Verificar que exista la propiedad cCamposBusqueda
			if type("THISFORM.cCamposBusqueda") = "C" and !empty(thisform.ccamposbusqueda)
		
		* Dividir los campos por comas
				lncampos = alines(lacampos, strtran(thisform.ccamposbusqueda, " ", ""), 1, ",")
				lcfiltro = ""
		
		* Construir el filtro dinámicamente
				for lni = 1 to lncampos
					lccampo = alltrim(lacampos[lnI])
		
		* Verificar que el campo existe en el cursor
					if used(lcrecordsource)
						select (lcrecordsource)
						if type(lccampo) <> "U"
		
		* Agregar OR si no es el primer campo
							if !empty(lcfiltro)
								lcfiltro = lcfiltro + " OR "
							endif
		
		* Determinar el tipo de campo y construir la condición apropiada
							do case
								case type(lccampo) = "N"  && Campo numérico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(STR(" + lccampo + ")))"
		
								case type(lccampo) = "C"  && Campo de texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(" + lccampo + "))"
		
								case type(lccampo) = "D"  && Campo de fecha
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(DTOC(" + lccampo + "))"
		
								case type(lccampo) = "L"  && Campo lógico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(IIF(" + lccampo + ", 'TRUE', 'FALSE'))"
		
								otherwise  && Otros tipos, tratar como texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(TRANSFORM(" + lccampo + ")))"
							endcase
						endif
					endif
				next
		
		* Aplicar el filtro si se construyó correctamente
				if !empty(lcfiltro) and used(lcrecordsource)
					select (lcrecordsource)
					set filter to &lcfiltro
					go top
				endif
		
			else
		* Si no existe la propiedad, mostrar mensaje de error
				messagebox("La propiedad 'cCamposBusqueda' no está definida en el formulario.", 16, "Error de configuración")
			endif
		endif
		
		* Refrescar el grid
		thisform.grid1.refresh()
	ENDPROC

	PROCEDURE txt_cod_suc.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode = 42
			NODEFAULT 
			LOCAL loregistro
			DO FORM bus_sucursal TO loregistro
			
			IF VARTYPE(loregistro)<>"L"
				this.Value = loregistro.idsucursal
			ELSE
				this.Value = 0
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE txt_cod_suc.LostFocus
		IF NOT EMPTY(this.Value)
		    LOCAL lnidsucursal, lcSQL, lnResult
		    LOCAL ARRAY laError[1]
		    
		    lnidsucursal= this.Value
		    
		    lcSQL = "SELECT * FROM v_sucursal WHERE idsucursal = " + ALLTRIM(STR(lnidsucursal))
		    
		    lnResult = SQLEXEC(conexion, lcSQL, "cur_sucursal")
		    
		    IF lnResult > 0
		        IF RECCOUNT("cur_sucursal") > 0
		            WITH thisform
		                .txt_sucursal.Value = ALLTRIM(cur_sucursal.sucursal)
		            ENDWITH
		        ELSE
		            MESSAGEBOX("El sucursal con ID " + ALLTRIM(STR(lnidsucursal)) + " no existe.", 16, "Atención")
		            this.Value = 0
		            thisform.txt_sucursal.Value = ""
		        ENDIF
		    ELSE
		        AERROR(laError)
		        MESSAGEBOX("Error al consultar el sucursal: " + laError[2], 16, "Error")
		    ENDIF
		    
		    *-- Cerrar cursor temporal
		    IF USED("cur_sucursal")
		        USE IN cur_sucursal
		    ENDIF
		ELSE
			thisform.txt_sucursal.Value = ""
		ENDIF
	ENDPROC

ENDDEFINE
