	PROCEDURE gencuota_con_redondeo
		*-----------------------------------------------
		* Método: GenerarPlanPagos
		* Propósito: Genera un plan de pagos unificado con redondeo inteligente
		* Parámetros: tdFechaInicio - Fecha de inicio
		*-----------------------------------------------
		LPARAMETERS tdFechaInicio
		LOCAL lnMaxCuotas, lnCuota, lnImporteTotal, ldFechaVenc, lcOrdenCuota
		LOCAL lnImporteCuota, lnImporteUltimaCuota, lnTotalAcumulado, lnMontoCuotaRedondeado
		LOCAL lnTotalGeneral
		
		* Verificar que el cursor detalle existe
		IF !USED("crstempdetalle")
		    MESSAGEBOX("El cursor crstempdetalle no existe", 16, "Error")
		    RETURN .F.
		ENDIF
		
		* Limpiar el cursor de cuotas si existe
		IF USED("crstempcuotas")
		    SELECT crstempcuotas
		    ZAP
		ELSE
		    * Crear el cursor de cuotas si no existe
		    CREATE CURSOR crstempcuotas(cOrdenCuota c(10), nOrdencuota n(10),;
		          dfechavto d(8), nmontocuota n(10,2), ncuotasaldo n(10,2))
		ENDIF
		
		* Calcular el importe total general sumando todas las cuotas
		SELECT crstempdetalle
		lnTotalGeneral = 0
		SCAN
		    lnTotalGeneral = lnTotalGeneral + (nmontocuota * ncantcuota)
		ENDSCAN
		
		* Encontrar el número máximo de cuotas
		SELECT crstempdetalle
		lnMaxCuotas = 0
		SCAN
		    IF ncantcuota > lnMaxCuotas
		        lnMaxCuotas = ncantcuota
		    ENDIF
		ENDSCAN
		
		* Si no hay cuotas, salir
		IF lnMaxCuotas = 0
		    RETURN .T.
		ENDIF
		
		* Calcular importe de cuota base con redondeo
		* Primero intentamos redondear hacia arriba al múltiplo de 1000 más cercano
		* CEILING no existe en VFP, usamos INT() y agregamos 1 si hay residuo
		lnImporteCuota = INT((lnTotalGeneral / lnMaxCuotas) / 1000) * 1000
		IF MOD(lnTotalGeneral / lnMaxCuotas, 1000) > 0
		    lnImporteCuota = lnImporteCuota + 1000
		ENDIF
		
		lnTotalAcumulado = lnImporteCuota * (lnMaxCuotas - 1)
		
		* Verificar si el total acumulado supera el importe total
		IF lnTotalAcumulado >= lnTotalGeneral
		    * Si es así, obtenemos el múltiplo de 1000 inferior (FLOOR)
		    lnImporteCuota = INT((lnTotalGeneral / lnMaxCuotas) / 1000) * 1000
		ENDIF
		
		* Calcular el importe de la última cuota (aquí se carga la diferencia)
		lnImporteUltimaCuota = lnTotalGeneral - (lnImporteCuota * (lnMaxCuotas - 1))
		
		* Generar las cuotas unificadas
		FOR lnCuota = 1 TO lnMaxCuotas
		    * Determinar el importe de esta cuota
		    IF lnCuota = lnMaxCuotas
		        * Última cuota - lleva la diferencia
		        lnMontoCuotaRedondeado = lnImporteUltimaCuota
		    ELSE
		        * Cuotas normales - importe redondeado
		        lnMontoCuotaRedondeado = lnImporteCuota
		    ENDIF
		    
		    * Calcular fecha de vencimiento
		    ldFechaVenc = GOMONTH(tdFechaInicio, lnCuota - 1)
		    
		    * Ajustar a día hábil (Lun-Sáb)
		    ldFechaVenc = AjustarFechaHabil(ldFechaVenc)
		    
		    * Formatear el orden de cuota como "1/12", "2/12", etc.
		    lcOrdenCuota = ALLTRIM(STR(lnCuota)) + "/" + ALLTRIM(STR(lnMaxCuotas))
		    
		    * Insertar la cuota en el cursor resultado
		    SELECT crstempcuotas
		    APPEND BLANK
		    REPLACE cOrdenCuota WITH lcOrdenCuota,;
		            nOrdencuota WITH lnCuota,;
		            dfechavto WITH ldFechaVenc,;
		            nmontocuota WITH lnMontoCuotaRedondeado,;
		            ncuotasaldo WITH lnMontoCuotaRedondeado
		ENDFOR
		
		* Posicionar en el primer registro
		SELECT crstempcuotas
		GO TOP
		
		RETURN .T.
		
		
		
		
	ENDPROC

	PROCEDURE gencuota_sin_redondeo
		*-----------------------------------------------
		* metodo: GenerarPlanPagos
		* Propósito: Genera un plan de pagos unificado
		* Parámetros: tdFechaInicio - Fecha de inicio
		*-----------------------------------------------
		lparameters tdfechainicio
		local lnmaxcuotas, lncuota, lnimportetotal, ldfechavenc, lcordencuota
		
		* Verificar que el cursor detalle existe
		if !used("crstempdetalle")
			messagebox("El cursor crstempdetalle no existe", 16, "Error")
			return .f.
		endif
		
		* Limpiar el cursor de cuotas si existe
		if used("crstempcuotas")
			select crstempcuotas
			zap
		else
		* Crear el cursor de cuotas si no existe
			create cursor crstempcuotas(cordencuota c(10), nordencuota n(10),;
				  dfechavto d(8), nmontocuota n(10, 2), ncuotasaldo n(10, 2))
		endif
		
		* Encontrar el número máximo de cuotas
		select crstempdetalle
		lnmaxcuotas = 0
		scan
			if ncantcuota > lnmaxcuotas
				lnmaxcuotas = ncantcuota
			endif
		endscan
		
		* Si no hay cuotas, salir
		if lnmaxcuotas = 0
			return .t.
		endif
		
		* Generar las cuotas unificadas
		for lncuota = 1 to lnmaxcuotas
			lnimportetotal = 0
		
		* Recorrer el cursor detalle y sumar los importes
			select crstempdetalle
			scan
		* Si la cuota actual está dentro del plan del producto
				if lncuota <= ncantcuota
					lnimportetotal = lnimportetotal + nmontocuota
				endif
			endscan
		
		* Calcular fecha de vencimiento
			ldfechavenc = gomonth(tdfechainicio, lncuota - 1)
		
		* Ajustar a día hábil (Lun-Sáb)
			ldfechavenc = ajustarfechahabil(ldfechavenc)
		
		* Formatear el orden de cuota como "1/12", "2/12", etc.
			lcordencuota = alltrim(str(lncuota)) + "/" + alltrim(str(lnmaxcuotas))
		
		* Insertar la cuota en el cursor resultado
			select crstempcuotas
			append blank
			replace cordencuota with lcordencuota,;
				nordencuota with lncuota,;
				dfechavto with ldfechavenc,;
				nmontocuota with lnimportetotal,;
				ncuotasaldo with lnimportetotal
		endfor
		
		* Posicionar en el primer registro
		select crstempcuotas
		go top
		
		RETURN .t.
		
	ENDPROC

	PROCEDURE generarplanpagos
		*-----------------------------------------------
		* Método: GenerarPlanPagos
		* Propósito: Genera un plan de pagos unificado con redondeo inteligente
		* Parámetros: tdFechaInicio - Fecha de inicio
		*-----------------------------------------------
		LPARAMETERS tdFechaInicio
		LOCAL lnMaxCuotas, lnCuota, lnImporteTotal, ldFechaVenc, lcOrdenCuota
		LOCAL lnImporteCuota, lnImporteUltimaCuota, lnTotalAcumulado, lnMontoCuotaRedondeado
		LOCAL lnTotalGeneral
		
		* Verificar que el cursor detalle existe
		IF !USED("crstempdetalle")
		    MESSAGEBOX("El cursor crstempdetalle no existe", 16, "Error")
		    RETURN .F.
		ENDIF
		
		* Limpiar el cursor de cuotas si existe
		IF USED("crstempcuotas")
		    SELECT crstempcuotas
		    ZAP
		ELSE
		    * Crear el cursor de cuotas si no existe
		    CREATE CURSOR crstempcuotas(cOrdenCuota c(10), nOrdencuota n(10),;
		          dfechavto d(8), nmontocuota n(10,2), ncuotasaldo n(10,2))
		ENDIF
		
		* Calcular el importe total general sumando todas las cuotas
		SELECT crstempdetalle
		lnTotalGeneral = 0
		SCAN
		    lnTotalGeneral = lnTotalGeneral + (nmontocuota * ncantcuota)
		ENDSCAN
		
		* Encontrar el número máximo de cuotas
		SELECT crstempdetalle
		lnMaxCuotas = 0
		SCAN
		    IF ncantcuota > lnMaxCuotas
		        lnMaxCuotas = ncantcuota
		    ENDIF
		ENDSCAN
		
		* Si no hay cuotas, salir
		IF lnMaxCuotas = 0
		    RETURN .T.
		ENDIF
		
		* Calcular importe de cuota base con redondeo
		* Primero intentamos redondear hacia arriba al múltiplo de 1000 más cercano
		* CEILING no existe en VFP, usamos INT() y agregamos 1 si hay residuo
		lnImporteCuota = INT((lnTotalGeneral / lnMaxCuotas) / 1000) * 1000
		IF MOD(lnTotalGeneral / lnMaxCuotas, 1000) > 0
		    lnImporteCuota = lnImporteCuota + 1000
		ENDIF
		
		lnTotalAcumulado = lnImporteCuota * (lnMaxCuotas - 1)
		
		* Verificar si el total acumulado supera el importe total
		IF lnTotalAcumulado >= lnTotalGeneral
		    * Si es así, obtenemos el múltiplo de 1000 inferior (FLOOR)
		    lnImporteCuota = INT((lnTotalGeneral / lnMaxCuotas) / 1000) * 1000
		ENDIF
		
		* Calcular el importe de la última cuota (aquí se carga la diferencia)
		lnImporteUltimaCuota = lnTotalGeneral - (lnImporteCuota * (lnMaxCuotas - 1))
		
		* Generar las cuotas unificadas
		FOR lnCuota = 1 TO lnMaxCuotas
		    * Determinar el importe de esta cuota
		    IF lnCuota = lnMaxCuotas
		        * Última cuota - lleva la diferencia
		        lnMontoCuotaRedondeado = lnImporteUltimaCuota
		    ELSE
		        * Cuotas normales - importe redondeado
		        lnMontoCuotaRedondeado = lnImporteCuota
		    ENDIF
		    
		    * Calcular fecha de vencimiento
		    ldFechaVenc = GOMONTH(tdFechaInicio, lnCuota - 1)
		    
		    * Ajustar a día hábil (Lun-Sáb)
		    ldFechaVenc = AjustarFechaHabil(ldFechaVenc)
		    
		    * Formatear el orden de cuota como "1/12", "2/12", etc.
		    lcOrdenCuota = ALLTRIM(STR(lnCuota)) + "/" + ALLTRIM(STR(lnMaxCuotas))
		    
		    * Insertar la cuota en el cursor resultado
		    SELECT crstempcuotas
		    APPEND BLANK
		    REPLACE cOrdenCuota WITH lcOrdenCuota,;
		            nOrdencuota WITH lnCuota,;
		            dfechavto WITH ldFechaVenc,;
		            nmontocuota WITH lnMontoCuotaRedondeado,;
		            ncuotasaldo WITH lnMontoCuotaRedondeado
		ENDFOR
		
		* Posicionar en el primer registro
		SELECT crstempcuotas
		GO TOP
		
		RETURN .T.
		
		
		
		
	ENDPROC

	PROCEDURE grid_cuota
		WITH this.grdcuota
		    .RecordSource = ""
		    .RecordSourceType = 1
		    .RecordSource = "crstempcuotas"
		    
		    * Configurar el número de columnas
		    .ColumnCount = 5
		    
		    * ===== COLUMNA 1: Orden de Cuota (BLOQUEADA) =====
		    .Column1.Header1.Caption = "Cuota"
		    .Column1.Width = 80
		    .Column1.ControlSource = "crstempcuotas.cOrdenCuota"
		    .Column1.Alignment = 2  && Centrado
		    .Column1.ReadOnly = .T.
		    .Column1.BackColor = RGB(240, 240, 240)  && Gris claro para indicar bloqueado
		    
		    * ===== COLUMNA 2: Número de Orden (BLOQUEADA) =====
		    .Column2.Header1.Caption = "N° Orden"
		    .Column2.Width = 70
		    .Column2.ControlSource = "crstempcuotas.nOrdencuota"
		    .Column2.Alignment = 2  && Centrado
		    .Column2.ReadOnly = .T.
		    .Column2.BackColor = RGB(240, 240, 240)  && Gris claro para indicar bloqueado
		    
		    * ===== COLUMNA 3: Fecha de Vencimiento (EDITABLE) =====
		    .Column3.Header1.Caption = "Fecha Vto."
		    .Column3.Width = 90
		    .Column3.ControlSource = "crstempcuotas.dfechavto"
		    .Column3.Alignment = 2  && Centrado
		    .Column3.ReadOnly = .F.
		    .Column3.BackColor = RGB(255, 255, 255)  && Blanco para indicar editable
		    .Column3.DynamicBackColor = "IIF(RECNO('crstempcuotas')=RECNO(), RGB(255,255,200), RGB(255,255,255))"
		    
		    * ===== COLUMNA 4: Monto de Cuota (EDITABLE) =====
		    .Column4.Header1.Caption = "Monto Cuota"
		    .Column4.Width = 100
		    .Column4.ControlSource = "crstempcuotas.nmontocuota"
		    .Column4.Alignment = 1  && Derecha
		    .Column4.ReadOnly = .F.
		    .Column4.BackColor = RGB(255, 255, 255)  && Blanco para indicar editable
		    .Column4.DynamicBackColor = "IIF(RECNO('crstempcuotas')=RECNO(), RGB(255,255,200), RGB(255,255,255))"
		    .Column4.InputMask = "999,999,999.99"
		    
		    * ===== COLUMNA 5: Saldo de Cuota (BLOQUEADA) =====
		    .Column5.Header1.Caption = "Saldo"
		    .Column5.Width = 100
		    .Column5.ControlSource = "crstempcuotas.ncuotasaldo"
		    .Column5.Alignment = 1  && Derecha
		    .Column5.ReadOnly = .T.
		    .Column5.BackColor = RGB(240, 240, 240)  && Gris claro para indicar bloqueado
		    .Column5.InputMask = "999,999,999.99"
		    
		    * Configuración general de la grilla
		    *.ReadOnly = .F.  && La grilla debe permitir edición
		    .DeleteMark = .F.
		    .ScrollBars = 2  && Vertical
		    .RecordMark = .F.
		    .GridLines = 0  && Ambas
		    .HighLight = .T.
		    .AllowRowSizing = .F.
		    .AllowCellSelection = .T.  && Permitir selección de celdas individuales
		    
		    * Ajustar al ancho del contenido
		    .Refresh()
		    
		ENDWITH
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tniddatasesion
		
		SET DATASESSION TO tniddatasesion
		
		DODEFAULT()
		SELECT crstempcuotas
		GO top
		this.redraw()
		this.grid_cuota()
	ENDPROC

	PROCEDURE Unload
		RETURN thisform.lretok
	ENDPROC

	PROCEDURE btncuotas.Click
		if empty(thisform.txt_primera_fecha_vto.value)
			messagebox('Falta la Pirmera fecha de vto para generar cuotas', 16, "Avisto")
			thisform.txt_primera_fecha_vto.setfocus
			return
		endif
		
		
		if thisform.optmetodo.value = 1
			if thisform.gencuota_sin_redondeo(thisform.txt_primera_fecha_vto.value)
				thisform.grid_cuota()
			endif
		else
			if thisform.gencuota_con_redondeo(thisform.txt_primera_fecha_vto.value)
				thisform.grid_cuota()
			endif
		endif
	ENDPROC

	PROCEDURE Btnnorbase1.Click
		* Verificar que hay registros
		lnreccount = reccount()
		if lnreccount = 0
			messagebox("No hay registro para las cuotas", 16, "Aviso")
			return
		ENDIF
		
		SELECT crstempcuotas
		GO top
		SCAN
			replace crstempcuotas.ncuotasaldo WITH crstempcuotas.nmontocuota
		ENDSCAN  
		
		thisform.lretok = .t.
		thisform.Release()
	ENDPROC

	PROCEDURE Btnnorbase2.Click
		thisform.lretok = .f.
		thisform.Release()
	ENDPROC

	PROCEDURE grdcuota.Init
		NODEFAULT 
	ENDPROC

	PROCEDURE grdcuota.When
		NODEFAULT 
	ENDPROC

