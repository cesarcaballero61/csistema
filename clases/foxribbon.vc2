		*< END OBJECT: BaseClass="timer" />
	
	PROCEDURE Shape1.Init
		WITH THIS
			.BACKCOLOR = _SCREEN.oRibbon.ChangeColor(_SCREEN.oRibbon.BackColor1, _SCREEN.oRibbon.nFactorBackcolor)
			.BORDERCOLOR = _SCREEN.oRibbon.LinesColor
		ENDWITH
		
	ENDPROC

	PROCEDURE Shape2.Init
		WITH THIS
			.BACKCOLOR = _SCREEN.oRibbon.ShadowColor
		ENDWITH
		
	ENDPROC

	PROCEDURE Timer1.Timer
		THIS.PARENT.VISIBLE = .T.
		THIS.ENABLED = .F.
		
	ENDPROC

ENDDEFINE

DEFINE CLASS ribbonlabel AS label 
 	*< CLASSDATA: Baseclass="label" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: redraw
		*m: thisenabled
		*p: lfontalternate
		*p: _idtranslate
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoSize = .T.
		BackStyle = 0
		Caption = "Label1"
		Height = 17
		lfontalternate = .F.
		Name = "ribbonlabel"
		Width = 40
		_idtranslate = 
	*</PropValue>
	
	PROCEDURE Init
		THIS.ReDraw()
		
		
		
	ENDPROC

	PROCEDURE redraw
		WITH THIS
			.FORECOLOR = IIF(.lFontAlternate, _SCREEN.oRibbon.FontColorAlternate,_SCREEN.oRibbon.FontColor)
			.FONTNAME = _SCREEN.oRibbon.cFontName
		ENDWITH
		
		*--THIS.Caption translate
		LOCAL lcCaption
		WITH THIS
			IF !EMPTY(_SCREEN.oRibbon.LANGUAGE) AND !EMPTY(._IdTranslate)
				lcCaption = .CAPTION
				lcCaption = _SCREEN.oRibbon.Translate(._IdTranslate, .CAPTION)
				IF ISNULL(lcCaption)
					lcCaption = .CAPTION
				ENDIF
				.CAPTION = lcCaption
			ENDIF
		ENDWITH
		*--
		
	ENDPROC

	PROCEDURE thisenabled
		PARAMETERS tlEnabled
		WITH THIS
			IF PCOUNT() = 1
				.ENABLED = tlEnabled
			ENDIF
		ENDWITH
	ENDPROC

ENDDEFINE

