ENDDEFINE

DEFINE CLASS ribbonformmsgbox AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Timer1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="panel1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Image1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Ribbonlabel1" UniqueID="" Timestamp="" />

	*<PropValue>
		AlwaysOnTop = .T.
		BorderStyle = 0
		Caption = ""
		Desktop = .T.
		DoCreate = .T.
		Height = 120
		Left = 0
		MaxButton = .F.
		MinButton = .F.
		Name = "ribbonformmsgbox"
		ShowInTaskBar = .F.
		ShowWindow = 1
		TitleBar = 0
		Top = 0
		Width = 250
	*</PropValue>

	ADD OBJECT 'Image1' AS image WITH ;
		Height = 32, ;
		Left = 7, ;
		Name = "Image1", ;
		Picture = defaultimages\iimage.png, ;
		Top = 7, ;
		Width = 32
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'panel1' AS _panel WITH ;
		Height = 22, ;
		Left = -2, ;
		lshadow = .F., ;
		Name = "panel1", ;
		Top = -2, ;
		Width = 254, ;
		_SHAPE1.Name = "_SHAPE1", ;
		RIBBONLABEL1.Height = 17, ;
		RIBBONLABEL1.Left = 3, ;
		RIBBONLABEL1.Name = "RIBBONLABEL1", ;
		RIBBONLABEL1.Top = 3, ;
		RIBBONLABEL1.Width = 248, ;
		_SHAPE2.Name = "_SHAPE2", ;
		_IMAGE1.Name = "_IMAGE1", ;
		SHADOW.Name = "SHADOW"
		*< END OBJECT: ClassLib="foxribbon.vcx" BaseClass="container" />

	ADD OBJECT 'Ribbonlabel1' AS ribbonlabel WITH ;
		Alignment = 2, ;
		AutoSize = .F., ;
		Height = 60, ;
		Left = 12, ;
		Name = "Ribbonlabel1", ;
		Top = 49, ;
		Width = 228, ;
		WordWrap = .T., ;
		ZOrderSet = 3
		*< END OBJECT: ClassLib="foxribbon.vcx" BaseClass="label" />

	ADD OBJECT 'Timer1' AS timer WITH ;
		Height = 23, ;
		Left = 146, ;
		Name = "Timer1", ;
		Top = 26, ;
		Width = 23
		*< END OBJECT: BaseClass="timer" />
	
	PROCEDURE Init
		PARAMETERS tcTitle, tcText, tnTime, tlBeep
		LOCAL lnTime, lnTrans
		lnTime = IIF(EMPTY(tnTime),(_SCREEN.oRibbon.nTimeMsgBox), tnTime)
		WITH THIS
			.BACKCOLOR = _SCREEN.oRibbon.FormBackColor
			.LEFT = SYSMETRIC(1) - .WIDTH - 30
			.TOP = SYSMETRIC(2) - .HEIGHT - 40
			.Panel1.RibbonLabel1.CAPTION = IIF(VARTYPE(tcTitle) = "C", tcTitle, "")
			.RibbonLabel1.CAPTION = IIF(VARTYPE(tcText) = "C", tcText, "")
			.Timer1.INTERVAL = lnTime
			IF _SCREEN.oRibbon.lBeepMsgBox OR tlBeep
				?? CHR(7)
			ENDIF
		ENDWITH
		
	ENDPROC

	PROCEDURE Timer1.Timer
		THISFORM.RELEASE()
		
	ENDPROC

ENDDEFINE

DEFINE CLASS ribbonformtime AS ribbonformbase OF "foxribbon.vcx" 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="h00" UniqueID="" Timestamp="" />
