			.BORDERCOLOR = _SCREEN.oRibbon.BackColor2
			.BACKCOLOR = _SCREEN.oRibbon.FormBackColor
			.ZORDER(1)
		ENDWITH
		
	ENDPROC

	PROCEDURE redraw
		WITH THIS
			.BORDERCOLOR = _SCREEN.oRibbon.BackColor2
			.BACKCOLOR = _SCREEN.oRibbon.FormBackColor
		ENDWITH
		
	ENDPROC

ENDDEFINE

