	PROCEDURE Init
		PARAMETERS tnLeft, tnTop, tnHWND, toTextBox, tdDate
		DODEFAULT(tnLeft, tnTop, tnHWND)
		WITH THIS
			.oTextBox = toTextBox
			._Calendar1.ThisDate = tdDate
			._Calendar1._Refresh()
			.SHOW()
		ENDWITH
		
		
		
		
	ENDPROC

	PROCEDURE otextbox_assign
		LPARAMETERS vNewVal
		*To do: Modify this routine for the Assign method
		THIS.otextbox = m.vNewVal
		
	ENDPROC

	PROCEDURE _calendar1.controldate
		PARAMETERS oDateValue
		THIS.PARENT.oTextBox.VALUE = oDateValue
		THISFORM.RELEASE
		
	ENDPROC

	PROCEDURE _calendar1.Ribboncommandbutton3.Click
		THIS.PARENT.PARENT.oTextBox.VALUE = {}
		THISFORM.RELEASE
	ENDPROC

	PROCEDURE _calendar1.RibbonDateTime.Click
		THIS.PARENT.PARENT.oTextBox.VALUE = DATE()
		THISFORM.RELEASE
	ENDPROC

ENDDEFINE

