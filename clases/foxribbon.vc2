DEFINE CLASS ribbon AS container 		&& Ribbon class
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Line2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Line1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Image1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Shape2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Line3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Line4" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Line5" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Line7" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Line8" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Line9" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Line6" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Line10" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label4" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label5" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Shape3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label6" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Timer1" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: redraw
		*m: setline
		*p: firsttabclick
		*p: yourstartbutton
		*p: yourstatusbar
		*p: yourtitlebar
	*</DefinedPropArrayMethod>

	*<PropValue>
		BackColor = 191,219,255
		firsttabclick = 
		Height = 149
		Name = "ribbon"
		SpecialEffect = 2
		Width = 800
		yourstartbutton = 
		yourstatusbar = 
		yourtitlebar = 
	*</PropValue>

	ADD OBJECT 'Image1' AS image WITH ;
		Height = 16, ;
		Left = -34, ;
		Name = "Image1", ;
		Stretch = 2, ;
		Top = 132, ;
		Width = 16
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'Label1' AS label WITH ;
		AutoSize = .T., ;
		Caption = "_TitleBar", ;
		Height = 17, ;
		Left = 3, ;
		Name = "Label1", ;
		Top = 7, ;
		Visible = .F., ;
		Width = 51
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label2' AS label WITH ;
		AutoSize = .T., ;
		Caption = "RibbonTabs zone", ;
		Height = 17, ;
		Left = 3, ;
		Name = "Label2", ;
		Top = 35, ;
		Visible = .F., ;
		Width = 99
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label3' AS label WITH ;
		AutoSize = .T., ;
		Caption = "RibbonGroups zone", ;
		Height = 17, ;
		Left = 3, ;
		Name = "Label3", ;
		Top = 92, ;
		Visible = .F., ;
		Width = 112
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label4' AS label WITH ;
		AutoSize = .T., ;
		Caption = "RibbonTabs zone", ;
		Height = 17, ;
		Left = 400, ;
		Name = "Label4", ;
		Top = 4, ;
		Visible = .F., ;
		Width = 99
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label5' AS label WITH ;
		AutoSize = .T., ;
		Caption = "RibbonGroups zone", ;
		Height = 17, ;
		Left = 400, ;
		Name = "Label5", ;
		Top = 60, ;
		Visible = .F., ;
		Width = 112
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Label6' AS label WITH ;
		AutoSize = .T., ;
		Caption = "Without wide _TitleBar", ;
		Height = 17, ;
		Left = 400, ;
		Name = "Label6", ;
		Top = 125, ;
		Visible = .F., ;
		Width = 124
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Line1' AS line WITH ;
		BorderColor = 255,0,0, ;
		Height = 0, ;
		Left = -40, ;
		Name = "Line1", ;
		Top = 52, ;
		Width = 36
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'Line10' AS line WITH ;
		Height = 0, ;
		Left = 400, ;
		Name = "Line10", ;
		Top = 118, ;
		Visible = .F., ;
		Width = 400
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'Line2' AS line WITH ;
		BorderColor = 255,0,0, ;
		Height = 0, ;
		Left = -40, ;
		Name = "Line2", ;
		Top = 52, ;
		Width = 36
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'Line3' AS line WITH ;
		Height = 0, ;
		Left = 0, ;
		Name = "Line3", ;
		Top = 30, ;
		Visible = .F., ;
		Width = 400
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'Line4' AS line WITH ;
		Height = 0, ;
		Left = 0, ;
		Name = "Line4", ;
		Top = 56, ;
		Visible = .F., ;
		Width = 400
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'Line5' AS line WITH ;
		Height = 0, ;
		Left = 0, ;
		Name = "Line5", ;
		Top = 59, ;
		Visible = .F., ;
		Width = 400
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'Line6' AS line WITH ;
		Height = 0, ;
		Left = 400, ;
		Name = "Line6", ;
		Top = 115, ;
		Visible = .F., ;
		Width = 400
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'Line7' AS line WITH ;
		Height = 0, ;
		Left = 0, ;
		Name = "Line7", ;
		Top = 145, ;
		Visible = .F., ;
		Width = 400
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'Line8' AS line WITH ;
		Height = 0, ;
		Left = 400, ;
		Name = "Line8", ;
		Top = 23, ;
		Visible = .F., ;
		Width = 400
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'Line9' AS line WITH ;
		Height = 0, ;
		Left = 400, ;
		Name = "Line9", ;
		Top = 26, ;
		Visible = .F., ;
		Width = 400
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackStyle = 0, ;
		Curvature = 5, ;
		Height = 94, ;
		Left = -216, ;
		Name = "Shape1", ;
		SpecialEffect = 1, ;
		Top = 120, ;
		Width = 213
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape2' AS shape WITH ;
		BorderStyle = 0, ;
		Height = 48, ;
		Left = -137, ;
		Name = "Shape2", ;
		SpecialEffect = 1, ;
		Top = 132, ;
		Width = 133
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape3' AS shape WITH ;
		BorderStyle = 0, ;
		Height = 29, ;
		Left = 400, ;
		Name = "Shape3", ;
		SpecialEffect = 1, ;
		Top = 119, ;
		Visible = .F., ;
		Width = 400
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Timer1' AS timer WITH ;
		Enabled = .F., ;
		Height = 23, ;
		Interval = 1, ;
		Left = -28, ;
		Name = "Timer1", ;
		Top = 60, ;
		Width = 23
		*< END OBJECT: BaseClass="timer" />
	
	PROCEDURE Init
		LOCAL lcMacro, lcPageClass
		WITH THIS
			.ADDPROPERTY("oLastClick" , "")
			.ADDPROPERTY("oLastPage" , "")
			.ADDPROPERTY("oPreviusPage" , "")
			IF !EMPTY(.YourTitlebar)
				lcMacro = "THISFORM.NEWOBJECT('" + .YourTitlebar + "', '" + .YourTitlebar +"')"
				&lcMacro
			ENDIF
			IF !EMPTY(.YourStartButton)
				lcMacro = "THISFORM.NEWOBJECT('" + .YourStartButton + "', '" + .YourStartButton +"')"
				&lcMacro
			ENDIF
			IF !EMPTY(.YourStatusBar)
				lcMacro = "THISFORM.NEWOBJECT('" + .YourStatusBar + "', '" + .YourStatusBar +"')"
				&lcMacro
			ENDIF
		
			.LEFT = 0
			.WIDTH = THISFORM.WIDTH
			.HEIGHT = THISFORM.HEIGHT
			.BORDERWIDTH = 0
			.BACKSTYLE = 0
			.ANCHOR = 15
			.ZORDER(1)
			THISFORM.BACKCOLOR = _SCREEN.oRibbon.FormBackColor
			THISFORM.MINWIDTH = 140
			THISFORM.MINHEIGHT = 25 + IIF(!EMPTY(.YourTitlebar), 30, 0) + IIF(!EMPTY(.YourStatusBar), 22, 0)
		ENDWITH
		
		WITH THIS.Shape2
			.LEFT = 0
			.TOP = 0
			.HEIGHT = 119 + IIF(!EMPTY(THIS.YourTitlebar), 30, 0)
			.WIDTH = THIS.PARENT.WIDTH
			.BACKCOLOR = _SCREEN.oRibbon.BackGround
			.ANCHOR = 10
		ENDWITH
		
		WITH THIS.Shape1
			.ZORDER(1)
			.LEFT = 2
			.TOP = 23 + IIF(!EMPTY(THIS.YourTitlebar), 30, 0)
			.HEIGHT = 94
			.WIDTH = THIS.PARENT.WIDTH - 4
			.BORDERCOLOR = _SCREEN.oRibbon.LinesColor
			.ANCHOR = 10
		ENDWITH
		
		WITH THIS.Image1
			.ZORDER(1)
			.LEFT = 3
			.TOP = 24 + IIF(!EMPTY(THIS.YourTitlebar), 30, 0)
			.HEIGHT = 92
			.WIDTH = THIS.PARENT.WIDTH - 6
			.PICTURE = _SCREEN.oRibbon.cFileBMP1
			.ANCHOR = 10
		ENDWITH
		
		WITH THIS.line1
			.TOP = THIS.Shape1.TOP
			.VISIBLE = .F.
			.ZORDER(0)
		ENDWITH
		
		WITH THIS.line2
			.TOP = THIS.Shape1.TOP - 1
			.VISIBLE = .F.
			.ZORDER(0)
		ENDWITH
		
		WITH THIS
			LOCAL lnI
			FOR lnI = 1 TO .CONTROLCOUNT
				IF .CONTROLS(lnI).CLASS == "Ribbontab"
					lcPageClass = .CONTROLS(lnI).PageClass
					IF !EMPTY(lcPageClass)
						.NEWOBJECT(lcPageClass, lcPageClass)
					ENDIF
					.CONTROLS(lnI).ZORDER(1)
				ENDIF
			ENDFOR
			IF !EMPTY(.FirstTabClick)
				lcMacro = "THIS." + .FirstTabClick + ".CLICK()"
				&lcMacro
			ENDIF
			.Shape2.ZORDER(1)
		ENDWITH
		
	ENDPROC

	PROCEDURE redraw
		LOCAL llOldLock
		llOldLock = THISFORM.LOCKSCREEN
		
		THISFORM.LOCKSCREEN = .T.
		
		WITH THIS
			THISFORM.BACKCOLOR = _SCREEN.oRibbon.FormBackColor
			.Image1.PICTURE = _SCREEN.oRibbon.cFileBMP1
			.Shape1.BORDERCOLOR = _SCREEN.oRibbon.LinesColor
			.Shape2.BACKCOLOR = _SCREEN.oRibbon.BackGround
			.Line1.BORDERCOLOR = _SCREEN.oRibbon.backcolor1
			.Line2.BORDERCOLOR = _SCREEN.oRibbon.backcolor1
		ENDWITH
		
		LOCAL lnI
		WITH THIS
			FOR lnI = 1 TO .CONTROLCOUNT
				IF .CONTROLS(lnI).PARENTCLASS == "Ribbonpage"
					.CONTROLS(lnI).ZORDER(0)
				ENDIF
				IF PEMSTATUS(.CONTROLS(lnI).CLASS, "redraw", 5)
					.CONTROLS(lnI).ReDraw()
				ENDIF
			ENDFOR
		ENDWITH
		
		WITH THISFORM
			LOCAL lnI
			FOR lnI = 1 TO .CONTROLCOUNT
				IF UPPER(.CONTROLS(lnI).NAME) # UPPER(THIS.NAME) AND PEMSTATUS(.CONTROLS(lnI).CLASS, "redraw", 5)
					.CONTROLS(lnI).ReDraw()
				ENDIF
			ENDFOR
		ENDWITH
		
		THISFORM.LOCKSCREEN = llOldLock
		
	ENDPROC

	PROCEDURE Resize
		LOCAL lcMacro
		IF VARTYPE(_SCREEN.oRibbon.LastOpenForm) = "O" AND ;
				(UPPER(_SCREEN.oRibbon.LastOpenForm.NAME) # "RIBBONFORMMSGBOX" AND ;
				UPPER(_SCREEN.oRibbon.LastOpenForm.NAME) # "RIBBONFORMWAIT")
			RELEASE WINDOWS (_SCREEN.oRibbon.LastOpenForm.NAME)
		ENDIF
		IF !EMPTY(THIS.YourStartButton)
			lcMacro = "THISFORM." + THIS.YourStartButton
			IF &lcMacro .HEIGHT # 38
				&lcMacro .CLICK()
			ENDIF
		ENDIF
		
	ENDPROC

	PROCEDURE setline
		PARAMETERS tnLeft, tnWidth
		WITH THIS.line1
			.VISIBLE = .F.
			.TOP = THIS.Shape1.TOP
			.LEFT = tnLeft
			.WIDTH = tnWidth
			.BORDERCOLOR = _SCREEN.oRibbon.backcolor1
			.ZORDER(0)
			.VISIBLE = .T.
		ENDWITH
		
		WITH THIS.line2
			.VISIBLE = .F.
			.TOP = THIS.Shape1.TOP - 1
			.LEFT = tnLeft + 1
			.WIDTH = tnWidth - 2
			.BORDERCOLOR = _SCREEN.oRibbon.backcolor1
			.ZORDER(0)
			.VISIBLE = .T.
		ENDWITH
		
	ENDPROC

	PROCEDURE Shape2.Click
		THIS.PARENT.CLICK()
		
	ENDPROC

	PROCEDURE Timer1.Timer
		LOCAL lcMacro, lcMacro2
		IF ! EMPTY(THIS.PARENT.oPreviuspage)
			lcMacro = "THIS.PARENT." + THIS.PARENT.oPreviuspage + ".VISIBLE = .T."
			&lcMacro
			lcMacro = "THIS.PARENT." + THIS.PARENT.oPreviuspage + ".LEFT"
			&lcMacro = &lcMacro - _SCREEN.oRibbon.AnimationFaster
		ENDIF
		
		lcMacro = "THIS.PARENT." + THIS.PARENT.oLastClick + ".PageClass"
		lcMacro2 = "THIS.PARENT." + &lcMacro + ".LEFT"
		
		&lcMacro2 = &lcMacro2 - _SCREEN.oRibbon.AnimationFaster
		
		IF &lcMacro2 <= 3
			&lcMacro2 = 3
			IF ! EMPTY(THIS.PARENT.oPreviuspage)
				lcMacro = "THIS.PARENT." + THIS.PARENT.oPreviuspage + ".VISIBLE = .F."
				&lcMacro
			ENDIF	
			THIS.ENABLED = .F.
		ENDIF
		
		
		
	ENDPROC

ENDDEFINE

DEFINE CLASS ribbon_groupseparator AS ribbonseparator OF "foxribbon.vcx" 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<PropValue>
		Height = 94
		Name = "ribbon_groupseparator"
		Line1.Height = 94
		Line1.Name = "Line1"
		Line2.Height = 94
		Line2.Name = "Line2"
		LINE3.Height = 94
		LINE3.Name = "LINE3"
	*</PropValue>
	
	PROCEDURE Init
		DODEFAULT()
		THIS.TOP = 0
	ENDPROC

	PROCEDURE redraw
		IF _SCREEN.oRibbon.SeeOutlineGroup
			THIS.VISIBLE = .F.
		ELSE
			THIS.VISIBLE = .T.
		ENDIF
		DODEFAULT()
		
	ENDPROC

ENDDEFINE

DEFINE CLASS ribbonbuttongroup AS ribbonbuttonv OF "foxribbon.vcx" 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="x1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="x2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="z1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="z2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="x6" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="x5" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="x4" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="x3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="z3" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="z4" UniqueID="" Timestamp="" />

	*<PropValue>
		BackColor = 255,128,0
		Height = 15
		Name = "ribbonbuttongroup"
		Visible = .F.
		Width = 15
		Image1.Height = 32
		Image1.Left = 48
		Image1.Name = "Image1"
		Image1.Top = 120
		Image1.Width = 32
		xShape2.Name = "xShape2"
		Shape1.Left = 3
		Shape1.Name = "Shape1"
		Shape1.Top = 85
		Command1.Left = 50
		Command1.Name = "Command1"
		Command1.Top = 72
		Image2.Left = 12
		Image2.Name = "Image2"
		Image2.Top = 75
		Ribbonlabel1.Left = 108
		Ribbonlabel1.Name = "Ribbonlabel1"
		Ribbonlabel1.Top = 120
		Ribbonlabel2.Name = "Ribbonlabel2"
		Marlett.Name = "Marlett"
	*</PropValue>

	ADD OBJECT 'x1' AS line WITH ;
		Height = 7, ;
		Left = 3, ;
		Name = "x1", ;
		Top = 3, ;
		Width = 0
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'x2' AS line WITH ;
		Height = 0, ;
		Left = 4, ;
		Name = "x2", ;
		Top = 3, ;
		Width = 6
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'x3' AS line WITH ;
		Height = 0, ;
		Left = 7, ;
		Name = "x3", ;
		Top = 7, ;
		Width = 1
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'x4' AS line WITH ;
		Height = 0, ;
		Left = 10, ;
		Name = "x4", ;
		Top = 7, ;
		Width = 1
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'x5' AS line WITH ;
		Height = 0, ;
		Left = 7, ;
		Name = "x5", ;
		Top = 10, ;
		Width = 1
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'x6' AS shape WITH ;
		BackColor = 100,100,100, ;
		Height = 3, ;
		Left = 8, ;
		Name = "x6", ;
		Top = 8, ;
		Width = 3
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'z1' AS line WITH ;
		BorderColor = 255,255,255, ;
		Height = 7, ;
		Left = 4, ;
		Name = "z1", ;
		Top = 4, ;
		Width = 0
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'z2' AS line WITH ;
		BorderColor = 255,255,255, ;
		Height = 0, ;
		Left = 5, ;
		Name = "z2", ;
		Top = 4, ;
		Width = 6
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'z3' AS line WITH ;
		BorderColor = 255,255,255, ;
		Height = 0, ;
		Left = 8, ;
		Name = "z3", ;
		Top = 11, ;
		Width = 4
		*< END OBJECT: BaseClass="line" />

	ADD OBJECT 'z4' AS line WITH ;
		BorderColor = 255,255,255, ;
		Height = 3, ;
		Left = 11, ;
		Name = "z4", ;
		Top = 8, ;
		Width = 0
		*< END OBJECT: BaseClass="line" />
	
	PROCEDURE Init
		DODEFAULT()
		THIS.ReDraw()
		
	ENDPROC

	PROCEDURE redraw
		LOCAL lnColor1, lnColor2
		DODEFAULT()
		lnColor1 = _SCREEN.oRibbon.ChangeColor(_SCREEN.oRibbon.BackGround, -25)
		lnColor2 = RGB(240,240,240)
		WITH THIS
			.x1.BORDERCOLOR = lnColor1
			.x2.BORDERCOLOR = lnColor1
			.x3.BORDERCOLOR = lnColor1
			.x4.BORDERCOLOR = lnColor1
			.x5.BORDERCOLOR = lnColor1
			.x6.BORDERCOLOR = lnColor1
			.x6.BACKCOLOR = lnColor1
			.z1.BORDERCOLOR = lnColor2
			.z2.BORDERCOLOR = lnColor2
			.z3.BORDERCOLOR = lnColor2
			.z4.BORDERCOLOR = lnColor2
		ENDWITH
		
	ENDPROC

ENDDEFINE

