		Image1.Height = 16
		Image1.Left = 6
		Image1.Name = "Image1"
		Image1.Picture = defaultimages\noimage16.bmp
		Image1.Top = 3
		Image1.Width = 16
		xShape2.Name = "xShape2"
		Shape1.Name = "Shape1"
		Command1.Name = "Command1"
		Image2.Name = "Image2"
		Ribbonlabel1.Alignment = 0
		Ribbonlabel1.AutoSize = .T.
		Ribbonlabel1.Left = 32
		Ribbonlabel1.Name = "Ribbonlabel1"
