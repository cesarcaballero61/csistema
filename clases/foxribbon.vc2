			.RibbonMenuSeparator2.HEIGHT = THIS.HEIGHT
			.RibbonMenuSeparator1.ZOrder(0)
			.RibbonMenuSeparator2.ZOrder(0)
			.ZORDER(1)
		ENDWITH
		
		
	ENDPROC

	PROCEDURE redraw
	ENDPROC

ENDDEFINE

DEFINE CLASS _borderform AS shape 
