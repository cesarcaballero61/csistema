DEFINE CLASS ribbonformwait AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="panel1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Image1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="_progressbar1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Ribbonlabel1" UniqueID="" Timestamp="" />

	*<PropValue>
		AlwaysOnTop = .T.
		BorderStyle = 0
		Caption = ""
		Desktop = .T.
		DoCreate = .T.
		Height = 90
		Left = 0
		Name = "ribbonformwait"
		ShowInTaskBar = .F.
		ShowWindow = 1
		TitleBar = 0
		Top = 0
		Width = 250
	*</PropValue>

	ADD OBJECT '_progressbar1' AS _progressbar WITH ;
		Height = 16, ;
		Left = 12, ;
		Name = "_progressbar1", ;
		Top = 67, ;
		Visible = .F., ;
		Width = 226, ;
		SHAPE1.Name = "SHAPE1", ;
		IMAGE1.Name = "IMAGE1", ;
		RIBBONLABEL1.Left = 3, ;
		RIBBONLABEL1.Name = "RIBBONLABEL1", ;
		RIBBONLABEL1.Top = 1, ;
		RIBBONLABEL1.Width = 129
		*< END OBJECT: ClassLib="foxribbon.vcx" BaseClass="container" />

	ADD OBJECT 'Image1' AS image WITH ;
		Height = 32, ;
		Left = 8, ;
		Name = "Image1", ;
		Picture = defaultimages\clock_run32.png, ;
		Top = 7, ;
		Width = 32
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'panel1' AS _panel WITH ;
		Height = 22, ;
		Left = -2, ;
		lshadow = .F., ;
		Name = "panel1", ;
		Top = -2, ;
		Width = 254, ;
		_SHAPE1.Name = "_SHAPE1", ;
		RIBBONLABEL1.Height = 17, ;
		RIBBONLABEL1.Left = 3, ;
		RIBBONLABEL1.Name = "RIBBONLABEL1", ;
		RIBBONLABEL1.Top = 3, ;
		RIBBONLABEL1.Width = 248, ;
		_SHAPE2.Name = "_SHAPE2", ;
		_IMAGE1.Name = "_IMAGE1", ;
		SHADOW.Name = "SHADOW"
		*< END OBJECT: ClassLib="foxribbon.vcx" BaseClass="container" />

	ADD OBJECT 'Ribbonlabel1' AS ribbonlabel WITH ;
		Alignment = 2, ;
		AutoSize = .F., ;
		Height = 17, ;
		Left = 7, ;
		Name = "Ribbonlabel1", ;
		Top = 43, ;
		Width = 236, ;
		ZOrderSet = 3
		*< END OBJECT: ClassLib="foxribbon.vcx" BaseClass="label" />
	
	PROCEDURE Init
		PARAMETERS tcTitle, tcText
		
		WITH THIS
			.BACKCOLOR = _SCREEN.oRibbon.FormBackColor
			.LEFT = SYSMETRIC(1) - THIS.WIDTH - 30
			.TOP = 10
			.Panel1.RibbonLabel1.CAPTION = IIF(VARTYPE(tcTitle) = "C", tcTitle, "")
			.RibbonLabel1.CAPTION = IIF(VARTYPE(tcText) = "C", tcText, "")
		ENDWITH
		
	ENDPROC

ENDDEFINE

DEFINE CLASS ribbongroup AS container 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Shape1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Ribbonlabel1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Image1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="_Shape2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Ribbonbuttongroup1" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: redraw
		*m: thisenabled
	*</DefinedPropArrayMethod>

	*<PropValue>
		BackColor = 193,255,255
		Height = 88
		Name = "ribbongroup"
		Width = 287
	*</PropValue>

	ADD OBJECT '_Shape2' AS shape WITH ;
		BackStyle = 0, ;
		BorderColor = 192,192,192, ;
		Curvature = 2, ;
		Height = 15, ;
		Left = 73, ;
		Name = "_Shape2", ;
		Top = 129, ;
		Width = 98
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Image1' AS image WITH ;
		Height = 16, ;
		Left = -24, ;
		Name = "Image1", ;
		Stretch = 2, ;
		Top = 8, ;
		Width = 16
		*< END OBJECT: BaseClass="image" />

	ADD OBJECT 'Ribbonbuttongroup1' AS ribbonbuttongroup WITH ;
		Left = 3, ;
		Name = "Ribbonbuttongroup1", ;
		Top = 72, ;
		Image1.Height = 32, ;
		Image1.Name = "Image1", ;
		Image1.Width = 32, ;
		xShape2.Name = "xShape2", ;
		Shape1.Name = "Shape1", ;
		Command1.Name = "Command1", ;
		Image2.Name = "Image2", ;
		Ribbonlabel1.Name = "Ribbonlabel1", ;
		Ribbonlabel2.Name = "Ribbonlabel2", ;
		Marlett.Name = "Marlett", ;
		x1.Name = "x1", ;
		x2.Name = "x2", ;
		z1.Name = "z1", ;
		z2.Name = "z2", ;
		x6.Name = "x6", ;
		x5.Name = "x5", ;
		x4.Name = "x4", ;
		x3.Name = "x3", ;
		z3.Name = "z3", ;
		z4.Name = "z4"
		*< END OBJECT: ClassLib="foxribbon.vcx" BaseClass="container" />

	ADD OBJECT 'Ribbonlabel1' AS ribbonlabel WITH ;
		Alignment = 2, ;
		AutoSize = .F., ;
		BackStyle = 1, ;
		Height = 17, ;
		Left = 1, ;
		Name = "Ribbonlabel1", ;
		Top = 71, ;
		Width = 285
		*< END OBJECT: ClassLib="foxribbon.vcx" BaseClass="label" />

	ADD OBJECT 'Shape1' AS shape WITH ;
		BackStyle = 0, ;
		Curvature = 5, ;
		Height = 17, ;
		Left = 72, ;
		Name = "Shape1", ;
		Top = 104, ;
		Width = 100
		*< END OBJECT: BaseClass="shape" />
	
	PROCEDURE Init
		WITH THIS
			.BORDERWIDTH = 0
			.BACKSTYLE = 0
			.TOP = 2
			.ThisEnabled(.ENABLED)
		ENDWITH
		
		WITH THIS.Image1
			.ZORDER(1)
			.LEFT = 1
			.TOP = 1
			.HEIGHT = THIS.HEIGHT - IIF(_SCREEN.oRibbon.SeeOutlineGroup, 16, -40)
			.WIDTH = THIS.WIDTH - 2
			.PICTURE = _SCREEN.oRibbon.cFileBMP1
			.VISIBLE = .F.
		ENDWITH
		
		WITH THIS.shape1
			.TOP = 0
			.LEFT = 0
			.HEIGHT = THIS.HEIGHT
			.WIDTH = THIS.WIDTH
			.BORDERCOLOR = _SCREEN.oRibbon.LinesColor
			.VISIBLE = _SCREEN.oRibbon.SeeOutlineGroup
		ENDWITH
		
		WITH THIS._Shape2
			.TOP = 1
			.LEFT = 1
			.HEIGHT = THIS.HEIGHT - 2
			.WIDTH = THIS.WIDTH - 2
			.BORDERCOLOR = _SCREEN.oRibbon.BackColor1  
			.VISIBLE = _SCREEN.oRibbon.SeeOutlineGroup
		ENDWITH
		
		WITH THIS.Ribbonlabel1
			.ZORDER(0)
			.TOP = 71
			.LEFT = 2
			.HEIGHT = 15
			.WIDTH = THIS.WIDTH - 4
			.BACKCOLOR = _SCREEN.oRibbon.ChangeColor(_SCREEN.oRibbon.BackGround, 30)
			.CAPTION = .CAPTION + IIF(THIS.RibbonButtonGroup1.VISIBLE, SPACE(2), SPACE(0))
			.BACKSTYLE = IIF(_SCREEN.oRibbon.SeeOutlineGroup, 1, 0)
		ENDWITH
		
		WITH THIS.RibbonButtonGroup1
			.ZORDER(0)
			.TOP = 71
			.LEFT = THIS.WIDTH - 17
		ENDWITH
		
		
	ENDPROC

	PROCEDURE MouseEnter
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		THIS._Shape2.MOUSEENTER()
		
	ENDPROC

	PROCEDURE MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		THIS._Shape2.MOUSELEAVE()
	ENDPROC

	PROCEDURE redraw
		LOCAL lnI
		WITH THIS
			FOR lnI = 1 TO .CONTROLCOUNT
				IF PEMSTATUS(.CONTROLS(lnI).CLASS, "redraw", 5)
					.CONTROLS(lnI).ReDraw()
				ENDIF
			ENDFOR
		ENDWITH
		
		WITH THIS
			.Image1.HEIGHT = .HEIGHT - IIF(_SCREEN.oRibbon.SeeOutlineGroup, 16, -40)
			.Image1.PICTURE = _SCREEN.oRibbon.cFileBMP1
			.Image1.VISIBLE = .F.
			.Shape1.BORDERCOLOR = _SCREEN.oRibbon.LinesColor
			._Shape2.BORDERCOLOR = _SCREEN.oRibbon.BackColor1  
			.Shape1.VISIBLE = _SCREEN.oRibbon.SeeOutlineGroup
			._Shape2.VISIBLE = _SCREEN.oRibbon.SeeOutlineGroup
		ENDWITH
		
		WITH THIS.Ribbonlabel1
			.BACKCOLOR = _SCREEN.oRibbon.ChangeColor(_SCREEN.oRibbon.BackGround, 30)
			.BACKSTYLE = IIF(_SCREEN.oRibbon.SeeOutlineGroup, 1, 0)	
		ENDWITH
		
		
		
		
	ENDPROC

	PROCEDURE thisenabled
		PARAMETERS tlEnabled
		LOCAL lnI
		WITH THIS
			IF PCOUNT() = 1
				.ENABLED = tlEnabled
				FOR lnI = 1 TO .CONTROLCOUNT
					IF PEMSTATUS(.CONTROLS(lnI).CLASS, "thisenabled", 5)
						.CONTROLS(lnI).ThisEnabled(.ENABLED)
					ENDIF
				ENDFOR
			ENDIF
		ENDWITH
		
	ENDPROC

	PROCEDURE Ribbonlabel1.MouseEnter
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		THIS.PARENT._Shape2.MOUSEENTER()
		
	ENDPROC

	PROCEDURE Ribbonlabel1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		THIS.PARENT._Shape2.MOUSELEAVE()
		
	ENDPROC

	PROCEDURE Ribbonlabel1.redraw
		DODEFAULT()
		THIS.FORECOLOR = _SCREEN.oRibbon.TabFontColor
	ENDPROC

	PROCEDURE Shape1.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		THIS.PARENT._Shape2.MOUSELEAVE()
		
	ENDPROC

	PROCEDURE _Shape2.MouseEnter
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		WITH THIS
			.PARENT.PARENT.SETALL("VISIBLE", .T., "RIBBONGROUP")
			.PARENT.PARENT.SETALL("BACKCOLOR", _SCREEN.oRibbon.ChangeColor(_SCREEN.oRibbon.BackGround, 30), "RIBBONLABEL")
			.PARENT.Image1.VISIBLE = .T.
			.PARENT.RibbonLabel1.BACKCOLOR = _SCREEN.oRibbon.ChangeColor(_SCREEN.oRibbon.BackGround, 20)
		ENDWITH
		
	ENDPROC

	PROCEDURE _Shape2.MouseLeave
		LPARAMETERS nButton, nShift, nXCoord, nYCoord
		WITH THIS.PARENT
			.Image1.VISIBLE = .F.
			.RibbonLabel1.BACKCOLOR = _SCREEN.oRibbon.ChangeColor(_SCREEN.oRibbon.BackGround, 30)  
		ENDWITH
	ENDPROC

ENDDEFINE

DEFINE CLASS ribbonhelp AS container 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
