		Height = 72, ;
		Left = 0, ;
		Name = "Shape1", ;
		Top = 0, ;
		Width = 200
		*< END OBJECT: BaseClass="shape" />

	ADD OBJECT 'Shape2' AS shape WITH ;
		BackColor = 143,143,143, ;
		BorderColor = 163,163,163, ;
		BorderStyle = 0, ;
		Curvature = 5, ;
		Height = 63, ;
