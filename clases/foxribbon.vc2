			.Month8.RibbonLabel1.CAPTION  = PROPER(LEFT(_SCREEN.oRibbon.c_cMonthEx(DATE(2011, 8, 1)), 3))
			.Month9.RibbonLabel1.CAPTION  = PROPER(LEFT(_SCREEN.oRibbon.c_cMonthEx(DATE(2011, 9, 1)), 3))
			.Month10.RibbonLabel1.CAPTION = PROPER(LEFT(_SCREEN.oRibbon.c_cMonthEx(DATE(2011,10, 1)), 3))
