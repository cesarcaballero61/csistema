DEFINE CLASS vfphash AS custom 
 	*< CLASSDATA: Baseclass="custom" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: apideclarations
		*m: createhash
		*m: hash
		*m: hashfile
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "vfphash"
		Width = 19
	*</PropValue>
	
	HIDDEN PROCEDURE apideclarations
		Declare INTEGER CryptAcquireContextA ;
			IN WIN32API AS CryptAcquireContext ;
			LONG @hProvHandle, ;
			STRING  cContainer, ;
			STRING  cProvider, ;
			LONG nProvType, ;
			LONG nFlags
				
		Declare LONG CryptReleaseContext ;
			IN WIN32API AS CryptReleaseContext ;
			LONG hProvHandle, ;
			LONG nReserved
		
		Declare LONG CryptCreateHash ;
			IN WIN32API AS CryptCreateHash ;
			LONG hProviderHandle, ;
			LONG nALG_ID, ;
			LONG hKeyhandle, ;
			LONG nFlags, ;
			LONG @hCryptHashHandle
				
		Declare LONG CryptDestroyHash ;
			IN WIN32API AS CryptDestroyHash;
			LONG hKeyHandle
			
		Declare LONG CryptHashData ;
			IN WIN32API AS CryptHashData ;
			LONG hHashHandle, ;
			STRING  @cData, ;
			LONG nDataLen, ;
			LONG nFlags
			
		Declare Long CryptGetHashParam ;
			IN WIN32API ;
			LONG hHashHandle, LONG nParam, ;
			String @ cHashValue, LONG @ nHashSize, LONG nFlags
		
	ENDPROC

	HIDDEN PROCEDURE createhash
		LPARAMETERS tcData as String, tcAlgo as String
		#DEFINE PROV_RSA_FULL     1
		#DEFINE PROV_RSA_AES      24
		#DEFINE CRYPT_VERIFYCONTEXT   0xF0000000
		
		#DEFINE HP_HASHVAL        2
		#DEFINE HP_HASHSIZE       4
		
		#DEFINE ALG_TYPE_ANY      0
		#DEFINE ALG_CLASS_HASH    32768
		
		#DEFINE ALG_SID_MD2       1
		#DEFINE ALG_SID_MD4       2
		#DEFINE ALG_SID_MD5       3
		#DEFINE ALG_SID_SHA       4
		#DEFINE ALG_SID_SHA_256   12
		#DEFINE ALG_SID_SHA_384   13
		#DEFINE ALG_SID_SHA_512   14
		
		#DEFINE CALG_MD2          BITOR(ALG_CLASS_HASH, ALG_TYPE_ANY, ALG_SID_MD2)
		#DEFINE CALG_MD4          BITOR(ALG_CLASS_HASH, ALG_TYPE_ANY, ALG_SID_MD4)
		#DEFINE CALG_MD5          BITOR(ALG_CLASS_HASH, ALG_TYPE_ANY, ALG_SID_MD5)
		#DEFINE CALG_SHA          BITOR(ALG_CLASS_HASH, ALG_TYPE_ANY, ALG_SID_SHA)
		#DEFINE CALG_SHA_256      BITOR(ALG_CLASS_HASH, ALG_TYPE_ANY, ALG_SID_SHA_256)
		#DEFINE CALG_SHA_384      BITOR(ALG_CLASS_HASH, ALG_TYPE_ANY, ALG_SID_SHA_384)
		#DEFINE CALG_SHA_512      BITOR(ALG_CLASS_HASH, ALG_TYPE_ANY, ALG_SID_SHA_512)
		
		tcAlgo = LOWER(ALLTRIM(tcAlgo))
		LOCAL lngAlgID as Long
		DO CASE 
		CASE tcAlgo = "md5"
			lngAlgID = CALG_MD5	
		
		CASE tcAlgo = "sha1"
			lngAlgID = CALG_SHA
		
		CASE tcAlgo = "sha256"
			lngAlgID = CALG_SHA_256
		
		CASE tcAlgo = "sha384"
			lngAlgID = CALG_SHA_384
		
		CASE tcAlgo = "sha512"
			lngAlgID = CALG_SHA_512
		
		OTHERWISE 
			lngAlgID = CALG_SHA
		ENDCASE 
		
		LOCAL hProv, lcHashValue, hHash, lnLen
		hProv = 0
		hHash = 0
		lcHashValue = ""
		IF CryptAcquireContext(@hProv, Null, Null, IIF(lngAlgID >= CALG_SHA_256, PROV_RSA_AES, PROV_RSA_FULL), CRYPT_VERIFYCONTEXT) <> 0
			IF CryptCreateHash(hProv, lngAlgID, 0, 0, @hHash) <> 0
				lnLen = LEN(tcData)
				IF lnLen > 0 
				    lngResult = CryptHashData(hHash, tcData, lnLen, 0)
				ELSE
					lngResult = CryptHashData(hHash, 0, 0, 0)
				ENDIF
		        LOCAL nBufsize, cBuffer
		        nBufsize = 0
				=CryptGetHashParam(hHash, HP_HASHVAL, Null, @nBufsize, 0)
				cBuffer = REPLICATE(CHR(0), m.nBufsize)
				IF CryptGetHashParam(hHash, HP_HASHVAL, @cBuffer, @nBufsize, 0) <> 0
					lcHashValue = STRCONV(cBuffer,15)
				ENDIF
				IF hHash <> 0
					=CryptDestroyHash(hHash)
				ENDIF
			
			ENDIF
			=CryptReleaseContext(hProv, 0)
		ENDIF
		RETURN (LOWER(lcHashValue))
		
	ENDPROC

	PROCEDURE hash
		LPARAMETERS tcData as String, tcAlgo as String
		IF EMPTY(tcData) OR VARTYPE(tcData) <> "C"
			RETURN ""
		ENDIF
		RETURN this.createhash(tcData, tcAlgo)
	ENDPROC

	PROCEDURE hashfile
		LPARAMETERS tcFile as String, tcAlgo as String
		IF EMPTY(tcFile) OR VARTYPE(tcFile) <> "C"
			RETURN ""
		ENDIF
		IF !FILE(tcFile)
			RETURN ""
		ENDIF
		LOCAL lcData as String
		lcData = FILETOSTR(tcFile)
		RETURN this.createhash(lcData, tcAlgo)
	ENDPROC

	PROCEDURE Init
		*!*	;@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
		*!*	;	Ejemplo de cifrado de un string en:  MD5, SHA1, SHA256, SHA384, SHA512	*
		*!*	;	Clase:	vfphash.vcx														*
		*!*	;	Autor: 	<<Edwin Juarez>>												*
		*!*	;	Email: 	edwinjuarez24x@gmail.com										*
		*!*	;	Blog:	http://edwinjuarezdeveloper.blogspot.com/						*
		*!*	;	Fecha:	14/10/2019														*
		*!*	;	email:	edwinjuarez24x@gmail.com										*
		*!*	;@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
		
		*!*	Function Hash()
		*!*	Signature: Hash(cStringtoHash[, cHashType])
		*!*	Parameters:
		*!*	cStringtoHash – A plain text string you wish to have hashed
		*!*	cHashType – The type of hash function to generate. There are currently 5 different hash functions supported
		*!*	- MD5
		*!*	- SHA1 *Default
		*!*	- SHA256
		*!*	- SHA384
		*!*	- SHA512
		*!*	Return Value:
		*!*	Binary Character Data – the hash for cStringtoHash.
		
		*!*	Function HashFile()
		*!*	Signature: HashFile(cFileName[, cHashType])
		*!*	Parameters:
		*!*	cFileName – The fullpath and name of an existing file you wish to generate a message digest for
		*!*	cHashType – The type of hash function to generate. There are currently 5 different hash functions supported
		*!*	- MD5
		*!*	- SHA1 *Default
		*!*	- SHA256
		*!*	- SHA384
		*!*	- SHA512
		*!*	Return Value:
		*!*	Binary Character Data – the hash for cFileName.
		
		this.Apideclarations()
	ENDPROC

ENDDEFINE
