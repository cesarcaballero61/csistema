DEFINE CLASS menu AS container 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Trvw" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="imagen" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Label1" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: llenartree
	*</DefinedPropArrayMethod>

	*<PropValue>
		Anchor = 0
		BackColor = 64,0,64
		BackStyle = 1
		BorderWidth = 0
		Height = 480
		Name = "menu"
		Width = 284
	*</PropValue>

	ADD OBJECT 'imagen' AS olecontrol WITH ;
		Height = 100, ;
		Left = 114, ;
		Name = "imagen", ;
		Top = 108, ;
		Width = 100
		*< END OBJECT: BaseClass="olecontrol" OLEObject="c:\windows\syswow64\mscomctl.ocx" Value="" />

	ADD OBJECT 'Label1' AS label WITH ;
		Anchor = 6, ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		Caption = "Acerca de.", ;
		FontBold = .T., ;
		Height = 17, ;
		Left = 13, ;
		Name = "Label1", ;
		Top = 462, ;
		Width = 63
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Trvw' AS trvw WITH ;
		Anchor = 0, ;
		Height = 458, ;
		Left = 2, ;
		Name = "Trvw", ;
		Top = 1, ;
		Width = 262
		*< END OBJECT: ClassLib="menu_trvw.vcx" BaseClass="olecontrol" OLEObject="c:\windows\syswow64\mscomctl.ocx" Value="" />
	
	PROCEDURE Init
		this.llenartree()
	ENDPROC

	PROCEDURE llenartree
		
		SQLEXEC(conexion,"select * from menu","cur_menu")
		GO top
		this.TRVW.ImageList=this.imagen
		inicio=ALLTRIM(TRANSFORM(cur_menu.idmenu))+[_]
		nd=this.TRVW.Nodes
		nd.clear()
		IF RECCOUNT()>0 then
			SCAN 
				cKey=ALLTRIM(TRANSFORM(idmenu))+[_]
				c_parent=ALLTRIM(TRANSFORM(parent))+[_]
				ccomando=ALLTRIM(comando)
				cTexto=ALLTRIM(texto)
				
					IF cur_menu.parent = 0 && menu raiz
						nd.add(,cKey,cTexto,1)
					ELSE
						IF cur_menu.nd_carpeta = 1 && nodo carpeta
							nd.add(c_parent,4,cKey,cTexto,2)
						ELSE && formularios 
							nd.add(c_parent,4,cKey,cTexto,3)
						ENDIF 
					ENDIF 
					nd.item(ckey).tag=ccomando
					
			ENDSCAN
			
			nd.item(inicio).expanded=.t.
		ENDIF 
	ENDPROC

	PROCEDURE Trvw.NodeClick
		*** Evento ActiveX Control ***
		LPARAMETERS node
	ENDPROC

ENDDEFINE

