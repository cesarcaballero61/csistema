DEFINE CLASS frmbusqueda1 AS frmbase OF "controles.vcx" 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="_gradient1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Lblbase1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txtBuscar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="grdBuscar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Btncommandbase1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Btncommandbase2" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: montargrid		&& metodo para montar el grid.
		*p: campobusq1		&& campo de busqueda1
		*p: campobusq2		&& campo de busqueda2
		*p: ccamposgrd		&& nombre de los campos separados por coma "," para la grilla
		*p: cheadercaption		&& caption para los header para los campos.
		*p: cwidthcolumns		&& ancho de cada columna separado por coma ","
		*p: lcfilter		&& valor de busqueda
	*</DefinedPropArrayMethod>

	*<PropValue>
		BorderStyle = 3
		campobusq1 = 
		campobusq2 = 
		Caption = ""
		ccamposgrd = 
		cheadercaption = 
		cwidthcolumns = 
		Desktop = .T.
		DoCreate = .T.
		HalfHeightCaption = .F.
		Height = 455
		KeyPreview = .T.
		lcfilter = 
		MaxButton = .F.
		MinButton = .F.
		Name = "frmbusqueda1"
		ShowWindow = 1
		Width = 472
		WindowType = 1
	*</PropValue>

	ADD OBJECT '_gradient1' AS _gradient WITH ;
		Height = 36, ;
		Left = 0, ;
		Name = "_gradient1", ;
		Top = 0, ;
		Width = 36, ;
		ZOrderSet = 0, ;
		Image1.Name = "Image1"
		*< END OBJECT: ClassLib="foxribbon.vcx" BaseClass="container" />

	ADD OBJECT 'Btncommandbase1' AS btncommandbase WITH ;
		Height = 27, ;
		Left = 248, ;
		Name = "Btncommandbase1", ;
		Top = 396, ;
		Width = 108, ;
		Image1.Height = 16, ;
		Image1.Name = "Image1", ;
		Image1.Picture = ..\iconos\seleccionar.ico, ;
		Image1.Top = 5, ;
		Image1.Width = 16, ;
		xShape2.Name = "xShape2", ;
		Shape1.Name = "Shape1", ;
		Command1.Name = "Command1", ;
		Image2.Name = "Image2", ;
		Ribbonlabel1.Caption = "Seleccionar", ;
		Ribbonlabel1.FontSize = 8, ;
		Ribbonlabel1.Name = "Ribbonlabel1", ;
		Ribbonlabel2.Name = "Ribbonlabel2", ;
		Marlett.Name = "Marlett"
		*< END OBJECT: ClassLib="controles.vcx" BaseClass="container" />

	ADD OBJECT 'Btncommandbase2' AS btncommandbase WITH ;
		Height = 27, ;
		Left = 360, ;
		Name = "Btncommandbase2", ;
		Top = 396, ;
		Width = 108, ;
		Image1.Height = 16, ;
		Image1.Name = "Image1", ;
		Image1.Picture = ..\iconos\salir.ico, ;
		Image1.Top = 5, ;
		Image1.Width = 16, ;
		xShape2.Name = "xShape2", ;
		Shape1.Name = "Shape1", ;
		Command1.Name = "Command1", ;
		Image2.Name = "Image2", ;
		Ribbonlabel1.Caption = "Salir", ;
		Ribbonlabel1.FontSize = 8, ;
		Ribbonlabel1.Left = 28, ;
		Ribbonlabel1.Name = "Ribbonlabel1", ;
		Ribbonlabel1.Top = 5, ;
		Ribbonlabel2.Name = "Ribbonlabel2", ;
		Marlett.Name = "Marlett"
		*< END OBJECT: ClassLib="controles.vcx" BaseClass="container" />

	ADD OBJECT 'grdBuscar' AS gridbase WITH ;
		Height = 325, ;
		Left = 5, ;
		Name = "grdBuscar", ;
		Top = 59, ;
		Width = 461, ;
		ZOrderSet = 3
		*< END OBJECT: ClassLib="controles.vcx" BaseClass="grid" />

	ADD OBJECT 'Lblbase1' AS lblbase WITH ;
		Caption = "Buscar:", ;
		Left = 12, ;
		Name = "Lblbase1", ;
		Top = 5, ;
		ZOrderSet = 1
		*< END OBJECT: ClassLib="controles.vcx" BaseClass="label" />

	ADD OBJECT 'txtBuscar' AS txtbase WITH ;
		Left = 12, ;
		Name = "txtBuscar", ;
		Top = 24, ;
		Width = 252, ;
		ZOrderSet = 2
		*< END OBJECT: ClassLib="controles.vcx" BaseClass="textbox" />
	
	PROCEDURE Init
		lparameters tcUserClass
		this.cuoclass= tcUserClass
		
		
		if not empty(this.cuoclass)
			this.ouclass = newobject(this.cuoclass,this.cuoclass+".prg","",thisform.DataSessionId)
			for each ocoltable in this.ouclass.colTables 
				if ocoltable.item("nNivel")=1
					thisform.ccursor = ocoltable.item("cCursor")
				endif 
			endfor 
			this.ouclass.getall()
			this.montargrid()
			
		endif
		
		this._gradient1.Top 	= 0
		this._gradient1.Height 	= 0
		this._gradient1.Height 	= this.Height
		this._gradient1.Width 	= this.Width
		this._gradient1.redraw()
	ENDPROC

	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if thisform.ActiveControl.name="grdBuscar"
			if nKeyCode = 13
				nodefault
				thisform.Btncommandbase1.Click()
			endif
		endif
		
		
		if nKeyCode = 27
			nodefault 
			thisform.Release
		endif 
	ENDPROC

	PROCEDURE montargrid		&& metodo para montar el grid.
		local lnfldCount as Integer
		
		lnfldCount = getwordcount(this.ccamposgrd,",")
		this.grdBuscar.ColumnCount=lnfldCount 
		this.grdBuscar.RecordSourceType= 1
		this.grdBuscar.RecordSource=this.ccursor
		this.grdBuscar.ReadOnly=.t.
		for i = 1 to lnfldCount 
			
			*caption
			this.grdBuscar.Columns(i).header1.caption=alltrim(getwordnum(this.cheadercaption,i,","))
			*ancho columna
			this.grdBuscar.Columns(i).width =val(getwordnum(this.cwidthcolumns,i,","))
			*controlsource
			this.grdBuscar.Columns(i).controlsource=this.ccursor+"."+alltrim(getwordnum(this.ccamposgrd,i,","))
			
		endfor 
		this.grdBuscar.redraw()
	ENDPROC

	PROCEDURE Unload
		return thisform.xidentity
	ENDPROC

	PROCEDURE Btncommandbase1.Click
		local lcRetVal as String
		lcRetVal = thisform.ccursor+"."+thisform.campobusq1
		thisform.xidentity= &lcRetVal 
		thisform.Release()
	ENDPROC

	PROCEDURE Btncommandbase2.Click
		thisform.Release
	ENDPROC

	PROCEDURE txtBuscar.InteractiveChange
		thisform.lcfilter = lower(alltrim(this.Value))+"*"
		select (thisform.ccursor)
		lcFilter1 = thisform.ccursor+"."+thisform.campobusq1
		lcFilter2 = thisform.ccursor+"."+thisform.campobusq2
		set filter to like(thisform.lcfilter ,lower(&lcFilter2)) or like(thisform.lcfilter ,lower(&lcFilter1))
		thisform.grdBuscar.Refresh()
	ENDPROC

ENDDEFINE

