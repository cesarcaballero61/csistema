DEFINE CLASS txtbusqueda AS txtbase OF "controles.vcx" 
 	*< CLASSDATA: Baseclass="textbox" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*p: cfldisplay		&& Nombre de campo o expresion para mostrar como datos.
		*p: ctxtdisplay		&& Nombre de control textbox para mostrar los datos.
	*</DefinedPropArrayMethod>

	*<PropValue>
		cfldisplay = 
		ctxtdisplay = 
		Format = "!"
		Name = "txtbusqueda"
	*</PropValue>
	
	PROCEDURE KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nKeyCode = 42
			nodefault 
			local lcfrmExecute as String
			local lxAuxID as Variant
			lxAuxID = this.Value
			lcfrmExecute = this.cformbusqueda
			do form &lcfrmExecute  with this.cuoclass to this.Value
			if empty(this.Value)
				this.value=lxAuxID 
			endif 
			this.SetFocus
			release loUser,lcfrmExecute 
		endif 
	ENDPROC

ENDDEFINE
