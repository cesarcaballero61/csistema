	PROCEDURE ordenarcolumna
		local lccampo, lcalias, lcarchivoindice, lni, lccampofuente, imagen
		
		if aevents(laobjeto, 0) > 0
			lccampo = laobjeto[1].parent.controlsource
			lcalias = alias()
			try
				select (lcalias)
				lcarchivoindice = forceext("K" + lccampo, "IDX")
				if vartype(&lccampo) == "C"
					index on upper(&lccampo) to &lcarchivoindice
				else
					index on &lccampo to &lcarchivoindice
				endif
				if laobjeto[1].parent.tag == "A"
					set order to juststem(lcarchivoindice) descending
					laobjeto[1].parent.tag = "D"
					laobjeto[1].picture = locfile("ds.bmp")
				else
