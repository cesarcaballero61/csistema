		ControlSource = "_SCREEN.oRibbon.cFontName", ;
		Height = 22, ;
		Left = 423, ;
		Name = "xFont", ;
		Top = 121, ;
		Width = 216
		*< END OBJECT: ClassLib="controles.vcx" BaseClass="combobox" />
	
	PROCEDURE Btnhbase1.Click
		LOCAL lcFileIni
		
		lcSkip = CHR(13) + CHR(10)
		lcFileIni = _SCREEN.oRibbon.FileIni
		
		WITH _SCREEN.oRibbon
			IF !EMPTY(lcFileIni)
				IF FILE(lcFileIni)
					DELETE FILE (lcFileIni)
				ENDIF
				STRTOFILE(";" + REPLICATE("-", 50) + lcSkip, lcFileIni, 1)
				STRTOFILE("; _SCREEN.oRibon PROPERTIES " + lcSkip, lcFileIni, 1)
				STRTOFILE(";" + REPLICATE("-", 50) + lcSkip, lcFileIni, 1)
				STRTOFILE("; Class name : " + ._ClassName + lcSkip, lcFileIni, 1)
				STRTOFILE("; Version    : " + ._Version + lcSkip, lcFileIni, 1)
				STRTOFILE("; Date       : " + ._Date + lcSkip, lcFileIni, 1)
				STRTOFILE("; Author     : " + ._Author + lcSkip, lcFileIni, 1)
				STRTOFILE("; Email      : " + ._Email + lcSkip, lcFileIni, 1)
				STRTOFILE(";" + REPLICATE("-", 50) + lcSkip, lcFileIni, 1)
				STRTOFILE(lcSkip, lcFileIni, 1)
				.FileIni =  m.pcFolderStyle + "\" + JUSTFNAME(lcFileIni)
				.Settings()
			endif
		
			
		endwith
		this.Parent.Visible = .f.
		
		*-- ScreenShot
		WITH _SCREEN.SYSTEM.Drawing
			lnWidth = 450
			lnHeight = 334
			loSrcImage = .BITMAP.New(.BITMAP.FromScreen(THISFORM.HWND))
			loThumbnail = loSrcImage.GetThumbnailImage(lnWidth, lnHeight)
			loThumbnail.SAVE(SUBSTR(_SCREEN.oRibbon.FileIni, 1, LEN(_SCREEN.oRibbon.FileIni) - 4) + ".jpg", .Imaging.ImageFormat.JPEG)
		ENDWITH
		**--
	ENDPROC

	PROCEDURE Btnhbase2.Click
		this.Parent.Visible = .f.
	ENDPROC

	PROCEDURE Cmbbase1.Valid
		_SCREEN.oRibbon.nFactorBackColor = THIS.VALUE
		this.Parent.redraw()
		thisform.redraw()
	ENDPROC

	PROCEDURE Ribbonbuttonh1.Click
		LOCAL lnOldColor, lnColor
		lnOldColor = THIS._Shape.BACKCOLOR
		lnColor= GETCOLOR(lnOldColor)
		IF lnColor >= 0
			THIS._Shape.BACKCOLOR = lnColor
			_SCREEN.oRibbon.BackGround = lnColor
			IF lnOldColor # lnColor
				THIS.RibbonLabel1.INIT()
			ENDIF	
		ENDIF
		
	ENDPROC

