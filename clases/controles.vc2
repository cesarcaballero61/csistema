			endtry
		
			with thisform.gridbase1
				*--- Para que las flechitas se vean solamente en la columna que se ordenó
				for lni = 1 to .columncount
					lccampofuente = ".Column" + transform(lni) + ".ControlSource"
					if lccampo <> evaluate(lccampofuente)
						imagen = ".Column" + transform(lni) + ".Header1.Picture"
						&imagen = ""
					endif
				endfor
				*--- Se refresca la grilla para que el nuevo orden sea visible
				.refresh()
				.setfocus()
			endwith
		endif
	ENDPROC

	PROCEDURE When
		select (this.RecordSource)
		if this.lappened=.f.
			if eof()
				append blank
			endif
			this.lappened=.t.
		endif
		
	ENDPROC

ENDDEFINE

DEFINE CLASS imgbase AS image 
 	*< CLASSDATA: Baseclass="image" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<PropValue>
		Height = 63
		Name = "imgbase"
		Width = 100
	*</PropValue>

ENDDEFINE

DEFINE CLASS lblbase AS ribbonlabel OF "foxribbon.vcx" 
 	*< CLASSDATA: Baseclass="label" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<PropValue>
		AutoSize = .T.
		FontSize = 8
		Name = "lblbase"
	*</PropValue>

ENDDEFINE

DEFINE CLASS pagebase AS page 
 	*< CLASSDATA: Baseclass="page" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: redraw
	*</DefinedPropArrayMethod>

	*<PropValue>
		BackStyle = 1
		Caption = "Page1"
		Height = 199
		Name = "pagebase"
		Width = 199
	*</PropValue>
	
	PROCEDURE Init
		this.redraw()
	ENDPROC

	PROCEDURE redraw
		with this
			.BackColor = _Screen.oRIBBON.background
			.FontName = _screen.oRIBBON.cfontname
			.ForeColor = _Screen.oRIBBON.fontcolor
		endwith 
	ENDPROC

ENDDEFINE

DEFINE CLASS pgframebase AS pageframe 
 	*< CLASSDATA: Baseclass="pageframe" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: redraw
	*</DefinedPropArrayMethod>

	*<PropValue>
		ActivePage = 0
		ErasePage = .T.
		Height = 165
		MemberClass = "pagebase"
		MemberClassLibrary = controles.vcx
		Name = "pgframebase"
		PageCount = 0
		Width = 241
	*</PropValue>
	
	PROCEDURE Init
		this.redraw()
	ENDPROC

	PROCEDURE redraw
		with this
			*.BorderColor= _Screen.oRIBBON.background
		endwith 
	ENDPROC

ENDDEFINE

