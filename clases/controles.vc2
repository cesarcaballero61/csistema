DEFINE CLASS statusbarbase AS _statusbar OF "foxribbon.vcx" 
 	*< CLASSDATA: Baseclass="container" Timestamp="" Scale="Pixels" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Ribbonseparator1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="_progressbar1" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*m: setmessage		&& metodo para colocar el mensaje en la barra de estado
	*</DefinedPropArrayMethod>

	*<PropValue>
		Name = "statusbarbase"
		Ribbonlabel1.Caption = ""
		Ribbonlabel1.Name = "Ribbonlabel1"
		Line1.Name = "Line1"
		Image1.Name = "Image1"
		oresize.Name = "oresize"
		oresize.x1.Name = "x1"
		oresize.x2.Name = "x2"
		oresize.x3.Name = "x3"
		oresize.x4.Name = "x4"
		oresize.x5.Name = "x5"
		oresize.x6.Name = "x6"
		oresize.z1.Name = "z1"
		oresize.z2.Name = "z2"
		oresize.z3.Name = "z3"
		oresize.z4.Name = "z4"
		oresize.z5.Name = "z5"
		oresize.z6.Name = "z6"
	*</PropValue>

	ADD OBJECT '_progressbar1' AS _progressbar WITH ;
		Height = 19, ;
		Left = 562, ;
		Name = "_progressbar1", ;
		swapcolors = .T., ;
		Top = 1, ;
		Visible = .F., ;
		Width = 158, ;
		Shape1.Name = "Shape1", ;
		Image1.Name = "Image1", ;
		Ribbonlabel1.Height = 16, ;
		Ribbonlabel1.Left = 62, ;
		Ribbonlabel1.Name = "Ribbonlabel1", ;
		Ribbonlabel1.Top = 1, ;
		Ribbonlabel1.Width = 34
		*< END OBJECT: ClassLib="foxribbon.vcx" BaseClass="container" />

	ADD OBJECT 'Ribbonseparator1' AS ribbonseparator WITH ;
		Left = 556, ;
		Name = "Ribbonseparator1", ;
		Top = 0, ;
		Line1.Name = "Line1", ;
		Line2.Name = "Line2", ;
		Line3.Name = "Line3"
		*< END OBJECT: ClassLib="foxribbon.vcx" BaseClass="container" />
	
	PROCEDURE setmessage		&& metodo para colocar el mensaje en la barra de estado
		lparameters tcMessage
		this.ribbonlabel1.Caption=tcMessage
	ENDPROC

ENDDEFINE

DEFINE CLASS txtbase AS ribbontextbox OF "foxribbon.vcx" 
 	*< CLASSDATA: Baseclass="textbox" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: limpiarctl
		*p: cformbusqueda		&& especifica el nombre del formulario de busqueda
		*p: cmsgstatusbar		&& mensaje del status bar.
		*p: cstatusbarname		&& nombre del control status bar
		*p: ctipodato
		*p: cuoclass
		*p: lobligatorio
		*p: ouclass
	*</DefinedPropArrayMethod>

	*<PropValue>
		BackStyle = 1
		BorderStyle = 1
		cformbusqueda = 
		cmsgstatusbar = 
		cstatusbarname = Statusbar
		ctipodato = C
		cuoclass = 
		FontName = "Tahoma"
		FontSize = 8
		InputMask = ""
		lobligatorio = .F.
		MaxLength = 45
		Name = "txtbase"
		ouclass = null
		StrictDateEntry = 1
		Style = 0
		Themes = .F.
	*</PropValue>
	
	PROCEDURE GotFocus
		dodefault()
		if not empty(this.cmsgstatusbar)
			lcMacro = 'thisform.'+this.cstatusbarName+'.setMessage'+'("'+this.cmsgstatusbar+'")'
			&lcMacro
		endif 
	ENDPROC

	PROCEDURE limpiarctl
		do case
			case this.ctipodato = "C"
				this.Value=""
			case this.ctipodato = "N"
				this.Value=0
			case this.ctipodato = "D"
				this.Value={}
		endcase 
	ENDPROC

	PROCEDURE LostFocus
		dodefault()
		if not empty(this.cmsgstatusbar)
			lcMacro = 'thisform.'+this.cstatusbarName+'.setMessage'+'("'+'")'
			&lcMacro
		endif 
	ENDPROC

ENDDEFINE
