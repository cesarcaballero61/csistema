DEFINE CLASS frmbase AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="Pixels" Uniqueid="" />

	*<DefinedPropArrayMethod>
		*m: borrarregistro
		*m: ordenarcolumna
		*m: redraw
		*m: validarctl
		*p: ccodventana		&& código de la ventana
		*p: ccursor
		*p: cfldidentity		&& contendra el nombre del campo ID
		*p: cuoclass		&& nombre de la capa de usuario
		*p: nactualizar
		*p: nborrar		&& permiso para borrar
		*p: nejecutar		&& permiso de ejecucion.
		*p: nmodificar
		*p: nnivel		&& control de nivel de tablas.
		*p: nnuevo
		*p: ntipooperacion		&& bandera para determinar el tipo de operacion a realizar 0 exploracion, 1 insersion, 2 modificacion.
		*p: oacceso
		*p: ouclass		&& contiene la instancia de la clase  capa de usuario
		*p: xidentity		&& mantendra el id de la entidad
	*</DefinedPropArrayMethod>

	*<PropValue>
		AutoCenter = .T.
		Caption = "Form"
		ccodventana = 
		ccursor = 
		cfldidentity = 
		cuoclass = 
		DataSession = 2
		Desktop = .F.
		DoCreate = .T.
		HalfHeightCaption = .F.
		Height = 398
		Icon = ..\iconos\sigco.ico
		nactualizar = 0
		Name = "frmbase"
		nborrar = 0
		nejecutar = 0
		nmodificar = 0
		nnivel = 0
		nnuevo = 0
		ntipooperacion = 0
		oacceso = null
		ouclass = null
		ShowWindow = 1
		Themes = .T.
		Width = 680
		xidentity = 
	*</PropValue>
	
	PROCEDURE borrarregistro
	ENDPROC

	PROCEDURE Init
		
		*!*	local lcCriteria as String
		*!*	this.oAcceso = newobject("uoAcceso","uoAcceso.prg","",thisform.DataSessionId)
		
		*!*	lcCriteria = " accesos.codVentana = '"+alltrim(this.ccodventana)+"'"
		*!*	lcCriteria = lcCriteria + " and accesos.codUsuario = '"+alltrim(_Screen.oaPP.CCODUSUARIO)+"'"
		
		*!*	this.oAcceso.getAll(lcCriteria,"crsAccesos")
		
		*!*	if reccount("crsAccesos")>0
		*!*		this.nnuevo 	= crsAccesos.nuevo
		*!*		this.nmodificar = crsAccesos.modificar
		*!*		this.nborrar 	= crsAccesos.borrar
		*!*		this.nactualizar = crsAccesos.actualizar
		*!*	else
		*!*		warning("Este usuario no tiene registros de acceso")
		
		*!*		this.nnuevo 	= 0
		*!*		this.nmodificar = 0
		*!*		this.nborrar 	= 0
		*!*		this.nactualizar = 0
		*!*		
		*!*		
		*!*	endif 
		
		this.redraw()
	ENDPROC

	PROCEDURE Load
		*-- Evento LOAD de tu Clase Base (o de cada formulario)
		SET SYSFORMATS OFF
		SET SEPARATOR TO "."
		SET POINT TO ","
		SET CENTURY ON
		SET DATE BRITISH
		SET DELETED ON  && Muy importante en sesiones privadas para no ver registros borrados
	ENDPROC

	PROCEDURE ordenarcolumna
		local lccampo, lcalias, lcarchivoindice, lni, lccampofuente, imagen
		
		if aevents(laobjeto, 0) > 0
			lccampo = laobjeto[1].parent.controlsource
			lcalias = alias()
			try
				select (lcalias)
				lcarchivoindice = forceext("K" + lccampo, "IDX")
				if vartype(&lccampo) == "C"
					index on upper(&lccampo) to &lcarchivoindice
				else
					index on &lccampo to &lcarchivoindice
				endif
				if laobjeto[1].parent.tag == "A"
					set order to juststem(lcarchivoindice) descending
					laobjeto[1].parent.tag = "D"
					laobjeto[1].picture = locfile("ds.bmp")
				else
					laobjeto[1].parent.tag = "A"
					laobjeto[1].picture = locfile("acs.bmp")
				endif
				locate
			catch
				*--- Aquí hay que poner el manejo de errores
			endtry
		
			with thisform.gridbase1
				*--- Para que las flechitas se vean solamente en la columna que se ordenó
				for lni = 1 to .columncount
					lccampofuente = ".Column" + transform(lni) + ".ControlSource"
					if lccampo <> evaluate(lccampofuente)
						imagen = ".Column" + transform(lni) + ".Header1.Picture"
						&imagen = ""
					endif
				endfor
				*--- Se refresca la grilla para que el nuevo orden sea visible
				.refresh()
				.setfocus()
			endwith
		endif
	ENDPROC

	PROCEDURE redraw
		with this
			.BackColor = _Screen.ORIBBON.backcolor1
		endwith 
	ENDPROC

	PROCEDURE validarctl
		lparameters toControl as Object
		local llRetVal as Boolean
		llRetVal = .f.
		for each oControl in toControl.controls 
				do case 
					case oControl.baseclass="Textbox"
						if oControl.lObligatorio and empty(oControl.value)
							oControl.setfocus()
							llRetVal = .t.
							oControl.setfocus
							exit 
						endif 
					case oControl.baseclass="Combobox"
						if oControl.lObligatorio and empty(oControl.value)
							oControl.setfocus()
							llRetVal = .t.
							oControl.setfocus
							exit 
						endif 
					case oControl.baseclass="Container" or oControl.baseclass="Pageframe" or oControl.baseclass="Page"
						this.validarctl(oControl)
				endcase  
		endfor 
		return llRetVal 
	ENDPROC

ENDDEFINE

