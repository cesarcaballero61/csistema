	PROCEDURE Load
		DODEFAULT()
		SET SEPARATOR  TO "."
		SET POINT TO ","
	ENDPROC

	PROCEDURE btn_aceptar.Click
		local lddesde, ldhasta, lctipo_ranking, lntop
		local lcsql, lnresult, loexception
		
		IF EMPTY(thisform.fecha_desde.getvalue())
			messagebox("selecciones un rango de fecha desde, para procesar el informe!", 272, "Error")
			thisform.fecha_desde.setfocus()
			RETURN 
		ENDIF 
		
		IF EMPTY(thisform.fecha_hasta.getvalue())
			messagebox("selecciones un rango de fecha hasta, para procesar el informe!", 272, "Error")
			thisform.fecha_hasta.setfocus()
			RETURN 
		ENDIF 
		
		
		IF EMPTY(thisform.cbo_tipo_ranking.Value)
			messagebox("selecciones un tipo de ranking para procesar el informe!", 272, "Error")
			thisform.cbo_tipo_ranking.setfocus()
			RETURN 
		ENDIF 
		
		IF EMPTY(thisform.cbo_nro_top.value)
			messagebox("selecciones el to maximo de ranking para procesar el informe!", 272, "Error")
			thisform.cbo_nro_top.setfocus()
			RETURN 
		ENDIF 
		
		lddesde      		= fechatomysql(thisform.fecha_desde.getvalue())
		ldhasta     	 	= fechatomysql(thisform.fecha_hasta.getvalue())
		lctipo_ranking		= ALLTRIM(thisform.cbo_tipo_ranking.Value)
		lntop				= ALLTRIM(thisform.cbo_nro_top.Value)
		
		try
		* Construir la llamada al stored procedure
			lcsql = "CALL sp_ranking_articulos_vendidos('" + lddesde + "', '" + ldhasta + "', '" + ;
				lctipo_ranking + "', " + ;
				lntop + ", 0, 0)"
		
			* Ejecutar la consulta
			lnresult = sqlexec(conexion, lcsql, "curRanking_ventas")
		
			if lnresult > 0
				* Verificar si hay datos
				if reccount("curRanking_ventas") > 0
					* Imprimir el informe
					*REPORT FORM _informe_cobro_detallado.frx PREVIEW
					* Para imprimir directamente: 
					lddesde      = thisform.fecha_desde.getvalue()
					ldhasta      = thisform.fecha_hasta.getvalue()
					
					report form _informe_ranking_venta preview noconsole
				else
					messagebox("No se encontraron registros para los criterios especificados", 64, "Información")
				endif
			else
				messagebox("Error al ejecutar la consulta de ventas", 16, "Error")
			endif
		
		
		
		catch to loexception
			messagebox("Error: " + loexception.message, 16, "Error en consulta")
		endtry
		
	ENDPROC

	PROCEDURE btn_cancelar.Click
		THISFORM.Release()
	ENDPROC

ENDDEFINE
