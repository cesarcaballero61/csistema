	PROCEDURE Init
		SQLEXEC(conexion,"select * from v_personal order by idpersonal","cur_personal")
		GO top
		thisform.llenar_dato()
		thisform.llenar_grid()
	ENDPROC

	PROCEDURE llenar_dato
		thisform.txt_codigo.Value=cur_personal.idpersonal
		thisform.txt_nombre.Value=cur_personal.nombre
		thisform.txt_apellido.Value=cur_personal.apellido
		thisform.txt_Ci.Value=cur_personal.ci
		thisform.txt_telefono.Value=cur_personal.telefono
		thisform.txt_direccion.Value=cur_personal.direccion
		thisform.txt_cod_sucursal.Value=cur_personal.idsucursal
		thisform.txt_sucursal.Value=cur_personal.sucursal
	ENDPROC

	PROCEDURE llenar_grid
		WITH this.grid1
			.RecordSource="cur_personal"
			.RecordSourceType= 1
			.fontsize=8
			.columncount=7
			
			.column1.header1.caption="Código"
			.column1.width=50
			.column1.alignment=0
			.column1.controlsource="idpersonal"
			
			.column2.header1.caption="Nombre"
			.column2.width=198
			.column2.controlsource="nombre"
			
			.column3.header1.caption="Apellido"
			.column3.width=198
			.column3.controlsource="apellido"
		
			.column4.header1.caption="Cedula"
			.column4.width=75
			.column4.controlsource="ci"
		
			.column5.header1.caption="Direccion"
			.column5.width=75
			.column5.controlsource="direccion"
		
			.column6.header1.caption="Telefono"
			.column6.width=75
			.column6.controlsource="telefono"
			
			.column7.header1.caption="Sucursal"
			.column7.width=100
			.column7.controlsource="telefono"
		ENDWITH 
	ENDPROC

	PROCEDURE Unload
		if thisform.linsert
			return thisform.nretcod
		endif
	ENDPROC

	PROCEDURE btn_aceptar.Click
		local lnok, cap_cod, cap_nombre, cap_apellido, cap_ci, cap_telefono, cap_direccion, cap_idsucursal, lncodnew
		local array laerr[1]
		
		* Validaciones de campos obligatorios
		if empty(thisform.txt_nombre.value)
		    messagebox("Debes indicar un nombre!", 272, "Error")
		    thisform.txt_nombre.setfocus
		    return
		endif
		
		if empty(thisform.txt_apellido.value)
		    messagebox("Debes indicar un apellido!", 272, "Error")
		    thisform.txt_apellido.setfocus
		    return
		endif
		
		if empty(thisform.txt_ci.value)
		    messagebox("Debes indicar una cédula de identidad!", 272, "Error")
		    thisform.txt_ci.setfocus
		    return
		ENDIF
		
		if empty(thisform.txt_cod_sucursal.value)
		    messagebox("Debes indicar la sucursal del personal!", 272, "Error")
		    thisform.txt_cod_sucursal.setfocus
		    return
		endif
		
		* Asignar valores desde los textboxes
		cap_codigo 		= thisform.txt_codigo.value
		cap_nombre	 	= thisform.txt_nombre.value
		cap_apellido 	= thisform.txt_apellido.value
		cap_ci 			= thisform.txt_ci.value
		cap_telefono 	= thisform.txt_telefono.value
		cap_direccion 	= thisform.txt_direccion.value
		cap_idsucursal 	= thisform.txt_cod_sucursal.Value
		
		cap_tipo = thisform.tipo
		
		= sqlexec(conexion, "START TRANSACTION")
		
		* Llamar al stored procedure amb_personal
		lnok = sqlexec(conexion, "call amb_personal(?cap_tipo, ?cap_codigo,";
		 +"?cap_nombre, ?cap_apellido, ?cap_ci, ?cap_telefono, ?cap_direccion, ?cap_idsucursal)")
		
		if lnok > 0
		    if cap_tipo = "N"
		        = sqlexec(conexion, "SELECT CAST(LAST_INSERT_ID() AS SIGNED) as new_id", "curNewId")
		        if used("curNewId") and reccount("curNewId") > 0
		            lncodnew = int(val(curnewid.new_id))
		            use in curnewid
		        else
		            lncodnew = 0
		        endif
		    else
		        lncodnew = cap_codigo
		    endif
		
		    = sqlexec(conexion, "COMMIT")
		    = sqlexec(conexion, "select * from v_personal order by idPersonal", "cur_personal")
		
		    * Buscar el registro insertado/modificado
		    select cur_personal
		    locate for idPersonal = lncodnew
		    if not found()
		        if cap_tipo = "N"
		            go bottom in cur_personal
		        else
		            go top in cur_personal
		        endif
		    endif
		
		    thisform.llenar_grid()
		    thisform.llenar_dato()
		
		else
		    * ERROR EN LA EJECUCIÓN DEL SQLEXEC
		    aerror(laerr)
		    = sqlexec(conexion, "ROLLBACK")
		    messagebox("Error de conexión: " + laerr[2], 16, "Error")
		endif
		
		if thisform.linsert
		    thisform.nretcod = lncodnew
		    thisform.release()
		else
		    thisform.btn_nuevo.enabled = .t.
		    thisform.btn_modificar.enabled = .t.
		    thisform.btn_borrar.enabled = .t.
		
		    thisform.btn_aceptar.enabled = .f.
		    thisform.btn_cancelar.enabled = .f.
		
		    * Deshabilitar todos los textboxes
		    thisform.txt_nombre.enabled = .f.
		    thisform.txt_apellido.enabled = .f.
		    thisform.txt_ci.enabled = .f.
		    thisform.txt_telefono.enabled = .f.
		    thisform.txt_direccion.enabled = .f.
		    thisform.txt_cod_sucursal.enabled = .f.
		    thisform.txt_sucursal.enabled = .f.
		
		    thisform.cnt_navegacion.enabled = .t.
		    thisform.grid1.enabled = .t.
		    thisform.llenar_dato()
		    thisform.llenar_grid()
		    thisform.btn_nuevo.setfocus
		endif
	ENDPROC

	PROCEDURE btn_borrar.Click
		local lnok, cap_cod
		LOCAL Array err[1]
		
		
		if messagebox("Desea borrar este registro?", 36, "Aviso") = 6
		
			cap_cod = thisform.txt_codigo.value
		
			= sqlexec(conexion, "START TRANSACTION")
		
			lnok = sqlexec(conexion, "call amb_personal('B',?cap_cod ,'', '','','','',0)")
		
			if lnok > 0
			
				=sqlexec(conexion, "COMMIT")
				=sqlexec(conexion, "select * from v_personal order by idpersonal", "cur_personal")
				
			else
		
				aerror(err)
				= sqlexec(conexion, "ROLLBACK")
				
				messagebox("Error ocurrido al borrar datos: " + err[2], 16, "Error")
		
			endif
		
			select cur_personal
			go top
		
			thisform.llenar_grid()
			thisform.llenar_dato()
		
		endif
		
	ENDPROC

	PROCEDURE btn_cancelar.Click
		thisform.btn_nuevo.enabled = .t.
		thisform.btn_modificar.enabled = .t.
		thisform.btn_borrar.Enabled = .t.
		thisform.btn_aceptar.enabled = .f.
		thisform.btn_cancelar.enabled = .f.
		
		* Deshabilitar todos los textboxes1
		thisform.txt_nombre.enabled = .f.
		thisform.txt_apellido.enabled = .f.
		thisform.txt_ci.enabled = .f.
		thisform.txt_telefono.enabled = .f.
		thisform.txt_direccion.enabled = .f.
		thisform.txt_cod_sucursal.enabled = .f.
		thisform.txt_sucursal.enabled = .f.
		
		thisform.cnt_navegacion.enabled = .t.
		thisform.grid1.enabled = .t.
		
		if thisform.tipo = "N"
		    select cur_personal && Cambié cur_vendedor por v_personal (tu vista)
		    go top
		ENDIF
		
		thisform.llenar_dato()
		thisform.btn_nuevo.setfocus
	ENDPROC

	PROCEDURE btn_modificar.Click
		thisform.btn_nuevo.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_borrar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		* Habilitar todos los textboxes para edición
		thisform.txt_nombre.enabled = .t.
		thisform.txt_apellido.enabled = .t.
		thisform.txt_ci.enabled = .t.
		thisform.txt_telefono.enabled = .t.
		thisform.txt_direccion.enabled = .t.
		thisform.txt_cod_sucursal.enabled = .t.
		
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_nombre.setfocus
		
		thisform.tipo = "M"
	ENDPROC

	PROCEDURE btn_nuevo.Click
		this.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_borrar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		thisform.txt_codigo.value = 0
		
		thisform.txt_nombre.enabled = .t.
		thisform.txt_apellido.enabled = .t.
		thisform.txt_ci.enabled = .t.
		thisform.txt_telefono.enabled = .t.
		thisform.txt_direccion.enabled = .t.
		thisform.txt_cod_sucursal.enabled = .t.
		
		thisform.txt_nombre.value = ""
		thisform.txt_apellido.value = ""
		thisform.txt_ci.value = ""
		thisform.txt_telefono.value = ""
		thisform.txt_direccion.value = ""
		thisform.txt_cod_sucursal.value = 0
		thisform.txt_sucursal.value = ""
		
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_nombre.setfocus
		
		thisform.tipo = "N"
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.Release
	ENDPROC

	PROCEDURE cnt_navegacion.btn_atras.Click
		 SELECT cur_personal
		 IF  .NOT. BOF()
		    SKIP -1
		    IF BOF()
		       GOTO TOP
		       WAIT WINDOW NOWAIT "Estas en el primer registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh()
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_primero.Click
		SELECT cur_personal
		GO top
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE cnt_navegacion.btn_siguiente.Click
		 SELECT cur_personal
		 IF  .NOT. EOF()
		    SKIP
		    IF EOF()
		       GOTO BOTTOM
		       WAIT WINDOW NOWAIT "Estas en el último registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_ultimo.Click
		SELECT cur_personal
		GO bottom
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		thisform.llenar_dato
	ENDPROC

	PROCEDURE Grid1.Click
		thisform.llenar_dato
	ENDPROC

	PROCEDURE txt_buscar.InteractiveChange
		dodefault()
		local lcbusqueda, lcfiltro, lcrecordsource, lacampos[1], lncampos, lni, lccampo
		
		* Obtener el texto de búsqueda (sin espacios al inicio/final)
		lcbusqueda = alltrim(upper(this.value))
		
		* Obtener el recordsource del grid
		lcrecordsource = thisform.grid1.recordsource
		
		if empty(lcbusqueda)
		* Si no hay texto de búsqueda, mostrar todos los registros
			if used(lcrecordsource)
				select (lcrecordsource)
				set filter to
				go top
			endif
		else
		* Verificar que exista la propiedad cCamposBusqueda
			if type("THISFORM.cCamposBusqueda") = "C" and !empty(thisform.ccamposbusqueda)
		
		* Dividir los campos por comas
				lncampos = alines(lacampos, strtran(thisform.ccamposbusqueda, " ", ""), 1, ",")
				lcfiltro = ""
		
		* Construir el filtro dinámicamente
				for lni = 1 to lncampos
					lccampo = alltrim(lacampos[lnI])
		
		* Verificar que el campo existe en el cursor
					if used(lcrecordsource)
						select (lcrecordsource)
						if type(lccampo) <> "U"
		
		* Agregar OR si no es el primer campo
							if !empty(lcfiltro)
								lcfiltro = lcfiltro + " OR "
							endif
		
		* Determinar el tipo de campo y construir la condición apropiada
							do case
								case type(lccampo) = "N"  && Campo numérico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(STR(" + lccampo + ")))"
		
								case type(lccampo) = "C"  && Campo de texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(" + lccampo + "))"
		
								case type(lccampo) = "D"  && Campo de fecha
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(DTOC(" + lccampo + "))"
		
								case type(lccampo) = "L"  && Campo lógico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(IIF(" + lccampo + ", 'TRUE', 'FALSE'))"
		
								otherwise  && Otros tipos, tratar como texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(TRANSFORM(" + lccampo + ")))"
							endcase
						endif
					endif
				next
		
		* Aplicar el filtro si se construyó correctamente
				if !empty(lcfiltro) and used(lcrecordsource)
					select (lcrecordsource)
					set filter to &lcfiltro
					go top
				endif
		
			else
		* Si no existe la propiedad, mostrar mensaje de error
				messagebox("La propiedad 'cCamposBusqueda' no está definida en el formulario.", 16, "Error de configuración")
			endif
		endif
		
		* Refrescar el grid
		thisform.grid1.refresh()
	ENDPROC

	PROCEDURE txt_cod_sucursal.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = 42
			NODEFAULT 
			LOCAL loregistro
			DO FORM bus_sucursal TO loregistro
			
			IF VARTYPE(loregistro)<>"L"
				this.Value = loregistro.idsucursal
			ELSE
				this.Value = 0
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE txt_cod_sucursal.LostFocus
		IF NOT EMPTY(this.Value)
		    LOCAL lnidsucursal, lcSQL, lnResult
		    LOCAL ARRAY laError[1]
		    
		    lnidsucursal= this.Value
		    
		    lcSQL = "SELECT * FROM v_sucursal WHERE idsucursal = " + ALLTRIM(STR(lnidsucursal))
		    
		    lnResult = SQLEXEC(conexion, lcSQL, "cur_sucursal")
		    
		    IF lnResult > 0
		        IF RECCOUNT("cur_sucursal") > 0
		            WITH thisform
		                .txt_sucursal.Value = ALLTRIM(cur_sucursal.sucursal)
		            ENDWITH
		        ELSE
		            MESSAGEBOX("El sucursal con ID " + ALLTRIM(STR(lnidsucursal)) + " no existe.", 16, "Atención")
		            this.Value = 0
		            thisform.txt_sucursal.Value = ""
		        ENDIF
		    ELSE
		        AERROR(laError)
		        MESSAGEBOX("Error al consultar el personal: " + laError[2], 16, "Error")
		    ENDIF
		    
		    *-- Cerrar cursor temporal
		    IF USED("cur_sucursal")
		        USE IN cur_sucursal
		    ENDIF
		ELSE
			thisform.txt_sucursal.Value = ""
		ENDIF
	ENDPROC

ENDDEFINE
