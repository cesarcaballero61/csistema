	PROCEDURE Init
		DODEFAULT()
		SET SEPARATOR  TO "."
		SET POINT TO ","
		thisform.cbo_mes.ListIndex = MONTH(DATE())
		thisform.txt_anio.Value = YEAR(DATE())
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		SET SEPARATOR  TO "."
		SET POINT TO ","
	ENDPROC

	PROCEDURE btn_aceptar.Click
		LOCAL lnmes,lcmes,lnanio, lncodCobrador
		LOCAL lcSQL, lnResult, loException
		
		lnmes			= thisform.cbo_mes.ListIndex
		lcmes			= thisform.cbo_mes.Value
		lnanio			= thisform.txt_anio.Value
		
		TRY
		    * Construir la llamada al stored procedure
		    lcSQL = "CALL sp_resumen_general_cobranza_mes('" + ALLTRIM(STR(lnmes))+ "', '" + ALLTRIM(STR(lnanio))+ "',0,0)" 
		    
		    * Ejecutar la consulta
		    lnResult = SQLEXEC(CONEXION, lcSQL, "curResumen_gral_cobranza_mes")
		    
		    IF lnResult > 0
		        * Verificar si hay datos
		        IF RECCOUNT("curResumen_gral_cobranza_mes") > 0
		            * Imprimir el informe
		            * REPORT FORM _informe_cobro_detallado.frx PREVIEW
		            * Para imprimir directamente: 
					
		             REPORT FORM _RESUMEN_GRAL_COBRANZA_MES PREVIEW NOCONSOLE 
		        ELSE
		            MESSAGEBOX("No se encontraron registros para los criterios especificados", 64, "Información")
		        ENDIF
		    ELSE
		        MESSAGEBOX("Error al ejecutar la consulta de pagos", 16, "Error")
		    ENDIF
		    
		CATCH TO loException
		    MESSAGEBOX("Error: " + loException.Message, 16, "Error en consulta")
		ENDTRY
		
	ENDPROC

	PROCEDURE btn_cancelar.Click
		THISFORM.Release()
	ENDPROC

