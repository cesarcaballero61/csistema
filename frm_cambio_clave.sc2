	ADD OBJECT 'TXT_USUARIO' AS txtbase WITH ;
		Enabled = .F., ;
		Height = 22, ;
		Left = 192, ;
		Name = "TXT_USUARIO", ;
		TabIndex = 2, ;
		Top = 36, ;
		Width = 182
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="textbox" />
	
	PROCEDURE _cambiar_clave
		LOCAL lnidusuario, lcpassword_anterior,;
		lcpassword_nuevo,lcpassword_confirmar
		
		LOCAL loVfpHash as vfphash OF vfphash.vcx
		loVfpHash = NEWOBJECT('vfphash','vfphash.vcx')
		
		LOCAL llok 
		llok = .t.
		
		lnidusuario			= thisform.txt_id_usuario.value 
		lcpassword_anterior	= ALLTRIM(thisform.txt_password_anterior.value)
		lcpassword_nuevo 	= ALLTRIM(thisform.txt_password_nuevo.value)
		lcpassword_confirmar	= ALLTRIM(thisform.txt_confirmar_password.value)
		
		*verficar vacios
		IF EMPTY(lnidusuario)
			MESSAGEBOX("Debes indicar un usuario para la operacion",16,"Aviso")
			thisform.txt_ID_USUARIO.SetFocus()
			RETURN 
		ENDIF 
		
		IF EMPTY(lcpassword_anterior)
			MESSAGEBOX("Debes indicar el password anterior",16,"Aviso")
			thisform.txt_password_anterior.setfocus() 
			RETURN 
		ENDIF 
		
		IF EMPTY(lcpassword_nuevo)
			MESSAGEBOX("Debes indicar el nuevo password",16,"Aviso")
			thisform.txt_password_nuevo.setfocus() 
			RETURN 
		ENDIF 
		
		IF EMPTY(lcpassword_confirmar)
			MESSAGEBOX("Debes indicar la confirmacion del nuevo password",16,"Aviso")
			thisform.txt_confirmar_password.setfocus() 
			RETURN 
		ENDIF 
		
		* Verificar que el password anterior sea correcto
		llokpass_anterior = (loVfpHash.hash(lcpassword_anterior,'md5') == ALLTRIM(v_usuarios.clave))
		
		IF NOT llokpass_anterior 
			MESSAGEBOX('La clave anterior no es la correcta, vuelva a intentarlo.',16,'Aviso')
			thisform.txt_PASSWORD_ANTERIOR.SetFocus()
			RETURN 
		ENDIF 
		
		* Verificar que los nuevos passwords coincidan
		llokpass_nuevo = (loVfpHash.hash(lcpassword_nuevo,'md5') == loVfpHash.hash(lcpassword_confirmar,'md5'))
		
		IF NOT llokpass_nuevo 
			MESSAGEBOX('El nuevo password no coinciden, vuelva a intentarlo',16,'Aviso')
			thisform.txt_password_nuevo.SetFocus()
			RETURN 
		ENDIF 
		
		* Si todo está bien, hacer el hash al password nuevo con md5
		lcpassword_nuevo = loVfpHash.hash(lcpassword_nuevo,'md5')
		
		* Actualizar el password llamando al sp_actualizar_clave_usuario
		LOCAL lcSQL, lnResult
		
		* Llamar al stored procedure (sin esperar retorno de datos)
		lcSQL = "CALL sp_actualizar_clave_usuario(" + ;
		        ALLTRIM(STR(lnidusuario)) + ", '" + ;
		        lcpassword_nuevo + "')"
		
		lnResult = SQLExec(conexion, lcSQL)
		
		IF lnResult > 0
		    * Éxito en la ejecución
		    MESSAGEBOX("Password actualizado correctamente", 64, "Éxito")
		    
		    * Limpiar los campos del formulario
			thisform._cancelar()
		    
		    llok = .T.
		ELSE
		    * Error en la ejecución
		    MESSAGEBOX("Error al actualizar el password en la base de datos", 16, "Error")
		    llok = .F.
		ENDIF
		
		RETURN llok
	ENDPROC

	PROCEDURE _cancelar
		thisform.txt_id_usuario.value = 0
		thisform.txt_usuario.value = ''
		thisform.txt_password_anterior.value = ''
		thisform.txt_password_nuevo.value = ''
		thisform.txt_confirmar_password.value = ''
		
		thisform.txt_id_usuario.enabled = .t.
		thisform.txt_id_usuario.setfocus
	ENDPROC

	PROCEDURE BTN_ACEPTAR.Click
		IF MESSAGEBOX('¿Desea confirmar esta operacion?',4+32,'Aviso') = 6
			thisform._cambiar_clave()
		ENDIF 
	ENDPROC

	PROCEDURE BTN_CANCELAR.Click
		IF MESSAGEBOX('¿Desea cancelar esta operacion?',4+32,'Aviso') = 6
			thisform._cancelar()
		ENDIF 
	ENDPROC

	PROCEDURE BTN_SALIR.Click
		THISFORM.Release()
	ENDPROC

	PROCEDURE TXT_ID_USUARIO.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		if nkeycode = 42
			NODEFAULT
			local loregistro as object
			do form bus_usuario to loregistro
		
		
			if vartype(loregistro) <> "L"
		
				this.value = loregistro.idusuario
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
	ENDPROC

	PROCEDURE TXT_ID_USUARIO.LostFocus
		dodefault()
		if not empty(this.value)
			local lnidusuario, lcsql
		
			lnidusuario = this.value
		
			lcsql = "SELECT * FROM v_usuarios WHERE idusuario = " + alltrim(str(lnidusuario, 20, 0))
		
			if sqlexec(conexion, lcsql, "v_usuarios") > 0
				if reccount("v_usuarios") > 0
		
					** Llenar campos del formulario.
					this.value = v_usuarios.idusuario
					thisform.txt_usuario.value = v_usuarios.nick
		
					this.enabled = .f.
		
				else
		
					** Personal no encontrado
					messagebox("Usuario no encontrado", 16, "Atención")
					this.value = 0
					thisform.txt_usuario.value = ""
		
					** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		
					this.setfocus()
					nodefault
		
				endif
			else
				** Error en la consulta
				local laerror[1]
				aerror(laerror)
				messagebox("Error al buscar el Usuario: " + laerror[2], 16, "Error")
			endif
		else
			thisform.txt_usuario.value = ""
		endif
	ENDPROC

ENDDEFINE
