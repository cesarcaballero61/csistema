	PROCEDURE calculartotales
		local lncantidad, lncuota
		
		*-- Inicializar variables
		store 0 to lncantidad, lnsaldo
		
		*-- Calcular sumatorias desde el cursor
		select curestadocuotas
		CALCULATE cnt(idVenta),SUM(saldo_cuota) ;
			to lncantidad,lncuota
		
		
		*-- Mostrar los totales en los controles correspondientes
		*-- Asumiendo que tienes textboxes para mostrar los totales
		thisform.txt_cant_registro.value = lncantidad
		thisform.txt_cuota.Value		= lncuota
		
		*-- Formatear los valores si es necesario
		thisform.txt_cant_registro.inputmask = "999,999,999"
		thisform.txt_cuota.inputmask = "999,999,999"
	ENDPROC

	PROCEDURE cancelar_consulta
		*--limpiar controles
		
		thisform.cbo_tipo_consulta.value = ""
		thisform.cbo_dias_vto.value = ""
		
		thisform.cbo_tipo_consulta.enabled = .t.
		thisform.cbo_dias_vto.enabled = .t.
		
		thisform.txt_buscar.value = ""
		thisform.txt_ci_CLIENTE.Value = ""
		thisform.txt_clIENTE.Value = ""
		thisform.txt_idcliente.Value = 0
		
		thisform.grid_consulta_cuota_vacio()
		
		
		if used("curEstadoCuotas")
			use in curestadocuotas
		endif
		
		thisform.txt_buscar.value = ""
		thisform.txt_cant_registro.value = 0
		thisform.txt_cuota.value = 0
		
		thisform.cbo_TIPO_CONSULTA.SetFocus()
		
		
		*-- Mensaje de confirmación
		messagebox("Ventana limpiada, Controles reseteados.", 64, "Cancelado")
	ENDPROC

	PROCEDURE consultarestadocuotas
		lparameters tntipoconsulta, tndias, tnsucursal, tndicliente
		
		local lcsql, lctipoconsulta, lnresult,lndias
		local array laerror[1]
		
		
		* Valores por defecto
		tntipoconsulta = iif(empty(tntipoconsulta), 4, tntipoconsulta)
		tndias = iif(empty(tndias), null, tndias)
		tnsucursal = iif(empty(tnsucursal), null, tnsucursal)
		
		* Convertir tipo de consulta
		lctipoconsulta = thisform.obtenertipoconsulta(tntipoconsulta)
		lndias = thisform.obtenerdias(tndias)
		
		* Construir SQL
		lcsql = "CALL sp_consultar_estado_cuotas('" + lctipoconsulta + "', "
		lcsql = lcsql + iif(isnull(lndias), "NULL, ", alltrim(str(lndias)) + ", ")
		lcsql = lcsql + iif(isnull(tnsucursal), "NULL, ", alltrim(str(tnsucursal)) + ", ")
		lcsql = lcsql + iif(EMPTY(tndicliente), "NULL) ", alltrim(str(tndicliente)) + ")")
		
		*SET STEP ON
		
		* Ejecutar consulta
		lnresult = sqlexec(conexion, lcsql, "curEstadoCuotas")
		**_cliptext = lcsql 
		
		if lnresult > 0
			thisform.grid_consulta_cuota()
			thisform.calculartotales()
			return .t.
		else
			aerror(laerror)
			messagebox("Error en consulta "+laerror[2], 16, "Error")
			return .f.
		endif
	ENDPROC

	PROCEDURE grid_consulta_cuota
		* Versión con 14 columnas incluyendo cobrador
		WITH THIS.grdEstado
			.allowcellselection = .F.
			.columncount = 0
			.FontSize = 9
			.recordsourcetype = 1
			.recordsource = "curEstadoCuotas"
			.columncount = 14
		
		*-- Columna 1: CLIENTE
			.Column1.Header1.Caption = "CLIENTE"
			.Column1.Header1.FontBold = .T.
			.Column1.ControlSource = "curEstadoCuotas.cliente_nombre_completo"
			.Column1.Width =200
		
		*-- Columna 2: CI/RUC
			.Column2.Header1.Caption = "CI/RUC"
			.Column2.Header1.FontBold = .T.
			.Column2.ControlSource = "curEstadoCuotas.cliente_ci"
			.Column2.Width = 80
		
		*-- Columna 3: FACTURA
			.Column3.Header1.Caption = "FACTURA"
			.Column3.Header1.FontBold = .T.
			.Column3.ControlSource = "curEstadoCuotas.factura_completa"
			.Column3.Width = 150
		
		*-- Columna 4: FEC. VENTA
			.Column4.Header1.Caption = "FEC. VTA"
			.Column4.Header1.FontBold = .T.
			.Column4.ControlSource = "curEstadoCuotas.fecha_venta"
			.Column4.Width = 75
		
		*-- Columna 5: TOTAL
			.Column5.Header1.Caption = "TOTAL"
			.Column5.Header1.FontBold = .T.
			.Column5.ControlSource = "curEstadoCuotas.total_venta"
			.Column5.Width = 75
			.Column5.Alignment = 1
			.Column5.InputMask = "999,999,999"
		
		*-- Columna 6: SALDO
			.Column6.Header1.Caption = "SALDO"
			.Column6.Header1.FontBold = .T.
			.Column6.ControlSource = "curEstadoCuotas.saldo_pendiente"
			.Column6.Width = 75
			.Column6.Alignment = 1
			.Column6.InputMask = "999,999,999"
		
		*-- Columna 7: TOTAL CUOT.
			.Column7.Header1.Caption = "TOTAL CUOT."
			.Column7.Header1.FontBold = .T.
			.Column7.ControlSource = "curEstadoCuotas.total_cuotas"
			.Column7.Width = 75
			.Column7.Alignment = 1
		
		*-- Columna 8: CUOTA NRO
			.Column8.Header1.Caption = "CUOTA"
			.Column8.Header1.FontBold = .T.
			.Column8.ControlSource = "curEstadoCuotas.orden_char"
			.Column8.Width = 50
			.Column8.Alignment = 0
		
		*-- Columna 9: MONTO
			.Column9.Header1.Caption = "MONTO"
			.Column9.Header1.FontBold = .T.
			.Column9.ControlSource = "curEstadoCuotas.saldo_cuota"
			.Column9.Width = 75
			.Column9.Alignment = 1
			.Column9.InputMask = "999,999,999"
		
		*-- Columna 10: FEC. VTO
			.Column10.Header1.Caption = "FEC. VTO"
			.Column10.Header1.FontBold = .T.
			.Column10.ControlSource = "curEstadoCuotas.fecha_vto"
			.Column10.Width = 75
		
		*-- Columna 11: DÍAS
			.Column11.Header1.Caption = "DÍAS"
			.Column11.Header1.FontBold = .T.
			.Column11.ControlSource = "IIF(curEstadoCuotas.situacion = 'VENCIDA', curEstadoCuotas.dias_vencido, curEstadoCuotas.dias_para_vencer)"
			.Column11.Width = 45
			.Column11.Alignment = 1
		
		*-- Columna 12: ESTADO
			.Column12.Header1.Caption = "ESTADO"
			.Column12.Header1.FontBold = .T.
			.Column12.ControlSource = "curEstadoCuotas.situacion"
			.Column12.Width = 100
		
		*-- Columna 13: NIVEL MORA
			.Column13.Header1.Caption = "NIVEL MORA"
			.Column13.Header1.FontBold = .T.
			.Column13.ControlSource = "curEstadoCuotas.nivel_mora"
			.Column13.Width = 180
		
		*-- Columna 14: COBRADOR
			.Column14.Header1.Caption = "COBRADOR"
			.Column14.Header1.FontBold = .T.
			.Column14.ControlSource = "curEstadoCuotas.cobrador_nombre"
			.Column14.Width = 200
			
			.SetAll("DynamicForeColor", ;
				  "ICASE(curEstadoCuotas.situacion = 'VENCIDA', RGB(255,0,0), ;
				         curEstadoCuotas.situacion = 'POR VENCER', RGB(255,128,0), ;
				         RGB(0,0,0))", ;
				  "Column")
		
			.SetAll("DynamicBackColor", ;
				  "ICASE(curEstadoCuotas.estado_cliente = 'MOROSO', RGB(255,200,200), ;
				         curEstadoCuotas.estado_cliente = 'AL DÍA', RGB(200,255,200), ;
				         RGB(255,255,255))", ;
				  "Column")
		
		*!*	*-- Formato condicional
		*!*		.SetAll("DynamicForeColor", ;
		*!*			  "IIF(curEstadoCuotas.situacion = 'VENCIDA', RGB(255,0,0), " + ;
		*!*			  "IIF(curEstadoCuotas.situacion = 'POR VENCER', RGB(255,128,0), RGB(0,0,0)))", ;
		*!*			  "Column")
		
		*!*		.SetAll("DynamicBackColor", ;
		*!*			  "IIF(curEstadoCuotas.estado_cliente = 'MOROSO', RGB(255,200,200), " + ;
		*!*			  "IIF(curEstadoCuotas.estado_cliente = 'AL DÍA', RGB(200,255,200), RGB(255,255,255)))", ;
		*!*			  "Column")
		
			.Redraw()
		ENDWITH
	ENDPROC

	PROCEDURE grid_consulta_cuota_vacio
		* Crear cursor vacío con mensaje
		CREATE CURSOR curEstadoCuotasEmpty (mensaje C(50))
		
		* Insertar mensaje
		INSERT INTO curEstadoCuotasEmpty (mensaje) VALUES ("No hay datos para mostrar")
		
		* Configurar grilla con cursor vacío
		WITH THIS.grdEstado
			.allowcellselection = .F.
			.columncount = 0
			.FontSize = 9
			.recordsourcetype = 1
			.recordsource = "curEstadoCuotasEmpty"
			.columncount = 1
		
		*-- Columna única con mensaje
			.Column1.Header1.Caption = "INFORMACIÓN"
			.Column1.Header1.FontBold = .T.
			.Column1.ControlSource = "mensaje"
			.Column1.Width = 400
			.Column1.Alignment = 2  && Centrado
		
			.SetAll("DynamicForeColor", "RGB(0,0,0)", "Column")
			.SetAll("DynamicBackColor", "RGB(255,255,255)", "Column")
		
			.Redraw()
		ENDWITH
	ENDPROC

	PROCEDURE Init
		DODEFAULT()
		thisform.grid_consulta_cuota_vacio()
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
	ENDPROC

	PROCEDURE obtenerdias
		lparameters tndias
		*15 dias,30 dias,60 dias,90 dias,>90 dias
		LOCAL lndias
		
		do case
			case tndias = 1
				lndias = 15
			case tndias = 2
				lndias =30
			case tndias = 3
				lndias = 60
			CASE tndias = 4
				lndias = 90
			OTHERWISE
				lndias = null
		ENDCASE
		
		RETURN lndias
	ENDPROC

	PROCEDURE obtenertipoconsulta
		lparameters tntipo
		
		do case
			case tntipo = 1
				return "VENCIDAS"
			case tntipo = 2
				return "POR_VENCER"
			case tntipo = 3
				return "AL_DIA"
			otherwise
				return "TODAS"
		endcase
	ENDPROC

	PROCEDURE _imprimir_consulta
	ENDPROC

	PROCEDURE _notificar_porvencer
	ENDPROC

	PROCEDURE _notificar_vto
	ENDPROC

	PROCEDURE Btnnorbase1.Click
		IF EMPTY(THISFORM.CBO_TIPO_CONSULTA.Value)
			MESSAGEBOX("DEBES SELECCIONAR UN TIPO CONSULTA",16,"AVISOR")
			THISFORM.CBO_TIPO_CONSULTA.SetFocus()
			RETURN 
		ENDIF 
		
		
		
		IF THISFORM.CBO_TIPO_CONSULTA.ListIndex < 2
			IF EMPTY(THISFORM.CBO_DIAS_VTO.Value)
				MESSAGEBOX("DEBES SELECCIONAR UN DIAS DE VTO",16,"AVISOR")
				THISFORM.CBO_DIAS_VTO.SetFocus()
				RETURN 
			ENDIF 
		ENDIF 
		
		thisform.consultarestadocuotas(thisform.cbo_TIPO_CONSULTA.ListIndex,;
		THISFORM.CBO_DIAS_VTO.ListIndex,;
		_Screen.oAPP.nsUCURSAL,;
		thisform.txt_idcliente.Value)
	ENDPROC

	PROCEDURE Btnnorbase2.Click
		thisform.Release()
	ENDPROC

	PROCEDURE Btnnorbase3.Click
		IF MESSAGEBOX("¿Desea cancelar esta operación de consulta?", 292, "Aviso") = 6
		    THISFORM.cancelar_consulta()
		ENDIF
	ENDPROC

	PROCEDURE Btnnorbase4.Click
		IF MESSAGEBOX("Desea imprimir esta consulta",4+32,"Aviso") =6
			SELECT curEstadoCuotas
			
			lctipoConsulta = thisform.cbO_TIPO_CONSULTA.Value
			ldFechaCorte = thisform.cbo_DIAS_VTO.Value
			lccicliente = thisform.txt_ci_CLIENTE.Value
			lccliente = thisform.txt_cliENTE.Value
			REPORT FORM _consulta_cuotas PREVIEW NOCONSOLE 
		ENDIF 
	ENDPROC

	PROCEDURE btn_notificarwhatsapp.Click
		*validar si existe cuotas vencidas para notificar
		
		local lccliente, lcnrocuota, lctelefono, ldfechavto, lnmonto
		local lctipoconsulta
		
		
		if !used('curEstadoCuotas')
			messagebox("No hay datos de cuotas para notificar", 016, "Atencion")
			return
		endif
		
		if reccount('curEstadoCuotas') = 0
			messagebox("No hay datos de cuotas para notificar", 016, "Atencion")
			return
		endif
		
		
		
		* ===== VALIDAR DATOS DEL FORMULARIO =====
		lctelefono = curestadocuotas.cliente_celular
		lccliente  = alltrim(curestadocuotas.cliente_nombre_completo)
		lcnrocuota = alltrim(curestadocuotas.orden_char)
		ldfechavto = curestadocuotas.fecha_vto
		lnmonto		= curestadocuotas.saldo_cuota
		
		
		if empty(lctelefono)
			messagebox("Este cliente no tiene el numero de telefono asignado", 48, "Validación")
			return
		endif
		
		
		* ===== ENVIAR NOTIFICACIÓN =====
		set procedure to whatsappnativo additive
		
		local lowa, llexito
		lowa = createobject("WhatsAppNativo")
		
		lctipoconsulta = thisform.obtenertipoconsulta(thisform.cbo_tipo_consulta.listindex)
		
		IF lctipoconsulta == 'VENCIDAS'
		
			llexito = lowa.notificarcuotavencida(;
				  lctelefono, ;
				  lccliente, ;
				  lcnrocuota, ;
				  ldfechavto, ;
				  lnmonto, ;
				  "Gs.")
		ELSE
			llexito = lowa.enviarrecordatorio(;
			lctelefono,;
			lccliente,;
			"")
			
		ENDIF 
		
		if llexito
			messagebox("WhatsApp abierto correctamente." + chr(13) + ;
				  "Complete el envío en la ventana de WhatsApp.", ;
				  64, "Éxito")
		endif
		
		lowa = null
		
	ENDPROC

	PROCEDURE CBO_TIPO_CONSULTA.Valid
		DO CASE
			CASE THIS.ListIndex = 1 && cuotas vencidas
				thisform.cbo_DIAS_VTO.Enabled = .t.
				
			CASE THIS.ListIndex = 2 && por vencer
				thisform.cbo_DIAS_VTO.Enabled = .t.
				
			CASE THIS.ListIndex = 3 && al dia
				thisform.cbo_DIAS_VTO.Value =""
				thisform.cbo_DIAS_VTO.Enabled = .f.	
			
			CASE THIS.ListIndex = 4 && todas
				thisform.cbo_DIAS_VTO.Value =""
				thisform.cbo_DIAS_VTO.Enabled = .f.	
			
			
		ENDCASE 
	ENDPROC

	PROCEDURE grdEstado.When
		NODEFAULT 
	ENDPROC

	PROCEDURE txt_buscar.InteractiveChange
		dodefault()
		local lcbusqueda, lcfiltro, lcrecordsource, lacampos[1], lncampos, lni, lccampo
		
		* Obtener el texto de búsqueda (sin espacios al inicio/final)
		lcbusqueda = alltrim(upper(this.value))
		
		* Obtener el recordsource del grid
		lcrecordsource = thisform.grdEstado.recordsource
		
		if empty(lcbusqueda)
		* Si no hay texto de búsqueda, mostrar todos los registros
			if used(lcrecordsource)
				select (lcrecordsource)
				set filter to
				go top
			endif
		else
		* Verificar que exista la propiedad cCamposBusqueda
			if type("THISFORM.cCamposBusqueda") = "C" and !empty(thisform.ccamposbusqueda)
		
		* Dividir los campos por comas
				lncampos = alines(lacampos, strtran(thisform.ccamposbusqueda, " ", ""), 1, ",")
				lcfiltro = ""
		
		* Construir el filtro dinámicamente
				for lni = 1 to lncampos
					lccampo = alltrim(lacampos[lnI])
		
		* Verificar que el campo existe en el cursor
					if used(lcrecordsource)
						select (lcrecordsource)
						if type(lccampo) <> "U"
		
		* Agregar OR si no es el primer campo
							if !empty(lcfiltro)
								lcfiltro = lcfiltro + " OR "
							endif
		
		* Determinar el tipo de campo y construir la condición apropiada
							do case
								case type(lccampo) = "N"  && Campo numérico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(STR(" + lccampo + ")))"
		
								case type(lccampo) = "C"  && Campo de texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(" + lccampo + "))"
		
								case type(lccampo) = "D"  && Campo de fecha
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(DTOC(" + lccampo + "))"
		
								case type(lccampo) = "L"  && Campo lógico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(IIF(" + lccampo + ", 'TRUE', 'FALSE'))"
		
								otherwise  && Otros tipos, tratar como texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(TRANSFORM(" + lccampo + ")))"
							endcase
						endif
					endif
				next
		
		* Aplicar el filtro si se construyó correctamente
				if !empty(lcfiltro) and used(lcrecordsource)
					select (lcrecordsource)
					set filter to &lcfiltro
					go top
				endif
		
			else
		* Si no existe la propiedad, mostrar mensaje de error
				messagebox("La propiedad 'cCamposBusqueda' no está definida en el formulario.", 16, "Error de configuración")
			endif
		endif
		
		* Refrescar el grid
		thisform.grdEstado.refresh()
	ENDPROC

	PROCEDURE txt_ci_cliente.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			LOCAL lcruc_ci as String
			lcruc_ci = ""
			local loregistro as object
			do form bus_cliente to loregistro
		
		
			if vartype(loregistro) <> "L"
			
				lcruc_ci = ALLTRIM(loregistro.ci)
				
				IF EMPTY(ALLTRIM(loregistro.ci))
					lcruc_ci =ALLTRIM(loregistro.ruc)
				ENDIF
				
				IF EMPTY(lcruc_ci)
					MESSAGEBOX("Este cliente no posee #cedula ni #ruc"+CHR(13);
					+"debes completar los datos faltantes antes de continuar",16,"Aviso")
					lcruc_ci=""
				ENDIF  
				
				this.value = lcruc_ci
				this.setfocus()
			else
				this.value = ""
			endif
		endif
		
		
		if m.nkeycode = 22
			nodefault
			local lncodigo
			do form cliente with .t. to m.lncodigo
			this.value = m.lncodigo
		endif
	ENDPROC

	PROCEDURE txt_ci_cliente.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lncodCliente, lcSQL
		    
		    lncodCliente= this.Value
		    
		    lcSQL = "SELECT * FROM v_clientes WHERE ci = '" + ALLTRIM(lncodCliente)+"'"
		    lcSQL =lcSQL + "  or  ruc = '" + ALLTRIM(lncodCliente)+"'"
		    
		    IF SQLExec(conexion, lcSQL, "cur_clientes") > 0
		        IF RECCOUNT("cur_cliente") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = ICASE(!EMPTY(cur_clientes.ci),cur_clientes.ci,!EMPTY(cur_clientes.ruc),cur_clientes.ruc,ALLTRIM(STR(cur_clientes.idcliente,10,0)))
					thisform.txt_cliente.Value = ALLTRIM(cur_clientes.nombre_completo)
					thisform.txt_idcliente.Value = cur_clientes.idcliente
		
					*this.Enabled = .f.
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Cliente no encontrado!", 16, "Atención")
		            this.Value = ""
					thisform.txt_cliente.Value = ""
					thisform.txt_idcliente.Value = 0
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar Cliente: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_cliente.Value = "TODOS"
			thisform.txt_idcliente.Value = 0
		ENDIF
	ENDPROC

ENDDEFINE
