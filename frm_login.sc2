DEFINE CLASS frmbase1 AS frmbase OF "clases\controles.vcx" 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*-- OBJECTDATA items order determines ZOrder / El orden de los items OBJECTDATA determina el ZOrder 
	*< OBJECTDATA: ObjPath="Lblbase1" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Lblbase2" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="btnaceptar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txt_login" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="txt_password" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="btncancelar" UniqueID="" Timestamp="" />
	*< OBJECTDATA: ObjPath="Imgbase1" UniqueID="" Timestamp="" />

	*<DefinedPropArrayMethod>
		*p: intentos
	*</DefinedPropArrayMethod>

	*<PropValue>
		BorderStyle = 1
		DoCreate = .T.
		Height = 221
		intentos = 1
		Name = "Frmbase1"
		ShowWindow = 2
		TitleBar = 0
		Width = 432
	*</PropValue>

	ADD OBJECT 'btnaceptar' AS btnnorbase WITH ;
		Caption = "\<Aceptar", ;
		Height = 48, ;
		Left = 324, ;
		Name = "btnaceptar", ;
		TabIndex = 3, ;
		Top = 100, ;
		Width = 84
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'btncancelar' AS btnnorbase WITH ;
		Caption = "\<Cancelar", ;
		Height = 48, ;
		Left = 324, ;
		Name = "btncancelar", ;
		TabIndex = 4, ;
		Top = 148, ;
		Width = 84
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="commandbutton" />

	ADD OBJECT 'Imgbase1' AS imgbase WITH ;
		Height = 60, ;
		Left = 0, ;
		Name = "Imgbase1", ;
		Picture = imagenes\acceso.png, ;
		Stretch = 2, ;
		Top = 0, ;
		Width = 432
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="image" />

	ADD OBJECT 'Lblbase1' AS lblbase WITH ;
		Caption = "USUARIO:", ;
		Left = 48, ;
		Name = "Lblbase1", ;
		TabIndex = 5, ;
		Top = 88
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="label" />

	ADD OBJECT 'Lblbase2' AS lblbase WITH ;
		Caption = "PASSWORD:", ;
		Left = 48, ;
		Name = "Lblbase2", ;
		TabIndex = 6, ;
		Top = 146
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="label" />

	ADD OBJECT 'txt_login' AS txtbase WITH ;
		Height = 22, ;
		Left = 48, ;
		Name = "txt_login", ;
		TabIndex = 1, ;
		Top = 110, ;
		Width = 240
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="textbox" />

	ADD OBJECT 'txt_password' AS txtbase WITH ;
		Height = 22, ;
		Left = 48, ;
		Name = "txt_password", ;
		PasswordChar = "*", ;
		TabIndex = 2, ;
		Top = 165, ;
		Width = 240
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="textbox" />
	
	PROCEDURE Activate
		SetForegroundWindow(THIS.HWnd)
	ENDPROC

	PROCEDURE Init
		DODEFAULT()
		
		=SQLEXEC(CONEXION,"SELECT * FROM v_usuarios ORDER BY idusuario","CUR_USUARIO")
		
	ENDPROC

	PROCEDURE Load
		set deleted on 
		set date DMY
		*set century on	
		set multilocks on
		set safety off
		set talk off
	ENDPROC

	PROCEDURE btnaceptar.Click
		local lclogin, lcpassword
		
		lclogin = alltrim(thisform.txt_login.value)
		lcpassword = alltrim(thisform.txt_password.value)
		
		local lovfphash as vfphash of vfphash.vcx
		lovfphash = newobject("vfphash", "vfphash.vcx")
		
		select cur_usuario
		
		locate for alltrim((cur_usuario.nick)) == lclogin
		
		lcpassword = lovfphash.hash(lcpassword , "md5")
		
		if found()
			if alltrim(cur_usuario.clave) == lcpassword 
		
				*usuario de en secion del sistema
				_screen.oapp.cusuariosistema = cur_usuario.nick
				_screen.oapp.nusuariosistema = cur_usuario.idusuario
				_screen.oapp.ctipousuario 	= cur_usuario.tipo_descripcion
		
				*datos del personal segun usuario en sesion
				_screen.oapp.npersonal 		= cur_usuario.idpersonal
				_screen.oapp.cpersonalnombre = cur_usuario.nombre_completo
				
				
				thisform.Release()
				
				DO FORM frm_principal
		
			else
				messagebox("clave o login incorrectas!!",016,"aviso")
				thisform.intentos = thisform.intentos + 1
				thisform.txt_login.setfocus
			endif
		else
			messagebox("clave o login incorrectas!!",016,"aviso")
			thisform.intentos = thisform.intentos + 1
			thisform.txt_login.setfocus
		endif
		
		if thisform.intentos > 2
			_screen.oapp.shutdown(.f.)
		endif
	ENDPROC

	PROCEDURE btncancelar.Click
		if !_screen.OAPP.ldebugmode
			_screen.OAPP.shutdown(.f.)
		else
			thisform.Release()
		endif 
	ENDPROC

ENDDEFINE
