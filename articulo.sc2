	PROCEDURE txt_codbarra.LostFocus
		DODEFAULT()
		
		* Segundo: Validar código duplicado según el tipo de operación
		IF !EMPTY(ALLTRIM(this.Value))
		    LOCAL lcCodigo
		    lcCodigo = ALLTRIM(this.Value)
		    
		    * Para operación Nueva (N)
		    IF thisform.coperacion== "N"
		    
		        IF thisform.buscarcodigoduplicado(lcCodigo)
		            MESSAGEBOX("El codigo '" + lcCodigo + "' ya fue registrado", 16, "Aviso")
		            this.Value = ""  && Limpiar para generar nuevo código
		        ENDIF
		        
		    ELSE
		        * Para operación Modificar (M) - solo si cambió el código
		        IF ALLTRIM(this.Value) <> ALLTRIM(thisform.coldcode)
		        
		            IF thisform.buscarcodigoduplicado(lcCodigo)
		                MESSAGEBOX("El codigo '" + lcCodigo + "' ya fue registrado en otro producto", 16, "Aviso")
		                this.Value = thisform.coldcode  && Restaurar código original
		            ENDIF
		            
		        ENDIF
		    ENDIF
		ENDIF
		
	ENDPROC

