	PROCEDURE actualizar_navegacion
		local lntotal, lnactual, lcestado
		
		if used('crsArticulo') and reccount('crsArticulo') > 0
			lntotal = reccount('crsArticulo')
			lnactual = recno('crsArticulo')
			lcestado = "Registro " + transform(lnactual) + " de " + transform(lntotal)
		
		* Actualizar control que muestre el estado
			if type("thisform.lblEstado") = "O" and pemstatus(thisform.lblestado, "Caption", 5)
				thisform.lblestado.caption = lcestado
			endif
		
		* Habilitar/deshabilitar botones de navegación si existen
			if type("thisform.cmdPrimero") = "O" and pemstatus(thisform.cmdprimero, "Enabled", 5)
				thisform.cmdprimero.enabled = (lnactual > 1)
			endif
			if type("thisform.cmdAnterior") = "O" and pemstatus(thisform.cmdanterior, "Enabled", 5)
				thisform.cmdanterior.enabled = (lnactual > 1)
			endif
			if type("thisform.cmdSiguiente") = "O" and pemstatus(thisform.cmdsiguiente, "Enabled", 5)
				thisform.cmdsiguiente.enabled = (lnactual < lntotal)
			endif
			if type("thisform.cmdUltimo") = "O" and pemstatus(thisform.cmdultimo, "Enabled", 5)
				thisform.cmdultimo.enabled = (lnactual < lntotal)
			endif
		else
		* Sin registros
			if type("thisform.lblEstado") = "O" and pemstatus(thisform.lblestado, "Caption", 5)
				thisform.lblestado.caption = "Sin registros"
			endif
		
		* Deshabilitar botones de navegación
			if type("thisform.cmdPrimero") = "O" and pemstatus(thisform.cmdprimero, "Enabled", 5)
				thisform.cmdprimero.enabled = .f.
			endif
			if type("thisform.cmdAnterior") = "O" and pemstatus(thisform.cmdanterior, "Enabled", 5)
				thisform.cmdanterior.enabled = .f.
			endif
			if type("thisform.cmdSiguiente") = "O" and pemstatus(thisform.cmdsiguiente, "Enabled", 5)
				thisform.cmdsiguiente.enabled = .f.
			endif
			if type("thisform.cmdUltimo") = "O" and pemstatus(thisform.cmdultimo, "Enabled", 5)
				thisform.cmdultimo.enabled = .f.
			endif
		endif
		
	ENDPROC

	PROCEDURE bloquear_boton_nav
		WITH thisform
		
			.cmdPrimero.enabled 	= .f.
			.cmdAnterior.enabled 	= .f.
			
			.cmdSiguiente.enabled	=.f.
			.cmdUltimo.enabled		=.f.
		ENDWITH 
	ENDPROC

	PROCEDURE buscarcodigoduplicado
		lparameter tcCodigo
		local lcsql, loresultado
		
		if empty(alltrim(tccodigo))
			return .f.
		endif
		
		* Escapar comillas y construir consulta
		tccodigo = strtran(alltrim(tccodigo), "'", "''")
		lcsql = "SELECT COUNT(*) as total FROM articulo WHERE codbarra = '" + tccodigo + "'"
		
		* Ejecutar consulta
		=sqlexec(conexion,lcsql, "crsCodigoDuplicado")
		
		* Retornar resultado
		return (used("crsCodigoDuplicado") and INT(VAL(crscodigoduplicado.total)) > 0)
	ENDPROC

	PROCEDURE calcularpreciocontado
		* --------------------------------------------------------------
		*  Método : CALCULARPRECIOCONTADO
		*  Objetivo: Devuelve el precio de contado
		*  Entrada : tnPrecioCosto  – Precio de costo
		*            tnPorcMargen   – % de margen sobre costo (ej: 25)
		*  Salida  : tnPrecioContado
		* --------------------------------------------------------------
		LPARAMETERS tnPrecioCosto, tnPorcMargen
		
		LOCAL lnPrecioContado
		
		* Validación básica
		IF VARTYPE(tnPrecioCosto) <> "N" OR VARTYPE(tnPorcMargen) <> "N" ;
		   OR tnPrecioCosto <= 0 OR tnPorcMargen < 0
		   RETURN 0
		ENDIF
		
		* Cálculo
		lnPrecioContado = tnPrecioCosto * (1 + tnPorcMargen / 100)
		
		* Redondeo (ajústalo si necesitas decimales)
		lnPrecioContado = ROUND(lnPrecioContado, 0)
		
		RETURN lnPrecioContado
	ENDPROC

	PROCEDURE cancelar
		with thisform
			.btnnuevo.enabled 		= .t.
			.btnmodificar.enabled 	= .t.
			
			.btnbuscar.enabled 		= .t.
			.btnborrar.enabled 		=.t.
			.btnaceptar.enabled 	= .f.
			.btncancelar.enabled 	= .f.
			.btnbuscarimg.enabled 	= .f.
			.btnquitar.enabled 		= .f.
			.btnplanpago.enabled = .t.
		endwith
		
		thisform.habilitar_ctl(thisform, .f.)
		thisform.llenar_datos()
		thisform.btnnuevo.setfocus()
	ENDPROC

	PROCEDURE field_valid		&& method for field valid
		**validacion de datos
		local lncnt, ln_cant_controls
		
		ln_cant_controls = thisform.controlcount
		for lncnt = 1 to ln_cant_controls
		
			do case
				case upper(thisform.controls(lncnt).baseclass) = "TEXTBOX"
		
					if thisform.controls(lncnt).lobligatorio then
						if empty(thisform.controls(lncnt).value) then
							messagebox("Llene los campos por favor!!", 0 + 64, "Atencion")
							thisform.controls(lncnt).setfocus
							return .f.
						endif
					endif
		
				case upper(thisform.controls(lncnt).baseclass) = "COMBOBOX"
		
					if thisform.controls(lncnt).lobligatorio then
						if empty(thisform.controls(lncnt).value) then
							messagebox("Llene los campos por favor!!", 0 + 64, "Atencion")
							thisform.controls(lncnt).setfocus
							return .f.
						endif
					endif
		
			endcase
		next
		return .t.
	ENDPROC

	PROCEDURE generarcodigo
		LOCAL lcSQL, lcCodigo, lnMaxID
		
		lcCodigo = ""
		
		* Obtener el máximo ID + 1 (más seguro que COUNT)
		TEXT TO lcSQL NOSHOW
		    SELECT IFNULL(MAX(idarticulo), 0) + 1 as proximo_id 
		    FROM articulo
		ENDTEXT
		
		IF SQLEXEC(conexion,lcSQL,"curMax")>0
		    SELECT curMax
		    IF !EOF() AND !ISNULL(proximo_id)
		        lnTotal = INT(VAL(proximo_id))  && Convertir a numérico        
		        * Generar código con formato 00001        
		        lcCodigo = PADL(ALLTRIM(STR(lnTotal)), 5, "0")
		    ENDIF
		ENDIF
		
		RETURN lcCodigo
	ENDPROC

