	ENDPROC

	PROCEDURE guardar
		local lccomando, lcmensaje
		
		do case
			case thisform.coperacion == "N"
				lcmensaje = "¿Desea guardar los datos de artículo?"
			case thisform.coperacion == "M"
				lcmensaje = "¿Desea modificar los datos de artículo?"
			case thisform.coperacion == "B"
				lcmensaje = "¿Desea borrar los datos de artículo?"
		endcase
		
		if not thisform.field_valid()
			return
		endif
		
		if messagebox(lcmensaje, 4 + 32, "Advertencia") = 6
			local lcoperacion, lnidarticulo, lcdescripcion, lccodbarra, lnidplancuota, lnidmarca, lnidgrupo
			local lnidsubgrupo, lnidproveedor, lcunidad, lcimpuesto, lnmargencontado, lninteresmensual
			local lnlimitecuota, lnpreciocosto, lnpreciocontado, lnstockminimo, lctipoimagen, lcfoto, lcdetalle
			local llok, laerr[1], lccodigogenerado, lnnewid, lcorden
			local lnerrorcode, lcerrormessage  && NUEVAS VARIABLES PARA CAPTURAR ERRORES
		
		* Guardar el orden actual para restaurarlo después
			lcorden = order('crsArticulo')
		
			lcoperacion = thisform.coperacion
			lnidarticulo = thisform.txt_idarticulo.value
			lcdescripcion = alltrim(thisform.txt_descripcion.value)
			lccodbarra = alltrim(thisform.txt_codbarra.value)
		
			if lcoperacion = "N" and empty(lccodbarra)
				lccodbarra = ""
			endif
		
			lnidplancuota = thisform.txtcodplanprecio.value
			lnidmarca = thisform.txtcodmarca.value
			lnidgrupo = thisform.txtcodgrupo.value
			lnidsubgrupo = thisform.txtcodsubgrupo.value
			lnidproveedor = thisform.txtcodproveedor.value
			lcunidad = alltrim(thisform.txt_unidad.value)
			lcimpuesto = thisform.cbo_impuesto.value
			lnmargencontado = thisform.txt_margen_contado.value
			lninteresmensual = thisform.txt_interes_mensual.value
			lnlimitecuota = thisform.txt_limite_cuota.value
			lnpreciocosto = thisform.txt_precio_costo.value
			lnpreciocontado = thisform.txt_precio_contado.value
			lnstockminimo = thisform.txt_stock_minimo.value
			lctipoimagen = thisform.cbo_tipo_imagen.value
			lcfoto = iif(thisform.cbo_tipo_imagen.value = 1, thisform.imgbase1.picture, thisform.curl)
			lcdetalle = thisform.edit_detalle.value
		
			= sqlexec(conexion, "START TRANSACTION")
		
		* COMANDO ACTUALIZADO CON LOS NUEVOS PARÁMETROS OUT
			lccomando = "CALL abm_articulo(?lcOperacion, ?lnIdArticulo, ?lcDescripcion, ?lccodbarra, " + ;
				"?lnIdPlanCuota, ?lnIdMarca, ?lnIdGrupo, ?lnIdSubgrupo, ?lnIdProveedor, " + ;
				"?lcUnidad, NULL, NULL, NULL, ?lcImpuesto, ?lnMargenContado, ?lnInteresMensual, " + ;
				"?lnLimiteCuota, ?lnPrecioCosto, ?lnPrecioContado, ?lnStockMinimo, ?lcTipoImagen, " + ;
				"?lcFoto, ?lcDetalle, @lcCodigoGenerado, @lnErrorCode, @lcErrorMessage)"
		
			llok = sqlexec(conexion, lccomando)
		
			if llok > 0
		* OBTENER LOS VALORES DE SALIDA
				llok = sqlexec(conexion, "SELECT @lcCodigoGenerado as codigo_generado, " + ;
					  "@lnErrorCode as error_code, " + ;
					  "@lcErrorMessage as error_message", "curResultado")
		
				if llok > 0 and used("curResultado") and reccount("curResultado") > 0
					lccodigogenerado = alltrim(curresultado.codigo_generado)
					lnerrorcode = int(val(curresultado.error_code))
					lcerrormessage = alltrim(curresultado.error_message)
					use in curresultado
		
		* VERIFICAR SI HUBO ERROR DE VALIDACIÓN DEL SP
					if lnerrorcode > 0
						= sqlexec(conexion, "ROLLBACK")
						messagebox("Error de validación: " + lcerrormessage, 16, "Error")
		
						if lnerrorcode = 45000
							thisform.txt_codbarra.setfocus()
							thisform.txt_codbarra.value = ''
						endif
		
						return
					endif
		
		* SI NO HAY ERROR, CONTINUAR NORMALMENTE
					thisform.txt_codbarra.value = lccodigogenerado
				else
					= sqlexec(conexion, "ROLLBACK")
					messagebox("Error al obtener resultado del procedimiento", 16, "Error")
					return
				endif
		
				if lcoperacion = "N"
					= sqlexec(conexion, "SELECT CAST(LAST_INSERT_ID() AS SIGNED) as new_id", "curNewId")
					if used("curNewId") and reccount("curNewId") > 0
						lnnewid = int(val(curnewid.new_id))
						use in curnewid
					else
						lnnewid = 0
					endif
				else
					lnnewid = lnidarticulo
				endif
		
				= sqlexec(conexion, "COMMIT")
		
				do case
					case lcoperacion = "N"
						messagebox("Artículo creado! Código: " + lccodigogenerado, 64, "Éxito")
					case lcoperacion = "M"
						messagebox("Artículo modificado!", 64, "Éxito")
					case lcoperacion = "B"
						messagebox("Artículo eliminado! Código: " + lccodigogenerado, 64, "Éxito")
				endcase
		
		* Recargar datos desde la base de datos
				= sqlexec(conexion, "SELECT * FROM v_articulo ORDER BY idarticulo", "crsArticulo")
		
		* Restaurar el orden original si existía
				if not empty(lcorden)
					set order to (lcorden) in crsarticulo
				endif
		
		* Posicionarse en el registro correcto
				if lcoperacion = "B"
					if reccount("crsArticulo") > 0
						go top
					else
						thisform.limpiar_datos()
					endif
				else
		* Buscar el registro insertado/modificado
					select crsarticulo
					locate for idarticulo = lnnewid
					if not found()
						if lcoperacion = "N"
							go bottom in crsarticulo
						else
							go top in crsarticulo
						endif
					endif
				endif
		
		* Actualizar interfaz con los datos frescos
				thisform.llenar_datos()
				thisform.cancelar()
			else
		
		
				local lnerrorcount
				lnerrorcount = aerror(laerr)
		
				if lnerrorcount > 0
					messagebox("Error de conexión: " + laerr[2], 16, "Error")
				else
					messagebox("Error desconocido al ejecutar el procedimiento", 16, "Error")
				endif
		
		* ERROR EN LA EJECUCIÓN DEL SQLEXEC
				= sqlexec(conexion, "ROLLBACK")
			endif
		endif
	ENDPROC

	PROCEDURE habilitar_ctl
		lparameters tocontrol, tlenlable
		
		for each ocontrol in m.tocontrol.controls
			if ocontrol.baseclass = "Textbox" or ocontrol.baseclass = "Editbox" or ocontrol.baseclass = "Combobox"
				if ocontrol.tag!= "*"
					ocontrol.enabled = m.tlenlable
				endif
			endif
		ENDFOR
		
		thisform.cbo_tipo_imagen.thisenabled(m.tlenlable)
		
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tnidarticulo
		
		local lcsql
		
		
		IF PCOUNT()>0 AND VARTYPE(tnidarticulo) =="N"
			lcsql = "select * from v_articulo where idarticulo = ?tnidarticulo order by idarticulo"
			thisform.btnnuevo.Enabled =.f.
			thisform.btnmodificar.Enabled = .f.
			thisform.btnborrar.Enabled = .f.
			thisform.btnbuscar.Enabled =.f.
			thisform.WindowType = 1
		ELSE
			lcsql = "select * from v_articulo order by idarticulo"
		ENDIF 
		
		
		if sqlexec(conexion, lcsql, "crsArticulo") > 0
			go top
			thisform.llenar_datos()
		ENDIF
		
		
		this.habilitar_ctl(thisform,.f.)
		this.backcolor = _screen.oribbon.backcolor1
	ENDPROC

	PROCEDURE KeyPress
		lparameters nkeycode, nshiftaltctrl
		
		if m.nkeycode = -3
			nodefault
			thisform.btninventario.click()
		endif
		
		if m.nkeycode = 22
			nodefault
			thisform.release
		endif
		
		if m.nkeycode = 7
			nodefault
			if thisform.txtid.value > 0
				if messagebox("Desea eliminar este articulo?", 292, "Aviso") = 6
					select crsarticulo
					delete
					if thisform.ouarticulo.put(thisform.txtid.value)
						messagebox("Articulo eliminado!", 320, "Aviso")
						thisform.cancelar()
					endif
				endif
			endif
		endif
		
		
	ENDPROC

	PROCEDURE limpiar_ctl
		lparameters tocontrol
		for each ocontrol in m.tocontrol.controls
			if ocontrol.baseclass = "Textbox"
				ocontrol.limpiarctl()
			endif
		endfor
		
		this.edit_detalle.value = ""
		this.cbo_impuesto.value = "10"
		this.imgbase1.Picture = "imagenes\sin_img.png"
		this.cbo_tipo_imagen.Value=1
	ENDPROC

	PROCEDURE limpiar_datos
		WITH thisform
			* Limpiar campos principales
			.txt_idarticulo.Value = 0
			.txt_codbarra.Value = ""
			.txt_descripcion.Value = ""
			
			* Limpiar IDs de referencias
			.txtcodgrupo.Value = 0
			.txtcodsubgrupo.Value = 0
			.txtcodmarca.Value = 0
			.txtcodproveedor.Value = 0
			.txtcodplanprecio.Value = 0
			
			* Limpiar nombres de referencias
			.txtgrupo.Value = ""
			.txtsubgrupo.Value = ""
			.txtmarca.Value = ""
			.txtproveedor.Value = ""
			.txtplan.Value = ""
			
			* Limpiar plan de cuotas
			.txt_margen_contado.Value =0.00
			.txt_interes_mensual.Value = 0.00
			.txt_limite_cuota.Value = 0
			
			* Limpiar información del artículo
			.txt_unidad.Value = ""
			.txt_precio_costo.Value = 0
			.txt_precio_contado.Value = 0
			.txt_stock_minimo.Value = 0
			
			* Limpiar combos y campos especiales
			.cbo_impuesto.Value = "10"
			.edit_detalle.Value = ""
			.cbo_tipo_imagen.Value = 1
			
			* Limpiar imagen
			IF PEMSTATUS(thisform, "setimagen", 5)
				.setimagen("", "LOCAL")
			ENDIF
			
		ENDWITH
		
		* Actualizar estado de navegación
		thisform.actualizar_navegacion()
		
	ENDPROC

	PROCEDURE llenar_datos
		* Validar que el cursor principal existe y tiene datos
		IF NOT USED('crsArticulo')
			RETURN
		ENDIF
		
		IF EOF('crsArticulo') OR BOF('crsArticulo') OR RECCOUNT('crsArticulo') = 0
			thisform.limpiar_datos()
			RETURN
		ENDIF
		
		WITH thisform
			* Campos principales
			.txt_idarticulo.Value = NVL(crsArticulo.idarticulo, 0)
			.txt_codbarra.Value = ALLTRIM(NVL(crsArticulo.codbarra, ""))
			.coldcode = ALLTRIM(.txt_codbarra.Value)
			.txt_descripcion.Value = NVL(crsArticulo.descripcion, "")
			
			* IDs de referencias
			.txtcodgrupo.Value = NVL(crsArticulo.idgrupo, 0)
			.txtcodsubgrupo.Value = NVL(crsArticulo.idsubgrupo, 0)
			.txtcodmarca.Value = NVL(crsArticulo.idmarca, 0)
			.txtcodproveedor.Value = NVL(crsArticulo.idproveedor, 0)
			.txtcodplanprecio.Value = NVL(crsArticulo.idplan_cuota, 0)
			
			* Nombres de referencias
			.txtgrupo.Value = NVL(crsArticulo.nombre_grupo, "")
			.txtsubgrupo.Value = NVL(crsArticulo.nombre_subgrupo, "")
			.txtmarca.Value = NVL(crsArticulo.nombre_marca, "")
			.txtproveedor.Value = NVL(crsArticulo.nombre_proveedor, "")
			.txtplan.Value = NVL(crsArticulo.nombre_plan_cuota, "")
			
			* Plan de cuotas
			.txt_margen_contado.Value = NVL(crsArticulo.margen_contado, 0.00)
			.txt_interes_mensual.Value = NVL(crsArticulo.interes_mensual, 0.00)
			.txt_limite_cuota.Value = NVL(crsArticulo.limite_cuota, 0)
			
			* Información del artículo
			.txt_unidad.Value = NVL(crsArticulo.unidad, "")
			.txt_precio_costo.Value = NVL(crsArticulo.precio_costo, 0)
			.txt_precio_contado.Value = NVL(crsArticulo.precio_contado, 0)
			.txt_stock_minimo.Value = NVL(crsArticulo.stock_minimo, 0)
			
			.txt_precio_costo.inputmask= "999,999,999"
			.txt_precio_contado.inputmask= "999,999,999"
			
			* Combos y campos especiales
			.cbo_impuesto.Value = NVL(crsArticulo.impuesto, "10")
			.edit_detalle.Value = NVL(crsArticulo.detalle, "")
			
			* Manejo seguro del tipo de imagen
			DO CASE
				CASE UPPER(NVL(crsArticulo.tipo_imagen, "")) = "LOCAL"
					.cbo_tipo_imagen.Value = 1
				CASE UPPER(NVL(crsArticulo.tipo_imagen, "")) = "URL"
					.cbo_tipo_imagen.Value = 2
				OTHERWISE
					.cbo_tipo_imagen.Value = 1  && Valor por defecto
			ENDCASE
			
			* Cargar imagen de forma segura
			IF PEMSTATUS(thisform, "setimagen", 5)
				.setimagen(NVL(crsArticulo.foto, ""), NVL(crsArticulo.tipo_imagen, "LOCAL"))
				.curl = crsArticulo.foto
			ENDIF
			
			
			
		ENDWITH
		
		* Actualizar estado de navegación
		thisform.actualizar_navegacion()
		
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
	ENDPROC

	PROCEDURE modificar
		thisform.habilitar_ctl(thisform,.t.)
		
		with THISFORM 
			.coperacion ="M" 
			.btnnuevo.Enabled = .f.
			.btnmodificar.Enabled = .f.
			.btnborrar.enabled =.f.
			.btnaceptar.Enabled = .t.
			.btncancelar.Enabled = .t.
			.btnquitar.enabled = .t.
			.btnbuscarimg.Enabled = .t.
			.txt_idarticulo.enabled = .f.
			.txt_codbarra.SetFocus()
			.bloquear_boton_nav()
		endwith 
		
	ENDPROC

	PROCEDURE nuevo
		with thisform
			.coperacion = "N"
			.btnnuevo.enabled = .f.
			.btnbuscar.enabled =.f.
			.btnborrar.enabled =.f.
		
			.btnaceptar.enabled =.t.
			.btncancelar.enabled =.t.
			.btnbuscarimg.enabled = .t.
			.txt_idarticulo.enabled = .f.
		
			.btnquitar.enabled = .t.
			.btnplanpago.enabled = .f.
			.btnmodificar.enabled = .f.
			.cbo_impuesto.value = "10"
			
			.txt_codbarra.setfocus()
			.bloquear_boton_nav()
			.limpiar_ctl(thisform)
		ENDWITH
		
	ENDPROC

	PROCEDURE seleccionarimagen
		local lcarchivo, lcfiltro, lctitulo
		local loex
		
		*-- Definir filtros para tipos de imagen
		lcfiltro = "Archivos de Imagen|*.jpg;*.jpeg;*.png;*.gif;*.bmp;*.ico;*.tif;*.tiff|" + ;
			"JPEG (*.jpg,*.jpeg)|*.jpg;*.jpeg|" + ;
			"PNG (*.png)|*.png|" + ;
			"GIF (*.gif)|*.gif|" + ;
			"Bitmap (*.bmp)|*.bmp|" + ;
			"Iconos (*.ico)|*.ico|" + ;
			"TIFF (*.tif,*.tiff)|*.tif;*.tiff|" + ;
			"Todos los archivos (*.*)|*.*"
		
		lctitulo = "Seleccionar Imagen"
		
		*-- Abrir diálogo de selección
		lcarchivo = getfile("jpg,jpeg,png,gif,bmp,ico,tif,tiff", lctitulo, "Abrir", 0, "Seleccionar imagen")
		
		*-- Verificar si se seleccionó un archivo
		if empty(lcarchivo)
			return .f.
		endif
		
		*-- Verificar que el archivo existe
		if !file(lcarchivo)
			messagebox("El archivo seleccionado no existe", 16, "Error")
			return .f.
		endif
		
		RETURN lcarchivo
	ENDPROC

	PROCEDURE setcodigo
	ENDPROC

	PROCEDURE setimagen		&& metodo para colocar la imagen en el control.
		LPARAMETERS tcImagen, tcTipoImagen
		LOCAL lcUrl
		
		ThisForm.imgbase1.Picture = 'imagenes\sin_img.png'
		
		IF EMPTY(tcImagen)
		    RETURN .F.
		ENDIF 
		
		IF tcTipoImagen == "LOCAL"
			thisform.lbldescarga.caption=''
		    ThisForm.imgbase1.Picture = tcImagen
		ELSE
		
		    
		    *-- 1. Crear el objeto XMLHTTP si no existe
		    IF VARTYPE(ThisForm.oHttp) != "O"
		        ThisForm.AddProperty("oHttp", .NULL.)
		    ENDIF
		    
		    ThisForm.oHttp = CREATEOBJECT("Microsoft.XMLHTTP")
		    
		    *-- 2. Configurar la URL
		    lcUrl = tcImagen
		    this.curl = lcUrl 
		    
		    *-- IMPORTANTE: El tercer parámetro (.T.) indica ASÍNCRONO
		    ThisForm.oHttp.Open("GET", lcUrl, .T.) 
		    
		    *-- 3. Enviar la petición (esto ocurre al instante y sigue de largo)
		    TRY
		    	thisform.lbldescarga.caption='Descargando....'
		        ThisForm.oHttp.Send()
		        
		        *-- 4. Guardamos la ruta destino en una propiedad temporal del timer o form para usarla luego
		        IF !PEMSTATUS(ThisForm.tmrDescarga, "cFileDestino", 5)
		            ThisForm.tmrDescarga.AddProperty("cFileDestino", "")
		        ENDIF
		        ThisForm.tmrDescarga.cFileDestino = ADDBS(SYS(2023)) + "imagen_descargada.jpg"
		        
		        *-- 5. Encendemos el Timer para que vigile la descarga
		        ThisForm.tmrDescarga.Enabled = .T.
		        
		    CATCH TO loErr
		        MESSAGEBOX("No se pudo iniciar la descarga: " + loErr.Message)
		    ENDTRY
		ENDIF
		
	ENDPROC

	PROCEDURE Unload
		local lctempfile
		
		lctempfile =  ADDBS(SYS(2023)) + "imagen_descargada.jpg"
		
		if file(lctempfile)
			DELETE FILE (lctempfile)
		endif
	ENDPROC

	PROCEDURE btnaceptar.Click
		thisform.guardar()
	ENDPROC

	PROCEDURE btnborrar.Click
		if messagebox("Desea eliminar este registro de articulo?", 36, "Aviso") = 6
			thisform.coperacion = "B"
			thisform.guardar()
		endif
		
		
	ENDPROC

	PROCEDURE btnbuscar.Click
		local loregistro
		
		do form bus_articulo WITH 1,1 to loregistro
		
		if vartype(loregistro) <> "L"
			select crsarticulo
			locate for idarticulo = loregistro.idarticulo
		
			if not found()
				MESSAGEBOX("registro no encontrado!",016,"Error")
				go top in crsarticulo
			endif
		
			thisform.llenar_datos()
		
		endif
	ENDPROC

	PROCEDURE btnbuscarimg.Click
		if thisform.cbo_tipo_imagen.value = 1
			thisform.setimagen(thisform.seleccionarimagen(), "LOCAL")
		else
			local lcurl
			lcurl = ""
			do form frm_pegar_url TO lcurl
			thisform.setimagen(lcurl, "URL")
		endif
	ENDPROC

	PROCEDURE btncancelar.Click
		thisform.cancelar()
	ENDPROC

	PROCEDURE btnmodificar.Click
		thisform.modificar()
	ENDPROC

	PROCEDURE btnnuevo.Click
		thisform.habilitar_ctl(thisform,.t.)
		thisform.nuevo()
	ENDPROC

	PROCEDURE BTNPLANPAGO.Click
		IF thisform.txt_margen_contado.Value <=0
			messagebox("El % del margen  contado debe ser > 0 para generar el plan de cuotas.", 48, "Aviso")
			RETURN 
		ENDIF 
		
		
		*!*	IF thisform.txt_interes_mensual.Value<=0
		*!*		messagebox("El % del interes mensual debe ser > 0 para generar el plan de cuotas.", 48, "Aviso")
		*!*		RETURN 
		
		*!*	ENDIF 
		
		
		IF thisform.txt_limite_cuota.Value<=0
			messagebox("El valor del limite debe ser > 0 para generar el plan de cuotas.", 48, "Aviso")
			RETURN 
		ENDIF 
		
		
		
		DO FORM frm_plancuota WITH thisform.txt_descripcion.Value,thisform.txt_precio_contado.Value;
		,thisform.txt_limite_cuota.Value,thisform.txt_interes_mensual.Value
	ENDPROC

	PROCEDURE btnquitar.Click
		thisform.imgbase1.Picture = "imagenes\sin_img.png"
	ENDPROC

	PROCEDURE btnsalir.Click
		thisform.Release()
	ENDPROC

	PROCEDURE cbo_impuesto.GotFocus
		keyboard '{spacebar}'
		keyboard '{HOME}'
	ENDPROC

	PROCEDURE cmdAnterior.Click
		IF USED('crsArticulo') AND RECCOUNT('crsArticulo') > 0
		    IF NOT BOF('crsArticulo')
		        SKIP -1 IN crsArticulo
		        IF BOF('crsArticulo')
		            GO TOP IN crsArticulo
		        ENDIF
		        thisform.llenar_datos()
		    ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdPrimero.Click
		IF USED('crsArticulo') AND RECCOUNT('crsArticulo') > 0
		    GO TOP IN crsArticulo
		    thisform.llenar_datos()
		ENDIF
	ENDPROC

	PROCEDURE cmdSiguiente.Click
		IF USED('crsArticulo') AND RECCOUNT('crsArticulo') > 0
		    IF NOT EOF('crsArticulo')
		        SKIP 1 IN crsArticulo
		        IF EOF('crsArticulo')
		            GO BOTTOM IN crsArticulo
		        ENDIF
		        thisform.llenar_datos()
		    ENDIF
		ENDIF
	ENDPROC

	PROCEDURE cmdUltimo.Click
		IF USED('crsArticulo') AND RECCOUNT('crsArticulo') > 0
		    GO BOTTOM IN crsArticulo
		    thisform.llenar_datos()
		ENDIF
	ENDPROC

	PROCEDURE tmrDescarga.Timer
		*-- Verificar estado del objeto HTTP
		*-- ReadyState 4 significa "Completado"
		IF VARTYPE(ThisForm.oHttp) = "O" AND ThisForm.oHttp.readyState = 4
		    
		    *-- Apagar el timer para que no siga ejecutándose
		    This.Enabled = .F.
		    
		    *-- Verificar si la descarga fue exitosa (Status 200 = OK)
		    IF ThisForm.oHttp.Status = 200
		        LOCAL loStream, lcFile
		        lcFile = This.cFileDestino
		        
		        *-- Usamos ADODB.Stream para guardar datos binarios (imágenes)
		        *-- STRTOFILE a veces corrompe imágenes si hay conversión de codigos de página
		        TRY
		            loStream = CREATEOBJECT("ADODB.Stream")
		            loStream.Type = 1 && Tipo Binario
		            loStream.Open()
		            loStream.Write(ThisForm.oHttp.ResponseBody)
		            loStream.SaveToFile(lcFile, 2) && 2 = Overwrite
		            loStream.Close()
		            
		            *-- Asignar la imagen al control
		            ThisForm.imgbase1.Picture = lcFile
		            ThisForm.imgbase1.Picture = lcFile
		            
		        CATCH
		            MESSAGEBOX("Error al guardar la imagen en disco.", 16, "Error")
		            ThisForm.imgbase1.Picture = 'imagenes\sin_img.png'
		        ENDTRY
		    ELSE
		        MESSAGEBOX("Error al descargar la imagen. Servidor respondió: " + TRANSFORM(ThisForm.oHttp.Status), 16, "Error")
		         ThisForm.imgbase1.Picture = 'imagenes\sin_img.png'
		    ENDIF
		    
		    *-- Limpiar objeto
		    ThisForm.oHttp = .NULL.
		    thisform.lbldescarga.caption=''
		ENDIF
	ENDPROC

	PROCEDURE txtcodgrupo.KeyPress
		lparameters nkeycode, nshiftaltctrl
		
		if nkeycode = 42
			nodefault
			local loregistro as object
			do form bus_grupo to loregistro
		
		
			if vartype(loregistro) <> "L"
				this.value = loregistro.idgrupo
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
		
		if m.nkeycode = 22
			nodefault
			local lncodigo
			do form grupo with .t. to m.lncodigo
			this.value = m.lncodigo
		endif
	ENDPROC

	PROCEDURE txtcodgrupo.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnPersonalID, lcSQL
		    
		    lngrupoID= this.Value
		    
		    lcSQL = "SELECT * FROM grupo WHERE idGrupo = " + ALLTRIM(STR(lngrupoID, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_grupo") > 0
		        IF RECCOUNT("cur_grupo") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_grupo.idGrupo
					thisform.txtgrupo.Value = cur_grupo.grupo
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Grupo no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txtgrupo.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar grupo: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txtgrupo.Value = ""
		ENDIF
	ENDPROC

	PROCEDURE txtcodgrupo.Valid
		NODEFAULT 
	ENDPROC

