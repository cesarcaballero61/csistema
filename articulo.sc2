	PROCEDURE txt_precio_contado.GotFocus
		DODEFAULT()
		this.InputMask = "999999999"
	ENDPROC

	PROCEDURE txt_precio_contado.LostFocus
		DODEFAULT()
		IF EMPTY(this.Value)
			this.Value= thisform.CalcularPrecioContado(thisform.txt_precio_costo.Value,thisform.txt_margen_contado.Value)
		ENDIF 
		this.InputMask = "999,999,999"
		
		
	ENDPROC

