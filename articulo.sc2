	PROCEDURE TXTCODPLANPRECIO.KeyPress
		lparameters nkeycode, nshiftaltctrl
		local lncodigo
		
		if nkeycode = 42
			nodefault
			local loregistro as object
			do form bus_plancuota to loregistro
		
			if vartype(loregistro) <> "L"
				this.value = loregistro.idplan_cuota
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
		if m.nkeycode = 22
			nodefault
			do form plan_cuota with .t. to m.lncodigo
			this.value = m.lncodigo
		endif
	ENDPROC

	PROCEDURE TXTCODPLANPRECIO.LostFocus
		dodefault()
		if not empty(this.value)
			local lnplanprecioid, lcsql
		
			lnplanprecioid = this.value
		
			lcsql = "SELECT * FROM plan_cuota WHERE idplan_cuota= " + alltrim(str(lnplanprecioid, 20, 0))
		
			if sqlexec(conexion, lcsql, "cur_planprecio") > 0
				if reccount("cur_planprecio") > 0
		
		** Llenar campos del formulario.
					this.value = cur_planprecio.idplan_cuota
					thisform.txtplan.value = alltrim(cur_planprecio.nombre_plan)
					thisform.txt_margen_contado.value 	= cur_planprecio.margen_contado
					thisform.txt_interes_mensual.value 	= cur_planprecio.interes_mensual
					thisform.txt_limite_cuota.value    	= cur_planprecio.limite_cuota
		
				else
		
		** Personal no encontrado
					messagebox("Plan de precio no encontrado", 16, "Atención")
					this.value = 0
					thisform.txtplan.value = ''
					thisform.txt_margen_contado.value = 0
					thisform.txt_interes_mensual.value = 0
					thisform.txtlimitecuota.value    = 0
		
		** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		
					this.setfocus()
					nodefault
		
				endif
			else
		** Error en la consulta
				local laerror[1]
				aerror(laerror)
				messagebox("Error al buscar plan precio: " + laerror[2], 16, "Error")
			endif
		else
			thisform.txtplan.value = ''
			thisform.txt_margen_contado.value = 0
			thisform.txt_interes_mensual.value = 0
			thisform.txt_limite_cuota.value    = 0
		endif
	ENDPROC

	PROCEDURE TXTCODPLANPRECIO.Valid
		NODEFAULT 
	ENDPROC

	PROCEDURE txtcodproveedor.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			nodefault
			local loregistro as object
			do FORM bus_proveedor to loregistro
		
			if vartype(loregistro) <> "L"
				this.value = loregistro.idproveedor
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
		if m.nkeycode = 22
			NODEFAULT
			
			do form proveedor with .t. to m.lncodigo
			this.Value = m.lncodigo
		endif
	ENDPROC

	PROCEDURE txtcodproveedor.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnproveedorID, lcSQL
		    
		    lnproveedorID= this.Value
		    
		    lcSQL = "SELECT * FROM proveedor WHERE idproveedor= " + ALLTRIM(STR(lnproveedorID, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_proveedor") > 0
		        IF RECCOUNT("cur_proveedor") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_proveedor.idproveedor
					thisform.txtproveedor.Value = ALLTRIM(cur_proveedor.proveedor)
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Proveedor no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txtproveedor.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar proveedor: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txtproveedor.Value = ""
		ENDIF
	ENDPROC

	PROCEDURE txtcodproveedor.Valid
		NODEFAULT 
	ENDPROC

	PROCEDURE txtcodsubgrupo.KeyPress
		lparameters nkeycode, nshiftaltctrl
		
		local lncodigo
		
		if nkeycode = 42
			nodefault
			local loregistro as object
			do form bus_subgrupo with thisform.txtcodgrupo.value to loregistro
		
			if vartype(loregistro) <> "L"
				this.value = loregistro.idgrupo
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
		if m.nkeycode = 22 && TECLA (INS) INSERTAR.
			nodefault
			do form subgrupo with .t., thisform.txtcodgrupo.value to m.lncodigo
			this.value = m.lncodigo
		endif
	ENDPROC

	PROCEDURE txtcodsubgrupo.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lngrupoID, lnsubgrupoID, lcSQL
		    
		    lngrupoID= thisform.txtcodgrupo.Value
		    lnsubgrupoID = this.Value
		    
		    lcSQL = "SELECT * FROM subgrupo WHERE idsubgrupo = " + ALLTRIM(STR(lnsubgrupoID , 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_subgrupo") > 0
		        IF RECCOUNT("cur_subgrupo") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_subgrupo.idsubgrupo
					thisform.txtsubgrupo.Value = cur_subgrupo.subgrupo
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Subgrupo no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txtsubgrupo.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar subgrupo: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txtsubgrupo.Value = ""
		ENDIF
	ENDPROC

	PROCEDURE txtcodsubgrupo.Valid
		NODEFAULT 
	ENDPROC

