		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Form1.txt_fecha_desde' AS textbox WITH ;
		Alignment = 3, ;
		FontSize = 8, ;
		Format = "k", ;
		Height = 22, ;
		IntegralHeight = .T., ;
		Left = 107, ;
		Name = "txt_fecha_desde", ;
		TabIndex = 3, ;
		Top = 72, ;
		Value = (date()), ;
		Width = 72
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Form1.txt_fecha_hasta' AS textbox WITH ;
		Alignment = 3, ;
		FontSize = 8, ;
		Format = "k", ;
		Height = 22, ;
		IntegralHeight = .T., ;
		Left = 107, ;
		Name = "txt_fecha_hasta", ;
		TabIndex = 3, ;
		Top = 96, ;
		Value = (date()), ;
		Width = 72
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Form1.txt_sucursal' AS textbox WITH ;
		DisabledForeColor = 0,0,0, ;
		Enabled = .F., ;
		FontSize = 8, ;
		Height = 22, ;
		IntegralHeight = .T., ;
		Left = 145, ;
		Name = "txt_sucursal", ;
		TabIndex = 9, ;
		Top = 24, ;
		Width = 167
		*< END OBJECT: BaseClass="textbox" />
	
	PROCEDURE Form1.Command1.Click
		cap_desde = thisform.txt_fecha_desde.value
		cap_hasta = thisform.txt_fecha_hasta.value
		
		cap_cod_sucursal = thisform.txt_cod_sucursal.value
		cap_cod_cobrador = thisform.txt_cod_cobrador.value
		
		if wexist('Crystal')
			return
		endif
		
		crystal = createobject("CrystalRuntime.Application")
		reporte = crystal.openreport("inf_cobranza_cobrador.rpt")
		reporte.discardsaveddata()
		
		oparameters = reporte.parameterfields()
		oparameters.item(1).setcurrentvalue(cap_cod_sucursal)
		oparameters.item(2).setcurrentvalue(cap_cod_cobrador)
		oparameters.item(3).setcurrentvalue(cap_desde)
		oparameters.item(4).setcurrentvalue(cap_hasta)
		
		
		thisformset.addobject("Crystal", "frm_visor")
		with thisformset.crystal
			.addobject("CRViewer", "OleControl", "CRViewer9.CRViewer.9.2")
			.caption = "Informe de cobranza"
			.windowstate = 2
			.autocenter = .t.
			.visible = .t.
			.lockscreen = .f.
			.maxbutton = .t.
			.minbutton = .t.
		endwith
		
		with thisformset.crystal.crviewer
			.top = 0
			.left = 0
			.height = thisformset.crystal.height
			.width = thisformset.crystal.width
			.visible = .t.
			.reportsource = reporte
			.enableexportbutton = .t.
			.displaygrouptree = .f.
			.enableprintbutton = .t.
			.enablerefreshbutton = .t.
			.enablesearchcontrol = .t.
			.enablezoomcontrol = .t.
			.enableselectexpertbutton = .t.
			.enablesearchexpertbutton = .t.
		endwith
		thisformset.crystal.crviewer.viewreport
	ENDPROC

	PROCEDURE Form1.Command2.Click
		thisformset.Release
	ENDPROC

	PROCEDURE Form1.Command3.Click
		
		reg=buscar_sucursal()
		IF VARTYPE(reg)!="L"
			thisform.txt_cod_sucursal.Value=reg.idsucursal
			thisform.txt_cod_sucursal.SetFocus
		ENDIF 
	ENDPROC

	PROCEDURE Form1.Command4.Click
		reg=buscar_cobrador()
		IF VARTYPE(reg)!="L"
			thisform.txt_cod_cobrador.Value=reg.idcobrador
			thisform.txt_cod_cobrador.SetFocus
		ENDIF 
	ENDPROC

	PROCEDURE Form1.txt_cod_cobrador.Valid
		if not empty(this.value)
		
			cexp = "select * from v_cobrador where idcobrador=" + alltrim(str(this.value, 20, 0))
		
			if sqlexec(conexion, cexp, "cur_cobrador") > 0
				if reccount("cur_cobrador") > 0
		
					thisform.txt_cod_cobrador.value = cur_cobrador.idcobrador
					thisform.txt_cobrador.value = alltrim(cur_cobrador.nombre) + ", " + alltrim(cur_cobrador.apellido)
				else
		
					messagebox("Este registro no existe..", 016, "Atención")
					thisform.txt_cod_cobrador.value = 0
					thisform.txt_cobrador.value = ''
				endif
			else
				aerror(err)
				warning(err(2))
			endif
		else
			thisform.txt_cobrador.value = "Todos los cobradores."
		endif
	ENDPROC

	PROCEDURE Form1.txt_cod_sucursal.Valid
		if not empty(this.value)
		
			cexp = "select * from sucursal where idsucursal=" + alltrim(str(this.value, 20, 0))
		
			if sqlexec(conexion, cexp, "cur_sucursal") > 0
				if reccount("cur_sucursal") > 0
					thisform.txt_cod_sucursal.value = cur_sucursal.idsucursal
					thisform.txt_sucursal.value = cur_sucursal.sucursal
				else
					messagebox("Este registro no existe..", 016, "Atención")
					thisform.txt_cod_sucursal.value = 0
					thisform.txt_sucursal.value = ''
				endif
			else
				aerror(err)
				warning(err(2))
			endif
		else
			thisform.txt_sucursal.value = "Todas las sucursales."
		endif
	ENDPROC

ENDDEFINE
