		BorderStyle = 0, ;
		Caption = "Sucursal", ;
		FontSize = 8, ;
		Height = 16, ;
		Left = 24, ;
		Name = "Label1", ;
		TabIndex = 6, ;
		Top = 27, ;
		Width = 45
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Form1.Label2' AS label WITH ;
		AutoSize = .T., ;
		BackStyle = 0, ;
		BorderStyle = 0, ;
		Caption = "Cobrador:", ;
		FontSize = 8, ;
		Height = 16, ;
		Left = 24, ;
		Name = "Label2", ;
		TabIndex = 7, ;
		Top = 51, ;
		Width = 50
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Form1.Label3' AS label WITH ;
		AutoSize = .T., ;
