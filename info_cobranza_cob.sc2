	*<PropValue>
		AutoRelease = .T.
		DataSession = 1
		Name = "Formset"
	*</PropValue>

	ADD OBJECT 'Form1' AS form WITH ;
		AutoCenter = .T., ;
		Caption = "Informe de cobranza cobrador", ;
		DoCreate = .T., ;
		FontSize = 8, ;
		Height = 171, ;
		Icon = iconos\ventana.ico, ;
		Name = "Form1", ;
		ShowWindow = 1, ;
		Width = 355
		*< END OBJECT: BaseClass="form" />

	ADD OBJECT 'Form1.Command1' AS commandbutton WITH ;
		Caption = "Aceptar", ;
