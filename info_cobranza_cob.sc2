		Width = 66
		*< END OBJECT: BaseClass="label" />

	ADD OBJECT 'Form1.txt_cobrador' AS textbox WITH ;
		DisabledForeColor = 0,0,0, ;
		Enabled = .F., ;
		FontSize = 8, ;
		Height = 22, ;
		IntegralHeight = .T., ;
		Left = 144, ;
		Name = "txt_cobrador", ;
