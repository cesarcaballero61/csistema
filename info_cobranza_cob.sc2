		Height = 27, ;
		Left = 93, ;
		Name = "Command1", ;
		TabIndex = 4, ;
		Top = 129, ;
		Width = 84
		*< END OBJECT: BaseClass="commandbutton" />

	ADD OBJECT 'Form1.Command2' AS commandbutton WITH ;
		Caption = "Cancelar", ;
