		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Form1.txt_cod_cobrador' AS textbox WITH ;
		Alignment = 3, ;
		FontSize = 8, ;
		Format = "k", ;
		Height = 22, ;
		IntegralHeight = .T., ;
		Left = 107, ;
		Name = "txt_cod_cobrador", ;
		TabIndex = 2, ;
		Top = 48, ;
		Value = 0, ;
		Width = 36
		*< END OBJECT: BaseClass="textbox" />

	ADD OBJECT 'Form1.txt_cod_sucursal' AS textbox WITH ;
		Alignment = 3, ;
		FontSize = 8, ;
		Format = "k", ;
		Height = 22, ;
		IntegralHeight = .T., ;
		Left = 107, ;
		Name = "txt_cod_sucursal", ;
		TabIndex = 1, ;
