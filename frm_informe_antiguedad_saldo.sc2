	ADD OBJECT 'txt_cobrador' AS txtbase WITH ;
		DisabledForeColor = 0,0,0, ;
		Enabled = .F., ;
		Height = 22, ;
		Left = 180, ;
		Name = "txt_cobrador", ;
		TabIndex = 3, ;
		Top = 104, ;
		Width = 153
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="textbox" />

	ADD OBJECT 'txt_id_cobrador' AS txtbase WITH ;
		Alignment = 3, ;
		Format = "k!", ;
		Height = 22, ;
		Left = 143, ;
		Name = "txt_id_cobrador", ;
		TabIndex = 2, ;
		Top = 104, ;
		Value = 0, ;
		Width = 36
		*< END OBJECT: ClassLib="clases\controles.vcx" BaseClass="textbox" />
	
	PROCEDURE Init
		DODEFAULT()
		thisform.fecha_hasta.setvalue(DATE())
	ENDPROC

	PROCEDURE btn_aceptar.Click
		LOCAL ldFechaCorte, lncodCobrador
		LOCAL lcSQL, lnResult, loException
		
		ldFechaCorte  =thisform.fecha_hasta.getvalue()
		lncodCobrador = thisform.txt_id_COBRADOR.Value
		
		lcCobrador = ALLTRIM(thisform.txt_cobrador.Value)
		
		TRY
		    * Construir la llamada al stored procedure sp_antiguedad_saldos
		    lcSQL = "CALL sp_antiguedad_saldos(" + ;
		            ALLTRIM(STR(lncodCobrador)) + ", '" + ;
		            fechatoMysql(ldFechaCorte) + "')"
		    
		    * Ejecutar la consulta
		    lnResult = SQLEXEC(CONEXION, lcSQL, "curAntiguedadSaldos")
		    
		    IF lnResult > 0
		        * Verificar si hay datos
		        IF RECCOUNT("curAntiguedadSaldos") > 0
		            
		            * Imprimir el informe
		           REPORT FORM _antiguedad_saldo PREVIEW NOCONSOLE 
		        ELSE
		            MESSAGEBOX("No se encontraron registros para los criterios especificados", 64, "Información")
		        ENDIF
		    ELSE
		        MESSAGEBOX("Error al ejecutar la consulta de antigüedad de saldos", 16, "Error")
		    ENDIF
		    
		CATCH TO loException
		    MESSAGEBOX("Error: " + loException.Message, 16, "Error en consulta")
		ENDTRY
	ENDPROC

	PROCEDURE btn_cancelar.Click
		THISFORM.Release()
	ENDPROC

	PROCEDURE txt_id_cobrador.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			local loregistro as object
			do form bus_cobrador to loregistro
		
		
			if vartype(loregistro) <> "L"
		
				this.value = loregistro.idcobrador
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
	ENDPROC

	PROCEDURE txt_id_cobrador.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnIDcobrador, lcSQL
		    
		    lnIDcobrador= this.Value
		    
		    lcSQL = "SELECT * FROM v_cobradores WHERE idcobrador = " + ALLTRIM(STR(lnIDcobrador, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_cobrador") > 0
		        IF RECCOUNT("cur_cobrador") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_cobrador.idcobrador
					thisform.txt_cobrador.Value = cur_cobrador.nombre_completo
					*
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Cobrador no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_cobrador.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar Cobrador: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_cobrador.Value = "TODOS"
		ENDIF
	ENDPROC

ENDDEFINE
