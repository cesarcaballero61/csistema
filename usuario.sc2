	PROCEDURE checkpass
		lparameters tcpass1, tcpass2
		local llok as boolean
		
		llok = .f.
		llok = (thisform.gethash(tcpass1) == thisform.gethash(tcpass2))
		
		return llok
	ENDPROC

	PROCEDURE gethash
		lparameters tcstring
		local lcstring as string
		local lchash as string
		
		lcstring = ""
		lchash = ""
		
		lcstring = alltrim(tcstring)
		
		lchash = this.ovfphash.hash(lcstring, "md5")
		
		return lchash
	ENDPROC

	PROCEDURE Init
		=SQLEXEC(conexion,"select * from v_usuarios idusuario ","cur_usuario")
		
		GO top
		thisform.ovfphash = newobject("vfphash","vfphash.vcx")
		thisform.llenar_dato()
		thisform.llenar_grid()
	ENDPROC

	PROCEDURE llenar_dato
		thisform.txt_codigo.Value=cur_usuario.idusuario
		thisform.txt_cod_personal.Value=cur_usuario.idpersonal
		thisform.txt_personal.Value=ALLTRIM(cur_usuario.nombre_completo)
		thisform.txt_user.Value=cur_usuario.nick
		*thisform.txt_clave.Value =cur_usuario.clave
		*thisform.txt_clave1.Value =cur_usuario.clave
		thisform.opg_tipousuario.Value = cur_usuario.tipo
		
		
	ENDPROC

	PROCEDURE llenar_grid
		WITH this.grid1
			.RecordSource = "cur_usuario"
			.RecordSourceType = 1
			.fontsize = 8
			.columncount = 5
			
			.column1.header1.caption = "Código"
			.column1.width = 50
			.column1.alignment = 0
			.column1.controlsource = "idusuario"
			
			.column2.header1.caption = "Usuario"
			.column2.width = 80
			.column2.alignment = 0
			.column2.controlsource = "nick"
			
			.column3.header1.caption = "Nombre Completo"
			.column3.width = 200
			.column3.alignment = 0
			.column3.controlsource = "nombre_completo"
			
			.column4.header1.caption = "Tipo"
			.column4.width = 100
			.column4.alignment = 0
			.column4.controlsource = "tipo_descripcion"
			
			.column5.header1.caption = "Sucursal"
			.column5.width = 120
			.column5.alignment = 0
			.column5.controlsource = "sucursal"
		
		ENDWITH 
	ENDPROC

	PROCEDURE btn_aceptar.Click
		LOCAL lnok, cap_cod, cap_cod_personal, cap_user, cap_clave, cap_tipo
		LOCAL lncodnew
		LOCAL ARRAY laerr[1]
		
		cap_cod = thisform.txt_codigo.value
		cap_cod_personal = thisform.txt_cod_personal.value
		cap_user = ALLTRIM(thisform.txt_user.value)
		cap_clave = ALLTRIM(thisform.txt_clave.value)
		cap_tipo = thisform.tipo
		
		IF EMPTY(thisform.txt_cod_personal.Value)
			MESSAGEBOX("Debes seleccionar el personal para el usuario.",16,"Aviso")
			thisform.txt_cod_personal.setfocus
			RETURN 
		ENDIF
		
		
		
		IF !thisform.checkpass(ALLTRIM(thisform.txt_clave.value), ALLTRIM(thisform.txt_clave1.value))
			MESSAGEBOX("Las claves no son iguales, por favor vuelva a intentar introducir las claves", 16, "Aviso")
			RETURN
		ENDIF 
		
		cap_clave = thisform.gethash(cap_clave)
			
		
		
		IF thisform.opg_tipousuario.Value = 0
			MESSAGEBOX("Debes seleccionar el tipo de usuario antes de continuar",16,"Aviso")
			thisform.opg_tipousuario.Value= 0
			RETURN 
		ENDIF 
		
		* OBTENER EL TIPO DE USUARIO DEL OPTIONGROUP
		 lnTipoUsuario = thisform.opg_tipousuario.value
		   
		
		
		= SQLEXEC(conexion, "START TRANSACTION")
		
		* LLAMAR AL PROCEDIMIENTO ALMACENADO
		lnok = SQLEXEC(conexion, "call amb_usuario(?cap_tipo,?lnTipoUsuario, ?cap_cod, ?cap_cod_personal, ?cap_user, ?cap_clave)")
		
		IF lnok > 0
		    * OBTENER EL ID DEL NUEVO REGISTRO SI ES INSERCIÓN
		    IF cap_tipo = "N"
		        = SQLEXEC(conexion, "SELECT CAST(LAST_INSERT_ID() AS SIGNED) as new_id", "curNewId")
		        IF USED("curNewId") AND RECCOUNT("curNewId") > 0
		            lncodnew = INT(VAL(curNewId.new_id))
		            USE IN curNewId
		        ELSE
		            lncodnew = 0
		        ENDIF
		    ELSE
		        lncodnew = cap_cod
		    ENDIF
		
		    = SQLEXEC(conexion, "COMMIT")
		    
		    * ACTUALIZAR EL CURSOR DE USUARIOS
		    = SQLEXEC(conexion, "SELECT * FROM v_usuarios ORDER BY idusuario", "cur_usuario")
		
		    * BUSCAR EL REGISTRO INSERTADO/MODIFICADO
		    SELECT cur_usuario
		    LOCATE FOR idusuario = lncodnew
		    IF NOT FOUND()
		        IF cap_tipo = "N"
		            GO BOTTOM IN cur_usuario
		        ELSE
		            GO TOP IN cur_usuario
		        ENDIF
		    ENDIF
		    
		    thisform.llenar_grid()
		    thisform.llenar_dato()
		    
		    * MOSTRAR MENSAJE DE ÉXITO
		    DO CASE
		        CASE cap_tipo = "N"
		            MESSAGEBOX("Usuario creado correctamente", 64, "Éxito")
		        CASE cap_tipo = "M"
		            MESSAGEBOX("Usuario modificado correctamente", 64, "Éxito")
		        CASE cap_tipo = "B"
		            MESSAGEBOX("Usuario eliminado correctamente", 64, "Éxito")
		    ENDCASE
		
		ELSE
		    * ERROR EN LA EJECUCIÓN DEL SQLEXEC
		    AERROR(laerr)
		    = SQLEXEC(conexion, "ROLLBACK")
		    MESSAGEBOX("Error al guardar los datos de usuario: " + laerr[2], 16, "Error")
		    RETURN
		ENDIF
		
		* RESTAURAR EL FORMULARIO A MODO CONSULTA
		thisform.btn_nuevo.enabled = .t.
		thisform.btn_modificar.enabled = .t.
		thisform.btn_borrar.enabled = .t.
		thisform.btn_aceptar.enabled = .f.
		thisform.btn_cancelar.enabled = .f.
		
		* BLOQUEAR CONTROLES DE EDICIÓN
		thisform.txt_codigo.enabled = .f.
		thisform.txt_cod_personal.enabled = .f.
		thisform.txt_personal.enabled = .f.
		thisform.txt_user.enabled = .f.
		thisform.txt_clave.enabled = .f.
		thisform.txt_clave1.enabled = .f.
		thisform.opg_tipousuario.thisenabled(.f.)
		
		* HABILITAR NAVEGACIÓN Y GRID
		thisform.cnt_navegacion.enabled = .t.
		thisform.grid1.enabled = .t.
		
		* ACTUALIZAR DATOS Y ESTABLECER FOCO
		thisform.llenar_dato()
		thisform.llenar_grid()
		thisform.btn_nuevo.setfocus()
	ENDPROC

	PROCEDURE btn_borrar.Click
		LOCAL lnok
		LOCAL ARRAY laerr[1]
		
		IF MESSAGEBOX("¿Desea eliminar este usuario?", 36, "Confirmar eliminación") = 6
		    
		    cap_cod = thisform.txt_codigo.value
		
		    = SQLEXEC(conexion, "START TRANSACTION")
		
		    lnok = SQLEXEC(conexion, "call amb_usuario('B',0, ?cap_cod, 0, '', '')")
		
		    IF lnok > 0
		        = SQLEXEC(conexion, "COMMIT")
		        = SQLEXEC(conexion, "SELECT * FROM v_usuarios ORDER BY idusuario", "cur_usuario")
		        
		        MESSAGEBOX("Usuario eliminado correctamente", 64, "Éxito")
		    ELSE
		        AERROR(laerr)
		        = SQLEXEC(conexion, "ROLLBACK")
		        MESSAGEBOX("Error al eliminar el usuario: " + laerr[2], 16, "Error")
		    ENDIF
		    
		    * ACTUALIZAR EL GRID Y LOS DATOS
		    SELECT cur_usuario
		    GO TOP
		    
		    thisform.llenar_grid()
		    thisform.llenar_dato()
		    
		    * RESTAURAR EL FORMULARIO A MODO CONSULTA
		    thisform.btn_nuevo.enabled = .t.
		    thisform.btn_modificar.enabled = .t.
		    thisform.btn_borrar.enabled = .t.
		    thisform.btn_aceptar.enabled = .f.
		    thisform.btn_cancelar.enabled = .f.
		    
		    * BLOQUEAR CONTROLES DE EDICIÓN
		    thisform.txt_codigo.enabled = .f.
		    thisform.txt_cod_personal.enabled = .f.
		    thisform.txt_personal.enabled = .f.
		    thisform.txt_user.enabled = .f.
		    thisform.txt_clave.enabled = .f.
		    thisform.txt_clave1.enabled = .f.
		    thisform.opg_tipousuario.enabled = .f.
		    
		    * HABILITAR NAVEGACIÓN Y GRID
		    thisform.cnt_navegacion.enabled = .t.
		    thisform.grid1.enabled = .t.
		    
		    thisform.btn_nuevo.setfocus()
		
		ENDIF
	ENDPROC

	PROCEDURE btn_cancelar.Click
		thisform.btn_nuevo.enabled = .t.
		thisform.btn_modificar.enabled = .t.
		thisform.btn_borrar.Enabled = .t.
		thisform.btn_aceptar.enabled = .f.
		thisform.btn_cancelar.enabled = .f.
		
		*-- Bloquear controles de edición
		thisform.txt_cod_personal.enabled = .f.
		thisform.txt_personal.enabled 	= .f.
		thisform.txt_user.enabled 		= .f.
		thisform.txt_clave.enabled 		= .f.
		thisform.txt_clave1.enabled 	= .f.
		thisform.opg_tipousuario.thisenabled(.f.)
		
		*-- Habilitar navegación y grid
		thisform.cnt_navegacion.enabled = .t.
		thisform.grid1.enabled = .t.
		
		*-- Posicionar en el primer registro y actualizar datos
		if thisform.tipo = "N"
			select cur_usuario
			go top
		endif
		thisform.llenar_dato()
		
		*-- Establecer foco en botón Nuevo
		thisform.btn_nuevo.setfocus()
	ENDPROC

	PROCEDURE btn_modificar.Click
		thisform.btn_nuevo.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		
		* Personal (habilitado para búsqueda/modificación)
		thisform.txt_cod_personal.enabled = .t.
		
		* Usuario (bloqueado en modificación)
		thisform.txt_user.enabled = .t.
		
		* Claves (bloqueados en modificación)
		thisform.txt_clave.enabled = .f.
		thisform.txt_clave1.enabled = .f.
		
		
		* Tipo de Usuario (habilitado para modificación)
		thisform.opg_tipousuario.thisenabled(.t.)
		
		*-- Deshabilitar navegación y grid
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		
		*-- Poner foco en el campo de búsqueda de personal
		thisform.txt_cod_personal.setfocus()
		
		thisform.tipo = "M"
	ENDPROC

	PROCEDURE btn_nuevo.Click
		this.enabled = .f.
		thisform.txt_codigo.value = 0
		thisform.btn_modificar.enabled = .f.
		thisform.btn_borrar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		
		* Personal (bloqueado - muestra datos del personal seleccionado)
		thisform.txt_cod_personal.enabled = .T.
		thisform.txt_cod_personal.value = 0
		thisform.txt_personal.value = ""
		
		* Usuario (habilitado para nuevo registro)
		thisform.txt_user.enabled = .t.
		thisform.txt_user.value = ""
		
		* Claves (habilitados para nuevo registro)
		thisform.txt_clave.enabled = .t.
		thisform.txt_clave.value = ""
		thisform.txt_clave1.enabled = .t.
		thisform.txt_clave1.value = ""
		
		* Tipo de Usuario (habilitado para selección)
		thisform.opg_tipousuario.thisenabled(.t.)
		thisform.opg_tipousuario.value = 0 
		
		* Deshabilitar navegación y grid
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		
		* Poner foco en el primer campo editable
		thisform.TXT_COd_personal.setfocus()
		
		thisform.tipo = "N"
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.Release
	ENDPROC

	PROCEDURE cnt_navegacion.btn_atras.Click
		 SELECT cur_usuario
		 IF  .NOT. BOF()
		    SKIP -1
		    IF BOF()
		       GOTO TOP
		       WAIT WINDOW NOWAIT "Estas en el primer registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh()
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_primero.Click
		SELECT cur_usuario
		GO top
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE cnt_navegacion.btn_siguiente.Click
		 SELECT cur_usuario
		 IF  .NOT. EOF()
		    SKIP
		    IF EOF()
		       GOTO BOTTOM
		       WAIT WINDOW NOWAIT "Estas en el último registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_ultimo.Click
		SELECT cur_usuario
		GO bottom
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		thisform.llenar_dato
	ENDPROC

	PROCEDURE Grid1.Click
		thisform.llenar_dato
	ENDPROC

	PROCEDURE txt_buscar.InteractiveChange
		dodefault()
		local lcbusqueda, lcfiltro, lcrecordsource, lacampos[1], lncampos, lni, lccampo
		
		* Obtener el texto de búsqueda (sin espacios al inicio/final)
		lcbusqueda = alltrim(upper(this.value))
		
		* Obtener el recordsource del grid
		lcrecordsource = thisform.grid1.recordsource
		
		if empty(lcbusqueda)
		* Si no hay texto de búsqueda, mostrar todos los registros
			if used(lcrecordsource)
				select (lcrecordsource)
				set filter to
				go top
			endif
		else
		* Verificar que exista la propiedad cCamposBusqueda
			if type("THISFORM.cCamposBusqueda") = "C" and !empty(thisform.ccamposbusqueda)
		
		* Dividir los campos por comas
				lncampos = alines(lacampos, strtran(thisform.ccamposbusqueda, " ", ""), 1, ",")
				lcfiltro = ""
		
		* Construir el filtro dinámicamente
				for lni = 1 to lncampos
					lccampo = alltrim(lacampos[lnI])
		
		* Verificar que el campo existe en el cursor
					if used(lcrecordsource)
						select (lcrecordsource)
						if type(lccampo) <> "U"
		
		* Agregar OR si no es el primer campo
							if !empty(lcfiltro)
								lcfiltro = lcfiltro + " OR "
							endif
		
		* Determinar el tipo de campo y construir la condición apropiada
							do case
								case type(lccampo) = "N"  && Campo numérico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(STR(" + lccampo + ")))"
		
								case type(lccampo) = "C"  && Campo de texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(" + lccampo + "))"
		
								case type(lccampo) = "D"  && Campo de fecha
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(DTOC(" + lccampo + "))"
		
								case type(lccampo) = "L"  && Campo lógico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(IIF(" + lccampo + ", 'TRUE', 'FALSE'))"
		
								otherwise  && Otros tipos, tratar como texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(TRANSFORM(" + lccampo + ")))"
							endcase
						endif
					endif
				next
		
		* Aplicar el filtro si se construyó correctamente
				if !empty(lcfiltro) and used(lcrecordsource)
					select (lcrecordsource)
					set filter to &lcfiltro
					go top
				endif
		
			else
		* Si no existe la propiedad, mostrar mensaje de error
				messagebox("La propiedad 'cCamposBusqueda' no está definida en el formulario.", 16, "Error de configuración")
			endif
		endif
		
		* Refrescar el grid
		thisform.grid1.refresh()
	ENDPROC

	PROCEDURE txt_cod_personal.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode = 42
			NODEFAULT 
			LOCAL loregistro
			DO FORM bus_personal TO loregistro
			
			IF VARTYPE(loregistro)<>"L"
				this.Value = loregistro.idPersonal
			ELSE
				this.Value = 0
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE txt_cod_personal.LostFocus
		IF NOT EMPTY(this.Value)
		    LOCAL lnIdPersonal, lcSQL, lnResult
		    LOCAL ARRAY laError[1]
		    
		    lnIdPersonal = this.Value
		    
		    lcSQL = "SELECT * FROM v_personal WHERE idPersonal = " + ALLTRIM(STR(lnIdPersonal))
		    
		    lnResult = SQLEXEC(conexion, lcSQL, "cur_personal")
		    
		    IF lnResult > 0
		        IF RECCOUNT("cur_personal") > 0
		            WITH thisform
		                .txt_personal.Value = ALLTRIM(cur_personal.nombre)+" "+ALLTRIM(cur_personal.apellido)
		            ENDWITH
		        ELSE
		            MESSAGEBOX("El personal con ID " + ALLTRIM(STR(lnIdPersonal)) + " no existe.", 16, "Atención")
		            this.Value = 0
		            thisform.txt_personal.Value = ""
		        ENDIF
		    ELSE
		        AERROR(laError)
		        MESSAGEBOX("Error al consultar el personal: " + laError[2], 16, "Error")
		    ENDIF
		    
		    *-- Cerrar cursor temporal
		    IF USED("cur_personal")
		        USE IN cur_personal
		    ENDIF
		ENDIF
	ENDPROC

ENDDEFINE
