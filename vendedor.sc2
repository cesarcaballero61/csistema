	PROCEDURE Init
		lparameters tlinsert
		
		thisform.linsert = m.tlinsert
		
		SQLEXEC(conexion,"select * from v_vendedores order by idvendedor","cur_vendedor")
		GO top
		thisform.llenar_dato()
		thisform.llenar_grid()
		
		if thisform.linsert
			thisform.windowtype = 1
			thisform.btn_nuevo.click()
		endif
	ENDPROC

	PROCEDURE llenar_dato
		thisform.txt_codigo.value 		= cur_vendedor.idvendedor
		thisform.txt_cod_personal.value = cur_vendedor.idpersonal
		thisform.txt_personal.value 	= alltrim(cur_vendedor.vendedor)
		thisform.cbo_tipo.value 		= cur_vendedor.tipo_vendedor
		
		
	ENDPROC

	PROCEDURE llenar_grid
		with thisform.grid1
			.recordsourcetype = 1
			.columncount = 6
			.fontsize = 8
			.recordsource = "cur_vendedor"
		
			.column1.header1.caption = "Código"
			.column1.width = 50
			.column1.alignment = 2
			.column1.controlsource = "idVendedor"
		
			.column2.header1.caption = "Vendedor"
			.column2.width = 150
			.column2.alignment = 0
			.column2.controlsource = "vendedor"
		
			.column3.header1.caption = "Tipo"
			.column3.width = 70
			.column3.alignment = 2
			.column3.controlsource = "tipo_vendedor"
		
			.column4.header1.caption = "C.I.Nº"
			.column4.width = 80
			.column4.alignment = 2
			.column4.controlsource = "ci"
		
			.column5.header1.caption = "Teléfono"
			.column5.width = 90
			.column5.alignment = 2
			.column5.controlsource = "telefono"
		
			.column6.header1.caption = "Sucursal"
			.column6.width = 120
			.column6.alignment = 0
			.column6.controlsource = "sucursal"
		
			.refresh()
		endwith
		
	ENDPROC

	PROCEDURE Unload
		if thisform.linsert
			return thisform.nretcod
		endif
	ENDPROC

	PROCEDURE btn_aceptar.Click
		local lnok, cap_cod, cap_cod_personal, cap_tipo_vendedor, lncodnew, cap_tipo
		local array laerr[1]
		
		
		if empty(thisform.txt_cod_personal.value)
			messagebox("Debes indicar un personal!", 272, "Error")
			thisform.txt_cod_personal.setfocus
			return
		endif
		
		if empty(thisform.cbo_tipo.value)
			messagebox("Debes indicar un personal!", 272, "Error")
			thisform.cbo_tipo.setfocus
			return
		endif
		
		
		
		cap_cod = thisform.txt_codigo.value
		cap_cod_personal =	thisform.txt_cod_personal.value
		cap_tipo_vendedor =	thisform.cbo_tipo.value
		
		cap_tipo = thisform.tipo
		
		
		= sqlexec(conexion, "START TRANSACTION")
		
		lnok = sqlexec(conexion, "call amb_vendedor(?cap_tipo, ?cap_cod, ?cap_cod_personal, ?cap_tipo_vendedor)")
		
		if lnok > 0
			if cap_tipo = "N"
		
				= sqlexec(conexion, "SELECT CAST(LAST_INSERT_ID() AS SIGNED) as new_id", "curNewId")
				if used("curNewId") and reccount("curNewId") > 0
					lncodnew = int(val(curnewid.new_id))
					use in curnewid
				else
					lncodnew = 0
				endif
			else
				lncodnew = cap_cod
			endif
		
			= sqlexec(conexion, "COMMIT")
			= sqlexec(conexion, "select * from v_vendedores order by idvendedor", "cur_vendedor")
		
		* Buscar el registro insertado/modificado
			select cur_vendedor
			locate for idvendedor = lncodnew
			if not found()
				if cap_tipo = "N"
					go bottom in cur_vendedor
				else
					go top in cur_vendedor
				endif
			endif
		
			thisform.llenar_grid()
			thisform.llenar_dato()
		
		else
		* ERROR EN LA EJECUCIÓN DEL SQLEXEC
		
			aerror(laerr)
			= sqlexec(conexion, "ROLLBACK")
			messagebox("Error de conexión: " + laerr[2], 16, "Error")
		
		endif
		
		
		
		if thisform.linsert
		
			thisform.nretcod = lncodnew
			thisform.release()
		
		else
			thisform.btn_nuevo.enabled = .t.
			thisform.btn_modificar.enabled =.t.
			thisform.btn_borrar.enabled = .t.
		
			thisform.btn_aceptar.enabled = .f.
			thisform.btn_cancelar.enabled = .f.
		
			thisform.txt_cod_personal.enabled = .f.
			thisform.cbo_tipo.enabled = .f.
		
			thisform.cnt_navegacion.enabled = .t.
			thisform.grid1.enabled = .t.
			thisform.llenar_dato()
			thisform.llenar_grid()
			thisform.btn_nuevo.setfocus
		endif
		
	ENDPROC

	PROCEDURE btn_borrar.Click
		local lnok, cap_cod
		LOCAL Array err[1]
		
		
		if messagebox("Desea borrar este registro?", 36, "Aviso") = 6
		
			cap_cod = thisform.txt_codigo.value
		
			= sqlexec(conexion, "START TRANSACTION")
		
			lnok = sqlexec(conexion, "call amb_vendedor('B' ,?cap_cod , 0, '')")
		
			if lnok > 0
			
				=sqlexec(conexion, "COMMIT")
				=sqlexec(conexion, "select * from v_vendedores order by idvendedor", "cur_vendedor")
				
			else
		
				aerror(err)
				= sqlexec(conexion, "ROLLBACK")
				
				messagebox("Error ocurrido al borrar datos: " + err[2], 16, "Error")
		
			endif
		
			select cur_vendedor
			go top
		
			thisform.llenar_grid()
			thisform.llenar_dato()
		
		endif
		
	ENDPROC

	PROCEDURE btn_cancelar.Click
		thisform.btn_nuevo.enabled = .t.
		thisform.btn_modificar.enabled =.t.
		thisform.btn_borrar.Enabled = .t.
		thisform.btn_aceptar.enabled = .f.
		thisform.btn_cancelar.enabled = .f.
		
		thisform.txt_cod_personal.enabled = .f.
		thisform.cbo_tipo.enabled = .f.
		
		thisform.cnt_navegacion.enabled = .t.
		
		thisform.grid1.enabled = .t.
		
		if thisform.tipo = "N"
			select cur_vendedor
			go top
		ENDIF
		
		thisform.llenar_dato()
		thisform.btn_nuevo.setfocus
	ENDPROC

	PROCEDURE btn_modificar.Click
		thisform.btn_nuevo.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		
		thisform.txt_cod_personal.enabled = .t.
		thisform.cbo_tipo.enabled = .t.
		
		
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_cod_personal.setfocus
		
		thisform.tipo = "M"
	ENDPROC

	PROCEDURE btn_nuevo.Click
		this.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_borrar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		thisform.txt_codigo.value = 0
		
		thisform.txt_cod_personal.enabled = .t.
		thisform.cbo_tipo.enabled = .t.
		
		thisform.txt_cod_personal.value = 0
		thisform.txt_personal.value = ""
		
		thisform.cbo_tipo.value = ""
		
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_cod_personal.setfocus
		
		thisform.tipo = "N"
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.Release
	ENDPROC

	PROCEDURE cnt_navegacion.btn_atras.Click
		 SELECT cur_vendedor
		 IF  .NOT. BOF()
		    SKIP -1
		    IF BOF()
		       GOTO TOP
		       WAIT WINDOW NOWAIT "Estas en el primer registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh()
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_primero.Click
		SELECT cur_vendedor
		GO top
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE cnt_navegacion.btn_siguiente.Click
		 SELECT cur_vendedor
		 IF  .NOT. EOF()
		    SKIP
		    IF EOF()
		       GOTO BOTTOM
		       WAIT WINDOW NOWAIT "Estas en el último registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_ultimo.Click
		SELECT cur_vendedor
		GO bottom
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		thisform.llenar_dato
	ENDPROC

	PROCEDURE Grid1.Click
		thisform.llenar_dato
	ENDPROC

	PROCEDURE txt_buscar_nombre.InteractiveChange
		dodefault()
		local lcbusqueda, lcfiltro, lcrecordsource, lacampos[1], lncampos, lni, lccampo
		
		* Obtener el texto de búsqueda (sin espacios al inicio/final)
		lcbusqueda = alltrim(upper(this.value))
		
		* Obtener el recordsource del grid
		lcrecordsource = thisform.grid1.recordsource
		
		if empty(lcbusqueda)
		* Si no hay texto de búsqueda, mostrar todos los registros
			if used(lcrecordsource)
				select (lcrecordsource)
				set filter to
				go top
			endif
		else
		* Verificar que exista la propiedad cCamposBusqueda
			if type("THISFORM.cCamposBusqueda") = "C" and !empty(thisform.ccamposbusqueda)
		
		* Dividir los campos por comas
				lncampos = alines(lacampos, strtran(thisform.ccamposbusqueda, " ", ""), 1, ",")
				lcfiltro = ""
		
		* Construir el filtro dinámicamente
				for lni = 1 to lncampos
					lccampo = alltrim(lacampos[lnI])
		
		* Verificar que el campo existe en el cursor
					if used(lcrecordsource)
						select (lcrecordsource)
						if type(lccampo) <> "U"
		
		* Agregar OR si no es el primer campo
							if !empty(lcfiltro)
								lcfiltro = lcfiltro + " OR "
							endif
		
		* Determinar el tipo de campo y construir la condición apropiada
							do case
								case type(lccampo) = "N"  && Campo numérico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(STR(" + lccampo + ")))"
		
								case type(lccampo) = "C"  && Campo de texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(" + lccampo + "))"
		
								case type(lccampo) = "D"  && Campo de fecha
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(DTOC(" + lccampo + "))"
		
								case type(lccampo) = "L"  && Campo lógico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(IIF(" + lccampo + ", 'TRUE', 'FALSE'))"
		
								otherwise  && Otros tipos, tratar como texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(TRANSFORM(" + lccampo + ")))"
							endcase
						endif
					endif
				next
		
		* Aplicar el filtro si se construyó correctamente
				if !empty(lcfiltro) and used(lcrecordsource)
					select (lcrecordsource)
					set filter to &lcfiltro
					go top
				endif
		
			else
		* Si no existe la propiedad, mostrar mensaje de error
				messagebox("La propiedad 'cCamposBusqueda' no está definida en el formulario.", 16, "Error de configuración")
			endif
		endif
		
		* Refrescar el grid
		thisform.grid1.refresh()
	ENDPROC

	PROCEDURE txt_cod_personal.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		IF nKeyCode = 42
			NODEFAULT 
			LOCAL loregistro
			DO FORM bus_personal TO loregistro
			
			IF VARTYPE(loregistro)<>"L"
				this.Value = loregistro.idPersonal
			ELSE
				this.Value = 0
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE txt_cod_personal.Valid
		IF NOT EMPTY(this.Value)
		    LOCAL lnIdPersonal, lcSQL, lnResult
		    LOCAL ARRAY laError[1]
		    
		    lnIdPersonal = this.Value
		    
		    lcSQL = "SELECT * FROM v_personal WHERE idPersonal = " + ALLTRIM(STR(lnIdPersonal))
		    
		    lnResult = SQLEXEC(conexion, lcSQL, "cur_personal")
		    
		    IF lnResult > 0
		        IF RECCOUNT("cur_personal") > 0
		            WITH thisform
		                .txt_personal.Value = ALLTRIM(cur_personal.nombre)+" "+ALLTRIM(cur_personal.apellido)
		            ENDWITH
		        ELSE
		            MESSAGEBOX("El personal con ID " + ALLTRIM(STR(lnIdPersonal)) + " no existe.", 16, "Atención")
		            this.Value = 0
		            thisform.txt_personal.Value = ""
		        ENDIF
		    ELSE
		        AERROR(laError)
		        MESSAGEBOX("Error al consultar el personal: " + laError[2], 16, "Error")
		    ENDIF
		    
		    *-- Cerrar cursor temporal
		    IF USED("cur_personal")
		        USE IN cur_personal
		    ENDIF
		ENDIF
	ENDPROC

ENDDEFINE
