DEFINE CLASS form1 AS form 
 	*< CLASSDATA: Baseclass="form" Timestamp="" Scale="" Uniqueid="" />

	*<PropValue>
		Caption = "Pagare contrato"
		DoCreate = .T.
		Height = 301
		Icon = iconos\ventana.ico
		Left = 0
		Name = "FORM1"
		ShowWindow = 1
		Top = 0
		Width = 411
		WindowType = 1
	*</PropValue>
	
	PROCEDURE Init
		LPARAMETERS cod_Venta
		Local crystal As "CrystalRuntime.Application"
		IF WEXIST('Crystal')
		   RETURN
		ENDIF
		
		crystal = CREATEOBJECT("CrystalRuntime.Application")
		reporte = crystal.openreport("pagare.rpt")
		reporte.discardsaveddata()
		oParameters=reporte.ParameterFields()
		oParameters.item(1).SetCurrentValue(cod_Venta)
		
		    WITH thisform
		          .addobject("CRViewer", "OleControl", "Crviewer9.crviewer.9.2")
		          .caption = "Pagare"
		          .windowstate = 2
		          .autocenter = .T.
		          .visible = .T.
		          .lockscreen = .F.
		          .maxbutton = .T.
		          .minbutton = .T.
		       ENDWITH
		       
		       WITH thisform.CRViewer
		          .top = 0
		          .left = 0
		          .height = thisform.height
		          .width = thisform.width
		          .visible = .T.
		          .reportsource = reporte
		          .enableexportbutton = .T.
		          .displaygrouptree = .F.
		          .enableprintbutton = .T.
		          .enablerefreshbutton = .T.
		          .enablesearchcontrol = .T.
		          .enablezoomcontrol = .T.
		          .enableselectexpertbutton = .T.
		          .enablesearchexpertbutton = .T.
		       ENDWITH
		       thisform.crviewer.viewreport   
	ENDPROC

ENDDEFINE
