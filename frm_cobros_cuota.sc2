			*-- Columna 7: PAGADO (MONTO ABONADO)
			.Column7.Header1.Caption = "PAGADO"
			.Column7.Header1.FontBold = .t.
			.Column7.ControlSource = "crs_detalle_cuotas.total_pagado_detalle"
			.Column7.Width = 80
			.Column7.Alignment = 1
			.Column7.InputMask = "999,999,999"
		
			*-- Columna 8: SALDO (PENDIENTE)
			.Column8.Header1.Caption = "SALDO"
			.Column8.Header1.FontBold = .t.
			.Column8.ControlSource = "crs_detalle_cuotas.saldo_cuota"
			.Column8.Width = 80
			.Column8.Alignment = 1
			.Column8.InputMask = "999,999,999"
		
			*-- Columna 9: % PAGADO
			.Column9.Header1.Caption = "% PAG."
			.Column9.Header1.FontBold = .t.
			.Column9.ControlSource = "crs_detalle_cuotas.porcentaje_pagado_detalle"
			.Column9.Width = 60
			.Column9.Alignment = 1
			.Column9.Format = "99.9%"
		
			*-- Columna 10: ESTADO
			.Column10.Header1.Caption = "ESTADO"
			.Column10.Header1.FontBold = .t.
			.Column10.ControlSource = "crs_detalle_cuotas.estado_detalle_descripcion"
			.Column10.Width = 80
		
			*-- Columna 11: ÚLTIMO PAGO
			.Column11.Header1.Caption = "ÚLT. PAGO"
			.Column11.Header1.FontBold = .t.
			.Column11.ControlSource = "iif(ISNULL(crs_detalle_cuotas.ultima_fecha_pago),'',crs_detalle_cuotas.ultima_fecha_pago)"
			.Column11.Width = 80
		
			*-- Columna 12: ÚLTIMO IMPORTE
			.Column12.Header1.Caption = "ÚLT. IMP."
			.Column12.Header1.FontBold = .t.
			.Column12.ControlSource = "crs_detalle_cuotas.ultimo_importe"
			.Column12.Width = 80
			.Column12.Alignment = 1
			.Column12.InputMask = "999,999,999"
			*-- Formato condicional
			FOR i = 1 TO .ColumnCount
				.Columns(i).DynamicBackColor = ;
					"IIF(estado_detalle_descripcion='CANCELADO',RGB(220,255,220)," + ;
					"IIF(VAL(dias_atraso_efectivo)>30,RGB(255,200,200)," + ;
					"IIF(VAL(dias_atraso_efectivo)>0,RGB(255,255,200),RGB(255,255,255))))"
			ENDFOR
		
			*-- Color de texto según estado y mora
			FOR i = 1 TO .ColumnCount
				.Columns(i).DynamicForeColor = ;
					"IIF(estado_detalle_descripcion='CANCELADO',RGB(0,100,0)," + ;
					"IIF(VAL(dias_atraso_efectivo)>30,RGB(255,0,0)," + ;
					"IIF(VAL(dias_atraso_efectivo)>0,RGB(255,128,0),RGB(0,0,0))))"
			ENDFOR
		
			*-- Formato especial para columna de mora
			.Column5.DynamicForeColor = ;
				"IIF(nivel_mora='MORA GRAVE',RGB(255,0,0)," + ;
				"IIF(nivel_mora='MORA MODERADA',RGB(255,128,0)," + ;
				"IIF(nivel_mora='MORA LEVE',RGB(255,200,0),RGB(0,128,0))))"
		
			.Column5.DynamicFontBold = ;
				"nivel_mora='MORA GRAVE' OR nivel_mora='MORA MODERADA'"
		
			.Redraw()
		ENDWITH
	ENDPROC

