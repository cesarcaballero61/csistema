	PROCEDURE TXT_CI_CLIENTE.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			LOCAL lcruc_ci as String
			lcruc_ci = ""
			local loregistro as object
			do form bus_cliente to loregistro
		
		
			if vartype(loregistro) <> "L"
			
				lcruc_ci = ALLTRIM(loregistro.ci)
				
				IF EMPTY(ALLTRIM(loregistro.ci))
					lcruc_ci =ALLTRIM(loregistro.ruc)
				ENDIF
				
				IF EMPTY(lcruc_ci)
					MESSAGEBOX("Este cliente no posee #cedula ni #ruc"+CHR(13);
					+"debes completar los datos faltantes antes de continuar",16,"Aviso")
					lcruc_ci=""
				ENDIF  
				
				this.value = lcruc_ci
				this.setfocus()
			else
				this.value = ""
			endif
		endif
		
		
		if m.nkeycode = 22
			nodefault
			local lncodigo
			do form cliente with .t. to m.lncodigo
			this.value = m.lncodigo
		endif
	ENDPROC

	PROCEDURE TXT_CI_CLIENTE.LostFocus
		dodefault()
		if not empty(this.value)
			local lncodcliente, lcsql
		
			lncodcliente = this.value
		
			lcsql = "SELECT * FROM v_clientes WHERE ci = '" + alltrim(lncodcliente) + "'"
			lcsql = lcsql + "  or  ruc = '" + alltrim(lncodcliente) + "'"
		
			if sqlexec(conexion, lcsql, "cur_cliente") > 0
				if reccount("cur_cliente") > 0
		
					** Llenar campos del formulario.
					this.value = icase(!empty(cur_cliente.ci), cur_cliente.ci,!empty(cur_cliente.ruc), cur_cliente.ruc, alltrim(str(cur_cliente.idcliente, 10, 0)))
					thisform.txt_cliente.value = alltrim(cur_cliente.nombre_completo)
					thisform.TXT_ID_CLIENTE.value = cur_cliente.idcliente
					
					THISFORM.TXT_ID_ZONA.Value		=cur_cliente.idzona
					THISFORM.TXT_ZONA.Value			=cur_cliente.zona
					THISFORM.TXT_ID_BARRIO.Value	=cur_cliente.idbarrio
					THISFORM.TXT_BARRIO.Value 		=cur_cliente.barrio
					THISFORM.TXT_ID_PROFESION.Value	=cur_cliente.idprofesion
					THISFORM.TXT_PROFESION.Value	=cur_cliente.profesion
					
					THISFORM.TXT_ID_FORMA_PAGO.Value	=0
					THISFORM.TXT_FORMA_PAGO.Value		=""
					
					THISFORM._BUSCAR_DATOS_CUOTAS(THISFORM.TXT_ID_CLIENTE.Value)
					
					this.enabled = .f.
		
				ELSE
				
					MESSAGEBOX("Este cliente no fue encontrado",16,"Aviso")
		
					** Personal no encontrado
					this.value = ""
					thisform.txt_cliente.value 		= ""
					thisform.TXT_ID_CLIENTE.value 	= 0
					
					THISFORM.TXT_ID_ZONA.Value		=""
					THISFORM.TXT_ZONA.Value			=""
					THISFORM.TXT_ID_BARRIO.Value	=""
					THISFORM.TXT_BARRIO.Value 		=""
					THISFORM.TXT_ID_PROFESION.Value	=""
					THISFORM.TXT_PROFESION.Value	=""
					
					THISFORM.TXT_ID_FORMA_PAGO.Value	= 0
					THISFORM.TXT_FORMA_PAGO.Value		= ""
		
					** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		
					this.setfocus()
					nodefault
		
				endif
			else
				** Error en la consulta
				local laerror[1]
				aerror(laerror)
				messagebox("Error al buscar Cliente: " + laerror[2], 16, "Error")
			endif
		else
			thisform.txt_cliente.value = ""
			thisform.txt_id_cliente.value = 0
		endif
	ENDPROC

	PROCEDURE TXT_FECHA.LostFocus
		DODEFAULT()
		IF EMPTY(THIS.Value)
			THIS.Value = DATE()
		ENDIF 
	ENDPROC

	PROCEDURE TXT_ID_CONCEPTO.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			
			local loregistro as object
			do form bus_conceptos to loregistro
		
		
			if vartype(loregistro) <> "L"
				this.value = loregistro.idconcepto
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
		
		*!*	if m.nkeycode = 22
		*!*		nodefault
		*!*		local lncodigo
		*!*		do form tipo_pago with .t. to m.lncodigo
		*!*		this.value = m.lncodigo
		*!*	endif
	ENDPROC

	PROCEDURE TXT_ID_CONCEPTO.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnIDconcepto, lcSQL
		    
		    lnIDconcepto= this.Value
		    
		    lcSQL = "SELECT * FROM concepto_caja WHERE idconcepto= " + ALLTRIM(STR(lnIDconcepto, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_concepto") > 0
		        IF RECCOUNT("cur_concepto") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_concepto.idconcepto
					thisform.txt_concepto.Value = cur_concepto.concepto
					
					this.enabled = .f.
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Concepto de pago no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_concepto.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar la concepto de pago: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_concepto.Value = ""
		ENDIF
	ENDPROC

	PROCEDURE TXT_ID_FORMA_PAGO.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			
			local loregistro as object
			do form bus_tipopago to loregistro
		
		
			if vartype(loregistro) <> "L"
				this.value = loregistro.idtipo_pago
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
		
		if m.nkeycode = 22
			nodefault
			local lncodigo
			do form tipo_pago with .t. to m.lncodigo
			this.value = m.lncodigo
		endif
	ENDPROC

	PROCEDURE TXT_ID_FORMA_PAGO.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnIDtipopago, lcSQL
		    
		    lnIDtipopago= this.Value
		    
		    lcSQL = "SELECT * FROM tipo_pago WHERE idtipo_pago = " + ALLTRIM(STR(lnIDtipopago, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_tipopago") > 0
		        IF RECCOUNT("cur_tipopago") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_tipopago.idtipo_pago
					thisform.TXT_FORMA_PAGO.Value = cur_tipopago.tipo
					
					this.enabled = .f.
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Forma de pago no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.TXT_FORMA_PAGO.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar la Forma de pago: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.TXT_FORMA_PAGO.Value = ""
		ENDIF
	ENDPROC

	PROCEDURE TXT_IMPORTE.GotFocus
		DODEFAULT()
		this.InputMask = ''
	ENDPROC

	PROCEDURE TXT_IMPORTE.LostFocus
		dodefault()
		
		if this.value = 0
			this.value = thisform.txt_total_cuo.value
		endif
		
		
		if this.value > thisform.txt_total_cuo.value and thisform.cbo_tipo_pago.value = "CUOTA"
			messagebox("El importe no puede superar el monto de la cuota.", 16, "Aviso")
			this.value = 0
			nodefault
		endif
		
		if thisform.cbo_tipo_pago.value == "CUOTA"
			thisform.txt_saldo_cuo.value = thisform.txt_total_cuo.value - this.value
		endif
		this.inputmask = '999,999,999'
	ENDPROC

ENDDEFINE
