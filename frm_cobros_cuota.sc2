			.column8.width = 90
			.column8.alignment = 2
		
			*-- Columna 9: MONTO CUOTA
			.column9.header1.caption = "MONTO CUOTA"
			.column9.header1.fontbold = .t.
			.column9.controlsource = "crs_detalle_venta_articulo.monto_cuota"
			.column9.width = 90
			.column9.alignment = 1
			.column9.inputmask = "999,999,999"
		
			*-- Columna 10: IVA
			.column10.header1.caption = "IVA"
			.column10.header1.fontbold = .t.
			.column10.controlsource = "crs_detalle_venta_articulo.iva"
			.column10.width = 50
		
			.redraw()
		endwith
	ENDPROC

	PROCEDURE _limpiar_controles_detalle
		    *-- Limpiar todos los controles utilizados en el REPLACE
		    
		    *-- Limpiar ComboBox
		    THIS.cbo_tipo_pago.Value = ""
		    
		    *-- Limpiar TextBox de valores numéricos
		    THIS.txt_id_Detalle.Value = 0
		    THIS.txt_id_concepto.Value = 0
		    THIS.txt_orden.Value = 0
		    THIS.txt_atraso.Value = 0
		    THIS.txt_total_cuo.Value = 0
		    THIS.txt_importe.Value = 0
		    THIS.txt_saldo_cuo.Value = 0
		    
		    *-- Limpiar TextBox de valores de texto
		    THIS.txt_concepto.Value = ""
		    THIS.txt_coden.Value = ""
		    
		    *-- Limpiar TextBox de fecha
		    THIS.txt_fvto.Value = {}
	ENDPROC

	PROCEDURE _registrar_pago
		local lcsqlcabpagos, lcsqldetpagos
		local lnresutl
		local lc_nro_recibo, ld_fecha, ln_idempresa, ln_idtipo_pago, ln_idcliente, ln_idcobrador, ln_idpago
		local ln_idcuotas, ln_idsucursal, ln_total_importe, lnidusuario
		local lcsql
		local lcnroexp, lcnrosuc
		
		
		local llok as boolean
		llok = .t.
		
		local array loerror[1]
		
		with thisform
			lc_nro_recibo       = _screen.oapp.cpuntoexpedicion+"-"+.txt_nro_recibo.value
			ld_fecha            = .txt_fecha.value
			ln_total_importe    = .txt_total_importe.value
			ln_idcliente        = .txt_id_cliente.value
			ln_idtipo_pago      = .txt_id_forma_pago.value
			ln_idsucursal       = _screen.oapp.nsucursal
			ln_idempresa        = _screen.oapp.nempresa
			ln_idcobrador       = .txt_id_cobrador.value
			ln_idcuotas         = .txt_id_cuota.value
		
			lcnrosuc 			= _screen.oapp.cestablecimiento
			lcnroexp			= _screen.oapp.cpuntoexpedicion
		endwith
		
		*Codigo de usuario
		lnidusuario = _screen.oapp.nusuariosistema
		
		*inicio la transaccion
		= sqlexec(conexion, "start transaction")
		
		* Guardar cabecera del pago
		lcsqlcabpagos = "CALL pagos_cabecera(?lc_nro_recibo, ?ld_fecha, ?ln_total_importe, " + ;
			"?ln_idcliente, ?ln_idtipo_pago, ?ln_idsucursal, ?ln_idempresa, " + ;
			"?ln_idcobrador, ?ln_idcuotas, ?lnidusuario, @idpago_generado)"
		
		lnresutl = sqlexec(conexion, lcsqlcabpagos)
		
		if lnresutl > 0
		* Obtener id del pago generado
			lcsql = "SELECT @idpago_generado as idpago_generado"
			lnresutl = sqlexec(conexion, lcsql, "CURDIPAGO")
		
			if lnresutl > 0 and reccount("CURDIPAGO") > 0
				ln_idpago = curdipago.idpago_generado
		
		* Guardar detalles del pago
				select tmpconceptopago
				go top
				scan
					lcsqldetpagos = "CALL pagos_detalle(?ln_idpago, " + ;
						"?tmpconceptopago.ncoddetallecuota, " + ;
						"?tmpconceptopago.ctipo , " + ;  && -- tipo_pago
						"?tmpconceptopago.ncodconcepto, " + ;
						"?tmpconceptopago.cConcepto, " + ;
						"?tmpconceptopago.norden, " + ;
						"?tmpconceptopago.corden, " + ;
						"?tmpconceptopago.fvto, " + ;
						"?tmpconceptopago.ndiasAtaso, " + ;
						"?tmpconceptopago.ncuota, " + ;
						"?tmpconceptopago.nimporte, " + ;
						"?tmpconceptopago.nsaldo)"
		
					lnresutl = sqlexec(conexion, lcsqldetpagos)
		
					if lnresutl <= 0
						llok = .f.
						aerror(loerror)
						exit
					endif
				endscan
		
				if llok
		
					if sqlexec(conexion, "call confirmar_nro_recibo(?lcnrosuc , ?lcnroexp ,?ln_idsucursal)") > 0
		* Confirmar transacción
						= sqlexec(conexion, "commit")
						messagebox("Pago guardado exitosamente!" + chr(13) + ;
							  "Número de recibo: " + lc_nro_recibo + chr(13) + ;
							  "ID de pago: " + transform(ln_idpago), 64, "Éxito")
							  
						*metodo para imprimir recibos	  
						thisform.imprimirrecibo(ln_idpago)
						
					else
						llok = .f.
						aerror(loerror)
						= sqlexec(conexion, "rollback")
						messagebox("Error al confirmar la numeración de recibos " + loerror[2], 16, "Error")
					endif
				else
					= sqlexec(conexion, "rollback")
					messagebox("Error al guardar el detalle del pago: " + loerror[2], 16, "Error")
				endif
			else
				llok = .f.
				= sqlexec(conexion, "rollback")
				messagebox("Error al obtener el ID del pago generado", 16, "Error")
			endif
		else
			llok = .f.
			aerror(loerror)
			= sqlexec(conexion, "rollback")
			messagebox("Error al guardar la cabecera del pago: " + loerror[2], 16, "Error")
		endif
		
		* Cerrar cursor temporal
		if used("CURDIPAGO")
			use in curdipago
		endif
		
		return llok
		
	ENDPROC

	PROCEDURE _seleccion_cuota
		select crs_detalle_cuotas
		
		this.btn_agregar.enabled =.t.
		this.btn_eliminar.enabled =.t.
		
		this.cbo_tipo_pago.listindex = 1
		this.cbo_tipo_pago.valid()
		this.txt_orden.value = crs_detalle_cuotas.orden_cuota
		this.txt_total_cuo.value = crs_detalle_cuotas.saldo_cuota
		this.txt_saldo_cuo.value = crs_detalle_cuotas.saldo_cuota
		
		
		this.txt_atraso.value =crs_detalle_cuotas.dias_atraso_efectivo
		this.txt_fvto.value=crs_detalle_cuotas.fecha_vto
		this.txt_coden.value=crs_detalle_cuotas.orden_char
		this.txt_id_detalle.value=crs_detalle_cuotas.idcuotas_detalle
		
		this.cbo_tipo_pago.enabled = .t.
		this.cbo_tipo_pago.setfocus()
	ENDPROC

	PROCEDURE _sumar_total_importe
		*-- Calcular la suma total del campo nimporte en tmpconceptoPago
		*-- Devuelve el total calculado
		
		local lntotal
		local lnregistroactual
		
		
		lntotal = 0
		
		*-- Verificar que el cursor esté abierto
		if used("tmpconceptoPago")
			select tmpconceptopago
			lnregistroactual = recno()  && Guardar posición actual
		
		*-- Calcular suma total
			calculate sum(nimporte) to lntotal
		
		*-- Restaurar posición original
			if between(lnregistroactual, 1, reccount())
				go lnregistroactual
			endif
		endif
		
		return lntotal
	ENDPROC

	PROCEDURE btn_agregar.Click
		local llexiste
		
		if empty(thisform.txt_id_concepto.value)
			messagebox("Debes seleccionar un concepto para continuar", 48, "Aviso")
			thisform.txt_id_concepto.setfocus()
			return
		endif
		
		if empty(thisform.txt_importe.value)
			messagebox("Debes indicar un IMPORTE para continuar", 48, "Aviso")
			thisform.txt_importe.setfocus()
			return
		endif
		
		
		
		llexiste = thisform._buscar_en_tmpconcepto(thisform.txt_id_detalle.value, thisform.txt_orden.value)
		
		if llexiste
			messagebox("El registro ya existe en el pago de cuotas." + chr(13) + ;
				  "Código: " + transform(thisform.txt_id_detalle.value) + chr(13) + ;
				  "Orden: " + transform(thisform.txt_orden.value), 48, "Registro Duplicado")
				  
				  RETURN 
		endif
		
		thisform._agregar_cuota()
		thisform._limpiar_controles_detalle()
		thisform.grid_cuoTAS.SetFocus()
		*thisform.btn_agregar.enabled = .f.
		*thisform.btn_eliminar.enabled = .f.
		thisform.refresh()
		
	ENDPROC

	PROCEDURE BTN_CANCELAR.Click
		IF MESSAGEBOX("¿Desea cancelar esta operación de pago de cuotas?", 292, "Aviso") = 6
		    THISFORM._CANCELAR_OPERACION_PAGO()
		    THISFORM.TXT_CI_CLIENTE.SetFocus()
		ENDIF
	ENDPROC

	PROCEDURE btn_eliminar.Click
		local lnregistroactual, lntotalregistros
		
		*-- Verificar que el cursor esté abierto y tenga registros
		if !used("tmpconceptoPago") or reccount("tmpconceptoPago") = 0
			messagebox("No hay registros para eliminar.", 64, "Información")
			this.enabled = .f.  && Bloquear el botón
			return
		endif
		
		*-- Obtener el registro actual seleccionado
		select tmpconceptopago
		lnregistroactual = recno()
		
		*-- Verificar que hay un registro seleccionado
		if !between(lnregistroactual, 1, reccount())
			messagebox("Seleccione un registro para eliminar.", 48, "Advertencia")
			return
		endif
		
		*-- Confirmar eliminación
		if messagebox("¿Está seguro de eliminar este registro?", 4 + 32, "Confirmar Eliminación") = 6  && 6 = Sí
		*-- Eliminar el registro actual
			select tmpconceptopago
			delete
		
		*-- Opcional: PACK físico para eliminar definitivamente
		* PACK IN tmpconceptoPago
		
		*-- Verificar si quedan registros
			select tmpconceptopago
			lntotalregistros = reccount()
		
		*-- Mostrar mensaje de éxito
			messagebox("Registro eliminado correctamente.", 64, "Éxito")
		
		*-- Bloquear el botón si no hay más registros
			if lntotalregistros = 0
				this.enabled = .f.
				messagebox("No hay más registros para eliminar.", 64, "Información")
			else
		*-- Ajustar el registro actual después de la eliminación
				if lnregistroactual > lntotalregistros
					go bottom
				else
					go lnregistroactual
				endif
		
		*-- Refrescar la grilla o controles que muestren los datos
				thisform.grid_cuotas.setfocus()
				thisform.txt_total_importe.Value = thisform._sumar_total_importe()
				thisform.refresh()
		
			endif
		endif
	ENDPROC

	PROCEDURE BTN_REGISTRAR.Click
		if empty(thisform.txt_cI_CLIENTE.value)
			messagebox('Debes indicar un cliente para  continuar!', 16, "Aviso")
			thisform.txt_cI_CLIENTE.setfocus()
			return
		ENDIF
		
		if empty(thisform.txt_id_forma_pago.value)
			messagebox('Debes indicar una forma de pago para continuar!', 16, "Aviso")
			thisform.txt_id_forma_pago.setfocus()
			return
		ENDIF
		
		select tmpconceptopago
		go top
		
		if eof()
			messagebox('Este pago no posee detalles para guardar!', 64, "Atencion")
			return .f.
		endif
		
		if messagebox("Desea guardar los datos de pagos?", 36, "Aviso") = 6
			if thisform._registrar_pago()
		*imprimir recibo
				thisform._cancelar_operacion_pago()
				thisform.txt_ci_cliente.setfocus()
		
			endif
		
		endif
	ENDPROC

	PROCEDURE BTN_SALIR.Click
		thisform.Release()
	ENDPROC

	PROCEDURE CBO_TIPO_PAGO.LostFocus
		THIS.Enabled = .F.
		THISFORM.TXT_IMPORTE.Enabled = .T.
		IF THIS.ListIndex = 1
			THISFORM.TXT_IMPORTE.SetFocus()
		ELSE
		
			THISFORM.TXT_ID_CONCEPTO.SetFocus()
		ENDIF 
	ENDPROC

	PROCEDURE CBO_TIPO_PAGO.Valid
		thisform.txt_id_concepto.enabled = (this.listindex > 1)
		thisform.txt_id_concepto.value = iif(this.listindex = 1, crs_concepto.idconcepto, 0)
		thisform.txt_concepto.value = iif(this.listindex = 1, crs_concepto.concepto, "")
		
		
		thisform.txt_orden.value = 	iif(this.listindex = 1, crs_detalle_cuotas.orden_cuota, 0)
		thisform.txt_total_cuo.value = iif(this.listindex = 1, crs_detalle_cuotas.saldo_cuota, 0)
		thisform.txt_importe.value = 0
		thisform.txt_saldo_cuo.value = thisform.txt_total_cuo.value
		
	ENDPROC

