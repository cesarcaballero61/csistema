	PROCEDURE generar_recibo
		LPARAMETERS tcEstablecimiento, tcPuntoExpedicion
		
		LOCAL lcSQL, lcNroRecibo, lnSucursal, lnResult
		
		* Inicializar variables
		lcNroRecibo = ""
		lnSucursal = _screen.oapp.nSucursal
		
		* Llamar al stored procedure con parámetros posicionales
		* MySQL usa variables de sesión para parámetros OUT
		lcSQL = "CALL obtener_nro_recibo('" + tcEstablecimiento + "', '" + ;
		        tcPuntoExpedicion + "', " + TRANSFORM(lnSucursal) + ", @nro_recibo)"
		
		lnResult = SQLEXEC(conexion, lcSQL)
		
		IF lnResult > 0
		    * Recuperar el valor del parámetro OUT usando la variable de sesión
		    lcSQL = "SELECT @nro_recibo AS nro_recibo"
		    lnResult = SQLEXEC(conexion, lcSQL, "curNroRecibo")
		    
		    IF lnResult > 0 AND USED("curNroRecibo") AND RECCOUNT("curNroRecibo") > 0
		        lcNroRecibo = ALLTRIM(curNroRecibo.nro_recibo)
		    ELSE
		        MESSAGEBOX("Error al recuperar número de recibo", 16, "Error")
		        lcNroRecibo = ""
		    ENDIF
		ELSE
		    * Capturar error de SQL
		    LOCAL ARRAY laError[1]
		    AERROR(laError)
		    MESSAGEBOX("Error al ejecutar SP: " + CHR(13) + laError[2], 16, "Error")
		    lcNroRecibo = ""
		ENDIF
		
		* Limpiar cursor
		IF USED("curNroFactura")
		    USE IN curNroFactura
		ENDIF
		
		RETURN lcNroRecibo
	ENDPROC

	PROCEDURE imprimirrecibo
		*-- Procedimiento para imprimir recibo
		LPARAMETERS tnIdPago
		
		LOCAL loConexion, lcSQL, lnHandle
		
		*-- Llamar al stored procedure
		lcSQL = "CALL sp_consultar_pago_cuotas_detalle(" + TRANSFORM(tnIdPago) + ")"
		
		SQLEXEC(conexion, lcSQL, "cur_pago_detalle")
		
		*-- Verificar si hay datos
		IF RECCOUNT("cur_pago_detalle") = 0
		    MESSAGEBOX("No se encontraron datos para este pago", 48, "Aviso")
		    RETURN
		ENDIF
		
		*-- Crear cursor para el reporte (duplicando datos para Original y Copia)
		CREATE CURSOR cur_recibo_impresion ( ;
		    tipo_copia C(10), ;
		    idpago I, ;
		    nro_recibo C(20), ;
		    fecha_pago D, ;
		    total_pagado N(12,2), ;
		    estado_pago C(3), ;
		    cliente_nombre_completo C(100), ;
		    cliente_ci C(20), ;
		    cliente_celular C(20), ;
		    cobrador_nombre C(100), ;
		    forma_pago C(50), ;
		    factura_completa C(30), ;
		    fecha_venta D, ;
		    sucursal C(100), ;
		    direccion_sucursal C(200), ;
		    telefono_sucursal C(50), ;
		    empresa C(100), ;
		    concepto_pago C(200), ;
		    numero_cuota_char C(20), ;
		    fecha_vencimiento D(8), ;
		    monto_pagado N(12,2), ;
		    saldo_despues_pago N(12,2), ;
		    saldo_actual N(12,2),;
		    orden_detalle I ,;
		    personal_pago C(50);
		)
		
		*-- Insertar datos para ORIGINAL
		SELECT cur_pago_detalle
		SCAN
		    SELECT cur_recibo_impresion
		    APPEND BLANK
		    REPLACE tipo_copia WITH "ORIGINAL"
		    REPLACE idpago WITH cur_pago_detalle.idpago
		    REPLACE nro_recibo WITH cur_pago_detalle.nro_recibo
		    REPLACE fecha_pago WITH cur_pago_detalle.fecha_pago
		    REPLACE total_pagado WITH cur_pago_detalle.total_pagado
		    REPLACE estado_pago WITH cur_pago_detalle.estado_pago
		    REPLACE cliente_nombre_completo WITH cur_pago_detalle.cliente_nombre_completo
		    REPLACE cliente_ci WITH cur_pago_detalle.cliente_ci
		    REPLACE cliente_celular WITH cur_pago_detalle.cliente_celular
		    REPLACE cobrador_nombre WITH cur_pago_detalle.cobrador_nombre
		    REPLACE forma_pago WITH cur_pago_detalle.forma_pago
		    REPLACE factura_completa WITH cur_pago_detalle.factura_completa
		    REPLACE fecha_venta WITH cur_pago_detalle.fecha_venta
		    REPLACE sucursal WITH cur_pago_detalle.sucursal
		    REPLACE direccion_sucursal WITH cur_pago_detalle.direccion_sucursal
		    REPLACE telefono_sucursal WITH cur_pago_detalle.telefono_sucursal
		    REPLACE empresa WITH cur_pago_detalle.empresa
		    REPLACE concepto_pago WITH cur_pago_detalle.concepto_pago
		    REPLACE numero_cuota_char WITH cur_pago_detalle.numero_cuota_char
		    REPLACE fecha_vencimiento WITH IIF(!ISNULL(cur_pago_detalle.fecha_vencimiento),cur_pago_detalle.fecha_vencimiento,{})
		    REPLACE monto_pagado WITH cur_pago_detalle.monto_pagado
		    REPLACE saldo_despues_pago WITH cur_pago_detalle.saldo_despues_pago
		    REPLACE saldo_actual WITH cur_pago_detalle.saldo_actual_cuota
		    REPLACE orden_detalle WITH val(cur_pago_detalle.orden_tipo_pago)
		    replace personal_pago  WITH cur_pago_detalle.personal_registro
		ENDSCAN
		
		*-- Insertar datos para DUPLICADO (mismos datos)
		SELECT cur_pago_detalle
		SCAN
		    SELECT cur_recibo_impresion
		    APPEND BLANK
		    REPLACE tipo_copia WITH "DUPLICADO"
		    REPLACE idpago WITH cur_pago_detalle.idpago
		    REPLACE nro_recibo WITH cur_pago_detalle.nro_recibo
		    REPLACE fecha_pago WITH cur_pago_detalle.fecha_pago
		    REPLACE total_pagado WITH cur_pago_detalle.total_pagado
		    REPLACE estado_pago WITH cur_pago_detalle.estado_pago
		    REPLACE cliente_nombre_completo WITH cur_pago_detalle.cliente_nombre_completo
		    REPLACE cliente_ci WITH cur_pago_detalle.cliente_ci
		    REPLACE cliente_celular WITH cur_pago_detalle.cliente_celular
		    REPLACE cobrador_nombre WITH cur_pago_detalle.cobrador_nombre
		    REPLACE forma_pago WITH cur_pago_detalle.forma_pago
		    REPLACE factura_completa WITH cur_pago_detalle.factura_completa
		    REPLACE fecha_venta WITH cur_pago_detalle.fecha_venta
		    REPLACE sucursal WITH cur_pago_detalle.sucursal
		    REPLACE direccion_sucursal WITH cur_pago_detalle.direccion_sucursal
		    REPLACE telefono_sucursal WITH cur_pago_detalle.telefono_sucursal
		    REPLACE empresa WITH cur_pago_detalle.empresa
		    REPLACE concepto_pago WITH cur_pago_detalle.concepto_pago
		    REPLACE numero_cuota_char WITH cur_pago_detalle.numero_cuota_char
		    REPLACE fecha_vencimiento WITH IIF(!ISNULL(cur_pago_detalle.fecha_vencimiento),cur_pago_detalle.fecha_vencimiento,{})
		    REPLACE monto_pagado WITH cur_pago_detalle.monto_pagado
		    REPLACE saldo_despues_pago WITH cur_pago_detalle.saldo_despues_pago
		    REPLACE saldo_actual WITH cur_pago_detalle.saldo_actual_cuota
		    REPLACE orden_detalle WITH val(cur_pago_detalle.orden_tipo_pago)
		    replace personal_pago  WITH cur_pago_detalle.personal_registro
		ENDSCAN
		
		*-- Ordenar: primero ORIGINAL, luego DUPLICADO
		*SELECT * FROM cur_recibo_impresion ;
		    ORDER BY tipo_copia DESC, orden_detalle ;
		    INTO CURSOR cur_recibo_final
		
		SELECT cur_recibo_impresion 
		*-- Llamar al reporte
		REPORT FORM _recibos PREVIEW NOCONSOLE
		
		*-- Limpiar
		USE IN cur_pago_detalle
		USE IN cur_recibo_impresion
		*USE IN cur_recibo_final
	ENDPROC

	PROCEDURE Init
		dodefault()
		
		= sqlexec(conexion, "select * from v_cuotas_ventas_clientes WHERE 0=1", "crs_cuotas_ventas")
		thisform._grid_cuota_venta()
		
		= sqlexec(conexion, "select * from v_detalle_cuotas WHERE 0=1", "crs_detalle_cuotas")
		thisform._grid_cuotas()
		
		
		= sqlexec(conexion, "select * from v_detalle_ventas_simple WHERE 0=1", "crs_detalle_venta_articulo")
		thisform._grid_detalle_venta()
		
		
		this.txt_nro_recibo.value = thisform.generar_recibo(_screen.oapp.cestablecimiento, _screen.oapp.cpuntoexpedicion)
		thisform._grid_concepto_pago()
		thisform._buscar_concepto()
	ENDPROC

	PROCEDURE Line
		LPARAMETERS nXCoord2, nYCoord2
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		
		SET NULLDISPLAY TO [S/D]
		
		CREATE CURSOR tmpconceptoPago(ctipo c(10),ncoddetallecuota n(10), ncodConcepto n(10), cConcepto c(45), norden n(10), corden c(10), fvto d(8), ndiasAtaso n(10);
		,ncuota n(10,2), nimporte n(10,2), nsaldo n(10,2))
	ENDPROC

	PROCEDURE sumar_saldo
		LOCAL lnTotal
		lnTotal = 0
		* Verificar si existe el cursor
		IF USED("crs_cuotas_ventas")
		
		    * Guardar el área de trabajo actual
		    LOCAL lcAreaAnterior
		    lcAreaAnterior = ALIAS()
		    
		    * Seleccionar el cursor temporal
		    SELECT crs_cuotas_ventas
		    
		    * Calcular la suma
		    SUM saldo_actual TO lnTotal
		    
		    * Volver al área de trabajo anterior si existe
		    IF !EMPTY(lcAreaAnterior)
		        SELECT (lcAreaAnterior)
		    ENDIF
		ELSE
		    * Si no existe el cursor, el total es 0
		    lnTotal = 0
		ENDIF
		
		RETURN lnTotal
	ENDPROC

	PROCEDURE _agregar_cuota
		select tmpconceptopago
		append blank
		
		replace ctipo with this.cbo_tipo_pago.value,;
			ncoddetallecuota with this.txt_id_detalle.value,;
			ncodconcepto with this.txt_id_concepto.value,;
			cconcepto with alltrim(this.txt_concepto.value), ;
			norden with iif(this.cbo_tipo_pago.value = "CUOTA", this.txt_orden.value, 0), ; &&AQUI
			corden with iif(this.cbo_tipo_pago.value = "CUOTA", alltrim(this.txt_coden.value), ""), ; &&AQUI
			fvto with iif(this.cbo_tipo_pago.value = "CUOTA", this.txt_fvto.value, {}), ; &&AQUI
			ndiasataso with iif(this.cbo_tipo_pago.value = "CUOTA", val(this.txt_atraso.value), 0), ; &&AQUI
			ncuota with iif(this.cbo_tipo_pago.value = "CUOTA", this.txt_total_cuo.value, 0), ; &&AQUI
			nimporte with this.txt_importe.value,;
			nsaldo with iif(this.cbo_tipo_pago.value = "CUOTA", this.txt_saldo_cuo.value, 0) && AQUI
			
			
		thisform.txt_total_importe.Value = thisform._sumar_total_importe()
	ENDPROC

	PROCEDURE _buscar_concepto
		LOCAL lcValor, lnResultado
		DIMENSION laError[1]
		
		LCSQL = "SELECT valor FROM parametros_sistema WHERE nombre = 'CONCEPTO_PAGO_CUOTA' AND tabla ='concepto_caja'"
		
		lnResultado = SQLEXEC(conexion, LCSQL, "crs_parametro")
		
		IF lnResultado > 0 AND RECCOUNT('crs_parametro') > 0
		
		    lcValor = ALLTRIM(crs_parametro.valor)
		    
		    IF !EMPTY(lcValor)
		        LCSQL = "SELECT idconcepto, concepto FROM concepto_caja WHERE idconcepto = " + lcValor
		        IF SQLEXEC(conexion, LCSQL, "crs_concepto")<0
		        	    AERROR(laError)
		   				? "Error en consulta:", laError[2]
		   		ENDIF 
		    ELSE
		        ? "El parámetro está vacío"
		    ENDIF
		ELSE
		    AERROR(laError)
		    ? "Error en consulta:", laError[2]
		ENDIF
		
		* Limpiar cursores
		IF USED('crs_parametro')
		    USE IN crs_parametro
		ENDIF
	ENDPROC

	PROCEDURE _buscar_datos_cuotas
		lparameters tnidcliente
		
		local lnid_cliente, lcsql
		*:Global Array LOERROR[1]
		
		
		lnid_cliente = tnidcliente
		
		lcsql = "select * from v_cuotas_ventas_clientes where idcliente =";
			+ alltrim(str(tnidcliente, 10, 0)) + " AND ESTADO_CUOTA = 'PEN' ORDER BY IDVENTA"
		
		
		if sqlexec(conexion, lcsql, "crs_cuotas_ventas") > 0
			if reccount("crs_cuotas_ventas") = 0
				messagebox("ESTE CLIENTE NO POSEE DATOS DE CUOTAS PENDIENTES!", 16, "AVISO")
			ELSE
				THISFORM.TXT_SALDO.VALUE = thisform.sumar_saldo()
				
				GO TOP
				*thisform._buscar_detalle_cuota(crs_cuotas_ventas.idcuotas)
			endif
		else
			aerror(loerror)
			messagebox("Error en consulta de consulta cliente " + loerror[2])
		endif
		
		thisform._grid_cuota_venta()
		
		
		
		
		
		
	ENDPROC

	PROCEDURE _buscar_detalle_cuota
		lparameters tnidcuota
		
		local lnid_cuota, lcsql
		
		lnid_cuota = tnidcuota
		
		lcsql = "select * from v_detalle_cuotas where idcuotas=";
			+ alltrim(str(tnidcuota, 10, 0)) + " AND ESTADO_DETALLE = 'PEN' ORDER BY ORDEN_CUOTA ASC"
		
		
		if sqlexec(conexion, lcsql, "crs_detalle_cuotas") > 0
			if reccount("crs_detalle_cuotas") = 0
				messagebox("ESTE CLIENTE NO POSEE DATOS DE DETALLE DE CUOTAS!", 16, "AVISO")
			endif
		else
			aerror(loerror)
			messagebox("Error en consulta de DETALLE DE cuotas de cliente " + loerror[2])
		endif
		
		thisform._grid_cuotas()
	ENDPROC

	PROCEDURE _buscar_detalle_venta
		lparameters tnidventa
		
		local lnidventa, lcsql
		local array loerror[1]
		
		
		lnidventa = tnidventa
		
		lcsql = "select * from v_detalle_ventas_simple where idVenta=";
			+ alltrim(str(lnidventa, 10, 0)) + "  ORDER BY idDetalle ASC"
		
		
		if sqlexec(conexion, lcsql, "crs_detalle_venta_articulo") > 0
			if reccount("crs_detalle_venta_articulo") = 0
				messagebox("ESTE CLIENTE NO POSEE DATOS DE DETALLE DE VENTA!", 16, "AVISO")
			endif
		else
			aerror(loerror)
			messagebox("Error en consulta de DETALLE DE VENTA" + loerror[2])
		endif
		
		thisform._grid_detalle_venta()
	ENDPROC

	PROCEDURE _buscar_en_tmpconcepto
		lparameters tncoddetallecuota, tnorden
		*-- Buscar en cursor temporal por ncoddetallecuota y norden
		*-- Devuelve .T. si encuentra, .F. si no encuentra
		
		local llencontrado
		
		*-- Validar parámetros
		if pcount() < 2 or type("tnCodDetalleCuota") <> "N" or type("tnOrden") <> "N"
			return .f.
		endif
		
		*-- Buscar en el cursor
		llencontrado = .f.
		
		if used("tmpconceptoPago")
			select tmpconceptopago
			locate for ncoddetallecuota = tncoddetallecuota and norden = tnorden
		
			if found()
				llencontrado = .t.
			endif
		endif
		
		return llencontrado
		
	ENDPROC

	PROCEDURE _cancelar_operacion_pago
		*-- Método para cancelar operación de pago y limpiar/desbloquear controles
		
		*-- Limpiar controles de texto
		with this
		*-- Limpiar y desbloquear controles de cliente
			.txt_ci_cliente.value = ""
			.txt_ci_cliente.enabled = .t.
		
			.txt_id_cobrador.value 	= 0
			.txt_cobrador.value 	= ""
			.txt_id_cuota.value 	= 0
		
			.txt_cliente.value = ""
			.txt_id_cliente.value = 0
			.txt_id_zona.value = 0
			.txt_zona.value = ""
			.txt_id_barrio.value = 0
			.txt_barrio.value = ""
			.txt_id_profesion.value = 0
			.txt_profesion.value = ""
		
		*-- Limpiar controles de fecha y pago
			.txt_fecha.value = {}
			.txt_id_forma_pago.value = 0
			.txt_id_forma_pago.enabled = .t.
			.txt_forma_pago.value = ""
		
		*-- Desbloquear grilla
			.grid_cuota_venta.enabled = .t.
		
		*-- Ejecutar método de limpieza de controles de detalle
			._limpiar_controles_detalle()
		
		*BOTONES ELIMINAR Y AGREGAR
			.btn_agregar.enabled = .f.
			.btn_eliminar.enabled = .f.
			.txt_importe.enabled = .f.
			.txt_total_importe.value = 0
			.txt_saLDO.Value = 0
		
		*ELIMINAR EL CURSOR DE PAGOS
			select tmpconceptopago
			zap
		*-- Ejecutar evento Init del formulario
			.init()
		endwith
		
		*-- Mensaje de confirmación
		messagebox("Ventana limpiada, Controles reseteados.", 64, "Cancelado")
	ENDPROC

