	PROCEDURE calcularpreciocuotasdetallado
		lparameters tcproductonombre, tnpreciocontado, tninteresmensual, tnlimitecuota
		local lcsql,llret
		LOCAL lcProducto, lcPrecio, lcInteres, lcLimite
		llret = .t.
		
		* ------------------------------------------------------------------
		*  Armado del SQL respetando el formato que MySQL exige
		* ------------------------------------------------------------------
		LOCAL lcProducto, lcPrecio, lcInteres, lcLimite
		lcProducto = "'" + ALLTRIM(tcproductonombre) + "'"
		lcPrecio   = ALLTRIM(STR(tnpreciocontado, 20, 0))
		lcInteres  = STR(tninteresmensual, 10, 2)
		lcInteres  = CHRTRAN(lcInteres, ",", ".")   && <-- clave
		lcLimite   = ALLTRIM(STR(tnlimitecuota, 10, 0))
		
		lcsql = "CALL CalcularPrecioCuotasDetallado(" + ;
		        lcProducto + "," + ;
		        lcPrecio   + "," + ;
		        lcInteres  + "," + ;
		        lcLimite   + ")"
		
		
		if sqlexec(conexion, lcsql, "crsCalculoCuotas") < 0
			llret = .f.
			AERROR(loerror)
			messagebox("Error en calcular precios "+loerror(2),16,"aviso")
		
		endif
		
		return llret
		
		
	ENDPROC

	PROCEDURE grdpreciocuotas
		with this.gridbase1
			.columncount = -1
		
		
			.recordsourcetype = 1
			.recordsource = "crsCalculoCuotas"
		
			.columncount = 3
		
		
			.column1.header1.caption = "DESCRIPCION"
			.column1.WIDTH = 228
			.column1.controlsource = "crsCalculoCuotas.descripcion"
			.column1.alignment = 0
		
			.column2.header1.caption = "TIPO"
			.column2.WIDTH = 100
			.column2.controlsource = "crsCalculoCuotas.tipo"
			.column2.alignment = 0
		
		
			.column3.header1.caption = "CUOTAS"
			.column3.WIDTH = 200
			.column3.controlsource = "crsCalculoCuotas.monto"
			.column3.alignment = 0
		endwith
	ENDPROC

	PROCEDURE Init
		LPARAMETERS tcproductoNombre,tnpreciocontado,tnlimitecuota,tninteresmensual
		
		this.txtinteresMensual.Value = tninteresmensual
		this.txtlimiteCuota.Value =tnlimitecuota
		
		
		IF this.CalcularPrecioCuotasDetallado(tcproductoNombre,tnpreciocontado,tninteresmensual,tnlimitecuota)
			this.grdPrecioCuotas()
		ENDIF 
		THIS.BackColor = _screen.oRIBBON.backcolor1
	ENDPROC

