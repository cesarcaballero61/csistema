	ADD OBJECT 'Foxcharts1' AS foxcharts WITH ;
		Left = 60, ;
		Name = "Foxcharts1", ;
		Top = 48, ;
		Title.Name = "Title", ;
		SubTitle.Name = "SubTitle", ;
		XAxis.Name = "XAxis", ;
		YAxis.Name = "YAxis", ;
		ScaleLegend.Name = "ScaleLegend", ;
		AxisLegend2.Name = "AxisLegend2", ;
		ShapeLegend.Name = "ShapeLegend", ;
		SideLegend.Name = "SideLegend", ;
		ChartCanvas.Name = "ChartCanvas", ;
		Fields.Name = "Fields", ;
		ToolTip.Name = "ToolTip", ;
		YAxis2.Name = "YAxis2"
		*< END OBJECT: ClassLib="clases\foxcharts.vcx" BaseClass="container" />
	
	PROCEDURE cargargrafico
		* 1. PREPARACIÓN DE DATOS (Lo que hicimos antes)
		* ---------------------------------------------------------
		LOCAL lnCobrado, lnPendiente
		* (Aquí irían tus SELECT SQL, usaremos valores de ejemplo)
		lnCobrado   = 65000000
		lnPendiente = 35000000
		
		* Creamos el cursor que alimentará al gráfico
		CREATE CURSOR curCartera (Concepto C(20), Monto N(14,2), Color I)
		
		* Insertamos los datos con los colores que definiste
		INSERT INTO curCartera VALUES ("Cobrado", lnCobrado, RGB(46, 204, 113))   && Verde
		INSERT INTO curCartera VALUES ("Pendiente", lnPendiente, RGB(231, 76, 60)) && Rojo
		
		* 2. CONFIGURACIÓN DEL GRÁFICO (Adaptado de tu código)
		* ---------------------------------------------------------
		WITH ThisForm.FoxCharts1
		    * --- A. Datos ---
		    .SourceAlias = "curCartera"
		    .ChartsCount = 1             && Solo necesitamos 1 serie de datos
		    .ChartType   = 1             && 1 = Barras Verticales (Tu configuración original)
		    
		    * Vinculamos las columnas del cursor
		    .FieldAxis2  = "Concepto"    && Eje X (Texto)
		    .Fields(1).FieldValue = "Monto" && Eje Y (Valor)
		    .Fields(1).Color      = "Color" && Color personalizado de la barra
		
		    * --- B. Estilo Visual (Tomado de tu código) ---
		    .BackColor = RGB(255,255,255)
		    .BrushType = 1               && Degradado suave
		    .Depth = 0                 && Un poco de profundidad 3D (Se ve mejor que 0)
		    .Area3dTop = .T.             && Tapa 3D
		   * 
		    * Fuentes
		    .FontName = 'Verdana'
		    .Title.FontName = 'Tahoma'
		    
		    * Títulos
		    .Title.Caption = "Estado de Cartera Actual"
		    .Title.ForeColor = RGB(0, 120, 215) && Azul corporativo
		    .SubTitle.Caption = "Comparativa Cobrado vs. Pendiente"
		    
		    * Ejes y Leyendas
		    .ShowValuesOnShapes = .T.    && Mostrar el número encima de la barra
		    .ShowPercentages    = .T.    && Mostrar el % al lado
		    .AxisColor = RGB(150,150,150)
		    
		    * --- C. Ajustes de Márgenes (Para que quepa bien en tu recuadro) ---
		    .MarginTop = 10
		    .MarginBottom = 20
		    .MarginLeft = 10
		    .MarginRight = 10
		
		    * 3. DIBUJAR EL GRÁFICO
		    .DrawChart()
		ENDWITH
		
		* Limpieza
		*USE IN SELECT("curCartera")
	ENDPROC

	PROCEDURE Init
		DODEFAULT()
		this.cargargrafico()
	ENDPROC

ENDDEFINE
