	PROCEDURE Init
		DODEFAULT()
		
		LOCAL LCSQLRECIBO,LCSQLDETALLE
		
		LCSQLRECIBO ="SELECT * FROM V_RECIBO WHERE 1=0"
		LCSQLDETALLE ="SELECT * FROM v_recibos_detallados where  1=0"
		
		
		=SQLEXEC(CONEXION,LCSQLRECIBO,"crs_recibo")
		=SQLEXEC(CONEXION,LCSQLDETALLE ,"crs_detalle")
		
		
		THIS._gridrecibo()
		this._griddetalle()
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		
		SET NULLDISPLAY TO 'S/D'
	ENDPROC

	PROCEDURE _anular
		LOCAL lnidpago, lcmotivo, lnidusuario, lnResult, lcSQL, lnHandle, llExito
		
		lnidpago = crs_recibo.idpago
		lcmotivo = 'ANULACION DE RECIBO'
		lnidusuario = _SCREEN.OAPP.NUSUARIOSISTEMA
		llExito = .F.
		
		* Usar conexión existente
		lnHandle = conexion
		=SQLEXEC(conexion,'START TRANSACTION')
		
		lcSQL = "CALL sp_anular_recibo(" + ;
		        ALLTRIM(STR(lnidpago)) + ", " + ;
		        "'" + lcmotivo + "', " + ;
		        ALLTRIM(STR(lnidusuario)) + ")"
		
		lnResult = SQLExec(lnHandle, lcSQL)
		
		IF lnResult > 0
		        llExito = .T.
		        =SQLEXEC(conexion,"commit")
		ELSE
			AERROR(loerror)
			=SQLEXEC(conexion,'ROLLBACK')
		    MESSAGEBOX("Error al anular el recibo: "+loerror(2), 16, "Error")
		    llExito = .F.
		ENDIF
		
		RETURN llExito
	ENDPROC

	PROCEDURE _buscardetallerecibo
		LPARAMETERS tnidpago
		
		LOCAL lcSQL, lnResult, laError[1]
		
		*-- Validar que se recibió un ID de pago válido
		IF EMPTY(tnidpago) OR ISNULL(tnidpago)
		    MESSAGEBOX("No se especificó un ID de pago válido.", 16, "Error")
		    RETURN .F.
		ENDIF
		
		*-- Construir la consulta SQL para MySQL
		lcSQL = "SELECT * FROM v_recibos_detallados WHERE idpago = " + TRANSFORM(tnidpago) + ;
		        " ORDER BY orden_cuota"
		
		*-- Ejecutar la consulta usando SQLEXEC
		lnResult = SQLEXEC(conexion, lcSQL, 'crs_detalle')
		
		*-- Verificar el resultado de la ejecución
		IF lnResult <= 0
		    *-- Capturar información del error usando AERROR
		    AERROR(laError)
		    
		    LOCAL lcErrorMessage
		    lcErrorMessage = "Error al ejecutar la consulta de detalle." + CHR(13) + ;
		                     "Código de error: " + TRANSFORM(lnResult) + CHR(13) + ;
		                     "Error: " + TRANSFORM(laError[2]) + CHR(13) + ;
		                     "Mensaje: " + TRANSFORM(laError[3])
		    
		    MESSAGEBOX(lcErrorMessage, 16, "Error de Base de Datos")
		    RETURN .F.
		ENDIF
		
		*-- Verificar si se obtuvieron registros
		IF RECCOUNT('crs_detalle') = 0
		    MESSAGEBOX("No se encontraron detalles para el pago ID: " + TRANSFORM(tnidpago), 64, "Información")
		ENDIF
		
		RETURN .T.
	ENDPROC

	PROCEDURE _cancelar
	ENDPROC

	PROCEDURE _filtrar
		LPARAMETERS tcnroreciboini, tcnrorecibofin, tdfechainicio, tdfechafin
		
		*-- Suponiendo que 'conexion' es el manejador de conexión a la base de datos
		LOCAL lcWhere, lcSQL, lnResult, laError[1]
		
		*-- Construir la cláusula WHERE basada en los parámetros recibidos
		lcWhere = ""
		
		*-- Validar y agregar condición para número de recibo inicial
		IF !EMPTY(tcnroreciboini)
		    lcWhere = lcWhere + " AND nro_recibo >= '" + ALLTRIM(tcnroreciboini) + "'"
		ENDIF
		
		*-- Validar y agregar condición para número de recibo final
		IF !EMPTY(tcnrorecibofin)
		    lcWhere = lcWhere + " AND nro_recibo <= '" + ALLTRIM(tcnrorecibofin) + "'"
		ENDIF
		
		*-- Validar y agregar condición para fecha de inicio
		IF !EMPTY(tdfechainicio)
		    lcWhere = lcWhere + " AND fecha >= '" + tdfechainicio + "'"
		ENDIF
		
		*-- Validar y agregar condición para fecha de fin
		IF !EMPTY(tdfechafin)
		    lcWhere = lcWhere + " AND fecha <= '" + tdfechafin + "'"
		ENDIF
		
		*-- Remover el "AND" inicial si existe
		IF !EMPTY(lcWhere)
		    lcWhere = SUBSTR(lcWhere, 6)  && Remueve el " AND " inicial
		ENDIF
		
		*-- Construir la consulta SQL completa para MySQL
		IF EMPTY(lcWhere)
		    lcSQL = "SELECT * FROM v_recibo ORDER BY fecha DESC, nro_recibo DESC"
		ELSE
		    lcSQL = "SELECT * FROM v_recibo WHERE " + lcWhere + " ORDER BY fecha DESC, nro_recibo DESC"
		ENDIF
		
		*-- Ejecutar la consulta usando SQLEXEC
		lnResult = SQLEXEC(conexion, lcSQL, 'crs_recibo')
		
		*-- Verificar el resultado de la ejecución
		IF lnResult <= 0
		    *-- Capturar información del error usando AERROR
		    AERROR(laError)
		    
		    *-- Construir mensaje de error detallado
		    LOCAL lcErrorMessage
		    lcErrorMessage = "Error al ejecutar la consulta en la base de datos." + CHR(13) + ;
		                     "Código de error: " + TRANSFORM(lnResult) + CHR(13) + ;
		                     "Nativo: " + TRANSFORM(laError[2]) + CHR(13) + ;
		                     "Mensaje: " + TRANSFORM(laError[3])
		    
		    *-- Si hay más información de error, agregarla
		    IF ALEN(laError) >= 5 AND !EMPTY(laError[5])
		        lcErrorMessage = lcErrorMessage + CHR(13) + "Detalle: " + TRANSFORM(laError[5])
		    ENDIF
		    
		    MESSAGEBOX(lcErrorMessage, 16, "Error de Base de Datos")
		    RETURN .F.
		ENDIF
		
		*-- Verificar si se obtuvieron registros
		IF RECCOUNT('crs_recibo') = 0
		    MESSAGEBOX("No se encontraron registros con los criterios especificados.", 64, "Información")
		ENDIF
		
		RETURN .T.
	ENDPROC

