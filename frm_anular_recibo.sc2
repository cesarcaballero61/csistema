	PROCEDURE BTN_ANULAR.Click
		
		IF RECCOUNT('crs_recibo') = 0
			MESSAGEBOX('Debes seleccionar un recibo para anular!',16,'Aviso')
			RETURN 
		ENDIF 
		*-- Preguntar al usuario si desea anular el recibo
		lnRespuesta = MESSAGEBOX("¿Está seguro que desea anular el recibo seleccionado?", ;
		                         4 + 32 + 256, ;  && Botones Sí/No + Icono Pregunta + 2do botón por defecto
		                         "Confirmar Anulación")
		
		*-- Si el usuario eligió Sí (respuesta = 6), llamar al método anular
		IF lnRespuesta = 6
		    IF thisform._anular()
		    	MESSAGEBOX("Anulacion de recibo exitosa",64,"Aviso")
		    	thisform.Init()
		    ENDIF 
		ENDIF
	ENDPROC

	PROCEDURE BTN_CANCELAR.Click
		thisform.Init()
	ENDPROC

	PROCEDURE BTN_FILTRAR.Click
		LOCAL lcnrodesde,lcnrohasta
		LOCAL lddesde,ldhasta
		
		lcnrodesde = ALLTRIM(thisform.txt_reCIBO_INI.Value)
		lcnrohasta = ALLTRIM(thisform.txT_RECIBO_FIN.Value)
		lddesde = fechatomysql(thisform._fecha_desde.getvalue())
		IF lddesde = '0000-00-00'
		    lddesde = ""
		ENDIF
		
		ldhasta = fechatomysql(thisform._fecha_hasta.getvalue())
		IF ldhasta = '0000-00-00'
		    ldhasta = ""
		ENDIF
		
		IF thisform._filtrar(lcnrodesde,lcnrohasta,lddesde,ldhasta)
			thisform._gridrecibo()
		ENDIF 
	ENDPROC

	PROCEDURE BTN_SALIR.Click
		THISFORM.Release()
	ENDPROC

	PROCEDURE grddetalle.When
		NODEFAULT
	ENDPROC

	PROCEDURE grdrecibo.AfterRowColChange
		LPARAMETERS nColIndex
		
		if used("crs_recibo") and reccount("crs_recibo") > 0
			IF thisform._buscardetallerecibo(crs_recibo.idpago)
				thisform._griddetalle()
			ENDIF 
		endif
	ENDPROC

	PROCEDURE grdrecibo.Click
		this.AfterRowColChange()
	ENDPROC

	PROCEDURE grdrecibo.When
		NODEFAULT
	ENDPROC

	PROCEDURE TXT_RECIBO_FIN.LostFocus
		dodefault()
	ENDPROC

	PROCEDURE TXT_RECIBO_INI.LostFocus
		dodefault()
	ENDPROC

ENDDEFINE
