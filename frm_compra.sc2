	PROCEDURE Init
		DODEFAULT()
		this.grid_detalle()
	ENDPROC

	PROCEDURE limpiar_articulos
		thisform.txt_cod_articulo.value = ''
		thisform.txt_idarticulo.value		= 0
		thisform.TXT_IVA.Value				= ''
		thisform.txt_descripcion.value 		= ''
		thisform.txt_grupo_subgrupo.value	= ''
		thisform.txt_marca.value			= ''
		thisform.txt_preciocosto.value		= 0
		thisform.txt_cant.value				= 0
		thisform.txt_subtotal.value			= 0
		
		
		this.grddetalle.refresh()
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		SET SEPARATOR  TO "."
		SET POINT TO ","
		
		CREATE CURSOR curtmpCompra(ncodarticulo n(10), ccodarticulo c(45), carticulo c(45), cIva c(2), cgruposubgrupo c(45), cmarca c(45),;
		 ncantidad n(10),nprecio_costo n(10), ngravadas_excenta n(10),ngravadas_cinco n(10), ngravadas_diez n(10), nsubtotal n(10))
		
	ENDPROC

	PROCEDURE registrar_compra
		IF EMPTY(thisform.txtcodproveedor.Value)
			MESSAGEBOX("Debes indicar el proveedor para registrar la compra!",16,"Aviso")
			thisform.txtcodproveedor.SetFocus
			RETURN 
		ENDIF 
		
		IF EMPTY(thisform.txt_id_deposito.Value)
			MESSAGEBOX("Debes indicar el deposito para registrar la compra!",16,"Aviso")
			thisform.txt_id_deposito.SetFocus
			RETURN 
		ENDIF 
		
		*detalle
		SELECT curtmpCompra
		GO TOP
		IF EOF()
			MESSAGEBOX('Esta compra no posee detalles para guardar!', 16, "Atencion")
			RETURN
		ENDIF
		
		LOCAL ldfecha, lnidproveedor, lniddeposito, lcobservacion, lcTipo, lnidEmpresa, lnidSucursal, lnidusuario
		LOCAL lcnro_est, lcnro_exp, lcnro_factura, lnplazo, ldfecha_vto, lcTipoCompra
		LOCAL lntotal_gravadas_excenta, lntotal_gravadas_cinco, lntotal_gravadas_diez
		LOCAL lnliqui_iva_cinco, lnliqui_iva_diez, lntotal_liqui_iva, lntotal_compra
		
		ldfecha				= thisform.txt_fecha.getvalue()
		lnidproveedor		= thisform.txtcodproveedor.Value
		lniddeposito 		= thisform.txt_id_deposito.Value
		lcnro_est			= ALLTRIM(thisform.txt_est.Value)
		lcnro_exp			= ALLTRIM(thisform.txt_exp.Value)
		lcnro_factura		= ALLTRIM(thisform.txt_nROFACTURA.Value)
		lnplazo				= thisform.cbo_plazo.Value
		ldfecha_vto			= thisform.txt_fecha_vto.getvalue()
		lcTipoCompra		= ALLTRIM(thisform.cbo_tipo_factura.Value)
		lcestado_compra		= IIF(thisform.cbo_tipo_factura.Value == "CONTADO","FACTURADO","PENDIENTE")
		lnidEmpresa			= _Screen.OAPP.nempresa
		lnidSucursal		= _Screen.OAPP.nsucursal
		lnidusuario			= _Screen.OAPP.nusuariosistema
		
		*-- Obtener los totales calculados del formulario
		lntotal_gravadas_excenta = thisform.TXT_EXCENTA.Value
		lntotal_gravadas_cinco   = thisform.TXT_TOTALIVA5.Value
		lntotal_gravadas_diez    = thisform.TXT_TOTALIVA10.Value
		lnliqui_iva_cinco        = thisform.TXT_LQ_CINCO.Value
		lnliqui_iva_diez         = thisform.TXT_LQ_DIEZ.Value
		lntotal_liqui_iva        = thisform.TXT_LQ_TOTAL.Value
		lntotal_compra           = thisform.TXT_TOTAL.Value
		
		IF MESSAGEBOX("Desea guardar los datos de la compra?", 36, "Aviso") = 6
			
			LOCAL llok AS Boolean
			llok = .T.
			
			LOCAL ARRAY loerror[1]
			
			= SQLEXEC(conexion, "START TRANSACTION")
			
			* 1. LLAMAR AL SP PARA GUARDAR CABECERA DE COMPRA
			LOCAL lcsqlcabecera, lnidcompra
			
			lcsqlcabecera = "CALL compra(?lnidproveedor, ?lniddeposito, ?lnidSucursal, ?lnidEmpresa, ?lnidusuario, " + ;
				"?ldfecha, ?lcnro_est, ?lcnro_exp, ?lcnro_factura, ?lnplazo, ?ldfecha_vto, ?lcTipoCompra, " + ;
				"?lcestado_compra, ?lntotal_gravadas_excenta, ?lntotal_gravadas_cinco, ?lntotal_gravadas_diez, " + ;
				"?lnliqui_iva_cinco, ?lnliqui_iva_diez, ?lntotal_liqui_iva, ?lntotal_compra)"
			
			LOCAL lnresult
			lnresult = SQLEXEC(conexion, lcsqlcabecera, "curCompraId")
			
			IF lnresult < 0
				llok = .F.
				AERROR(loerror)
				= SQLEXEC(conexion, "ROLLBACK")
				MESSAGEBOX("Error al guardar la cabecera de la compra: " + loerror[2], 16, "Error")
				RETURN
			ENDIF
			
			* OBTENER EL ID DE COMPRA GENERADO DEL SP
			lnidcompra = 0
			IF USED("curCompraId") AND RECCOUNT("curCompraId") > 0
				lnidcompra = curCompraId.id_compra
			ELSE
				llok = .F.
				= SQLEXEC(conexion, "ROLLBACK")
				MESSAGEBOX("Error al obtener el ID de compra generado", 16, "Error")
				RETURN
			ENDIF
			
			* 2. LLAMAR AL SP PARA GUARDAR DETALLES DE COMPRA
			SELECT curtmpCompra
			GO TOP
			SCAN
				LOCAL lcsqldetalle
				lcsqldetalle = "CALL compra_detalle(?lnidcompra, ?curtmpCompra.ncodarticulo, " + ;
					"?curtmpCompra.cIva, ?curtmpCompra.nprecio_costo, ?curtmpCompra.ncantidad, " + ;
					"?curtmpCompra.ngravadas_excenta, ?curtmpCompra.ngravadas_cinco, " + ;
					"?curtmpCompra.ngravadas_diez, ?curtmpCompra.nsubtotal)"
				
				lnresult = SQLEXEC(conexion, lcsqldetalle)
				IF lnresult < 0
					llok = .F.
					AERROR(loerror)
					= SQLEXEC(conexion, "ROLLBACK")
					MESSAGEBOX("Error al guardar el detalle de la compra: " + loerror[2], 16, "Error")
					RETURN
				ENDIF
			ENDSCAN
			
			* 3. OBTENER EL NRO DE FACTURA ANTES DEL COMMIT
			IF llok
				* Consultar el número de factura usando el ID generado
				LOCAL lcsql_consulta_nro
				lcsql_consulta_nro = "SELECT nro_factura FROM compra WHERE idcompra = ?lnidcompra"
				
				lnresult = SQLEXEC(conexion, lcsql_consulta_nro, "curNroFactura")
				
				IF lnresult < 0 OR NOT USED("curNroFactura") OR RECCOUNT("curNroFactura") = 0
					llok = .F.
					AERROR(loerror)
					= SQLEXEC(conexion, "ROLLBACK")
					MESSAGEBOX("Error al obtener el número de factura: " + loerror[2], 16, "Error")
					RETURN
				ELSE
					LOCAL lcnro_factura_guardado
					lcnro_factura_guardado = ALLTRIM(curNroFactura.nro_factura)
					USE IN curNroFactura
				ENDIF
			ENDIF
			
			* 4. HACER COMMIT SI TODO SALE BIEN
			IF llok
				= SQLEXEC(conexion, "COMMIT")
				MESSAGEBOX("Compra guardada correctamente! Nro Factura: " + lcnro_factura_guardado, 64, "Éxito")
				
				* Limpiar formulario después de guardar
				thisform.cancelar_compra()
				
			ELSE
				= SQLEXEC(conexion, "ROLLBACK")
				MESSAGEBOX("Error al guardar la compra", 16, "Error")
			ENDIF
			
			RETURN llok
		ELSE
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE Btnnorbase1.Click
		thisform.registrar_compra()
	ENDPROC

	PROCEDURE Btnnorbase2.Click
		if messagebox("¿Desea cancelar esta compra y limpiar la ventana?", 36, "Aviso") = 6
			thisform.cancelar_compra()
		ENDIF 
	ENDPROC

	PROCEDURE Btnnorbase3.Click
		THISFORM.Release()
	ENDPROC

	PROCEDURE btn_agregar.Click
		if empty(thisform.txt_cod_articulo.value)
			messagebox("Debes seleccionar un artículo para seguir.", 48, "Aviso")
			thisform.txt_cod_articulo.setfocus()
			return
		endif
		
		if empty(thisform.txt_cant.value)
			messagebox("Debes ingresar la cantidad de articulo para la compra.", 48, "Aviso")
			thisform.txt_cant.setfocus()
			return
		endif
		
		select curtmpcompra
		
		local lncodarticulo, lccodarticulo, lciva, lnsubtotal, lngravadaexcenta, lngravadacinco, lngravadadiez
		lncodarticulo = thisform.txt_idarticulo.value
		lccodarticulo = alltrim(thisform.txt_cod_articulo.value)
		lciva = alltrim(thisform.txt_iva.value)  && Asumiendo que tienes un control para el IVA
		
		*-- Verificar si el artículo ya existe en el cursor
		locate for ncodarticulo = lncodarticulo
		if found()
		*-- Artículo duplicado encontrado
			messagebox("El artículo '" + alltrim(thisform.txt_descripcion.value) + "' ya existe en la lista." + chr(13) + ;
				  "Código: " + lccodarticulo, 48, "Artículo Duplicado")
			thisform.txt_cod_articulo.setfocus()
			thisform.limpiar_articulos()
			return
		endif
		
		*-- Calcular subtotal
		lnsubtotal = thisform.txt_cant.value * thisform.txt_preciocosto.value
		
		*-- Inicializar campos de gravadas
		lngravadaexcenta = 0
		lngravadacinco = 0
		lngravadadiez = 0
		
		*-- Asignar subtotal al campo correspondiente según el IVA
		do case
			case lciva = "0"   && Exenta
				lngravadaexcenta = lnsubtotal
		
			case lciva = "5"   && 5%
				lngravadacinco = lnsubtotal
		
			case lciva = "10"  && 10%
				lngravadadiez = lnsubtotal
		
			otherwise
		*-- Si no coincide con ningún caso, por defecto va a exenta
				lngravadaexcenta = lnsubtotal
		endcase
		
		*-- Agregar un nuevo registro en blanco (solo si no es duplicado)
		append blank
		
		*-- Reemplazar los campos con los valores correspondientes
		replace ;
			ncodarticulo     with lncodarticulo, ;              			&& Código numérico
			ccodarticulo     with lccodarticulo, ;            			&& Código alfanumérico
			carticulo        with alltrim(thisform.txt_descripcion.value), ; && Descripción del artículo
			civa             with lciva, ;                                 && IVA
			cgruposubgrupo   with alltrim(thisform.txt_grupo_subgrupo.value), ; && Grupo/Subgrupo
			cmarca           with alltrim(thisform.txt_marca.value), ;   && Marca
			ncantidad        with thisform.txt_cant.value, ;            && Cantidad
			nprecio_costo    with thisform.txt_preciocosto.value, ;		&& Precio costo
			ngravadas_excenta with lngravadaexcenta, ;                   && Gravadas exentas
			ngravadas_cinco   with lngravadacinco, ;                     && Gravadas 5%
			ngravadas_diez    with lngravadadiez, ;                      && Gravadas 10%
			nsubtotal         with lnsubtotal                            && Subtotal
			
		*-- Llamar al método para calcular totales
		thisform.calcular_totales()
		
		thisform.limpiar_articulos()
		thisform.txt_cod_articulo.setfocus()
		thisform.grddetalle.refresh()
	ENDPROC

	PROCEDURE btn_borrar.Click
		*========================================
		* Evento Click del Botón Eliminar
		* Descripción: Elimina el registro actual del cursor y actualiza el total
		*========================================
		LOCAL lnRecNo, lnRecCount, lnResponse
		
		* Validaciones iniciales
		IF !USED("curtmpCompra")
		    MESSAGEBOX("No hay registros para eliminar.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		SELECT curtmpCompra
		lnRecCount = RECCOUNT()
		
		* Validar que existen registros y hay uno seleccionado
		DO CASE
		    CASE lnRecCount = 0
		        MESSAGEBOX("No hay registros para eliminar.", 48, "Aviso")
		        RETURN .F.
		    
		    CASE EOF() OR BOF()
		        MESSAGEBOX("Debe seleccionar un registro para eliminar.", 48, "Aviso")
		        RETURN .F.
		ENDCASE
		
		* Confirmar eliminación
		lnResponse = MESSAGEBOX("¿Está seguro de eliminar este registro?", 4+32, "Confirmar Eliminación")
		IF lnResponse != 6
		    RETURN .F.
		ENDIF
		
		* Guardar posición actual
		lnRecNo = RECNO()
		
		* Eliminar el registro
		DELETE
		SELECT curtmpCompra
		
		
		* Reposicionar cursor
		lnRecCount = RECCOUNT()
		IF lnRecCount > 0
		    * Ir al mismo número de registro o al último si ya no existe
		    GO MIN(lnRecNo, lnRecCount)
		ENDIF
		thisform.grdDetalle.Refresh()
		MESSAGEBOX("Registro eliminado correctamente.", 64, "Éxito")
		thisform.calcular_totales()
		RETURN .T.
	ENDPROC

	PROCEDURE cbo_plazo.GotFocus
		KEYBOARD '{SPACEBAR}' 
	ENDPROC

	PROCEDURE cbo_plazo.LostFocus
		LOCAL lnPlazo
		this.Enabled = .f.
		thisform.TXT_FECHA_VTO.thisenabled(.t.)
		lnPlazo = INT(VAL(this.Value))
		thisform.TXT_FECHA_VTO.setvalue(thisform.calcular_plazo(lnPlazo,thisform.txt_fecha.getvalue()))
	ENDPROC

	PROCEDURE cbo_tipo_factura.GotFocus
		KEYBOARD '{SPACEBAR}' 
	ENDPROC

	PROCEDURE cbo_tipo_factura.LostFocus
		IF this.Value = "CONTADO"
			THISFORM.cbo_plazo.Value = "0"
			thisform.TXT_FECHA_VTO.setvalue(thisform.txt_fecha.getvalue())
		ENDIF
		
		IF !EMPTY(THIS.VALUE) 
			this.Enabled = .f.
			thisform.cbo_plazo.Enabled = .t.
		ENDIF 
	ENDPROC

	PROCEDURE grdDetalle.When
		NODEFAULT 
	ENDPROC

	PROCEDURE txtcodproveedor.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			nodefault
			local loregistro as object
			do FORM bus_proveedor to loregistro
		
			if vartype(loregistro) <> "L"
				this.value = loregistro.idproveedor
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
		if m.nkeycode = 22
			NODEFAULT
			
			do form proveedor with .t. to m.lncodigo
			this.Value = m.lncodigo
		endif
	ENDPROC

	PROCEDURE txtcodproveedor.LostFocus
		dodefault()
		if not empty(this.value)
			local lnproveedorid, lcsql
		
			lnproveedorid = this.value
		
			lcsql = "SELECT * FROM proveedor WHERE idproveedor= " + alltrim(str(lnproveedorid, 20, 0))
		
			if sqlexec(conexion, lcsql, "cur_proveedor") > 0
				if reccount("cur_proveedor") > 0
		
		** Llenar campos del formulario.
					this.value = cur_proveedor.idproveedor
					thisform.txtproveedor.value 	= alltrim(cur_proveedor.proveedor)
					thisform.txt_ruc.value			= alltrim(cur_proveedor.ruc)
					thisform.txt_direccion.value	= alltrim(cur_proveedor.direccion)
					thisform.txt_telefono.value		= alltrim(cur_proveedor.telefono)
					thisform.txt_id_deposito.Enabled = .t.
					this.Enabled = .f.
		
				else
		
		** Personal no encontrado
					messagebox("Proveedor no encontrado", 16, "Atención")
					this.value = 0
					thisform.txtproveedor.value 	= ""
					thisform.txtproveedor.value 	= ""
					thisform.txt_ruc.value			= ""
					thisform.txt_direccion.value	= ""
					thisform.txt_telefono.value		= ""
		
		** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		
					this.setfocus()
					nodefault
		
				endif
			else
		** Error en la consulta
				local laerror[1]
				aerror(laerror)
				messagebox("Error al buscar proveedor: " + laerror[2], 16, "Error")
			endif
		else
			thisform.txtproveedor.value = ""
			thisform.txtproveedor.value 	= ""
			thisform.txtproveedor.value 	= ""
			thisform.txt_ruc.value			= ""
			thisform.txt_direccion.value	= ""
			thisform.txt_telefono.value		= ""
		endif
	ENDPROC

	PROCEDURE txtcodproveedor.Valid
		NODEFAULT 
	ENDPROC

	PROCEDURE txtproveedor.redraw
		WITH THIS
			.BORDERCOLOR = _SCREEN.oRibbon.LinesColor
			.FORECOLOR = _SCREEN.oRibbon.ButtonFontColor
			.SELECTEDBACKCOLOR = _SCREEN.oRibbon.BackGround
			.SELECTEDFORECOLOR = _SCREEN.oRibbon.FontColor
			.FONTNAME = _SCREEN.oRibbon.cFontName
			.BACKCOLOR = _SCREEN.oRibbon.ChangeColor(_SCREEN.oRibbon.BackColor1, _SCREEN.oRibbon.nFactorBackcolor)
			.DISABLEDBACKCOLOR = _SCREEN.oRibbon.InEditBackDisable
			*.DISABLEDFORECOLOR = _SCREEN.oRibbon.InEditForeDisable
		ENDWITH
		
	ENDPROC

	PROCEDURE TXT_CANT.LostFocus
		DODEFAULT()
		if not empty(this.value)
			thisform.TXT_SUBTOTAL.Value = thisform.txt_preciocosto.Value * this.Value
			this.enabled = .f.
		endif
	ENDPROC

	PROCEDURE txt_cod_articulo.KeyPress
		lparameters nkeycode, nshiftaltctrl
		
		
		if nkeycode = 42
			nodefault
		
			if empty(thisform.txt_id_deposito.value)
				messagebox("Seleccione un depósito", 16, "Aviso")
				thisform.txt_id_deposito.setfocus()
				thisform.txt_fecha.SetFocus()
				return
			endif
		
		
			local loregistro as object
			do form bus_articulo with _screen.oapp.nsucursal, thisform.txt_id_deposito.value to  loregistro
		
		
			if vartype(loregistro) <> "L"
		
				this.value = alltrim(loregistro.codbarra)
				this.setfocus()
		
			else
		
				this.value = ""
		
			endif
		endif
	ENDPROC

	PROCEDURE txt_cod_articulo.LostFocus
		dodefault()
		if empty(thisform.txt_id_deposito.value)
			messagebox('Debes indicar un deposito', 16, "Aviso")
			thisform.txt_id_deposito.setfocus
			thisform.txt_fecha.SetFocus()
			nodefault
		endif
		
		if not empty(this.value)
			local lccodarticulo, lncoddeposito, lncodsucursal, lcsql
		
			lncodsucursal = _screen.oapp.nsucursal
			lccodarticulo = alltrim(this.value)
			lncoddeposito = thisform.txt_id_deposito.value
		
		
			lcsql = "SELECT * FROM v_articulo WHERE codbarra = '" + lccodarticulo + "'"
			lcsql = lcsql + " and iddeposito = " + alltrim(str(lncoddeposito, 10, 0))
			lcsql = lcsql + " and idsucursal = " + alltrim(str(lncodsucursal, 10, 0))
		
			if sqlexec(conexion, lcsql, "cur_articulo") > 0
				if reccount("cur_articulo") > 0
		
					** Llenar campos del formulario.
					**
		
					this.value = alltrim(cur_articulo.codbarra)
					thisform.txt_idarticulo.value		= cur_articulo.idarticulo
					thisform.TXT_IVA.Value				= cur_articulo.impuesto
					thisform.txt_descripcion.value 		= cur_articulo.descripcion
					thisform.txt_grupo_subgrupo.value	= alltrim(cur_articulo.nombre_grupo) + " " + alltrim(cur_articulo.nombre_subgrupo)
					thisform.txt_marca.value			= alltrim(cur_articulo.nombre_marca)
					thisform.txt_preciocosto.value		= cur_articulo.precio_costo
					thisform.TXT_CANT.value				= 1
					thisform.TXT_SUBTOTAL.Value			= 0
					
					thisform.txt_preciocosto.Enabled =.t.
					
		
				else
		
					** Articulo no encontrado
					messagebox("Articulo no encontrado", 16, "Atención")
		
		
					*limpiar datos de articulos
					thisform.limpiar_articulos()
		
					** DEVOLVER EL FOCO AL CONTROL ACTUAL.
					
					this.setfocus()
					nodefault
		
				endif
			else
				** Error en la consulta
				local laerror[1]
				aerror(laerror)
		
				messagebox("Error al buscar la Articulos: " + laerror[2], 16, "Error")
			endif
		else
		*thisform.txt_forma.value = ""
		endif
	ENDPROC

