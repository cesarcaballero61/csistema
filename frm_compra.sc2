	PROCEDURE calcular_plazo
		LPARAMETERS tnDias, tdFecha
		*-- Función que suma días a una fecha
		*-- Parámetros:
		*--   tnDias: Número de días a sumar (puede ser positivo o negativo)
		*--   tdFecha: Fecha base
		*-- Retorna: Fecha resultante
		
		LOCAL ldResultado
		
		*-- Validar que la fecha sea válida
		IF TYPE("tdFecha") <> "D" OR ISNULL(tdFecha)
		    ldResultado = DATE()  && Si no es fecha válida, usar fecha actual
		ELSE
		    ldResultado = tdFecha
		ENDIF
		
		*-- Validar que los días sean numéricos
		IF TYPE("tnDias") = "N"
		    ldResultado = ldResultado + tnDias
		ENDIF
		
		RETURN ldResultado
	ENDPROC

	PROCEDURE calcular_totales
		*-- Método para calcular totales de gravadas
		
		    LOCAL lnTotalExcenta, lnTotalCinco, lnTotalDiez, lnTotalGeneral,lnIVACinco,lnIVADiez,lnLiquidacionIVA 
		    
		    *-- Inicializar variables
		    STORE 0 TO lnTotalExcenta, lnTotalCinco, lnTotalDiez, lnTotalGeneral,lnIVACinco,lnIVADiez,lnLiquidacionIVA 
		    
		    *-- Calcular sumatorias desde el cursor
		    SELECT curtmpCompra
		    CALCULATE SUM(ngravadas_excenta), SUM(ngravadas_cinco), SUM(ngravadas_diez), SUM(nsubtotal) ;
		             TO lnTotalExcenta, lnTotalCinco, lnTotalDiez, lnTotalGeneral
		    
		
		    *-- CÁLCULO DE IVA SEGÚN TARIFAS PARAGUAYAS
		    lnIVACinco = lnTotalCinco /21      && IVA 5%
		    lnIVADiez = lnTotalDiez /11       && IVA 10%
		    lnLiquidacionIVA = lnIVACinco + lnIVADiez
		
		    *-- Mostrar los totales en los controles correspondientes
		    *-- Asumiendo que tienes textboxes para mostrar los totales
		    thisform.TXT_EXCENTA.Value = lnTotalExcenta
		    thisform.TXT_TOTALIVA5.Value = lnTotalCinco
		    thisform.TXT_TOTALIVA10.Value = lnTotalDiez
		    thisform.TXT_TOTALIVA10.Value = lnTotalGeneral
		    thisform.TXT_TOTAL.Value =lnTotalGeneral
		    
		    *--- liquidaciones
		    thisform.TXT_LQ_CINCO.Value = lnIVACinco 
		    thisform.TXT_LQ_DIEZ.Value =lnIVADiez 
		    thisform.TXT_LQ_TOTAL.value =lnLiquidacionIVA 
		    
		    
		    *-- Formatear los valores si es necesario
		    thisform.TXT_EXCENTA.InputMask = "999,999,999"
		    thisform.TXT_TOTALIVA5.InputMask = "999,999,999"
		    thisform.TXT_TOTALIVA10.InputMask = "999,999,999"
		    thisform.TXT_TOTAL.InputMask = "999,999,999"
		   
		    thisform.TXT_LQ_CINCO.InputMask = "999,999,999"
		    thisform.TXT_LQ_DIEZ.InputMask = "999,999,999"
		    thisform.TXT_LQ_TOTAL.InputMask = "999,999,999"
		
	ENDPROC

	PROCEDURE cancelar_compra
		WITH thisform
			.txt_fecha.setvalue({})
			.txtcodproveedor.Value = 0
			.txtproveedor.Value = ""
			.txt_id_deposito.Value = 0
			.txt_deposito.Value = ""
			.TXT_EST.Value = ""
			.TXT_EXP.Value = ""
			.TXT_NROFACTURA.Value = ""
			.cbo_plazo.Value = ""
			.txt_ruc.value= ""
			.txt_telefono.value = ""
			.txt_direccion.value = ""
			.TXT_FECHA_VTO.setvalue({})
			.cbo_tipo_factura.Value = ""
			
			*-- Limpiar controles de totales.
			.TXT_EXCENTA.Value = 0
			.TXT_TOTALIVA5.Value = 0
			.TXT_TOTALIVA10.Value = 0
			.TXT_LQ_CINCO.Value = 0
			.TXT_LQ_DIEZ.Value = 0
			.TXT_LQ_TOTAL.Value = 0
			.TXT_TOTAL.Value = 0
			
			.limpiar_articulos()
			
			*-- Habilitar controles
			.txt_fecha.Enabled = .T.
			.txtcodproveedor.Enabled = .T.
			.txt_id_deposito.Enabled = .T.
			.TXT_EST.Enabled = .T.
			.TXT_EXP.Enabled = .T.
			.TXT_NROFACTURA.Enabled = .T.
			.cbo_plazo.Enabled = .T.
			.txt_fecha_vto.Enabled = .T.
			.cbo_tipo_factura.Enabled = .T.
			
			.txt_fecha.SetFocus()
			
			*-- Limpiar cursor temporal de compra
			SELECT curtmpCompra
			ZAP
			
			.grdDetalle.Refresh()
			
		ENDWITH 
	ENDPROC

	PROCEDURE grid_detalle
		WITH this.grdDetalle
			.AllowCellSelection = .f.
			.ColumnCount = 0
			.RecordSourceType = 1
		    .RecordSource = "curtmpCompra"
		    .ColumnCount = 11
		    
		    *-- Columna 1: NCODARTICULO
		    .Column1.Header1.Caption = "ID.ARTICULO"
