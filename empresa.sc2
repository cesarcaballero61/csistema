	PROCEDURE Init
		lparameters tlinsert
		
		thisform.linsert = m.tlinsert
		
		sqlexec(conexion, "select * from empresa order by idempresa", "cur_empresa")
		go top
		thisform.llenar_dato()
		thisform.llenar_grid()
		
		if thisform.linsert
			thisform.windowtype = 1
			thisform.btn_nuevo.click()
		endif
		
	ENDPROC

	PROCEDURE llenar_dato
		thisform.txt_codigo.value = cur_empresa.idempresa
		thisform.txt_empresa.value = cur_empresa.empresa
		thisform.txt_descrip.value = cur_empresa.descrip
		thisform.txt_ruc.value = cur_empresa.ruc
		thisform.txt_telefono.value = cur_empresa.telefono
		
	ENDPROC

	PROCEDURE llenar_grid
		WITH thisform.grid1
			.RecordSource = "cur_empresa"
			.RecordSourceType = 1
			.ColumnCount = 5
			.FontSize = 8
			
			.Column1.Header1.Caption = "Código"
			.Column1.Width = 50
			.Column1.Alignment = 0
			.Column1.ControlSource = "idempresa"
			
			.Column2.Header1.Caption = "Empresa"
			.Column2.Width = 150
			.Column2.Alignment = 0
			.Column2.ControlSource = "empresa"
			
			.Column3.Header1.Caption = "RUC"
			.Column3.Width = 100
			.Column3.Alignment = 0
			.Column3.ControlSource = "ruc"
			
			.Column4.Header1.Caption = "Descripción"
			.Column4.Width = 180
			.Column4.Alignment = 0
			.Column4.ControlSource = "descrip"
			
			.Column5.Header1.Caption = "Teléfono"
			.Column5.Width = 90
			.Column5.Alignment = 0
			.Column5.ControlSource = "telefono"
			
		
		ENDWITH
	ENDPROC

	PROCEDURE Unload
		if thisform.linsert
			return thisform.nretcod
		endif
	ENDPROC

	PROCEDURE btn_aceptar.Click
		*BOTON ACEPTAR
		*ADAPTA LOS TEXTBOXES
		*METODO SP USADO ES amb_empresa
		
		local lnok, cap_cod, cap_empresa, cap_descrip, cap_ruc, cap_telefono, lncodnew, cap_tipo
		local array laerr[1]
		
		* Validaciones de campos obligatorios
		if empty(thisform.txt_empresa.value)
		    messagebox("Debes indicar un nombre de empresa!", 272, "Error")
		    thisform.txt_empresa.setfocus
		    return
		endif
		
		if empty(thisform.txt_ruc.value)
		    messagebox("Debes indicar un RUC!", 272, "Error")
		    thisform.txt_ruc.setfocus
		    return
		endif
		
		* Asignar valores desde los textboxes
		cap_cod = thisform.txt_codigo.value
		cap_empresa = thisform.txt_empresa.value
		cap_descrip = thisform.txt_descrip.value
		cap_ruc = thisform.txt_ruc.value
		cap_telefono = thisform.txt_telefono.value
		
		cap_tipo = thisform.tipo
		
		= sqlexec(conexion, "START TRANSACTION")
		
		lnok = sqlexec(conexion, "call amb_empresa(?cap_tipo, ?cap_cod, ?cap_empresa, ?cap_ruc, ?cap_telefono)")
		
		if lnok > 0
		    if cap_tipo = "N"
		        = sqlexec(conexion, "SELECT CAST(LAST_INSERT_ID() AS SIGNED) as new_id", "curNewId")
		        if used("curNewId") and reccount("curNewId") > 0
		            lncodnew = int(val(curnewid.new_id))
		            use in curnewid
		        else
		            lncodnew = 0
		        endif
		    else
		        lncodnew = cap_cod
		    endif
		
		    = sqlexec(conexion, "COMMIT")
		    = sqlexec(conexion, "select * from empresa order by idempresa", "cur_empresa")
		
		    * Buscar el registro insertado/modificado
		    select cur_empresa
		    locate for idempresa = lncodnew
		    if not found()
		        if cap_tipo = "N"
		            go bottom in cur_empresa
		        else
		            go top in cur_empresa
		        endif
		    ENDIF
		    
		    thisform.llenar_grid()
		    thisform.llenar_dato()
		
		else
		    * ERROR EN LA EJECUCIÓN DEL SQLEXEC
		    aerror(laerr)
		    = sqlexec(conexion, "ROLLBACK")
		    messagebox("Error de conexión: " + laerr[2], 16, "Error")
		endif
		
		if thisform.linsert
		    thisform.nretcod = lncodnew
		    thisform.release()
		else
		    thisform.btn_nuevo.enabled = .t.
		    thisform.btn_modificar.enabled = .t.
		    thisform.btn_borrar.Enabled = .t.
		    
		    thisform.btn_aceptar.enabled = .f.
		    thisform.btn_cancelar.enabled = .f.
		    
		    * Deshabilitar todos los textboxes
		    thisform.txt_empresa.enabled = .f.
		    thisform.txt_descrip.enabled = .f.
		    thisform.txt_ruc.enabled = .f.
		    thisform.txt_telefono.enabled = .f.
		    
		    thisform.cnt_navegacion.enabled = .t.
		    thisform.grid1.enabled = .t.
		    thisform.llenar_dato()
		    thisform.llenar_grid()
		    thisform.btn_nuevo.setfocus
		endif
	ENDPROC

	PROCEDURE btn_borrar.Click
		*BOTON BORRAR EMPRESA USANDO EL AMB_EMPRESA
		* Y ADAPTAR LOS TEXTBOX
		
		local lnok, cap_cod
		LOCAL Array err[1]
		
		if messagebox("¿Desea borrar este registro?", 36, "Aviso") = 6
		
		    cap_cod = thisform.txt_codigo.value
		
		    = sqlexec(conexion, "START TRANSACTION")
		
		    * Llamar al SP amb_empresa con tipo 'B' (Borrar) y solo el código
		    lnok = sqlexec(conexion, "call amb_empresa('B', ?cap_cod, '', '', '')")
		
		    if lnok > 0
		    
		        = sqlexec(conexion, "COMMIT")
		        = sqlexec(conexion, "select * from empresa order by idempresa", "cur_empresa")
		        
		        * Actualizar el grid y los datos
		        select cur_empresa
		        if reccount() > 0
		            go top
		        else
		            * Si no hay registros, limpiar los textboxes
		            thisform.txt_codigo.value = 0
		            thisform.txt_empresa.value = ""
		            thisform.txt_descrip.value = ""
		            thisform.txt_ruc.value = ""
		            thisform.txt_telefono.value = ""
		        endif
		        
		    else
		        aerror(err)
		        = sqlexec(conexion, "ROLLBACK")
		        messagebox("Error ocurrido al borrar datos: " + err[2], 16, "Error")
		    endif
		
		    thisform.llenar_grid()
		    thisform.llenar_dato()
		
		endif
	ENDPROC

	PROCEDURE btn_cancelar.Click
		*BOTON CANCELAR ADAPTA EL CODIGO CON LOS TEXTBOX 
		
		thisform.btn_nuevo.enabled = .t.
		thisform.btn_modificar.enabled = .t.
		thisform.btn_borrar.Enabled = .t.
		thisform.btn_aceptar.enabled = .f.
		thisform.btn_cancelar.enabled = .f.
		
		* Deshabilitar todos los textboxes de empresa
		thisform.txt_codigo.enabled = .f.
		thisform.txt_empresa.enabled = .f.
		thisform.txt_descrip.enabled = .f.
		thisform.txt_ruc.enabled = .f.
		thisform.txt_telefono.enabled = .f.
		
		thisform.cnt_navegacion.enabled = .t.
		thisform.grid1.enabled = .t.
		
		if thisform.tipo = "N"
		    select cur_empresa
		    go top
		ENDIF
		
		thisform.llenar_dato()
		thisform.btn_nuevo.setfocus
	ENDPROC

	PROCEDURE btn_modificar.Click
		*boton modificar
		thisform.btn_nuevo.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_borrar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		* Habilitar los textboxes para edición (excepto posiblemente el código)
		thisform.txt_empresa.enabled = .t.
		thisform.txt_descrip.enabled = .t.
		thisform.txt_ruc.enabled = .t.
		thisform.txt_telefono.enabled = .t.
		
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_empresa.setfocus
		
		thisform.tipo = "M"
	ENDPROC

	PROCEDURE btn_nuevo.Click
		this.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_borrar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		* Habilitar los textboxes para edición
		thisform.txt_empresa.enabled = .t.
		thisform.txt_descrip.enabled = .t.
		thisform.txt_ruc.enabled = .t.
		thisform.txt_telefono.enabled = .t.
		
		* Limpiar los valores de los textboxes
		thisform.txt_codigo.value = 0
		thisform.txt_empresa.value = ""
		thisform.txt_descrip.value = ""
		thisform.txt_ruc.value = ""
		thisform.txt_telefono.value = ""
		
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_empresa.setfocus
		
		thisform.tipo = "N"
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.Release
	ENDPROC

	PROCEDURE cnt_navegacion.btn_atras.Click
		 SELECT cur_empresa
		 IF  .NOT. BOF()
		    SKIP -1
		    IF BOF()
		       GOTO TOP
		       WAIT WINDOW NOWAIT "Estas en el primer registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh()
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_primero.Click
		SELECT cur_empresa
		GO top
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE cnt_navegacion.btn_siguiente.Click
		 SELECT cur_empresa
		 IF  .NOT. EOF()
		    SKIP
		    IF EOF()
		       GOTO BOTTOM
		       WAIT WINDOW NOWAIT "Estas en el último registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_ultimo.Click
		SELECT cur_empresa
		GO bottom
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		thisform.llenar_dato
	ENDPROC

	PROCEDURE Grid1.Click
		thisform.llenar_dato
	ENDPROC

	PROCEDURE txt_buscar.InteractiveChange
		dodefault()
		local lcbusqueda, lcfiltro, lcrecordsource, lacampos[1], lncampos, lni, lccampo
		
		* Obtener el texto de búsqueda (sin espacios al inicio/final)
		lcbusqueda = alltrim(upper(this.value))
		
		* Obtener el recordsource del grid
		lcrecordsource = thisform.grid1.recordsource
		
		if empty(lcbusqueda)
		* Si no hay texto de búsqueda, mostrar todos los registros
			if used(lcrecordsource)
				select (lcrecordsource)
				set filter to
				go top
			endif
		else
		* Verificar que exista la propiedad cCamposBusqueda
			if type("THISFORM.cCamposBusqueda") = "C" and !empty(thisform.ccamposbusqueda)
		
		* Dividir los campos por comas
				lncampos = alines(lacampos, strtran(thisform.ccamposbusqueda, " ", ""), 1, ",")
				lcfiltro = ""
		
		* Construir el filtro dinámicamente
				for lni = 1 to lncampos
					lccampo = alltrim(lacampos[lnI])
		
		* Verificar que el campo existe en el cursor
					if used(lcrecordsource)
						select (lcrecordsource)
						if type(lccampo) <> "U"
		
		* Agregar OR si no es el primer campo
							if !empty(lcfiltro)
								lcfiltro = lcfiltro + " OR "
							endif
		
		* Determinar el tipo de campo y construir la condición apropiada
							do case
								case type(lccampo) = "N"  && Campo numérico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(STR(" + lccampo + ")))"
		
								case type(lccampo) = "C"  && Campo de texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(" + lccampo + "))"
		
								case type(lccampo) = "D"  && Campo de fecha
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(DTOC(" + lccampo + "))"
		
								case type(lccampo) = "L"  && Campo lógico
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(IIF(" + lccampo + ", 'TRUE', 'FALSE'))"
		
								otherwise  && Otros tipos, tratar como texto
									lcfiltro = lcfiltro + "'" + lcbusqueda + "' $ UPPER(ALLTRIM(TRANSFORM(" + lccampo + ")))"
							endcase
						endif
					endif
				next
		
		* Aplicar el filtro si se construyó correctamente
				if !empty(lcfiltro) and used(lcrecordsource)
					select (lcrecordsource)
					set filter to &lcfiltro
					go top
				endif
		
			else
		* Si no existe la propiedad, mostrar mensaje de error
				messagebox("La propiedad 'cCamposBusqueda' no está definida en el formulario.", 16, "Error de configuración")
			endif
		endif
		
		* Refrescar el grid
		thisform.grid1.refresh()
	ENDPROC

ENDDEFINE
