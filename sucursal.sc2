	PROCEDURE Init
		lparameters tlinsert
		
		thisform.linsert = m.tlinsert
		
		sqlexec(conexion, "select * from v_sucursal order by idsucursal", "cur_sucursal")
		go top
		thisform.llenar_dato()
		thisform.llenar_grid()
		
		if thisform.linsert
			thisform.windowtype = 1
			thisform.btn_nuevo.click()
		endif
		
	ENDPROC

	PROCEDURE llenar_dato
		thisform.txt_codigo.Value=cur_sucursal.idsucursal
		thisform.txt_sucursal.Value=cur_sucursal.sucursal
		thisform.txt_cod_empresa.Value=cur_sucursal.idempresa
		thisform.txt_empresa.Value=cur_sucursal.empresa
		thisform.txt_direccion.Value=cur_sucursal.direccion
		thisform.txt_telefono.Value=cur_sucursal.telefono
		
	ENDPROC

	PROCEDURE llenar_grid
		*METODO PARA MONTAR GRID EN VFP USANDO V_SUCURSAL (VERSIÓN COMPACTA)
		WITH thisform.grid1
			.RecordSource = "cur_sucursal"
			.RecordSourceType = 1
			.FontSize = 8
			.ColumnCount = 3
			
			.Column1.Header1.Caption = "Código"
			.Column1.Width = 60
			.Column1.Alignment = 0
			.Column1.ControlSource = "idsucursal"
			
			.Column2.Header1.Caption = "Sucursal"
			.Column2.Width = 180
			.Column2.Alignment = 0
			.Column2.ControlSource = "sucursal"
			
			.Column3.Header1.Caption = "Empresa"
			.Column3.Width = 150
			.Column3.Alignment = 0
			.Column3.ControlSource = "empresa"
		
		ENDWITH 
	ENDPROC

	PROCEDURE Unload
		if thisform.linsert
			return thisform.nretcod
		endif
	ENDPROC

	PROCEDURE btn_aceptar.Click
		*BOTON ACEPTAR
		*METODO USADO ES amb_sucursal
		
		local lnok, cap_cod, cap_cod_empresa, cap_sucursal, cap_direccion, cap_telefono, lncodnew, cap_tipo
		local array laerr[1]
		
		* Validaciones de campos obligatorios
		if empty(thisform.txt_sucursal.value)
		    messagebox("Debes indicar un nombre de sucursal!", 272, "Error")
		    thisform.txt_sucursal.setfocus
		    return
		endif
		
		if empty(thisform.txt_cod_empresa.value) or thisform.txt_cod_empresa.value = 0
		    messagebox("Debes indicar una empresa!", 272, "Error")
		    thisform.txt_cod_empresa.setfocus
		    return
		endif
		
		* Asignar valores desde los textboxes
		cap_cod = thisform.txt_codigo.value
		cap_cod_empresa = thisform.txt_cod_empresa.value
		cap_sucursal = thisform.txt_sucursal.value
		cap_direccion = thisform.txt_direccion.value
		cap_telefono = thisform.txt_telefono.value
		
		cap_tipo = thisform.tipo
		
		= sqlexec(conexion, "START TRANSACTION")
		
		lnok = sqlexec(conexion, "call amb_sucursal(?cap_tipo, ?cap_cod, ?cap_cod_empresa, ?cap_sucursal, ?cap_direccion, ?cap_telefono)")
		
		if lnok > 0
		    if cap_tipo = "N"
		        = sqlexec(conexion, "SELECT CAST(LAST_INSERT_ID() AS SIGNED) as new_id", "curNewId")
		        if used("curNewId") and reccount("curNewId") > 0
		            lncodnew = int(val(curnewid.new_id))
		            use in curnewid
		        else
		            lncodnew = 0
		        endif
		    else
		        lncodnew = cap_cod
		    endif
		
		    = sqlexec(conexion, "COMMIT")
		    = sqlexec(conexion, "select * from v_sucursal order by idsucursal", "cur_sucursal")
		
		    * Buscar el registro insertado/modificado
		    select cur_sucursal
		    locate for idsucursal = lncodnew
		    if not found()
		        if cap_tipo = "N"
		            go bottom in cur_sucursal
		        else
		            go top in cur_sucursal
		        endif
		    ENDIF
		    
		    thisform.llenar_grid()
		    thisform.llenar_dato()
		
		else
		    * ERROR EN LA EJECUCIÓN DEL SQLEXEC
		    aerror(laerr)
		    = sqlexec(conexion, "ROLLBACK")
		    messagebox("Error de conexión: " + laerr[2], 16, "Error")
		endif
		
		if thisform.linsert
		    thisform.nretcod = lncodnew
		    thisform.release()
		else
		    thisform.btn_nuevo.enabled = .t.
		    thisform.btn_modificar.enabled = .t.
		    thisform.btn_borrar.Enabled = .t.
		    
		    thisform.btn_aceptar.enabled = .f.
		    thisform.btn_cancelar.enabled = .f.
		    
		    * Deshabilitar todos los textboxes
		    thisform.txt_codigo.enabled = .f.
		    thisform.txt_sucursal.enabled = .f.
		    thisform.txt_cod_empresa.enabled = .f.
		    thisform.txt_empresa.enabled = .f.
		    thisform.txt_direccion.enabled = .f.
		    thisform.txt_telefono.enabled = .f.
		    
		    thisform.cnt_navegacion.enabled = .t.
		    thisform.grid1.enabled = .t.
		    thisform.llenar_dato()
		    thisform.llenar_grid()
		    thisform.btn_nuevo.setfocus
		endif
	ENDPROC

	PROCEDURE btn_borrar.Click
		*BOTON BORRAR SUCURSAL USANDO EL AMB_SUCURSAL
		* Y ADAPTAR LOS TEXTBOX
		
		local lnok, cap_cod
		LOCAL Array err[1]
		
		if messagebox("¿Desea borrar este registro?", 36, "Aviso") = 6
		
		    cap_cod = thisform.txt_codigo.value
		
		    = sqlexec(conexion, "START TRANSACTION")
		
		    * Llamar al SP amb_sucursal con tipo 'B' (Borrar) y solo el código
		    lnok = sqlexec(conexion, "call amb_sucursal('B', ?cap_cod, 0, '', '', '')")
		
		    if lnok > 0
		    
		        = sqlexec(conexion, "COMMIT")
		        = sqlexec(conexion, "select * from v_sucursal order by idsucursal", "cur_sucursal")
		        
		        * Actualizar el grid y los datos
		        select cur_sucursal
		        if reccount() > 0
		            go top
		        else
		            * Si no hay registros, limpiar los textboxes
		            thisform.txt_codigo.value = 0
		            thisform.txt_sucursal.value = ""
		            thisform.txt_cod_empresa.value = 0
		            thisform.txt_empresa.value = ""
		            thisform.txt_direccion.value = ""
		            thisform.txt_telefono.value = ""
		        endif
		        
		    else
		        aerror(err)
		        = sqlexec(conexion, "ROLLBACK")
		        messagebox("Error ocurrido al borrar datos: " + err[2], 16, "Error")
		    endif
		
		    thisform.llenar_grid()
		    thisform.llenar_dato()
		
		endif
	ENDPROC

	PROCEDURE btn_cancelar.Click
		*BOTON CANCELAR ADAPTA EL CODIGO CON LOS TEXTBOX 
		
		thisform.btn_nuevo.enabled = .t.
		thisform.btn_modificar.enabled = .t.
		thisform.btn_borrar.Enabled = .t.
		thisform.btn_aceptar.enabled = .f.
		thisform.btn_cancelar.enabled = .f.
		
		* Deshabilitar todos los textboxes
		thisform.txt_codigo.enabled = .f.
		thisform.txt_sucursal.enabled = .f.
		thisform.txt_cod_empresa.enabled = .f.
		thisform.txt_empresa.enabled = .f.
		thisform.txt_direccion.enabled = .f.
		thisform.txt_telefono.enabled = .f.
		
		thisform.cnt_navegacion.enabled = .t.
		thisform.grid1.enabled = .t.
		
		if thisform.tipo = "N"
		    select cur_sucursal
		    go top
		ENDIF
		
		thisform.llenar_dato()
		thisform.btn_nuevo.setfocus
	ENDPROC

	PROCEDURE btn_modificar.Click
		*boton modificar
		thisform.btn_nuevo.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_borrar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		* Habilitar los textboxes para edición (excepto posiblemente el código)
		thisform.txt_sucursal.enabled = .t.
		thisform.txt_cod_empresa.enabled = .t.
		thisform.txt_direccion.enabled = .t.
		thisform.txt_telefono.enabled = .t.
		
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_sucursal.setfocus
		
		thisform.tipo = "M"
	ENDPROC

	PROCEDURE btn_nuevo.Click
		this.enabled = .f.
		thisform.btn_modificar.enabled = .f.
		thisform.btn_borrar.enabled = .f.
		thisform.btn_aceptar.enabled = .t.
		thisform.btn_cancelar.enabled = .t.
		
		thisform.txt_codigo.value = 0
		
		* Habilitar los textboxes para edición
		thisform.txt_sucursal.enabled = .t.
		thisform.txt_cod_empresa.enabled = .t.
		thisform.txt_direccion.enabled = .t.
		thisform.txt_telefono.enabled = .t.
		
		* Limpiar los valores de los textboxes
		thisform.txt_codigo.value = 0
		thisform.txt_sucursal.value = ""
		thisform.txt_cod_empresa.value = 0
		thisform.txt_empresa.value = ""
		thisform.txt_direccion.value = ""
		thisform.txt_telefono.value = ""
		
		thisform.cnt_navegacion.enabled = .f.
		thisform.grid1.enabled = .f.
		thisform.txt_sucursal.setfocus
		
		thisform.tipo = "N"
	ENDPROC

	PROCEDURE btn_salir.Click
		thisform.Release
	ENDPROC

	PROCEDURE cnt_navegacion.btn_atras.Click
		 SELECT cur_sucursal
		 IF  .NOT. BOF()
		    SKIP -1
		    IF BOF()
		       GOTO TOP
		       WAIT WINDOW NOWAIT "Estas en el primer registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh()
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_primero.Click
		SELECT cur_sucursal
		GO top
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE cnt_navegacion.btn_siguiente.Click
		 SELECT cur_sucursal
		 IF  .NOT. EOF()
		    SKIP
		    IF EOF()
		       GOTO BOTTOM
		       WAIT WINDOW NOWAIT "Estas en el último registro..."
		    ENDIF
			 thisform.llenar_dato
		    thisform.refresh
		 ENDIF
	ENDPROC

	PROCEDURE cnt_navegacion.btn_ultimo.Click
		SELECT cur_sucursal
		GO bottom
		thisform.llenar_dato
		thisform.Refresh
	ENDPROC

	PROCEDURE Grid1.AfterRowColChange
		LPARAMETERS nColIndex
		thisform.llenar_dato
	ENDPROC

	PROCEDURE Grid1.Click
		thisform.llenar_dato
	ENDPROC

	PROCEDURE txt_buscar.InteractiveChange
		cBuscar="%"+ALLTRIM(this.Value)+"%"
		SQLEXEC(conexion,"select * from v_sucursal where sucrursal like ?cBuscar","cur_sucursal")
		thisform.llenar_grid
	ENDPROC

	PROCEDURE txt_cod_empresa.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		IF nKeyCode = 42
			NODEFAULT 
			LOCAL loregistro
			DO FORM bus_empresa TO loregistro
			
			IF VARTYPE(loregistro) <> "L"
				this.Value = loregistro.idempresa
			ELSE
				this.Value = 0
			ENDIF 
		ENDIF 
	ENDPROC

	PROCEDURE txt_cod_empresa.LostFocus
		IF NOT EMPTY(this.Value)
		    LOCAL lnIdempresa, lcSQL, lnResult
		    LOCAL ARRAY laError[1]
		    
		    lnIdempresa= this.Value
		    
		    lcSQL = "SELECT * FROM empresa WHERE idempresa = " + ALLTRIM(STR(lnIdempresa))
		    
		    lnResult = SQLEXEC(conexion, lcSQL, "cur_empresa")
		    
		    IF lnResult > 0
		        IF RECCOUNT("cur_empresa") > 0
		            WITH thisform
		                .txt_empresa.Value = ALLTRIM(cur_empresa.empresa)
		            ENDWITH
		        ELSE
		            MESSAGEBOX("La empresa con ID " + ALLTRIM(STR(lnIdempresa)) + " no existe.", 16, "Atención")
		            this.Value = 0
		            thisform.txt_empresa.Value = ""
		        ENDIF
		    ELSE
		        AERROR(laError)
		        MESSAGEBOX("Error al consultar la empresa: " + laError[2], 16, "Error")
		    ENDIF
		    
		    *-- Cerrar cursor temporal
		    IF USED("cur_empresa")
		        USE IN cur_empresa
		    ENDIF
		ELSE
			thisform.txt_empresa.Value = ''
		ENDIF
	ENDPROC

ENDDEFINE
