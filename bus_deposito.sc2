		MinButton = .F.
		Name = "FORM1"
		registro = .F.
		ShowWindow = 1
		Width = 543
		WindowType = 1
	*</PropValue>

	ADD OBJECT 'cmdgroup' AS commandgroup WITH ;
		AutoSize = .F., ;
		ButtonCount = 2, ;
		Height = 37, ;
		Left = 429, ;
		Name = "cmdgroup", ;
		TabIndex = 3, ;
		Top = 360, ;
		Value = 1, ;
		Width = 112, ;
		Command1.AutoSize = .F., ;
		Command1.Caption = "Elegir", ;
		Command1.Height = 27, ;
		Command1.Left = 5, ;
		Command1.Name = "Command1", ;
		Command1.Top = 5, ;
		Command1.Width = 50, ;
		Command2.AutoSize = .F., ;
		Command2.Caption = "Salir", ;
		Command2.Height = 27, ;
		Command2.Left = 57, ;
		Command2.Name = "Command2", ;
		Command2.Top = 5, ;
		Command2.Width = 50
		*< END OBJECT: BaseClass="commandgroup" />

	ADD OBJECT 'Grid1' AS grid WITH ;
		AllowCellSelection = .F., ;
		BackColor = 255,255,255, ;
		ColumnCount = 0, ;
		DeleteMark = .F., ;
		FontSize = 8, ;
		ForeColor = 0,0,0, ;
		GridLineColor = 192,192,192, ;
		GridLines = 0, ;
