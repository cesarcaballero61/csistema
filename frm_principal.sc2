	PROCEDURE Activate
		thisform.actualizardashboard()
	ENDPROC

	PROCEDURE actualizardashboard
		
		    LOCAL lnEmpresa, lnSucursal, ldHoy, lcSQL
		
		    *--- Empresa y sucursal actual (ajustá a tu lógica)
		    lnEmpresa  = 1
		    lnSucursal = 1
		    ldHoy      = DATE()
		
		    *--- Armar llamada al store procedure
		    SET DATE YMD
		    SET CENTURY ON
		
		    lcSQL = "CALL sp_dashboard_mes(" + ;
		             TRANSFORM(lnEmpresa) + "," + ;
		             TRANSFORM(lnSucursal) + ",'" + DTOC(ldHoy,1) + "')"
		
		    IF SQLEXEC(conexion, lcSQL, "curDash") <= 0
		        MESSAGEBOX("Error al obtener datos del dashboard", 16, "Error")
		        RETURN
		    ENDIF
		
		    *=========================================================
		    * 1) _dash_cobranza1
		    *   _LBLPORCENTAJE
		    *   _lbltotal
		    *   _lblcobrado
		    *   _lblpendiente
		    *=========================================================
		    
		    WITH THIS._dash_cobranza1
		        .txtporcentaje.value = ;
		            TRANSFORM(curDash.porcentaje_cobranza, "999.9") + " %"
		
		        .txttotal.value = ;
		            TRANSFORM(curDash.total_cuotas_mes, "999,999,999,999")
		
		        .txtcobrado.value = ;
		            TRANSFORM(curDash.total_cobrado_mes, "999,999,999,999")
		
		        .txtpendiente.value = ;
		            TRANSFORM(curDash.total_pendiente_mes, "999,999,999,999")
		    ENDWITH
		
		    *=========================================================
		    * 2) _dash_cuota_vencida1
		    *   _lblcantidad_pendiente
		    *   _lblcant_cuota
		    *   _lblcant_cobrada
		    *=========================================================
		    
		    WITH THIS._dash_cuota_vencida1
		        .txtcuotapendiente.value = ;
		            TRANSFORM(curDash.cantidad_cuotas_pendientes_mes, "999,999,999")
		
		        .txtcantcuota.value = +;
		            TRANSFORM(curDash.cantidad_cuotas_total_mes, "999,999,999")
		
		        .txtcuotascobradas.value = +;
		            TRANSFORM(curDash.cantidad_cuotas_cobradas_mes, "999,999,999")
		    ENDWITH
		
		    *=========================================================
		    * 3) _dash_venta1
		    *   _lbltotal_mes
		    *   _lbltotal_contado
		    *   _lbltotal_credito
		    *=========================================================
		    
		    WITH THIS._dash_venta1
		        .txttotal_mes.value =;
		            TRANSFORM(curDash.total_ventas_mes, "999,999,999,999")
		
		        .txttotal_contado.value =;
		            TRANSFORM(curDash.total_ventas_contado, "999,999,999,999")
		
		        .txttotal_credito.value =;
		            TRANSFORM(curDash.total_ventas_credito, "999,999,999,999")
		    ENDWITH
		
	ENDPROC

	PROCEDURE habilitar_menu_administrador
		if _screen.oapp.ctipousuario <> "ADMINISTRADOR"
			WITH THIS._sidebar1.scrollbase.Scrollcontainer
			
				*Anulaciones
				._anular1.btn_anular_venta.thisenabled(.f.)
				._anular1.btn_anular_recibo.thisenabled(.f.)
				._anular1.btn_anular_compra.thisenabled(.f.)
				
				*usuarios,personales,vendedores y cobradores
				._archivos1.btn_usuarios.thisenabled(.f.)
				._archivos1.btn_cambio_password.thisenabled(.f.)
				._archivos1.btn_personales.thisenabled(.f.)
				._archivos1.btn_vendedores.thisenabled(.f.)
				._archivos1.btn_cobradores.thisenabled(.f.)
				
			
			ENDWITH 
		
		endif
	ENDPROC

	PROCEDURE Init
		dodefault()
		
		this.windowstate = 2
		this.caption = _screen.oapp.cappname + " - codigo de empresa: (" + ALLTRIM(STR(_screen.oapp.nempresa)) + ") codigo de suc.:(" + ALLTRIM(STR(_screen.oapp.nsucursal)) + ")";
			+ " Establ. " + _screen.oapp.cestablecimiento + " Punto Exp. " + _screen.oapp.cpuntoexpedicion
			
		this.statusbarbase1.txt_usuario.Value = _screen.oapp.cusuariosistema
		this.statusbarbase1.txt_tipousuario.Value = _screen.oapp.ctipousuario
		this.statusbarbase1.txt_nombreUsuarioPersonal.Value = _screen.oapp.cpersonalnombre 
		*HABILITAR BOTONES
		this.habilitar_menu_administrador()
		
		
		
		
	ENDPROC

	PROCEDURE llenar_tree
	ENDPROC

	PROCEDURE QueryUnload
		    * Forma simple y directa
		    _SCREEN.oApp.Shutdown(.T.)
	ENDPROC

	PROCEDURE _menutop1.btn_informes.Click
		LOCAL lcScrollContainer
		lcScrollContainer =LOWER('_SCROLLINFORME')
		
		THISFORM._Sidebar1.SCrollcontainer = lcScrollContainer 
		THISFORM._Sidebar1.RELoad()
	ENDPROC

	PROCEDURE _menutop1.btn_principal.Click
		LOCAL lcScrollContainer
		lcScrollContainer =LOWER('_SCROLLMENU')
		
		THISFORM._Sidebar1.SCrollcontainer = lcScrollContainer 
		THISFORM._Sidebar1.RELoad()
	ENDPROC

	PROCEDURE _menutop1.btn_salir.Click
		    * Forma simple y directa
		    _SCREEN.oApp.Shutdown(.T.)
	ENDPROC

ENDDEFINE
