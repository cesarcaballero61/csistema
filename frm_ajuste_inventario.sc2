	PROCEDURE cancelar_ajuste
		WITH thisform
			.txt_fecha.setvalue({})
			.txt_id_deposito.Value = 0
			.txt_deposito.Value = ""
			.txt_id_motivo.Value = 0
			.txt_motivo_ajuste.Value = ""
			.txt_tipo_motivo.value = ""
			.txt_observacion.Value = ""
			
			.limpiar_articulos()
			
			.txt_fecha.thisenabled(.t.)
			.txt_id_deposito.enabled =.t.
			.txt_id_motivo.enabled = .t.
			
			.txt_fecha.SetFocus()
			
			SELECT curtmpajuste
			ZAP
			
			.grdDetalle.Refresh()
			
		
		ENDWITH 
		
	ENDPROC

	PROCEDURE grid_detalle
		WITH this.grdDetalle
			.AllowCellSelection = .f.
			.ColumnCount = 0
			.RecordSourceType = 1
		    .RecordSource = "curtmpajuste"
		    .ColumnCount = 6
		    
		    *-- Columna 1: NCODARTICULO
		    .Column1.Header1.Caption = "ID.ARTICULO"
		    .Column1.Header1.FontBold = .t.
		    .Column1.ControlSource = "curtmpajuste.ncodarticulo"
		    .Column1.Width = 80
		    .Column1.Alignment = 1  && Derecha
		
		    *-- Columna 2: CCODARTICULO
		    .Column2.Header1.Caption = "CODIGO"
		    .Column2.Header1.FontBold = .t.
		    .Column2.ControlSource = "curtmpajuste.ccodarticulo"
		    .Column2.Width = 100
		
		    *-- Columna 3: CARTICULO
		    .Column3.Header1.Caption = "ARTICULO"
		    .Column3.Header1.FontBold = .t.
		    .Column3.ControlSource = "curtmpajuste.carticulo"
		    .Column3.Width = 300
		
		    *-- Columna 4: CGRUPOSUBGRUPO
		    .Column4.Header1.Caption = "GRUPO/SUBGRUPO"
		    .Column4.Header1.FontBold = .t.
		    .Column4.ControlSource = "curtmpajuste.cgruposubgrupo"
		    .Column4.Width = 150
		
		    *-- Columna 5: CMARCA
		    .Column5.Header1.Caption = "MARCA"
		    .Column5.Header1.FontBold = .t.
		    .Column5.ControlSource = "curtmpajuste.cmarca"
		    .Column5.Width = 120
		
		    *-- Columna 6: NCANTIDAD
		    .Column6.Header1.Caption = "CANTIDAD"
		    .Column6.Header1.FontBold = .t.
		    .Column6.ControlSource = "curtmpajuste.ncantidad"
		    .Column6.Width = 80
		    .Column6.Alignment = 1  && Derecha
		    .Column6.InputMask = "999,999,999"
		    
		    .Redraw()
		ENDWITH
	ENDPROC

	PROCEDURE Init
		DODEFAULT()
		THIS.GRid_detalle()
	ENDPROC

	PROCEDURE limpiar_articulos
		thisform.txt_cod_articulo.value = ''
		thisform.txt_idarticulo.value		= 0
		thisform.txt_descripcion.value 		= ''
		thisform.txt_grupo_subgrupo.value	= ''
		thisform.txt_marca.value			= ''
		thisform.txt_preciocosto.Value		= 0
		thisform.txt_conteo.value			= 0
		
		this.grdDetalle.Refresh()
	ENDPROC

	PROCEDURE Load
		DODEFAULT()
		
		SET SEPARATOR  TO "."
		SET POINT TO ","
		
		CREATE CURSOR curtmpajuste(ncodarticulo n(10), ccodarticulo c(45), carticulo c(45), cgruposubgrupo c(45), cmarca c(45), ncantidad n(10),nprecio_costo n(10))
		
	ENDPROC

	PROCEDURE registrar_ajuste
		IF EMPTY(thisform.txt_id_deposito.Value)
			MESSAGEBOX("Debes indicar el deposito para registrar el ajuste!",16,"Aviso")
			thisform.txt_id_deposito.SetFocus
			RETURN 
		ENDIF 
		
		IF EMPTY(thisform.txt_id_motivo.Value)
			MESSAGEBOX("Debes indicar el motivo ajuste para registrar el ajuste!",16,"Aviso")
			thisform.txt_id_motivo.SetFocus
			RETURN 
		ENDIF 
		
		*detalle
		SELECT curtmpajuste
		GO TOP
		IF EOF()
			MESSAGEBOX('Este ajuste no posee detalles para guardar!', 16, "Atencion")
			RETURN
		ENDIF
		
		LOCAL ldfecha, lniddeposito, lnidmotivo_ajuste, lcobservacion, lcTipo, lnidEmpresa, lnidSucursal, lnidusuario
		
		ldfecha				= thisform.txt_fecha.getvalue()
		lniddeposito 		= thisform.txt_id_deposito.Value
		lnidmotivo_ajuste	= thisform.txt_id_motivo.Value
		lcobservacion 		= ALLTRIM(thisform.txt_observacion.Value)
		lcTipo				= IIF(ALLTRIM(thisform.txt_tipo_motivo.Value)=='E','ENTRADAS','SALIDAS')
		lnidEmpresa			= _Screen.OAPP.nempresa
		lnidSucursal		= _Screen.OAPP.nsucursal
		lnidusuario			= _Screen.OAPP.nusuariosistema
		
		IF MESSAGEBOX("Desea guardar los datos del ajuste de inventario?", 36, "Aviso") = 6
			
			LOCAL llok AS Boolean
			llok = .T.
			
			LOCAL ARRAY loerror[1]
			
			= SQLEXEC(conexion, "START TRANSACTION")
			
			* 1. LLAMAR AL SP PARA GUARDAR CABECERA DE AJUSTE DE INVENTARIO
			LOCAL lcsqlcabecera, lnidajuste, lcnro_ajuste
			
			lcsqlcabecera = "CALL ajuste_inventario(?lnidEmpresa, ?lnidSucursal, ?ldfecha, ?lnidusuario, " + ;
				"?lnidmotivo_ajuste, ?lniddeposito, ?lcTipo, ?lcobservacion)"
			
			LOCAL lnresult
			lnresult = SQLEXEC(conexion, lcsqlcabecera, "curAjusteId")
			
			IF lnresult < 0
				llok = .F.
				AERROR(loerror)
				= SQLEXEC(conexion, "ROLLBACK")
				MESSAGEBOX("Error al guardar la cabecera del ajuste: " + loerror[2], 16, "Error")
				RETURN
			ENDIF
			
			* OBTENER EL ID DE AJUSTE GENERADO DEL SP
			lnidajuste = 0
			IF USED("curAjusteId") AND RECCOUNT("curAjusteId") > 0
				lnidajuste = curAjusteId.id_generado
			ELSE
				llok = .F.
				= SQLEXEC(conexion, "ROLLBACK")
				MESSAGEBOX("Error al obtener el ID de ajuste generado", 16, "Error")
				RETURN
			ENDIF
			
			* 2. LLAMAR AL SP PARA GUARDAR DETALLES DE AJUSTE
			SELECT curtmpajuste
			GO TOP
			SCAN
				LOCAL lcsqldetalle
				lcsqldetalle = "CALL ajuste_inventario_detalle(?lnidajuste, ?curtmpajuste.ncodarticulo, " + ;
					"?curtmpajuste.cmarca, ?curtmpajuste.cgruposubgrupo, ?curtmpajuste.nprecio_costo, ?curtmpajuste.ncantidad)"
				
				lnresult = SQLEXEC(conexion, lcsqldetalle)
				IF lnresult < 0
					llok = .F.
					AERROR(loerror)
					= SQLEXEC(conexion, "ROLLBACK")
					MESSAGEBOX("Error al guardar el detalle del ajuste: " + loerror[2], 16, "Error")
					RETURN
				ENDIF
			ENDSCAN
			
			* 3. OBTENER EL NRO DE AJUSTE ANTES DEL COMMIT
			IF llok
				* Consultar el número de ajuste usando el ID generado
				LOCAL lcsql_consulta_nro
				lcsql_consulta_nro = "SELECT nro_ajuste FROM ajuste_inventario WHERE idajuste_inventario = ?lnidajuste"
				
				lnresult = SQLEXEC(conexion, lcsql_consulta_nro, "curNroAjuste")
				
				IF lnresult < 0 OR NOT USED("curNroAjuste") OR RECCOUNT("curNroAjuste") = 0
					llok = .F.
					AERROR(loerror)
					= SQLEXEC(conexion, "ROLLBACK")
					MESSAGEBOX("Error al obtener el número de ajuste: " + loerror[2], 16, "Error")
					RETURN
				ELSE
					lcnro_ajuste = ALLTRIM(curNroAjuste.nro_ajuste)
					USE IN curNroAjuste
				ENDIF
			ENDIF
			
			* 4. HACER COMMIT SI TODO SALE BIEN
			IF llok
				= SQLEXEC(conexion, "COMMIT")
				MESSAGEBOX("Ajuste de inventario guardado correctamente! Nro: " + lcnro_ajuste, 64, "Éxito")
				
				* Limpiar formulario después de guardar
				thisform.cancelar_ajuste()
				
			ELSE
				= SQLEXEC(conexion, "ROLLBACK")
				MESSAGEBOX("Error al guardar el ajuste de inventario", 16, "Error")
			ENDIF
			
			RETURN llok
		ELSE
			RETURN .F.
		ENDIF
	ENDPROC

	PROCEDURE Btnnorbase1.Click
		thisform.registrar_ajuste()
	ENDPROC

	PROCEDURE Btnnorbase2.Click
		if messagebox("¿Desea cancelar este ajuste y limpiar la ventana?", 36, "Aviso") = 6
			thisform.cancelar_ajuste()
		ENDIF 
	ENDPROC

	PROCEDURE Btnnorbase3.Click
		THISFORM.Release()
	ENDPROC

	PROCEDURE btn_agregar.Click
		IF EMPTY(thisform.txt_cod_articulo.Value)
			MESSAGEBOX("Debes seleccionar un artículo para seguir.", 48, "Aviso")
			thisform.txt_cod_articulo.SetFocus()
			RETURN
		ENDIF
		
		IF EMPTY(thisform.txt_conteo.Value)
			MESSAGEBOX("Debes ingresar la cantidad para el ajuste.", 48, "Aviso")
			thisform.txt_conteo.SetFocus()
			RETURN
		ENDIF
		
		SELECT curtmpajuste
		LOCAL lnCodArticulo, lcCodArticulo
		lnCodArticulo = thisform.txt_idarticulo.Value
		lcCodArticulo = ALLTRIM(thisform.txt_cod_articulo.Value)
		
		*-- Verificar si el artículo ya existe en el cursor
		LOCATE FOR ncodarticulo = lnCodArticulo
		IF FOUND()
		    *-- Artículo duplicado encontrado
		    MESSAGEBOX("El artículo '" + ALLTRIM(thisform.txt_descripcion.Value) + "' ya existe en la lista." + CHR(13) + ;
		               "Código: " + lcCodArticulo, 48, "Artículo Duplicado")
		    thisform.txt_cod_articulo.SetFocus()
		    thisform.limpiar_articulos()
		    RETURN
		ENDIF
		
		*-- Agregar un nuevo registro en blanco (solo si no es duplicado)
		APPEND BLANK
		
		*-- Reemplazar los campos con los valores correspondientes
		REPLACE ;
		    ncodarticulo    WITH lnCodArticulo, ;              			&& Código numérico
		    ccodarticulo    WITH lcCodArticulo, ;            			&& Código alfanumérico
		    carticulo       WITH ALLTRIM(thisform.txt_descripcion.Value), ; && Descripción del artículo
		    cgruposubgrupo  WITH ALLTRIM(thisform.txt_gRUPO_SUBGRUPO.Value), ; && Grupo/Subgrupo
		    cmarca          WITH ALLTRIM(thisform.txt_marca.Value), ;   && Marca
		    ncantidad       WITH thisform.txt_conteo.Value ,;             && Cantidad
		 	nprecio_costo 	with thisform.txt_preciocosto.Value				&& preciocosto   
		thisform.limpiar_articulos()
		thisform.txt_cod_articulo.SetFocus()
		thisform.grddetalle.Refresh()
	ENDPROC

	PROCEDURE btn_borrar.Click
		*========================================
		* Evento Click del Botón Eliminar
		* Descripción: Elimina el registro actual del cursor y actualiza el total
		*========================================
		LOCAL lnRecNo, lnRecCount, lnResponse
		
		* Validaciones iniciales
		IF !USED("curtmpajuste")
		    MESSAGEBOX("No hay registros para eliminar.", 48, "Aviso")
		    RETURN .F.
		ENDIF
		
		SELECT curtmpajuste 
		lnRecCount = RECCOUNT()
		
		* Validar que existen registros y hay uno seleccionado
		DO CASE
		    CASE lnRecCount = 0
		        MESSAGEBOX("No hay registros para eliminar.", 48, "Aviso")
		        RETURN .F.
		    
		    CASE EOF() OR BOF()
		        MESSAGEBOX("Debe seleccionar un registro para eliminar.", 48, "Aviso")
		        RETURN .F.
		ENDCASE
		
		* Confirmar eliminación
		lnResponse = MESSAGEBOX("¿Está seguro de eliminar este registro?", 4+32, "Confirmar Eliminación")
		IF lnResponse != 6
		    RETURN .F.
		ENDIF
		
		* Guardar posición actual
		lnRecNo = RECNO()
		
		* Eliminar el registro
		DELETE
		SELECT curtmpajuste 
		
		
		* Reposicionar cursor
		lnRecCount = RECCOUNT()
		IF lnRecCount > 0
		    * Ir al mismo número de registro o al último si ya no existe
		    GO MIN(lnRecNo, lnRecCount)
		ENDIF
		thisform.grdDetalle.Refresh()
		MESSAGEBOX("Registro eliminado correctamente.", 64, "Éxito")
		RETURN .T.
	ENDPROC

	PROCEDURE txt_cod_articulo.KeyPress
		lparameters nkeycode, nshiftaltctrl
		
		
		if nkeycode = 42
			nodefault
		
			if empty(thisform.txt_id_deposito.value)
				messagebox("Seleccione un depósito", 16, "Aviso")
				thisform.txt_id_deposito.setfocus()
				return
			endif
		
		
			local loregistro as object
			do form bus_articulo with _screen.oapp.nsucursal, thisform.txt_id_deposito.value to  loregistro
		
		
			if vartype(loregistro) <> "L"
		
				this.value = alltrim(loregistro.codbarra)
				this.setfocus()
		
			else
		
				this.value = ""
		
			endif
		endif
	ENDPROC

	PROCEDURE txt_cod_articulo.LostFocus
		dodefault()
		if empty(thisform.txt_id_deposito.value)
			messagebox('Debes indicar un deposito', 16, "Aviso")
			thisform.txt_id_deposito.setfocus
			nodefault
		endif
		
		if not empty(this.value)
			local lccodarticulo, lncoddeposito, lncodsucursal, lcsql
		
			lncodsucursal = _screen.oapp.nsucursal
			lccodarticulo = alltrim(this.value)
			lncoddeposito = thisform.txt_id_deposito.value
		
		
			lcsql = "SELECT * FROM v_articulo WHERE codbarra = '" + lccodarticulo + "'"
			lcsql = lcsql + " and iddeposito = " + alltrim(str(lncoddeposito, 10, 0))
			lcsql = lcsql + " and idsucursal = " + alltrim(str(lncodsucursal, 10, 0))
		
			if sqlexec(conexion, lcsql, "cur_articulo") > 0
				if reccount("cur_articulo") > 0
		
		** Llenar campos del formulario.
		**
		
					this.value = alltrim(cur_articulo.codbarra)
					thisform.txt_idarticulo.value		= cur_articulo.idarticulo
					thisform.txt_descripcion.value 		= cur_articulo.descripcion
					thisform.txt_grupo_subgrupo.value	= alltrim(cur_articulo.nombre_grupo) + " " + alltrim(cur_articulo.nombre_subgrupo)
					thisform.txt_marca.value			= alltrim(cur_articulo.nombre_marca)
					thisform.txt_preciocosto.value		= cur_articulo.precio_costo
					thisform.txt_conteo.value			= 1
		
				else
		
		** Articulo no encontrado
		
					messagebox("Articulo no encontrado", 16, "Atención")
		
		
		*limpiar datos de articulos
					thisform.limpiar_articulos()
		
		** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		
					this.setfocus()
					nodefault
		
				endif
			else
		** Error en la consulta
				local laerror[1]
				aerror(laerror)
		
				messagebox("Error al buscar la Articulos: " + laerror[2], 16, "Error")
			endif
		else
		*thisform.txt_forma.value = ""
		endif
	ENDPROC

	PROCEDURE txt_fecha.Ribbontextbox1.LostFocus
		DODEFAULT() 
		IF EMPTY(THIS.Value)
			THIS.Parent.SETvalue(DATE())
		ENDIF 
		*THIS.Parent.THIsenabled(.F.)
	ENDPROC

	PROCEDURE txt_id_deposito.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			
			local loregistro as object
			do form bus_deposito to loregistro
		
		
			if vartype(loregistro) <> "L"
				this.value = loregistro.iddeposito
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
		
		if m.nkeycode = 22
			nodefault
			local lncodigo
			do form deposito with .t. to m.lncodigo
			this.value = m.lncodigo
		endif
	ENDPROC

	PROCEDURE txt_id_deposito.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnDeposito, lcSQL
		    
		    lnDeposito = this.Value
		    
		    lcSQL = "SELECT * FROM v_deposito WHERE iddeposito = " + ALLTRIM(STR(lnDeposito, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_deposito") > 0
		        IF RECCOUNT("cur_deposito") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_deposito.iddeposito
					thisform.txt_deposito.Value = cur_deposito.deposito
					this.enabled = .f.
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Deposito no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_deposito.Value = ""
		            
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar deposito: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_deposito.Value = ""
		ENDIF
	ENDPROC

	PROCEDURE txt_id_motivo.KeyPress
		LPARAMETERS nKeyCode, nShiftAltCtrl
		
		if nkeycode = 42
			NODEFAULT
			
			local loregistro as object
			do form bus_motivo to loregistro
		
		
			if vartype(loregistro) <> "L"
				this.value = loregistro.idmotivo
				this.setfocus()
			else
				this.value = 0
			endif
		endif
		
		
		if m.nkeycode = 22
			nodefault
			local lncodigo
			do form motivo_ajuste with .t. to m.lncodigo
			
			IF VARTYPE(lncodigo) <> "L"
				this.value = m.lncodigo
			ELSE
				this.Value = 0
			ENDIF 
		endif
	ENDPROC

	PROCEDURE txt_id_motivo.LostFocus
		DODEFAULT()
		IF NOT EMPTY(this.Value)
		    LOCAL lnIdmotivo, lcSQL
		    
		    lnIdmotivo= this.Value
		    
		    lcSQL = "SELECT * FROM motivo_ajuste WHERE idmotivo = " + ALLTRIM(STR(lnIdmotivo, 20, 0))
		    
		    IF SQLExec(conexion, lcSQL, "cur_motivo") > 0
		        IF RECCOUNT("cur_motivo") > 0
		        
		            ** Llenar campos del formulario.
		            this.Value = cur_motivo.idmotivo
					thisform.txt_motivo_ajuste.Value = cur_motivo.motivo
					thisform.txt_tipo_motivo.Value = cur_motivo.tipo
					this.enabled = .f.
					
		        ELSE
		        
		            ** Personal no encontrado
		            MESSAGEBOX("Motivo de ajuste no encontrado", 16, "Atención")
		            this.Value = 0
		            thisform.txt_motivo_ajuste.Value = ""
		            thisform.txt_tipo_motivo.Value = ""
		           ** DEVOLVER EL FOCO AL CONTROL ACTUAL.
		            
		           this.SetFocus()
		           NODEFAULT 
		           
		        ENDIF
		    ELSE
		        ** Error en la consulta
		        LOCAL laError[1]
		        AERROR(laError)
		        MESSAGEBOX("Error al buscar motivo de ajuste: " + laError[2], 16, "Error")
		    ENDIF
		ELSE
			thisform.txt_motivo_ajuste.Value = ""
			thisform.txt_tipo_motivo.Value = ""
		ENDIF
	ENDPROC

ENDDEFINE
